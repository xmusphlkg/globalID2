[Unit]
Description=GlobalID dashboard web
After=globalid-dashboard-api.service
Wants=globalid-dashboard-api.service
PartOf=globalid-stack.target
OnFailure=globalid-notify-failure@%n.service

[Service]
Type=simple
User=__RUN_AS_USER__
Group=__RUN_AS_GROUP__
WorkingDirectory=__PROJECT_DIR__/dashboard
EnvironmentFile=-__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/scripts/run_dashboard_web_service.sh
Restart=always
RestartSec=5
# Node exits 143 (128+SIGTERM) on a requested stop; that is not a failure.
SuccessExitStatus=143
TimeoutStopSec=20
