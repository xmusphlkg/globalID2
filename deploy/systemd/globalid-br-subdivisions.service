[Unit]
Description=Refresh Brazil SINAN residence-state cases and site exports
After=globalid-docker.service
Wants=globalid-docker.service

[Service]
Type=oneshot
User=__RUN_AS_USER__
Group=__RUN_AS_GROUP__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/.env
ExecStart=/usr/bin/flock __PROJECT_DIR__/data/official-subdivision-refresh.lock __PROJECT_DIR__/venv/bin/python __PROJECT_DIR__/scripts/update_br_subdivisions.py --recent-years 2 --apply --export
TimeoutStartSec=10800
