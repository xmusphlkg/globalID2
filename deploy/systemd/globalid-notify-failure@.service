# Template unit — sends a rate-limited SMTP email after a service failure.
# Referenced via OnFailure= in dashboard API, worker, scheduler, and web units.
#
# Usage: OnFailure=globalid-notify-failure@%n.service
[Unit]
Description=Notify admin about failed service %i

[Service]
Type=oneshot
User=__RUN_AS_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/.env
RuntimeDirectory=globalid-notify
RuntimeDirectoryPreserve=yes
ExecStart=__PROJECT_DIR__/venv/bin/python __PROJECT_DIR__/scripts/send_systemd_failure_alert.py %i
