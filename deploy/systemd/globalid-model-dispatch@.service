[Unit]
Description=GlobalID auxiliary model dispatcher %i
After=globalid-ai-worker.service
BindsTo=globalid-ai-worker.service
PartOf=globalid-ai-worker.service

[Service]
Type=simple
User=__RUN_AS_USER__
Group=__RUN_AS_GROUP__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/.env
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE__POOL_SIZE=2
Environment=DATABASE__MAX_OVERFLOW=1
ExecStart=__PROJECT_DIR__/venv/bin/python -m src.services.model_dispatch_worker
Restart=on-failure
RestartSec=10
MemoryMax=2G
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
