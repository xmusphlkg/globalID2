[Unit]
Description=GlobalID dashboard task worker
After=globalid-docker.service globalid-dashboard-api.service
Wants=globalid-docker.service globalid-dashboard-api.service
PartOf=globalid-stack.target

[Service]
Type=simple
User=__RUN_AS_USER__
Group=__RUN_AS_GROUP__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/.env
ExecStart=__PROJECT_DIR__/scripts/run_dashboard_worker_service.sh
Restart=always
RestartSec=5

