{
  "$schema": "../surveillance-data/node_modules/wrangler/config-schema.json",
  "name": "globalid-papers-template",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "globalid-papers" }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
