# Application
APP_ENV=development
APP_NAME=GlobalID
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://globalid:globalid_dev_password@localhost:5432/globalid
DATABASE_URL_SYNC=postgresql://globalid:globalid_dev_password@localhost:5432/globalid

# Parallel Processing
# AI 并行任务数（用于报告生成等 AI 任务）
MAX_PARALLEL_TASKS=10

# Crawler Parallel Processing
# 爬虫并发数（降低以避免数据库死锁，建议值：2-3）
MAX_CRAWLER_CONCURRENT=2

# AI Models
DEFAULT_AI_PROVIDER=qianwen
DEFAULT_MODEL=qwen3.5-plus

# Paths
DATA_DIR=./data
LOG_DIR=./logs
CONFIG_DIR=./configs
