# Application
APP_ENV=development
APP_NAME=GlobalID
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://globalid:globalid_dev_password@localhost:5432/globalid
DATABASE_URL_SYNC=postgresql://globalid:globalid_dev_password@localhost:5432/globalid
# Dedicated append-oriented Situation Room history store. If URL is blank,
# GlobalID reuses DATABASE_URL credentials and connects to this database name.
SITUATION_HISTORY_DATABASE_ENABLED=true
SITUATION_HISTORY_DATABASE_NAME=globalid_history
SITUATION_HISTORY_DATABASE_URL=

# Parallel Processing
# AI 并行任务数（用于报告生成等 AI 任务）
MAX_PARALLEL_TASKS=10
# 后台任务 worker 并发数（用于队列中的知识库、报告、发布等任务）
TASK_WORKER_CONCURRENCY=6

# Crawler Parallel Processing
# 爬虫并发数（降低以避免数据库死锁，建议值：2-3）
MAX_CRAWLER_CONCURRENT=2

# AI Models
DEFAULT_AI_PROVIDER=qianwen
DEFAULT_MODEL=qwen3.5-plus
AI__MODEL_CHAIN_RAW=qwen3.5-397b-a17b,qwen3-max-2026-01-23,qwen3.5-flash-2026-02-23
# 知识库任务会按 disease_id 做模型分流，并按这个列表轮转优先级
AI__KNOWLEDGE_MODEL_SHARDS_RAW=qwen3.5-397b-a17b,qwen3-max-2026-01-23,qwen3.5-flash-2026-02-23
# 知识生成的受控重试：额度/权限错误不重试，超时立即切路由，格式或引用最多修复一次
AI__KNOWLEDGE_GENERATION_TIMEOUT_SECONDS=300
AI__KNOWLEDGE_MODEL_REQUEST_TIMEOUT_SECONDS=120
AI__KNOWLEDGE_MODEL_ATTEMPTS_PER_ROUTE=2
AI__KNOWLEDGE_TIMEOUT_COOLDOWN_SECONDS=60
AI__KNOWLEDGE_OUTPUT_REPAIR_ATTEMPTS=1
AI__KNOWLEDGE_MAX_OUTPUT_TOKENS=3600
# 多专家工作流的角色模型偏好，格式示例：planner=qwen3.5-plus|qwen3-max,analyst=qwen3-max,reviewer=qwen3.5-flash
AI__AGENT_ROLE_MODELS_RAW=
AI__AGENT_MAX_REPLAN_ROUNDS=1

# 新来源疾病映射：单路由超时、常规尝试上限，以及达到上限后的周期性恢复重试
MAPPING_AI_REQUEST_TIMEOUT_SECONDS=90
MAPPING_AI_MAX_ATTEMPTS=5
MAPPING_AI_EXHAUSTED_RETRY_HOURS=6
MAPPING_AI_PROVIDER_COOLDOWN_MINUTES=360
MAPPING_AI_BATCH_SIZE=6
MAPPING_AUTOMATION_POLL_SECONDS=5

# 映射通知只在每天 01:00 UTC（北京时间 09:00）发送一封中文摘要
MAPPING_EMAIL_DIGEST_ENABLED=true
MAPPING_EMAIL_DIGEST_HOUR_UTC=1
MAPPING_EMAIL_DIGEST_MAX_EVENTS=2000
# MAPPING_REVIEW_DASHBOARD_URL=https://your-dashboard.example/ai/disease-mapping
AI__AGENT_MAX_SEARCH_ROUNDS=2
AI__AGENT_STEP_TOKEN_BUDGET=2500
AI__AGENT_TOTAL_TOKEN_BUDGET=12000

# Paths
DATA_DIR=./data
LOG_DIR=./logs
CONFIG_DIR=./configs

# Korea KDCA/data.go.kr OpenAPI
# Use the decoded service key from data.go.kr's API application page.
DATA_GO_KR_SERVICE_KEY=
# Optional no-key fallback: KDCA dportal/KOSIS files downloaded from the web UI.
KR_DPORTAL_FILE=
KR_DPORTAL_DIR=./data/raw/kr/portal
KR_KOSIS_FILE=

# Local service/autostart settings
GLOBALID_API_PORT=8000
GLOBALID_DASHBOARD_PORT=3000
GLOBALID_SITE_PORT=4321
GLOBALID_DASHBOARD_BUILD_ON_START=0
GLOBALID_SITE_BUILD_ON_START=0
GLOBALID_SITE_REGENERATE_ON_START=0

# Optional dashboard API shared secret. When set, all /api/v1 HTTP endpoints
# except health checks require this key via the Next.js server-side proxy.
DASHBOARD_API_KEY=
# Server-only target used by the Next.js BFF. Never expose this as NEXT_PUBLIC_*.
API_PROXY_TARGET=http://127.0.0.1:8000

# Default report email recipients, comma-separated
EMAIL__DEFAULT_RECIPIENTS_RAW=reports@example.com

# Automation
# Use nested env names because AppSettings reads nested models with "__"
AUTOMATION__ENABLED=false
AUTOMATION__TIMEZONE=Asia/Shanghai
AUTOMATION__POLL_INTERVAL_SECONDS=30
AUTOMATION__DEFAULT_RETRY_THRESHOLD=3
AUTOMATION__ALERT_GROUP_COOLDOWN_MINUTES=360
AUTOMATION__ADMIN_EMAILS_RAW=admin@example.com,ops@example.com
# Example jobs JSON:
# AUTOMATION__JOBS_JSON=[{"job_id":"cn-daily","name":"CN Daily Crawl","country_code":"CN","source":"all","daily_time":"08:00","priority":"normal","process":true,"save_raw":true,"fill_missing":true,"force":false,"retry_threshold":3}]
AUTOMATION__JOBS_JSON=[]

# Research Radar. Manual refresh remains available when scheduling is disabled.
LITERATURE__ENABLED=true
LITERATURE__SCHEDULE_ENABLED=false
LITERATURE__INTERVAL_MINUTES=360
LITERATURE__TIMEZONE=UTC
LITERATURE__CONTACT_EMAIL=research-radar@globalinfectiousdisease.com
LITERATURE__INITIAL_LOOKBACK_DAYS=14
LITERATURE__INDEX_OVERLAP_DAYS=2
LITERATURE__MAX_RECORDS_PER_RUN=300
LITERATURE__MAX_EUROPE_PMC_RECORDS=200
LITERATURE__EUROPE_PMC_ENABLED=true
LITERATURE__AUTO_PUBLISH_MIN_SCORE=0.72
LITERATURE__AI_ENRICHMENT_ENABLED=false
LITERATURE__AI_ENRICHMENT_SCHEDULE_ENABLED=false
LITERATURE__AI_ENRICHMENT_INTERVAL_MINUTES=60
LITERATURE__AI_ENRICHMENT_BATCH_SIZE=8
LITERATURE__AI_MAX_QUALITY_ATTEMPTS=2
LITERATURE__AI_ENRICHMENT_LANGUAGES_RAW=en,zh
LITERATURE__AI_MIN_ABSTRACT_CHARACTERS=180
LITERATURE__AI_REQUIRE_OPEN_ACCESS=true
LITERATURE__AI_MODEL_REQUEST_TIMEOUT_SECONDS=120
LITERATURE__GAP_DISCOVERY_ENABLED=true
LITERATURE__GAP_DISCOVERY_SCHEDULE_ENABLED=false
LITERATURE__GAP_DISCOVERY_INTERVAL_MINUTES=720
LITERATURE__GAP_DISCOVERY_MAX_GAPS_PER_RUN=8
LITERATURE__GAP_DISCOVERY_RECORDS_PER_GAP=25
LITERATURE__GAP_DISCOVERY_CANDIDATE_LIMIT=12
LITERATURE__GAP_DISCOVERY_LOOKBACK_DAYS=730
LITERATURE__GAP_DISCOVERY_RETRY_HOURS=24
LITERATURE__AUTOPILOT_ENABLED=false
LITERATURE__AUTOPILOT_ARTICLE_MIN_SCORE=0.70
LITERATURE__AUTOPILOT_ARTICLE_EXCLUDE_BELOW_SCORE=0.60
LITERATURE__AUTOPILOT_DISEASE_MIN_CONFIDENCE=0.82
LITERATURE__AUTOPILOT_EXACT_RELATION_MIN_CONFIDENCE=0.78
LITERATURE__AUTOPILOT_CONTEXT_RELATION_MIN_CONFIDENCE=0.82
LITERATURE__AUTOPILOT_SUMMARY_MIN_QUALITY=0.90
LITERATURE__AUTOPILOT_AUTO_REJECT_WEAK_LINKS=true
LITERATURE__AUTOPILOT_AUTO_EXCLUDE_INCOMPLETE=true
LITERATURE__AUTOPILOT_AUTO_EXCLUDE_PREPRINTS=true
LITERATURE__AUTOPILOT_EXPORT_ON_CHANGE=true

# SMTP email for report delivery and failure alerts (AWS SES, SendGrid, etc.)
AUTOMATION__SMTP_HOST=email-smtp.us-east-1.amazonaws.com
AUTOMATION__SMTP_PORT=587
AUTOMATION__SMTP_USERNAME=
AUTOMATION__SMTP_PASSWORD=
AUTOMATION__SMTP_FROM_EMAIL=noreply@yourdomain.com
AUTOMATION__SMTP_USE_TLS=true

# Cloudflare deployment
# Used by Wrangler CLI. Keep real values in .env, not in Git.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PROJECT_NAME=

# Public GA4 identifier injected during the local Astro build. This can also be
# managed in Dashboard → Settings → Site Settings.
PUBLIC_GA4_MEASUREMENT_ID=G-8P39XV52NC
DATA_RELEASE__AUTO_FAILURE_COOLDOWN_MINUTES=720

# Automatic raw crawler archive. The platform runs this after successful data
# update tasks; no GitHub Release or manual upload is involved.
RAW_ARCHIVE__ENABLED=false
RAW_ARCHIVE__REPO_URL=git@github.com:your-org/globalid-data-archive.git
RAW_ARCHIVE__BRANCH=main
RAW_ARCHIVE__REPOSITORY_DIR=exports/raw-git-archive
RAW_ARCHIVE__GIT_TIMEOUT_SECONDS=1800

# Cloudflare subscription Worker configuration
# These values are read by cloudflare/subscriptions/scripts/wrangler-env.sh.
SUBSCRIPTIONS__WORKER_NAME=globalid-subscriptions
SUBSCRIPTIONS__COMPATIBILITY_DATE=2026-05-01
SUBSCRIPTIONS__WORKERS_DEV=true
SUBSCRIPTIONS__PUBLIC_BASE_URL=http://localhost:8787
SUBSCRIPTIONS__ALLOWED_ORIGINS=http://localhost:4321,http://localhost:4322,http://localhost:4323,https://globalinfectiousdisease.com
SUBSCRIPTIONS__DEBUG_RETURN_TOKENS=false
SUBSCRIPTIONS__D1_BINDING=DB
SUBSCRIPTIONS__D1_DATABASE_NAME=
SUBSCRIPTIONS__D1_DATABASE_ID=
SUBSCRIPTIONS__PENDING_EXPIRY_DAYS=14
SUBSCRIPTIONS__SUBMISSION_RATE_LIMIT_PER_HOUR=30
SUBSCRIPTIONS__CONFIRMATION_EMAIL_LIMIT_PER_10_MINUTES=2
SUBSCRIPTIONS__NOTIFICATION_BATCH_SIZE=20
SUBSCRIPTIONS__SYNC_OPTIONS_ON_RELEASE=auto
# Optional Cloudflare Cron Trigger for pending cleanup, for example: 17 3 * * *
SUBSCRIPTIONS__MAINTENANCE_CRON=
# Optional subscription Worker SMTP overrides.
# If these are empty, cloudflare/subscriptions/scripts/wrangler-env.sh falls back
# to the shared AUTOMATION__SMTP_* settings above.
SUBSCRIPTIONS__SMTP_HOST=
SUBSCRIPTIONS__SMTP_PORT=
SUBSCRIPTIONS__SMTP_USERNAME=
SUBSCRIPTIONS__SMTP_PASSWORD=
SUBSCRIPTIONS__SMTP_FROM_EMAIL=
SUBSCRIPTIONS__SMTP_FROM_NAME=GIDS Alerts
SUBSCRIPTIONS__SMTP_USE_TLS=
# Runtime secrets uploaded with: cloudflare/subscriptions/scripts/wrangler-env.sh sync-secrets
SUBSCRIPTIONS__TOKEN_SIGNING_SECRET=
SUBSCRIPTIONS__ADMIN_API_TOKEN=
SUBSCRIPTIONS__TURNSTILE_SECRET_KEY=

# Static site public subscription API endpoint. If omitted, the subscribe page
# uses SUBSCRIPTIONS__PUBLIC_BASE_URL during build, then falls back to the
# production subscriptions domain.
PUBLIC_SUBSCRIPTIONS_API_BASE=https://subscriptions.globalinfectiousdisease.com
