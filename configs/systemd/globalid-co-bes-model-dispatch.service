[Unit]
Description=Shared model-center dispatcher for unattended BES parsing
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=likangguo
Group=likangguo
WorkingDirectory=/home/likangguo/globalID/globalID2/data/runtime/co-bes/current
EnvironmentFile=-/home/likangguo/globalID/globalID2/.env
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE__POOL_SIZE=3
Environment=DATABASE__MAX_OVERFLOW=1
ExecStart=/home/likangguo/globalID/globalID2/venv/bin/python -m src.services.model_dispatch_worker --standalone
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
MemoryMax=4G
UMask=0077

[Install]
WantedBy=multi-user.target
