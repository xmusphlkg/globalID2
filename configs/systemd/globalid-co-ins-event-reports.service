ExecStart=/home/likangguo/globalID/globalID2/venv/bin/python /home/likangguo/globalID/globalID2/scripts/imports/collect_co_sivigila_resources.py --output /home/likangguo/globalID/globalID2/data/raw/co/ins-publications
