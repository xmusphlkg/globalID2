    "AnomalyAssessment": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "detector_tier": {
          "default": "common_count",
          "enum": [
            "common_count",
            "rare_count",
            "rate",
            "context_only"
          ],
          "title": "Detector Tier",
          "type": "string"
        },
        "state": {
          "enum": [
            "routine",
            "watch",
            "alert",
            "strong",
            "not_modeled"
          ],
          "title": "State",
          "type": "string"
        },
        "raw_p_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw P Value"
        },
        "q_value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q Value"
        },
        "standardized_exceedance": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standardized Exceedance"
        },
        "dispersion": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dispersion"
        },
        "fit_status": {
          "title": "Fit Status",
          "type": "string"
        },
        "effect_threshold_passed": {
          "title": "Effect Threshold Passed",
          "type": "boolean"
        },
        "diagnostics": {
          "additionalProperties": true,
          "title": "Diagnostics",
          "type": "object"
        }
      },
      "required": [
        "model",
        "state",
        "fit_status",
        "effect_threshold_passed"
      ],
      "title": "AnomalyAssessment",
      "type": "object"
    },
