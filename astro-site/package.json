{
  "name": "globalid-report-site",
  "type": "module",
  "version": "0.5.2",
  "scripts": {
    "dev": "astro dev",
    "site:data": "sh -c 'PYTHON_BIN=../venv/bin/python3; if [ ! -x \"$PYTHON_BIN\" ]; then PYTHON_BIN=python3; fi; \"$PYTHON_BIN\" ../scripts/generate_site_data.py'",
    "build": "node scripts/build-site.mjs",
    "build:astro": "astro build",
    "build:with-data": "npm run site:data && npm run build",
    "test:curve": "node --experimental-strip-types --test src/components/charts/epidemicCurveModel.test.ts",
    "test:monthly": "node --experimental-strip-types --test src/components/charts/monthlyBarModel.test.ts src/components/charts/monthlyBarOption.integration.test.ts",
    "test:charts": "node --experimental-strip-types --test src/lib/echartsReact.test.ts src/lib/country-coverage.test.ts src/components/charts/epidemicCurveModel.test.ts src/components/charts/monthlyBarModel.test.ts src/components/charts/monthlyBarOption.integration.test.ts",
    "test:knowledge": "node --experimental-strip-types --test src/utils/knowledge.test.ts",
    "test:seo": "node --experimental-strip-types --test src/lib/report-routes.test.ts src/lib/seo.test.ts src/lib/sitemap-entries.test.ts",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "astro": "^7.1.6",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "marked": "^18.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
