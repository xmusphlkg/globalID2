---
// src/layouts/ReportLayout.astro
import BaseLayout from './BaseLayout.astro';
import {
  buildBreadcrumbStructuredData,
  type JsonLdNode,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: Array<{ label: string; labelZh?: string; href?: string }>;
  initialLanguage?: 'en' | 'zh';
  structuredData?: JsonLdNode | JsonLdNode[];
}

const {
  title,
  description,
  breadcrumbs = [],
  initialLanguage = 'en',
  structuredData = [],
} = Astro.props;
const homeLabel = initialLanguage === 'zh' ? '首页' : 'Home';
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const breadcrumbStructuredData = buildBreadcrumbStructuredData({
  siteOrigin,
  currentPath: Astro.url.pathname,
  breadcrumbs,
});
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const additionalStructuredData = [
  ...(breadcrumbStructuredData ? [breadcrumbStructuredData] : []),
  ...pageStructuredData,
];
---

<BaseLayout
  title={title}
  description={description}
  initialLanguage={initialLanguage}
  additionalStructuredData={additionalStructuredData}
>
  <!-- Breadcrumb -->
  {breadcrumbs.length > 0 && (
    <nav class="site-breadcrumb border-b backdrop-blur-sm sticky top-16 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <ol class="site-breadcrumb-list flex flex-wrap items-center gap-2 text-sm">
          <li>
            <a
              href="/"
              class="site-breadcrumb-link academic-kicker tracking-[0.16em] transition-colors"
              data-lang-en="Home"
              data-lang-zh="首页"
            >{homeLabel}</a>
          </li>
          {breadcrumbs.map((crumb, i) => (
            <>
              <li class="site-breadcrumb-separator">/</li>
              <li>
                {crumb.href && i < breadcrumbs.length - 1 ? (
                  <a
                    href={crumb.href}
                    class="site-breadcrumb-link transition-colors"
                    data-lang-en={crumb.label}
                    data-lang-zh={crumb.labelZh ?? crumb.label}
                  >
                    {initialLanguage === 'zh' ? (crumb.labelZh ?? crumb.label) : crumb.label}
                  </a>
                ) : (
                  <span
                    class="site-breadcrumb-current"
                    data-lang-en={crumb.label}
                    data-lang-zh={crumb.labelZh ?? crumb.label}
                  >{initialLanguage === 'zh' ? (crumb.labelZh ?? crumb.label) : crumb.label}</span>
                )}
              </li>
            </>
          ))}
        </ol>
      </div>
    </nav>
  )}

  <!-- Page content -->
  <div class="academic-shell">
    <slot />
  </div>
</BaseLayout>
