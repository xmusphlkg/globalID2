---
// src/layouts/BaseLayout.astro
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  initialLanguage?: 'en' | 'zh';
}

const {
  title,
  description = 'GIDS — Global Infectious Disease Surveillance',
  image = '/logo-2.png',
  noindex = false,
  initialLanguage = 'en',
} = Astro.props;

const siteReleaseId = import.meta.env.PUBLIC_GIDS_RELEASE_ID?.trim() || 'development';
const siteSourceCommit = import.meta.env.PUBLIC_GIDS_SOURCE_COMMIT?.trim() || '';
const siteDeploymentBranch = import.meta.env.PUBLIC_GIDS_DEPLOY_BRANCH?.trim() || '';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteOrigin = Astro.site ? new URL(Astro.site).origin : canonicalURL.origin;
const pageTitle = title === 'GIDS' ? title : `${title} | GIDS`;
const robotsContent = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const maintenanceMessage = import.meta.env.PUBLIC_GIDS_MAINTENANCE_MESSAGE?.trim();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}#website`,
      url: siteOrigin,
      name: 'GIDS',
      description,
      inLanguage: ['en', 'zh'],
      publisher: {
        '@id': `${siteOrigin}#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}#organization`,
      name: 'GIDS',
      url: siteOrigin,
      logo: new URL('/logo.png', siteOrigin).toString(),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL.toString(),
      name: pageTitle,
      description,
      isPartOf: {
        '@id': `${siteOrigin}#website`,
      },
    },
  ],
};
---

<!doctype html>
<html
  lang={initialLanguage === 'zh' ? 'zh-CN' : 'en'}
  data-initial-lang={initialLanguage}
  data-release-id={siteReleaseId}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="gids-release-id" content={siteReleaseId} />
    <meta name="gids-source-commit" content={siteSourceCommit} />
    <meta name="gids-deployment-branch" content={siteDeploymentBranch} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#f4f7fb" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GIDS" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Apply theme before first paint to avoid flashing -->
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'light';
        const storedLang = localStorage.getItem('lang');
        const initialLang = document.documentElement.getAttribute('data-initial-lang');
        const lang = storedLang === 'zh' || storedLang === 'en'
          ? storedLang
          : (initialLang === 'zh' ? 'zh' : 'en');
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header initialLanguage={initialLanguage} />
    {maintenanceMessage && <div class="site-update-banner border-b" role="status" aria-live="polite">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 text-sm font-medium text-center">
        <span
          data-lang-en={maintenanceMessage}
          data-lang-zh="网站正在维护，部分功能可能暂时不可用。"
        >
          {initialLanguage === 'zh'
            ? '网站正在维护，部分功能可能暂时不可用。'
            : maintenanceMessage}
        </span>
      </div>
    </div>}
    <main class="flex-1 academic-shell">
      <slot />
    </main>
    <Footer initialLanguage={initialLanguage} />
  </body>
</html>
