---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'GIDS — Global Infectious Disease Surveillance',
  image = '/logo-2.png',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteOrigin = Astro.site ? new URL(Astro.site).origin : canonicalURL.origin;
const pageTitle = title === 'GIDS' ? title : `${title} | GIDS`;
const robotsContent = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}#website`,
      url: siteOrigin,
      name: 'GIDS',
      description,
      inLanguage: ['en', 'zh'],
      publisher: {
        '@id': `${siteOrigin}#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}#organization`,
      name: 'GIDS',
      url: siteOrigin,
      logo: new URL('/logo.png', siteOrigin).toString(),
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL.toString(),
      name: pageTitle,
      description,
      isPartOf: {
        '@id': `${siteOrigin}#website`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#f4f7fb" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="GIDS" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Apply theme before first paint to avoid flashing -->
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'light';
        const storedLang = localStorage.getItem('lang');
        const lang = storedLang === 'zh' ? 'zh' : 'en';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <div class="site-update-banner border-b" role="status" aria-live="polite">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 text-sm font-medium text-center">
        <span
          data-lang-en="Data is currently being updated. Some features may be temporarily unstable."
          data-lang-zh="网站正在更新数据，部分功能可能暂时不稳定。"
        >
          Data is currently being updated. Some features may be temporarily unstable.
        </span>
      </div>
    </div>
    <main class="flex-1 academic-shell">
      <slot />
    </main>
    <Footer />
  </body>
</html>
