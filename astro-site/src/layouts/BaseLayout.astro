---
// src/layouts/BaseLayout.astro
import '../styles/fonts.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { buildAlternatePaths, clampSeoDescription, type JsonLdNode, type SeoDocument } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  initialLanguage?: 'en' | 'zh';
  additionalStructuredData?: JsonLdNode | JsonLdNode[];
  seo?: SeoDocument;
  hideLanguageToggle?: boolean;
}

const {
  title,
  description = 'GIDS — Global Infectious Disease Surveillance',
  image = '/og-default.png',
  noindex = false,
  initialLanguage = 'en',
  additionalStructuredData = [],
  seo,
  hideLanguageToggle = false,
} = Astro.props;

const siteReleaseId = import.meta.env.PUBLIC_GIDS_RELEASE_ID?.trim() || 'development';
const siteSourceCommit = import.meta.env.PUBLIC_GIDS_SOURCE_COMMIT?.trim() || '';
const siteDeploymentBranch = import.meta.env.PUBLIC_GIDS_DEPLOY_BRANCH?.trim() || '';
const siteBase = Astro.site?.toString() ?? Astro.url.origin;
const canonicalURL = new URL(seo?.canonicalPath ?? Astro.url.pathname, siteBase);
const siteOrigin = new URL(siteBase).origin;
const documentLocale = seo?.locale ?? initialLanguage;
const pageTitle = seo?.title ?? (title === 'GIDS' ? title : `${title} | GIDS`);
const pageDescription = seo?.description ?? description;
const metaDescription = clampSeoDescription(pageDescription);
const pageImage = seo?.image ?? image;
const pageImageAlt = seo?.imageAlt ?? `${pageTitle} — GIDS`;
const shouldNoindex = seo?.noindex ?? noindex;
const robotsContent = shouldNoindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const alternatePaths = seo?.alternatePaths ?? buildAlternatePaths(
  Astro.url.pathname,
  documentLocale,
);
const alternateUrls = Object.entries(alternatePaths).map(([locale, path]) => ({
  locale,
  url: new URL(path, siteBase).toString(),
}));
const pageType = seo?.pageType ?? 'WebPage';
const ogType = ['Report', 'Article', 'MedicalWebPage'].includes(pageType) ? 'article' : 'website';
const gaMeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID?.trim();
const validGaMeasurementId = gaMeasurementId && /^G-[A-Z0-9]+$/i.test(gaMeasurementId)
  ? gaMeasurementId
  : null;
const maintenanceMessage = import.meta.env.PUBLIC_GIDS_MAINTENANCE_MESSAGE?.trim();
const extraStructuredData = Array.isArray(additionalStructuredData)
  ? additionalStructuredData
  : [additionalStructuredData];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}#website`,
      url: siteOrigin,
      name: 'Global Infectious Disease Surveillance',
      alternateName: 'GIDS',
      description: 'Official-source infectious disease surveillance data, trends, downloadable datasets, and methodology.',
      inLanguage: ['en', 'zh'],
      publisher: {
        '@id': `${siteOrigin}#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteOrigin}#organization`,
      name: 'Global Infectious Disease Surveillance',
      alternateName: 'GIDS',
      url: siteOrigin,
      logo: new URL('/logo.png', siteOrigin).toString(),
      sameAs: ['https://github.com/xmusphlkg/globalID2'],
      publishingPrinciples: new URL('/about/#editorial-responsibility', siteOrigin).toString(),
    },
    {
      '@type': 'DataCatalog',
      '@id': `${siteOrigin}#catalog`,
      name: 'GIDS infectious disease surveillance data catalog',
      url: new URL('/diseases/', siteOrigin).toString(),
      publisher: { '@id': `${siteOrigin}#organization` },
    },
    {
      '@type': pageType,
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL.toString(),
      name: pageTitle,
      description: pageDescription,
      author: { '@id': `${siteOrigin}#organization` },
      publisher: { '@id': `${siteOrigin}#organization` },
      isPartOf: {
        '@id': `${siteOrigin}#website`,
      },
      inLanguage: documentLocale === 'zh' ? 'zh-CN' : 'en',
      ...(seo?.datePublished ? { datePublished: seo.datePublished } : {}),
      ...(seo?.dateModified ? { dateModified: seo.dateModified } : {}),
    },
    ...extraStructuredData,
  ],
};
---

<!doctype html>
<html
  lang={documentLocale === 'zh' ? 'zh-CN' : 'en'}
  data-lang={documentLocale}
  data-release-id={siteReleaseId}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="gids-release-id" content={siteReleaseId} />
    <meta name="gids-source-commit" content={siteSourceCommit} />
    <meta name="gids-deployment-branch" content={siteDeploymentBranch} />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />
    {alternateUrls.map(({ locale, url }) => (
      <link rel="alternate" hreflang={locale === 'zh' ? 'zh-CN' : 'en'} href={url} />
    ))}
    {alternatePaths.en && <link rel="alternate" hreflang="x-default" href={new URL(alternatePaths.en, siteBase)} />}
    <meta name="robots" content={robotsContent} />
    <meta name="theme-color" content="#102A43" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="GIDS" />
    <meta property="og:locale" content={documentLocale === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={documentLocale === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={new URL(pageImage, siteBase)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageImageAlt} />
    <meta property="og:url" content={canonicalURL} />
    {seo?.datePublished && <meta property="article:published_time" content={seo.datePublished} />}
    {seo?.dateModified && <meta property="article:modified_time" content={seo.dateModified} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={new URL(pageImage, siteBase)} />
    <meta name="twitter:image:alt" content={pageImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    {validGaMeasurementId && <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}window.gtag=gtag;gtag('js',new Date());gtag('config','${validGaMeasurementId}');document.addEventListener('click',function(event){const target=event.target instanceof Element?event.target.closest('[data-seo-event],[data-file-download]'):null;if(!target)return;gtag('event',target.getAttribute('data-seo-event')||'dataset_download');});(function(){let started=false;function loadAnalytics(){if(started)return;started=true;const script=document.createElement('script');script.async=true;script.src='https://www.googletagmanager.com/gtag/js?id=${validGaMeasurementId}';document.head.appendChild(script)}function deferAnalytics(){window.setTimeout(function(){if('requestIdleCallback'in window){window.requestIdleCallback(loadAnalytics,{timeout:2000})}else{loadAnalytics()}},2000)}if(document.readyState==='complete'){deferAnalytics()}else{window.addEventListener('load',deferAnalytics,{once:true})}})();`} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Apply theme before first paint to avoid flashing -->
    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme === 'light' || storedTheme === 'dark' ? storedTheme : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.toggle('dark', theme === 'dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a class="skip-link" href="#main-content">{documentLocale === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <Header initialLanguage={initialLanguage} hideLanguageToggle={hideLanguageToggle} />
    {maintenanceMessage && <div class="site-update-banner border-b" role="status" aria-live="polite">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 text-sm font-medium text-center">
        <span>
          {initialLanguage === 'zh'
            ? '网站正在维护，部分功能可能暂时不可用。'
            : maintenanceMessage}
        </span>
      </div>
    </div>}
    <main id="main-content" tabindex="-1" class="flex-1 academic-shell">
      <slot />
    </main>
    <Footer initialLanguage={initialLanguage} />
  </body>
</html>
