---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternatePaths } from '../lib/seo';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' };
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;

const updatedAt = 'August 18, 2026';

const summaryItems = [
  {
    labelEn: 'Purpose',
    labelZh: '服务目的',
    valueEn: 'Public-interest infectious disease surveillance, charts, reports, and email updates.',
    valueZh: '面向公共利益的传染病监测、图表、报告与邮件更新。',
  },
  {
    labelEn: 'Source basis',
    labelZh: '来源基础',
    valueEn: 'Official public health feeds, open data, public reports, and automated normalization.',
    valueZh: '官方公共卫生数据源、开放数据、公开报告与自动标准化处理。',
  },
  {
    labelEn: 'Use boundary',
    labelZh: '使用边界',
    valueEn: 'Informational only; not medical advice, legal advice, or an official emergency alert system.',
    valueZh: '仅供信息参考；不构成医疗建议、法律建议或官方应急预警系统。',
  },
  {
    labelEn: 'Commercial use',
    labelZh: '商业使用',
    valueEn: 'Not-for-profit public-interest service; unauthorized commercial use is prohibited.',
    valueZh: '非营利公共利益服务；禁止未经授权的商业使用。',
  },
];

const sections = [
  {
    titleEn: '1. Acceptance and Scope',
    titleZh: '1. 接受协议与适用范围',
    paragraphs: [
      {
        en: 'These Service Terms and Privacy Notice govern access to and use of GIDS, including the public website, disease and country pages, generated reports, charts, downloadable or machine-readable data, and subscription-related services.',
        zh: '本《服务协议与隐私说明》适用于你访问和使用 GIDS，包括公开网站、疾病与国家页面、生成报告、图表、可下载或机器可读数据，以及订阅相关服务。',
      },
      {
        en: 'By browsing the website, using published data, submitting a subscription form, or otherwise interacting with GIDS, you agree to these terms. If you do not agree, do not use the service or submit subscription information.',
        zh: '当你浏览网站、使用公开数据、提交订阅表单或以其他方式与 GIDS 交互，即表示你同意本协议。若你不同意，请勿使用服务或提交订阅信息。',
      },
    ],
  },
  {
    titleEn: '2. Service Purpose',
    titleZh: '2. 服务目的',
    paragraphs: [
      {
        en: 'GIDS is a Global Infectious Disease Surveillance project built to make official infectious disease surveillance data easier to find, compare, visualize, and monitor across jurisdictions.',
        zh: 'GIDS 是 Global Infectious Disease Surveillance 项目，旨在让不同司法辖区的官方传染病监测数据更易检索、比较、可视化和持续关注。',
      },
      {
        en: 'The service may include automated data collection, parsing, disease-name normalization, public-health source attribution, AI-assisted bilingual summaries, report generation, alert or digest subscriptions, and source-visible project materials.',
        zh: '服务内容可能包括自动化数据采集、解析、疾病名称标准化、公共卫生来源标注、AI 辅助双语摘要、报告生成、提醒或摘要订阅，以及源码可见的项目资料。',
      },
      {
        en: 'GIDS is provided for research, education, journalism, open-data exploration, and public-interest monitoring. It is not a substitute for official public health systems, clinical judgment, professional epidemiological review, or emergency communications.',
        zh: 'GIDS 用于研究、教育、新闻报道、开放数据探索和公共利益监测，不替代官方公共卫生系统、临床判断、专业流行病学复核或应急通信。',
      },
    ],
  },
  {
    titleEn: '3. Not-for-Profit Nature and Commercial Use Restrictions',
    titleZh: '3. 非营利性质与商业使用限制',
    paragraphs: [
      {
        en: 'The public GIDS website and subscription service are operated on a not-for-profit, public-interest, research-oriented basis. Unless GIDS expressly states otherwise, access to the public website and public subscription features is provided without charge.',
        zh: 'GIDS 公开网站和订阅服务以非营利、公共利益、研究导向方式运营。除非 GIDS 另有明确说明，公开网站和公开订阅功能均免费提供。',
      },
      {
        en: 'This statement describes the operating purpose of the public service. It does not represent that GIDS is a registered charity, tax-exempt organization, foundation, or other regulated non-profit legal entity unless a separate official notice expressly says so.',
        zh: '上述表述用于说明公开服务的运营目的，并不表示 GIDS 已登记为慈善机构、免税组织、基金会或其他受监管的非营利法律实体，除非另有正式公告明确说明。',
      },
      {
        en: 'Without prior written authorization from GIDS, you may not use the GIDS website, public data views, generated reports, charts, summaries, subscription system, name, logos, or branding for commercial products or services, resale, paid monitoring, proprietary datasets, advertising, lead generation, model training, automated commercial scraping, or any other revenue-generating activity.',
        zh: '未经 GIDS 事先书面授权，你不得将 GIDS 网站、公开数据视图、生成报告、图表、摘要、订阅系统、名称、标识或品牌用于商业产品或服务、转售、付费监测、专有数据集、广告、获客、模型训练、自动化商业抓取或任何其他营利性活动。',
      },
      {
        en: 'Permitted non-commercial uses include personal learning, academic citation, classroom use, public-interest journalism, non-commercial research, and internal evaluation, provided that you preserve attribution, do not misrepresent the data, and comply with source-specific terms.',
        zh: '允许的非商业使用包括个人学习、学术引用、课堂教学、公共利益新闻报道、非商业研究和内部评估，但你必须保留署名，不得歪曲数据，并遵守来源特定条款。',
      },
      {
        en: 'Commercial authorization must be explicit and in writing. Silence, lack of technical blocking, public availability, repository visibility, or receipt of subscription emails does not grant commercial permission.',
        zh: '商业授权必须是明确且书面的。沉默、未设置技术阻断、公开可访问、仓库可见或收到订阅邮件，均不构成商业许可。',
      },
      {
        en: 'This commercial-use restriction applies to the public service and GIDS-created content. If a separate software licence is published for identified repository files, that licence controls those files. The repository currently publishes no general LICENSE covering all code, and repository visibility alone grants no additional reuse permission. Third-party source data remains governed by the original providers\' terms.',
        zh: '本商业使用限制适用于公开服务和 GIDS 创建的内容。若仓库对特定文件另行公布软件许可，则该许可适用于相应文件。仓库当前未发布覆盖全部代码的通用 LICENSE，仓库公开可见本身不授予额外复用许可。第三方来源数据仍以原始提供方条款为准。',
      },
    ],
  },
  {
    titleEn: '4. Informational Use Only',
    titleZh: '4. 仅供信息参考',
    paragraphs: [
      {
        en: 'GIDS content does not constitute medical advice, diagnosis, treatment advice, legal advice, policy instruction, travel advice, or an official public health directive.',
        zh: 'GIDS 内容不构成医疗建议、诊断、治疗建议、法律建议、政策指令、旅行建议或官方公共卫生指令。',
      },
      {
        en: 'For personal medical questions, consult qualified healthcare professionals. For official case counts, reporting definitions, outbreaks, travel restrictions, public-health measures, or emergencies, consult the relevant government or health authority directly.',
        zh: '如涉及个人医疗问题，请咨询合格医疗专业人员。如涉及官方病例数、报告定义、暴发事件、旅行限制、公共卫生措施或紧急情况，请直接查阅相关政府或卫生主管机构信息。',
      },
      {
        en: 'Do not use GIDS as the sole basis for clinical decisions, emergency response, procurement, legal compliance, investment, insurance, employment, school closure, border control, or other high-impact decisions.',
        zh: '请勿将 GIDS 作为临床决策、应急响应、采购、法律合规、投资、保险、雇佣、停课、边境管理或其他重大影响决策的唯一依据。',
      },
    ],
  },
  {
    titleEn: '5. Data Sources and Methodology',
    titleZh: '5. 数据来源与处理方法',
    paragraphs: [
      {
        en: 'GIDS aggregates and republishes derived views of public infectious disease information from official health authorities, open-data portals, public dashboards, reports, APIs, and other source materials identified on the website.',
        zh: 'GIDS 会聚合并再发布来自官方卫生机构、开放数据门户、公共仪表板、报告、API 及网站列明来源材料的传染病公开信息衍生视图。',
      },
      {
        en: 'The project normalizes names, countries, time periods, cases, deaths, and related fields into a shared data model. This improves comparability but may also introduce mapping assumptions, aggregation choices, or temporary inconsistencies.',
        zh: '项目会将名称、国家、时间周期、病例数、死亡数及相关字段标准化到统一数据模型中。这有助于比较，但也可能引入映射假设、聚合选择或临时不一致。',
      },
      {
        en: 'Source data may be delayed, corrected, withdrawn, preliminary, incomplete, revised, or subject to different case definitions. GIDS may update records when source materials change, but it cannot guarantee real-time synchronization or complete historical correction.',
        zh: '来源数据可能存在延迟、修订、撤回、初步统计、不完整、定义差异等情况。GIDS 可在来源材料变化时更新记录，但无法保证实时同步或完整追溯修正。',
      },
    ],
  },
  {
    titleEn: '6. AI-Assisted Reports and Automated Processing',
    titleZh: '6. AI 辅助报告与自动化处理',
    paragraphs: [
      {
        en: 'Some summaries, insights, translations, labels, or reports may be generated or assisted by automated systems, including language models, based on database-backed surveillance records and source metadata.',
        zh: '部分摘要、洞察、翻译、标签或报告可能由自动化系统（包括语言模型）基于数据库监测记录和来源元数据生成或辅助生成。',
      },
      {
        en: 'AI-assisted content may contain omissions, outdated interpretations, translation issues, unsupported inferences, or reasoning errors. Users should verify important statements against cited sources and official publications.',
        zh: 'AI 辅助内容可能存在遗漏、过时解读、翻译问题、缺乏充分支持的推断或推理错误。对于重要陈述，用户应结合引用来源和官方发布内容自行核验。',
      },
      {
        en: 'GIDS may use review workflows and quality checks, but publication does not mean every automated statement has been independently reviewed by a licensed physician, attorney, public-health authority, or regulator.',
        zh: 'GIDS 可能使用审核流程和质量检查，但内容发布并不表示每一条自动化陈述均已由持证医生、律师、公共卫生主管机构或监管机构独立复核。',
      },
    ],
  },
  {
    titleEn: '7. Subscriptions and Email Communications',
    titleZh: '7. 订阅与邮件通信',
    paragraphs: [
      {
        en: 'When you submit a subscription request, GIDS records your email address, selected lists, country and disease preferences, language, delivery frequency, timezone, source page, confirmation status, and related delivery metadata needed to provide the requested updates.',
        zh: '当你提交订阅请求时，GIDS 会记录你的邮箱地址、所选列表、国家和疾病偏好、语言、投递频率、时区、来源页面、确认状态以及提供所请求更新所需的相关投递元数据。',
      },
      {
        en: 'Subscriptions may require email confirmation before activation. Confirmation messages, digests, reports, alerts, resubmission notices, or service messages may be sent by GIDS Alerts or another sender published by GIDS.',
        zh: '订阅可能需要邮件确认后才会激活。确认邮件、摘要、报告、提醒、重新提交通知或服务消息可能由 GIDS Alerts 或 GIDS 公布的其他发件人发送。',
      },
      {
        en: 'Every subscription delivery is intended to include an unsubscribe or preference-control mechanism where technically available and legally required. You may stop future subscription emails by using the signed unsubscribe link or the contact channel published by GIDS.',
        zh: '在技术可用且法律要求的范围内，每次订阅投递均应包含退订或偏好控制机制。你可以通过签名退订链接或 GIDS 公布的联系渠道停止后续订阅邮件。',
      },
      {
        en: 'Subscription emails should accurately identify the sender and should not use materially deceptive subject lines or routing information. Where a message is promotional or otherwise requires additional disclosures, GIDS should include the legally required sender, contact, and opt-out information.',
        zh: '订阅邮件应准确标识发件人，不应使用具有实质误导性的主题行或路由信息。若邮件属于推广性质或依法需要额外披露，GIDS 应包含法律要求的发件人、联系方式和退订信息。',
      },
      {
        en: 'Email delivery is not guaranteed. Messages may be delayed, filtered, blocked, duplicated, or fail because of provider limits, recipient settings, security checks, or third-party infrastructure.',
        zh: '邮件投递不作保证。由于服务商限制、收件人设置、安全检查或第三方基础设施原因，邮件可能延迟、被过滤、被拦截、重复或发送失败。',
      },
    ],
  },
  {
    titleEn: '8. User Responsibilities',
    titleZh: '8. 用户责任',
    paragraphs: [
      {
        en: 'You are responsible for evaluating whether GIDS content is suitable for your use case, confirming information against primary sources, and complying with laws, professional duties, institutional review requirements, and source-specific terms that apply to your use.',
        zh: '你应自行评估 GIDS 内容是否适合你的使用场景，结合一手来源进行确认，并遵守适用于你使用行为的法律、专业义务、机构审查要求和来源特定条款。',
      },
      {
        en: 'You must not submit another person\'s email address without authorization, interfere with the service, bypass security controls, misrepresent GIDS output as an official government publication, remove source attribution, or use the service to send spam, malware, deceptive content, or unlawful material.',
        zh: '你不得未经授权提交他人邮箱地址，不得干扰服务、绕过安全控制、将 GIDS 输出误称为政府官方发布、移除来源标注，或利用服务发送垃圾邮件、恶意软件、欺骗性内容或违法材料。',
      },
      {
        en: 'Automated access, scraping, mirroring, or bulk download should respect robots directives, published API guidance, rate limits, cache headers, source terms, and reasonable load constraints.',
        zh: '自动化访问、抓取、镜像或批量下载应遵守 robots 指令、已发布 API 指南、速率限制、缓存头、来源条款和合理负载约束。',
      },
    ],
  },
  {
    titleEn: '9. Intellectual Property, Attribution, and Reuse',
    titleZh: '9. 知识产权、署名与复用',
    paragraphs: [
      {
        en: 'Rights are reserved, where protectable, in the GIDS software, website design, generated presentation, documentation, and original text, except to the extent an express permission, file-specific licence, or applicable legal exception provides otherwise. The separate Copyright & Reuse notice explains the current rights layers and attribution practice.',
        zh: '对于 GIDS 软件、网站设计、生成式呈现、文档和原创文本中依法可受保护的部分，除非明确许可、特定文件许可或适用法律例外另有规定，相关权利予以保留。单独的《版权与复用说明》列明当前权利分层和署名方式。',
      },
      {
        en: 'Public health source data remains subject to the rights, licenses, disclaimers, and attribution requirements of the original source authorities or data providers. GIDS does not claim ownership of third-party source materials.',
        zh: '公共卫生来源数据仍受原始来源机构或数据提供方的权利、许可、免责声明和署名要求约束。GIDS 不主张拥有第三方来源材料。',
      },
      {
        en: 'When reusing GIDS-derived datasets, charts, or reports, preserve source attribution, cite GIDS and the relevant primary sources, identify the retrieval or build date, and avoid implying endorsement by GIDS or any health authority.',
        zh: '当你复用 GIDS 衍生数据集、图表或报告时，应保留来源标注，引用 GIDS 及相关一手来源，注明获取日期或构建日期，并避免暗示 GIDS 或任何卫生主管机构对你的使用背书。',
      },
      {
        en: 'You may not use GIDS names, logos, trade dress, screenshots, reports, charts, or data views in a way that suggests sponsorship, certification, partnership, official approval, or public-health authority status without express written permission.',
        zh: '未经明确书面许可，你不得以暗示赞助、认证、合作关系、官方批准或公共卫生主管机构身份的方式使用 GIDS 名称、标识、商业外观、截图、报告、图表或数据视图。',
      },
    ],
  },
  {
    titleEn: '10. Privacy Notice',
    titleZh: '10. 隐私说明',
    paragraphs: [
