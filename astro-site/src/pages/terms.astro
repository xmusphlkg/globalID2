---

<BaseLayout
  title={pick('Service Terms', '服务协议')}
  description={pick('GIDS service terms and privacy notice for public infectious disease surveillance data, AI-assisted reports, and email subscriptions.', '适用于公开传染病监测数据、AI 辅助报告和邮件订阅的 GIDS 服务协议与隐私说明。')}
  initialLanguage={locale}
  seo={{ title: pick('Service Terms | GIDS', '服务协议 | GIDS'), description: pick('GIDS service terms and privacy notice for public infectious disease surveillance data, AI-assisted reports, and email subscriptions.', '适用于公开传染病监测数据、AI 辅助报告和邮件订阅的 GIDS 服务协议与隐私说明。'), locale, canonicalPath: `${prefix}/terms/`, alternatePaths: buildAlternatePaths(`${prefix}/terms/`, locale), pageType: 'WebPage' }}
>
  <section class="terms-page">
    <div class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="terms-hero">
        <p class="terms-kicker">{pick('Official notice', '官方说明')}</p>
        <h1>{pick('GIDS Service Terms and Privacy Notice', 'GIDS 服务协议与隐私说明')}</h1>
        <p class="terms-updated">{pick(`Last updated: ${updatedAt}`, '最后更新：2026 年 8 月 18 日')}</p>
        <p class="terms-lead">{pick('This page explains the rules for using GIDS, the limits of public infectious disease surveillance information, and how subscription data is handled.', '本页说明 GIDS 的使用规则、公开传染病监测信息的使用边界，以及订阅数据的处理方式。')}</p>
      </div>

      <div class="terms-summary" aria-label={pick('Terms summary', '协议摘要')}>
        {summaryItems.map((item) => (
          <article>
            <p class="terms-summary-label">{pick(item.labelEn, item.labelZh)}</p>
            <p class="terms-summary-value">{pick(item.valueEn, item.valueZh)}</p>
          </article>
        ))}
      </div>

      <div class="terms-surface">
        {sections.map((section, index) => (
          <details class="terms-section" open={index < 3}>
            <summary>
              <h2>{pick(section.titleEn, section.titleZh)}</h2>
              <span aria-hidden="true">+</span>
            </summary>
            <div>
              {section.paragraphs.map((paragraph) => (
                <p>{pick(paragraph.en, paragraph.zh)}</p>
              ))}
            </div>
          </details>
        ))}

        <section class="terms-links-section">
          <h2>{pick('Project Links', '项目链接')}</h2>
          <div class="terms-link-list">
            <a href={`${prefix}/copyright/`}>
              <span>{pick('Copyright & reuse notice', '版权与复用说明')}</span>
            </a>
            <a href="https://github.com/xmusphlkg/globalID2" target="_blank" rel="noopener noreferrer">
              <span>{pick('Source repository', '源码仓库')}</span>
            </a>
            <a href="https://github.com/xmusphlkg/globalID2/issues" target="_blank" rel="noopener noreferrer">
              <span>{pick('Issue tracker', '问题反馈')}</span>
            </a>
            <a href={`${prefix}/subscribe/`}>
              <span>{pick('Subscription center', '订阅中心')}</span>
            </a>
          </div>
        </section>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.terms-page {
  min-height: 100%;
}

.terms-page > div {
  padding-top: clamp(1.75rem, 4vw, 2.8rem);
  padding-bottom: clamp(2rem, 5vw, 3.2rem);
}

.terms-hero {
  border-left: 2px solid rgb(20 184 166 / 0.7);
  padding-left: 1rem;
}

.terms-page h1 {
  margin-top: 0.35rem;
  max-width: 820px;
  font-family: var(--font-serif, Georgia, serif);
  font-size: clamp(2rem, 4.8vw, 3rem);
  font-weight: 650;
  line-height: 1.08;
  color: rgb(var(--text-strong));
}

.terms-kicker {
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
  color: rgb(20 184 166);
}

.terms-updated {
  margin-top: 0.55rem;
  color: rgb(var(--text-faint));
  font-size: 0.82rem;
}

.terms-lead {
  margin-top: 0.75rem;
  max-width: 760px;
  color: rgb(var(--text-muted));
  font-size: 0.92rem;
  line-height: 1.62;
}

.terms-summary {
  display: grid;
  gap: 0.55rem;
  margin: 1.35rem 0;
}

.terms-summary article {
  border: 1px solid rgb(var(--border) / 0.78);
  background: rgb(var(--surface-raised) / 0.56);
  padding: 0.75rem;
}

.terms-summary-label {
  font-size: 0.74rem;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
  color: rgb(var(--text-faint));
}

.terms-summary-value {
  margin-top: 0.25rem;
  color: rgb(var(--text-strong));
  font-size: 0.82rem;
  line-height: 1.45;
}

.terms-surface {
  border: 1px solid rgb(var(--border) / 0.82);
  background: linear-gradient(180deg, rgb(var(--surface) / 0.98), rgb(var(--surface-raised) / 0.72));
  padding: 0;
  box-shadow: var(--paper-shadow);
}

.terms-section + .terms-section,
.terms-links-section {
  border-top: 1px solid rgb(var(--border) / 0.62);
}

.terms-section summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.9rem 1rem;
  cursor: pointer;
  list-style: none;
}

.terms-section summary::-webkit-details-marker {
  display: none;
}

.terms-section summary span {
  display: grid;
  width: 1.55rem;
  height: 1.55rem;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid rgb(var(--border));
  color: rgb(var(--text-muted));
  font-size: 1rem;
  line-height: 1;
}

.terms-section[open] summary span {
  transform: rotate(45deg);
}

.terms-section > div {
  padding: 0 1rem 1rem;
}

.terms-surface h2 {
  font-size: 1.05rem;
  font-weight: 800;
  color: rgb(var(--text-strong));
}

.terms-surface p {
  margin-top: 0.62rem;
  color: rgb(var(--text-muted));
  font-size: 0.86rem;
  line-height: 1.64;
}

.terms-links-section {
  padding: 1rem;
}

.terms-link-list {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 0.85rem;
}

.terms-link-list a {
  border: 1px solid rgb(20 184 166 / 0.38);
  background: rgb(20 184 166 / 0.08);
  color: rgb(15 118 110);
  padding: 0.55rem 0.72rem;
  font-size: 0.84rem;
  font-weight: 750;
  text-decoration: none;
}

:global(.dark) .terms-link-list a {
  color: rgb(45 212 191);
}

.terms-link-list a:hover {
  border-color: rgb(20 184 166 / 0.68);
  background: rgb(20 184 166 / 0.14);
}

@media (min-width: 768px) {
  .terms-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 1024px) {
  .terms-summary {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
}
</style>
