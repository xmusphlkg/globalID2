---
// src/pages/subscribe.astro — Subscribe page
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternatePaths } from '../lib/seo';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' };
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;

const subscriptionsApiBase = (
  import.meta.env.PUBLIC_SUBSCRIPTIONS_API_BASE ||
  process.env.PUBLIC_SUBSCRIPTIONS_API_BASE ||
  process.env.SUBSCRIPTIONS__PUBLIC_BASE_URL ||
  'https://subscriptions.globalinfectiousdisease.com'
).replace(/\/+$/, '');
---

<BaseLayout
  title={pick('Subscribe', '订阅')}
  description={pick('Subscribe to GIDS disease surveillance alerts and report updates.', '订阅 GIDS 疾病监测提醒和报告更新。')}
  initialLanguage={locale}
  seo={{ title: pick('Subscribe | GIDS', '订阅 | GIDS'), description: pick('Subscribe to GIDS disease surveillance alerts and report updates.', '订阅 GIDS 疾病监测提醒和报告更新。'), locale, canonicalPath: `${prefix}/subscribe/`, alternatePaths: buildAlternatePaths(`${prefix}/subscribe/`, locale), pageType: 'WebPage' }}
>
  <section class="subscribe-page">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(520px,1fr)] lg:items-start">
        <div class="subscribe-intro">
          <div class="mb-6 inline-flex items-center gap-2 border border-teal-500/25 bg-teal-500/10 px-3 py-1.5 text-xs font-semibold text-teal-400">
            <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
            <span>{pick('GIDS subscription center', 'GIDS 订阅中心')}</span>
          </div>

          <h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight text-[rgb(var(--text-strong))] sm:text-5xl">
            <span>{pick('Follow the surveillance updates that matter to you', '接收你关注的传染病监测更新')}</span>
          </h1>

          <p class="mt-5 max-w-2xl text-base leading-7 text-[rgb(var(--text-muted))] sm:text-lg">
            <span>{pick('Choose the countries, diseases, and update frequency you want to follow. You can unsubscribe at any time.', '选择你关注的国家/地区、疾病和更新频率；你可以随时退订。')}</span>
          </p>

          <dl class="subscribe-facts mt-8 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
            <div>
              <dt>{pick('Delivery', '投递内容')}</dt>
              <dd>{pick('Reports, Research Radar digests, and priority alerts', '报告、Research Radar 摘要和重点提醒')}</dd>
            </div>
            <div>
              <dt>{pick('Filters', '过滤条件')}</dt>
              <dd>{pick('Country, disease, topic, and study preferences', '国家、疾病、主题和研究类型偏好')}</dd>
            </div>
            <div>
              <dt>{pick('Control', '控制权')}</dt>
              <dd>{pick('One-click unsubscribe link', '一键退订链接')}</dd>
            </div>
          </dl>
        </div>

        <form
          id="subscription-form"
          class="subscribe-form"
          data-api-base={subscriptionsApiBase}
          data-page-locale={locale}
          novalidate
        >
          <div class="subscribe-form-header">
            <div>
              <p class="subscribe-kicker">{pick('Preferences', '订阅偏好')}</p>
              <h2>{pick('Create a subscription', '创建订阅')}</h2>
            </div>
            <span class="subscribe-service-badge">{pick('Official GIDS service', 'GIDS 官方服务')}</span>
          </div>

          <div class="subscribe-field">
            <label for="subscriber-email">{pick('Email address', '邮箱地址')}</label>
            <input
              id="subscriber-email"
              class="site-control-input subscribe-input"
              name="email"
              type="email"
              inputmode="email"
              autocomplete="email"
              required
              placeholder="name@example.com"
            />
          </div>

          <div class="subscribe-grid">
            <fieldset class="subscribe-field">
              <legend>{pick('Language', '语言')}</legend>
              <div class="subscribe-segmented" id="locale-options"></div>
            </fieldset>

            <fieldset class="subscribe-field">
              <legend>{pick('Frequency', '频率')}</legend>
              <div class="subscribe-segmented" id="frequency-options"></div>
            </fieldset>
          </div>

          <fieldset class="subscribe-field">
              <legend>{pick('Updates to receive', '接收内容')}</legend>
            <div class="subscribe-option-grid" id="list-options"></div>
          </fieldset>

          <fieldset class="subscribe-field">
            <div class="subscribe-field-title">
              <legend>{pick('Countries', '国家和地区')}</legend>
              <label class="subscribe-inline-check">
                <input id="all-countries" type="checkbox" checked />
                <span>{pick('All countries', '全部国家和地区')}</span>
              </label>
            </div>
            <div class="subscribe-chip-grid" id="country-options"></div>
          </fieldset>

          <fieldset class="subscribe-field">
            <div class="subscribe-field-title">
              <legend>{pick('Diseases', '疾病')}</legend>
              <span>{pick('Leave empty for all', '留空表示全部')}</span>
            </div>
            <input
              id="disease-search"
              class="site-control-input subscribe-input mt-3"
              type="text"
              placeholder={pick('Search diseases', '搜索疾病')}
            />
            <div class="subscribe-chip-grid mt-3" id="disease-options"></div>
          </fieldset>

          <fieldset class="subscribe-field">
            <div class="subscribe-field-title">
              <legend>{pick('Research topics', '研究主题')}</legend>
              <span>{pick('For Research Radar; leave empty for all', '适用于 Research Radar；留空表示全部')}</span>
            </div>
            <div class="subscribe-chip-grid" id="research-topic-options"></div>
          </fieldset>

          <fieldset class="subscribe-field">
            <div class="subscribe-field-title">
              <legend>{pick('Study types', '研究类型')}</legend>
              <span>{pick('Leave empty for all', '留空表示全部')}</span>
            </div>
            <div class="subscribe-chip-grid" id="study-type-options"></div>
          </fieldset>

          <fieldset class="subscribe-field">
            <div class="subscribe-field-title">
              <legend>{pick('Publication status', '出版状态')}</legend>
              <span>{pick('Leave empty for all approved research', '留空表示全部已审核研究')}</span>
            </div>
            <div class="subscribe-chip-grid" id="peer-review-status-options"></div>
          </fieldset>

          <label class="subscribe-consent">
            <input type="checkbox" name="consent" required />
            <span>
              <span>{pick('I agree to receive GIDS subscription emails and accept the', '我同意接收 GIDS 订阅邮件，并接受')}</span>
              <a href={`${prefix}/terms/`} target="_blank" rel="noopener">{pick('Service Terms', '服务协议')}</a>
              <span>{pick('.', '。')}</span>
            </span>
          </label>

          <div id="subscription-status" class="subscribe-status" role="status" aria-live="polite" hidden></div>

          <div class="subscribe-actions">
            <button id="subscription-submit" type="submit" class="subscribe-submit">
              <span>{pick('Subscribe', '提交订阅')}</span>
            </button>
            <p>{pick('We only send the updates you choose. You can unsubscribe in any email.', '我们只发送你选择的更新；你可以在任意邮件中退订。')}</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <div id="subscription-modal" class="subscribe-modal" role="dialog" aria-modal="true" aria-labelledby="subscription-modal-title" hidden>
    <div class="subscribe-modal-backdrop" data-modal-close></div>
    <div class="subscribe-modal-panel">
      <button class="subscribe-modal-close" type="button" aria-label={pick('Close', '关闭')} data-modal-close>
        <span aria-hidden="true">×</span>
      </button>
      <p class="subscribe-kicker">{pick('Subscription received', '订阅已收到')}</p>
      <h2 id="subscription-modal-title">{pick('Check your inbox', '请检查你的邮箱')}</h2>
      <p id="subscription-modal-message" class="subscribe-modal-message"></p>
      <div class="subscribe-trust-note">
        <strong>{pick('Trusted sender', '可信发件人')}</strong>
        <span>GIDS Alerts &lt;noreply@globalinfectiousdisease.com&gt;</span>
      </div>
      <p class="subscribe-modal-help">{pick('Add this sender to your contacts or allowlist so future GIDS updates are not filtered as spam.', '请将该发件人加入联系人或信任列表，帮助后续 GIDS 更新顺利送达。')}</p>
      <div class="subscribe-modal-actions">
        <button id="subscription-resend" class="subscribe-modal-secondary" type="button">
          <span>{pick('Resend confirmation', '再次发送确认邮件')}</span>
        </button>
        <button class="subscribe-modal-primary" type="button" data-modal-close>
          <span>{pick('Done', '完成')}</span>
        </button>
      </div>
      <p id="subscription-resend-status" class="subscribe-modal-resend" role="status" aria-live="polite"></p>
    </div>
  </div>

  <script is:inline>
    (() => {
      const form = document.getElementById('subscription-form');
      if (!form) return;

      const apiBase = form.getAttribute('data-api-base') || 'https://subscriptions.globalinfectiousdisease.com';
      const submitButton = document.getElementById('subscription-submit');
      const statusEl = document.getElementById('subscription-status');
      const modal = document.getElementById('subscription-modal');
      const modalMessage = document.getElementById('subscription-modal-message');
      const resendButton = document.getElementById('subscription-resend');
      const resendStatus = document.getElementById('subscription-resend-status');
      const allCountries = document.getElementById('all-countries');
      const localeOptions = document.getElementById('locale-options');
      const frequencyOptions = document.getElementById('frequency-options');
      const listOptions = document.getElementById('list-options');
      const countryOptions = document.getElementById('country-options');
      const diseaseOptions = document.getElementById('disease-options');
      const diseaseSearch = document.getElementById('disease-search');
      const researchTopicOptions = document.getElementById('research-topic-options');
      const studyTypeOptions = document.getElementById('study-type-options');
      const peerReviewStatusOptions = document.getElementById('peer-review-status-options');
      const optionState = {
        locales: [],
        frequencies: [],
        lists: [],
        countries: [],
        diseases: [],
        researchTopics: [],
        studyTypes: [],
        peerReviewStatuses: [],
      };
      let lastSubmittedPayload = null;

      const copy = {
        en: {
          missingEmail: 'Enter a valid email address.',
          missingList: 'Select at least one subscription list.',
          missingConsent: 'Accept the service terms before subscribing.',
          submitting: 'Submitting subscription...',
          received: 'Subscription received. A confirmation email will be sent by GIDS Alerts. Please keep the sender trusted so future updates can reach you.',
          emailSent: 'Subscription received. We sent a confirmation email from GIDS Alerts. Please keep the sender trusted so future updates can reach you.',
          failed: 'Subscription failed. Please try again in a moment.',
          network: 'Network error while contacting the subscription service.',
          optionsLoading: 'Loading subscription choices...',
          optionsFailed: 'Subscription choices could not be loaded. Please refresh in a moment.',
          rateLimited: 'Too many subscription attempts. Please wait a little before trying again.',
          emailRateLimited: 'Subscription saved. A confirmation email was already sent recently; please wait before requesting another one.',
          resendSending: 'Requesting another confirmation email...',
          resendDone: 'Confirmation request sent again.',
          resendUnavailable: 'Confirmation delivery is not connected yet. Your subscription request is still saved.',
        },
        zh: {
          missingEmail: '请输入有效的邮箱地址。',
          missingList: '请至少选择一个订阅列表。',
          missingConsent: '请先接受服务协议。',
          submitting: '正在提交订阅...',
          received: '订阅已收到。确认邮件将由 GIDS Alerts 发送。请将该发件人加入信任列表，帮助后续更新顺利送达。',
          emailSent: '订阅已收到。我们已通过 GIDS Alerts 发送确认邮件。请将该发件人加入信任列表，帮助后续更新顺利送达。',
          failed: '订阅提交失败，请稍后再试。',
          network: '连接订阅服务时发生网络错误。',
          optionsLoading: '正在加载订阅选项...',
          optionsFailed: '订阅选项暂时无法加载，请稍后刷新页面。',
          rateLimited: '订阅请求过于频繁，请稍后再试。',
          emailRateLimited: '订阅已保存。确认邮件刚刚发送过，请稍后再请求重新发送。',
          resendSending: '正在请求再次发送确认邮件...',
          resendDone: '确认邮件请求已再次发送。',
          resendUnavailable: '确认邮件投递尚未接入。你的订阅请求仍已保存。',
        },
      };

      function currentLang() {
        return form.getAttribute('data-page-locale') === 'zh' ? 'zh' : 'en';
      }

      function setStatus(type, message) {
        if (!statusEl) return;
        statusEl.hidden = false;
        statusEl.dataset.type = type;
        statusEl.textContent = message;
      }

      function setSubmitting(isSubmitting) {
        if (!submitButton) return;
        submitButton.disabled = isSubmitting;
        submitButton.setAttribute('aria-busy', String(isSubmitting));
      }

      function showModal(message) {
        if (!modal) return;
        if (modalMessage) modalMessage.textContent = message;
        if (resendStatus) resendStatus.textContent = '';
        modal.hidden = false;
        document.documentElement.classList.add('subscribe-modal-open');
        resendButton?.focus();
      }

      function closeModal() {
        if (!modal) return;
        modal.hidden = true;
        document.documentElement.classList.remove('subscribe-modal-open');
      }

      modal?.querySelectorAll('[data-modal-close]').forEach((element) => {
        element.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
      });

      function labelFor(item, lang = currentLang()) {
        return lang === 'zh'
          ? (item.label_zh || item.name_zh || item.label_en || item.name_en || item.value || item.code)
          : (item.label_en || item.name_en || item.label_zh || item.name_zh || item.value || item.code);
      }

      function descriptionFor(item, lang = currentLang()) {
        return lang === 'zh'
          ? (item.description_zh || item.description_en || '')
          : (item.description_en || item.description_zh || '');
      }

      function checkedValues(name) {
        return new Set(Array.from(form.querySelectorAll(`input[name="${name}"]:checked`)).map((input) => input.value));
      }

      function renderRadioOptions(container, name, items, defaultValue) {
        if (!container) return;
        const selected = form.querySelector(`input[name="${name}"]:checked`)?.value || defaultValue;
        container.replaceChildren();
        items.forEach((item) => {
          const label = document.createElement('label');
          const input = document.createElement('input');
          const span = document.createElement('span');
          input.type = 'radio';
          input.name = name;
          input.value = item.value;
          input.defaultChecked = item.value === defaultValue;
          input.checked = item.value === selected;
          span.textContent = labelFor(item);
          label.append(input, span);
          container.append(label);
        });
      }

      function renderListOptions() {
        if (!listOptions) return;
        const selected = checkedValues('list_codes');
        const hasSelection = selected.size > 0;
        listOptions.replaceChildren();
        optionState.lists.forEach((item, index) => {
          const label = document.createElement('label');
          const input = document.createElement('input');
          const body = document.createElement('span');
          const title = document.createElement('strong');
          const detail = document.createElement('small');
          label.className = 'subscribe-check';
          input.type = 'checkbox';
          input.name = 'list_codes';
          input.value = item.code;
          input.defaultChecked = index === 0 || item.code === 'reports';
          input.checked = hasSelection ? selected.has(item.code) : input.defaultChecked;
          title.textContent = labelFor(item);
          detail.textContent = descriptionFor(item);
          body.append(title, detail);
          label.append(input, body);
          listOptions.append(label);
        });
      }

      function renderChipOptions(container, name, items, disabled = false) {
        if (!container) return;
        const selected = checkedValues(name);
        container.replaceChildren();
        items.forEach((item) => {
          const label = document.createElement('label');
          const input = document.createElement('input');
          const span = document.createElement('span');
          label.className = 'subscribe-chip';
          input.type = 'checkbox';
          input.name = name;
          input.value = item.value;
          input.disabled = disabled;
          input.checked = selected.has(item.value);
          span.textContent = labelFor(item);
          label.append(input, span);
          container.append(label);
        });
      }

      function renderDiseaseOptions() {
        const query = String(diseaseSearch?.value || '').trim().toLowerCase();
        const visible = query
          ? optionState.diseases.filter((item) => {
              const haystack = `${item.value} ${item.label_en || ''} ${item.label_zh || ''}`.toLowerCase();
              return haystack.includes(query);
            })
          : optionState.diseases.slice(0, 24);
        renderChipOptions(diseaseOptions, 'diseases', visible, false);
      }

      function renderAllOptions() {
        if (diseaseSearch) {
          diseaseSearch.setAttribute('placeholder', currentLang() === 'zh' ? '搜索疾病' : 'Search diseases');
        }
        renderRadioOptions(localeOptions, 'locale', optionState.locales, currentLang());
        renderRadioOptions(frequencyOptions, 'frequency', optionState.frequencies, 'weekly');
        renderListOptions();
        renderChipOptions(countryOptions, 'countries', optionState.countries, Boolean(allCountries?.checked));
        renderDiseaseOptions();
        renderChipOptions(researchTopicOptions, 'research_topics', optionState.researchTopics);
        renderChipOptions(studyTypeOptions, 'study_types', optionState.studyTypes);
        renderChipOptions(peerReviewStatusOptions, 'peer_review_statuses', optionState.peerReviewStatuses);
      }

      async function loadOptions() {
        const messages = copy[currentLang()];
        setSubmitting(true);
        setStatus('pending', messages.optionsLoading);
        try {
          const response = await fetch(`${apiBase}/api/subscriptions/options`, {
            headers: { accept: 'application/json' },
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.error) {
            throw new Error(result.error || 'options_failed');
          }
          optionState.locales = Array.isArray(result.locales) ? result.locales : [];
          optionState.frequencies = Array.isArray(result.frequencies) ? result.frequencies : [];
          optionState.lists = Array.isArray(result.lists) ? result.lists : [];
          optionState.countries = Array.isArray(result.filters?.country) ? result.filters.country : [];
          optionState.diseases = Array.isArray(result.filters?.disease) ? result.filters.disease : [];
          optionState.researchTopics = Array.isArray(result.filters?.research_topic) ? result.filters.research_topic : [];
          optionState.studyTypes = Array.isArray(result.filters?.study_type) ? result.filters.study_type : [];
          optionState.peerReviewStatuses = Array.isArray(result.filters?.peer_review_status) ? result.filters.peer_review_status : [];
          renderAllOptions();
          if (statusEl && statusEl.dataset.type === 'pending') statusEl.hidden = true;
          setSubmitting(false);
        } catch (error) {
          setStatus('error', messages.optionsFailed);
          setSubmitting(true);
        }
      }

      function syncCountryInputs() {
        const all = Boolean(allCountries && allCountries.checked);
        form.querySelectorAll('input[name="countries"]').forEach((input) => {
          input.disabled = all;
          if (all) input.checked = false;
        });
      }

      allCountries?.addEventListener('change', syncCountryInputs);
      diseaseSearch?.addEventListener('input', renderDiseaseOptions);
      loadOptions();

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const lang = currentLang();
        const messages = copy[lang];
        const data = new FormData(form);
        const email = String(data.get('email') || '').trim();
        const consent = data.get('consent') === 'on';
        const listCodes = data.getAll('list_codes').map(String);

        if (!email || !email.includes('@')) {
          setStatus('error', messages.missingEmail);
          return;
        }

        if (listCodes.length === 0) {
          setStatus('error', messages.missingList);
          return;
        }

        if (!consent) {
          setStatus('error', messages.missingConsent);
          return;
        }

        const selectedCountries = allCountries?.checked
          ? []
          : data.getAll('countries').map(String);
        const checkedDiseases = data.getAll('diseases').map(String);
        const checkedResearchTopics = data.getAll('research_topics').map(String);
        const checkedStudyTypes = data.getAll('study_types').map(String);
        const checkedPeerReviewStatuses = data.getAll('peer_review_statuses').map(String);

        const payload = {
          email,
          locale: String(data.get('locale') || lang),
          frequency: String(data.get('frequency') || 'weekly'),
          list_codes: listCodes,
          countries: selectedCountries,
          diseases: Array.from(new Set(checkedDiseases)),
          research_topics: Array.from(new Set(checkedResearchTopics)),
          study_types: Array.from(new Set(checkedStudyTypes)),
          peer_review_statuses: Array.from(new Set(checkedPeerReviewStatuses)),
          source: 'website-subscribe-page',
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC',
        };

        setSubmitting(true);
        setStatus('pending', messages.submitting);
        window.gtag?.('event', 'subscription_start');

        try {
          const response = await fetch(`${apiBase}/api/subscriptions`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => ({}));

          if (!response.ok || result.error) {
            setStatus('error', result.error === 'rate_limited' ? messages.rateLimited : (result.error || messages.failed));
            return;
          }

          lastSubmittedPayload = payload;
          const emailStatus = result?.email?.status || result?.notification?.status || '';
          const emailReason = result?.email?.reason || result?.notification?.reason || '';
          const successMessage = emailReason === 'confirmation_rate_limited'
            ? messages.emailRateLimited
            : emailStatus === 'sent' || emailStatus === 'queued'
            ? messages.emailSent
            : messages.received;
          setStatus('success', successMessage);
          window.gtag?.('event', 'subscription_complete');
          showModal(successMessage);
          form.reset();
          if (diseaseSearch) diseaseSearch.value = '';
          renderAllOptions();
        } catch (error) {
          setStatus('error', messages.network);
        } finally {
          setSubmitting(false);
        }
      });

      resendButton?.addEventListener('click', async () => {
        const lang = currentLang();
        const messages = copy[lang];
        if (!lastSubmittedPayload) {
          if (resendStatus) resendStatus.textContent = messages.resendUnavailable;
          return;
        }

        resendButton.disabled = true;
        if (resendStatus) resendStatus.textContent = messages.resendSending;

        try {
          const response = await fetch(`${apiBase}/api/subscriptions`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ ...lastSubmittedPayload, source: 'website-subscribe-page-resend' }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.error) {
            if (resendStatus) resendStatus.textContent = result.error === 'rate_limited' ? messages.rateLimited : (result.error || messages.failed);
            return;
          }
          const emailStatus = result?.email?.status || result?.notification?.status || '';
          const emailReason = result?.email?.reason || result?.notification?.reason || '';
          if (resendStatus) {
            resendStatus.textContent = emailReason === 'confirmation_rate_limited'
              ? messages.emailRateLimited
              : emailStatus === 'sent' || emailStatus === 'queued'
              ? messages.resendDone
              : messages.resendUnavailable;
          }
        } catch (error) {
          if (resendStatus) resendStatus.textContent = messages.network;
        } finally {
          resendButton.disabled = false;
        }
      });
    })();
  </script>
</BaseLayout>

<style is:global>
.subscribe-page {
  min-height: 100%;
}

.subscribe-intro {
  padding-top: 0.75rem;
}

.subscribe-facts {
  color: rgb(var(--text-muted));
}

.subscribe-facts div {
  border-left: 2px solid rgb(20 184 166 / 0.55);
