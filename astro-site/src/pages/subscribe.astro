---
// src/pages/subscribe.astro — Subscribe page
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildAlternatePaths } from '../lib/seo';
import { localizedRegionName } from '../utils/i18n';
import metaRaw from '../data/meta.json';
import SubscriptionForm from '../components/subscription/SubscriptionForm.astro';
import SubscriptionModal from '../components/subscription/SubscriptionModal.astro';
import { subscriptionText } from '../components/subscription/messages';
import '../components/subscription/subscription.css';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const pick = subscriptionText(locale);

const subscriptionCountryNames = Object.fromEntries(((metaRaw as any).countries ?? []).map((country: any) => [String(country.code).toUpperCase(), localizedRegionName(locale, country.code, { en: country.name_en ?? country.name, zh: country.name_zh, fr: country.name_fr })]));

const subscriptionsApiBase = (
  import.meta.env.PUBLIC_SUBSCRIPTIONS_API_BASE ||
  process.env.PUBLIC_SUBSCRIPTIONS_API_BASE ||
  process.env.SUBSCRIPTIONS__PUBLIC_BASE_URL ||
  'https://subscriptions.globalinfectiousdisease.com'
).replace(/\/+$/, '');
const subscriptionOptionsUrl = import.meta.env.DEV
  ? '/__dev/subscription-options'
  : `${subscriptionsApiBase}/api/subscriptions/options`;
---

<BaseLayout
  title={pick('Subscribe', '订阅')}
  description={pick('Subscribe to GIDS disease surveillance alerts and report updates.', '订阅 GIDS 疾病监测提醒和报告更新。')}
  initialLanguage={locale}
  seo={{ title: pick('Subscribe | GIDS', '订阅 | GIDS'), description: pick('Subscribe to GIDS disease surveillance alerts and report updates.', '订阅 GIDS 疾病监测提醒和报告更新。'), locale, canonicalPath: `${prefix}/subscribe/`, alternatePaths: buildAlternatePaths(`${prefix}/subscribe/`, locale), pageType: 'WebPage' }}
>
  <section class="subscribe-page">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-18 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(520px,1fr)] lg:items-start">
        <div class="subscribe-intro">
          <div class="subscribe-intro-badge mb-6 inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold">
            <span class="h-1.5 w-1.5 rounded-full bg-teal-400"></span>
            <span>{pick('GIDS subscription center', 'GIDS 订阅中心')}</span>
          </div>

          <h1 class="font-serif text-4xl font-semibold leading-tight tracking-tight text-[rgb(var(--text-strong))] sm:text-5xl">
            <span>{pick('Follow the surveillance updates that matter to you', '接收你关注的传染病监测更新')}</span>
          </h1>

          <p class="mt-5 max-w-2xl text-base leading-7 text-[rgb(var(--text-muted))] sm:text-lg">
            <span>{pick('Choose the areas, diseases, and update frequency you want to follow. You can unsubscribe at any time.', '选择你关注的区域、疾病和更新频率；你可以随时退订。', 'Choisissez les zones, les maladies et la fréquence de mise à jour que vous souhaitez suivre. Vous pouvez vous désabonner à tout moment.')}</span>
          </p>

          <dl class="subscribe-facts mt-8 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
            <div>
              <dt>{pick('Delivery', '投递内容')}</dt>
              <dd>{pick('Reports, Research Radar digests, and priority alerts', '报告、Research Radar 摘要和重点提醒')}</dd>
            </div>
            <div>
              <dt>{pick('Filters', '筛选范围')}</dt>
              <dd>{pick('Area, disease, topic, and study preferences', '区域、疾病、主题和研究类型偏好')}</dd>
            </div>
            <div>
              <dt>{pick('Control', '随时管理')}</dt>
              <dd>{pick('One-click unsubscribe link', '一键退订链接')}</dd>
            </div>
          </dl>
        </div>

        <SubscriptionForm locale={locale} subscriptionsApiBase={subscriptionsApiBase} subscriptionOptionsUrl={subscriptionOptionsUrl} />
      </div>
    </div>
  </section>

  <SubscriptionModal locale={locale} />

  <script is:inline type="application/json" id="subscription-geography" set:html={JSON.stringify(subscriptionCountryNames).replaceAll('<', '\\u003c')} />
  <script>
    import { initializeSubscription } from '../components/subscription/controller.js';
    const names = JSON.parse(document.getElementById('subscription-geography')?.textContent || '{}');
    initializeSubscription(names);
  </script>
</BaseLayout>
