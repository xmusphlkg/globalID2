---
import ReportLayout from '../../layouts/ReportLayout.astro';
import { buildAlternatePaths, type SeoDocument } from '../../lib/seo';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

const situationPublic = existsSync(resolve('./src/data/situation/v3/latest.json'));
const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' };
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;

const sections = [
  ['One source-native identity', '唯一来源原生 identity', 'Each exact disease, source, metric, normalized geography, and dimension identity appears once. Geography aliases are retained for audit but resolve to one canonical identity. Counts, rates, percentages, admissions, and positivity are never summed across incompatible definitions.', '每个精确疾病、来源、指标、规范化地理和维度 identity 仅出现一次。地理别名保留用于审计，但归并为一个规范 identity。病例数、率、百分比、住院和阳性率不会跨不兼容定义相加。'],
  ['Publication-lag protection', '发布延迟保护', 'Countries and agencies publish on different schedules. For every source and cadence, GIDS derives a common analysis watermark from the latest periods available across eligible source identities. At least 80% of the active source cohort must reach the watermark, and a cadence-specific maturity interval must elapse before that period can enter the model. Newer provisional observations remain visible as latest received but are held out of analysis. Feeds beyond the configured delay warning are marked delayed and excluded from the current Benjamini–Hochberg family.', '不同国家和机构按不同节奏发布数据。GIDS 针对每个来源和频率，根据合格来源 identity 的最新周期计算共同分析水位线；至少 80% 的活跃来源群必须到达该水位线，且经过相应频率的成熟等待期后，该周期才可进入模型。更新但仍属暂定的数据会显示为最新收到，但不会进入分析。超过延迟预警线的来源会从当期 Benjamini–Hochberg 检验族中隔离。'],
  ['Tiered, frequency-aware detectors', '分层且频率感知的检测器', 'Common count metrics use robust quasi-Poisson regression with seasonal harmonics, optional long-term trend, over-dispersion, and historical-outlier down-weighting. Low-expected-count series use an exact Poisson or moment-matched negative-binomial upper tail. CUSUM is supporting persistence evidence only. A labelled seasonal empirical fallback can preserve review evidence but always remains private. Percentages and rates enter formal anomaly modeling only when numerator and denominator are available.', '常见计数指标使用含季节谐波、可选长期趋势、过度离散和历史异常降权的稳健准泊松回归；低期望计数序列使用精确泊松或矩匹配负二项上尾概率。CUSUM 仅作为持续性辅助证据。明确标注的季节经验回退方法可保留复核证据，但始终保持非公开。百分比或率只有在分子和分母均可用时才进入正式异常模型。'],
  ['Multiple testing and effect gates', '多重检验与效应门槛', 'Within each run, one-sided p values are adjusted with Benjamini–Hochberg inside detector-tier, metric-type, and cadence families. Alert requires q ≤ 0.05; strong requires q ≤ 0.01. Common counts require at least 20 current cases, +10 absolute, and +25%; rare counts require +100% relative growth. Rate metrics require an explicit metric-specific gate.', '每次运行中，单侧 p 值按检测分层、指标类型与频率组成检验族，并使用 Benjamini–Hochberg 校正。告警要求 q ≤ 0.05，强异常要求 q ≤ 0.01。常见计数需满足当前至少 20 例、绝对增加 10、相对增加 25%；稀有计数要求相对增长 100%；率值指标必须配置专属效应门槛。'],
  ['Calibrated, fail-closed publication', '校准约束与失败关闭发布', 'Collection, modeling, FDR adjustment, evidence linking, deduplication, queueing, static builds, and deployment are automated. Statistical candidates remain private until independently verified. Rare-count and fallback candidates enter analyst review only when independently matched to an official event. Public-health risk appears only with attributable evidence and rationale.', '采集、建模、FDR 校正、证据关联、去重、队列分流、静态构建和部署均自动运行。统计候选在独立验证前保持非公开；稀有计数与回退模型候选只有独立匹配到官方事件才进入人工复核。公共卫生风险只有在存在可归因证据与理由时才显示。'],
  ['Events, period reports, and revisions', '事件、期间报告与修订', 'Official updates for the same disease within 45 days and overlapping geographies resolve to a stable timeline before review state is applied. Weekly and monthly reports require every UTC daily member in the closed period to exist and pass its gate; missing or failed members block publication.', '同一疾病在 45 天内且地理集合相交的官方更新，会先解析到稳定时间线，再应用复核状态。周报和月报要求封闭周期内每个 UTC 日成员均存在且通过质量门，缺失或失败成员会阻止发布。'],
  ['Immutable publication', '不可变发布', 'Pydantic is the contract source for JSON Schema, OpenAPI, and generated TypeScript. Every analysis run and review decision is immutable. A report must pass its quality gate and commit to the history store before the main publication pointer advances. Archive, contract, or build failure leaves the previous public version in place.', 'Pydantic 是 JSON Schema、OpenAPI 和生成 TypeScript 的契约源。每次分析运行和复核决定均不可变。报告必须通过质量门并先提交到历史库，主发布指针才能推进；归档、契约或构建失败时继续保留上一公开版本。'],
] as const;

const seo: SeoDocument = {
  title: pick('Situation Room Methodology | GIDS', '全球态势室方法 | GIDS'),
  description: pick('The statistical model, evidence attribution, quality checks, period reports, revisions, and limitations used by GIDS Situation Room.', '了解 GIDS 全球态势室使用的统计模型、证据归因、质量检查、期间报告、修订与限制。'),
  canonicalPath: `${prefix}/situation/methodology/`,
  locale,
  alternatePaths: buildAlternatePaths(`${prefix}/situation/methodology/`, locale),
  noindex: !situationPublic,
};
---

<ReportLayout title={pick('Situation Room Methodology', '全球态势室方法')} description={seo.description} initialLanguage={locale} seo={seo} breadcrumbs={[{ label: pick('Situation Room', '全球态势室'), href: `${prefix}/situation/` }, { label: pick('Methodology', '方法') }]}>
  <article class="methodology max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header><p class="eyebrow">{pick('Methods', '方法')}</p><h1>{pick('How GIDS screens infectious-disease signals', 'GIDS 如何筛查传染病信号')}</h1><p>{pick('Situation Room results are reproducible statistical screens over GIDS-covered jurisdictions. They prioritize review; they are not outbreak declarations or clinical guidance.', '全球态势室结果是针对 GIDS 覆盖地区的可复现统计筛查，用于安排复核优先级，并非疫情暴发定性或临床建议。')}</p></header>
    {sections.map(([headingEn, headingZh, bodyEn, bodyZh]) => <section><h2>{pick(headingEn, headingZh)}</h2><p>{pick(bodyEn, bodyZh)}</p></section>)}
  </article>
</ReportLayout>

<style>
  .methodology { color: rgb(var(--text-muted)); }
  header { border-bottom: 2px solid rgb(var(--text-strong)); margin-bottom: 2rem; padding-bottom: 1.5rem; }
  .eyebrow { color: rgb(var(--color-teal)); font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  h1, h2 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; } h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.05; } h2 { font-size: 1.45rem; margin-top: 0; }
  section { border-top: 1px solid rgb(var(--border)); padding: 1.4rem 0; } p, li { line-height: 1.75; } ul, ol { padding-left: 1.25rem; }
</style>
