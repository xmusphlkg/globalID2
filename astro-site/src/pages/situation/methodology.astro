---
import ReportLayout from '../../layouts/ReportLayout.astro';
import { buildAlternatePaths, type SeoDocument } from '../../lib/seo';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

const situationPublic = existsSync(resolve('./src/data/situation/v3/latest.json'));

const seo: SeoDocument = {
  title: 'Situation Room Methodology | GIDS',
  description: 'The robust quasi-Poisson model, FDR control, evidence attribution, quality gates, period reports, revisions, and limitations for GIDS Situation Room v3.',
  canonicalPath: '/situation/methodology/',
  alternatePaths: buildAlternatePaths('/situation/methodology/', 'en'),
  noindex: !situationPublic,
};
---

<ReportLayout title="Situation Room Methodology" description={seo.description} seo={seo} breadcrumbs={[{ label: 'Situation Room', labelZh: '全球态势室', href: '/situation/' }, { label: 'Methodology', labelZh: '方法' }]}>
  <article class="methodology max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header><p class="eyebrow">Version 3.1</p><h1 data-lang-en="How GIDS screens infectious-disease signals" data-lang-zh="GIDS 如何筛查传染病信号">How GIDS screens infectious-disease signals</h1><p data-lang-en="Situation Room results are reproducible statistical screens over GIDS-covered jurisdictions. They prioritize review; they are not outbreak declarations or clinical guidance." data-lang-zh="全球态势室结果是针对 GIDS 覆盖地区的可复现统计筛查，用于安排复核优先级，并非疫情暴发定性或临床建议。">Situation Room results are reproducible statistical screens over GIDS-covered jurisdictions. They prioritize review; they are not outbreak declarations or clinical guidance.</p></header>
    <section><h2 data-lang-en="One source-native identity" data-lang-zh="唯一来源原生 identity">One source-native identity</h2><p data-lang-en="Each exact disease, source, metric, normalized geography, and dimension identity appears once. Geography aliases are retained for audit but resolve to one canonical identity. Counts, rates, percentages, admissions, and positivity are never summed across incompatible definitions." data-lang-zh="每个精确疾病、来源、指标、规范化地理和维度 identity 仅出现一次。地理别名保留用于审计，但归并为一个规范 identity。病例数、率、百分比、住院和阳性率不会跨不兼容定义相加。">Each exact disease, source, metric, normalized geography, and dimension identity appears once. Geography aliases are retained for audit but resolve to one canonical identity. Counts, rates, percentages, admissions, and positivity are never summed across incompatible definitions.</p></section>
    <section><h2 data-lang-en="Publication-lag protection" data-lang-zh="发布延迟保护">Publication-lag protection</h2><p data-lang-en="Countries and agencies publish on different schedules. For every source and cadence, GIDS derives a common analysis watermark from the latest periods available across eligible source identities. At least 80% of the active source cohort must reach the watermark, and a cadence-specific maturity interval must elapse before that period can enter the model. Newer provisional observations remain visible as latest received but are held out of analysis." data-lang-zh="不同国家和机构按不同节奏发布数据。GIDS 针对每个来源和频率，根据合格来源 identity 的最新周期计算共同分析水位线；至少 80% 的活跃来源群必须到达该水位线，且经过相应频率的成熟等待期后，该周期才可进入模型。更新但仍属暂定的数据会显示为最新收到，但不会进入分析。">Countries and agencies publish on different schedules. For every source and cadence, GIDS derives a common analysis watermark from the latest periods available across eligible source identities. At least 80% of the active source cohort must reach the watermark, and a cadence-specific maturity interval must elapse before that period can enter the model. Newer provisional observations remain visible as latest received but are held out of analysis.</p><p data-lang-en="Feeds beyond the configured delay warning are marked delayed. Their historical statistics remain auditable, but they are assigned watch status and excluded from the current Benjamini–Hochberg family so they cannot create or dilute a current alert." data-lang-zh="超过配置延迟预警线的来源会标记为延迟。其历史统计仍保留供审计，但只进入关注状态，并从当期 Benjamini–Hochberg 检验族中隔离，因此既不会产生当期告警，也不会稀释其他当期信号。">Feeds beyond the configured delay warning are marked delayed. Their historical statistics remain auditable, but they are assigned watch status and excluded from the current Benjamini–Hochberg family so they cannot create or dilute a current alert.</p></section>
    <section><h2 data-lang-en="Tiered, frequency-aware detectors" data-lang-zh="分层且频率感知的检测器">Tiered, frequency-aware detectors</h2><p data-lang-en="Common count metrics use robust quasi-Poisson regression with seasonal harmonics, optional long-term trend, over-dispersion, and historical-outlier down-weighting. Low-expected-count series use an exact Poisson or moment-matched negative-binomial upper tail with unweighted Pearson dispersion and aggregate parameter uncertainty. CUSUM is recorded only as supporting persistence evidence and never creates an alert by itself. If the primary fit does not converge, an explicitly labelled seasonal empirical fallback may preserve review evidence, but it always remains in the private review queue." data-lang-zh="常见计数指标使用含季节谐波、可选长期趋势、过度离散和历史异常降权的稳健准泊松回归；低期望计数序列使用未加权 Pearson 离散度并计入聚合参数不确定性的精确泊松或矩匹配负二项上尾概率。CUSUM 仅记录为持续性辅助证据，不能单独形成告警；主模型未收敛时，可使用明确标注的季节经验回退方法保留复核证据，但始终只留在非公开复核队列。">Common count metrics use robust quasi-Poisson regression with seasonal harmonics, optional long-term trend, over-dispersion, and historical-outlier down-weighting. Low-expected-count series use an exact Poisson or moment-matched negative-binomial upper tail with unweighted Pearson dispersion and aggregate parameter uncertainty. CUSUM is recorded only as supporting persistence evidence and never creates an alert by itself. If the primary fit does not converge, an explicitly labelled seasonal empirical fallback may preserve review evidence, but it always remains in the private review queue.</p><ul><li><b>Daily:</b> latest 28 days.</li><li><b>Weekly:</b> latest 4 source weeks.</li><li><b>Monthly:</b> latest complete UTC month.</li></ul><p data-lang-en="A percentage or rate enters formal anomaly modeling only when its numerator and denominator are available. Otherwise it remains a labelled context metric and cannot create a main alert." data-lang-zh="百分比或率只有在分子和分母均可用时才进入正式异常模型；否则仅作为带标签的背景指标，不能形成主告警。">A percentage or rate enters formal anomaly modeling only when its numerator and denominator are available. Otherwise it remains a labelled context metric and cannot create a main alert.</p></section>
    <section><h2 data-lang-en="Multiple testing and cost-sensitive effect gates" data-lang-zh="多重检验与成本敏感效应门槛">Multiple testing and cost-sensitive effect gates</h2><p data-lang-en="Within each run, raw one-sided p values are adjusted with Benjamini–Hochberg inside detector-tier, metric-type, and cadence families. Alert requires q ≤ 0.05; strong requires q ≤ 0.01. Common counts require at least 20 current cases, +10 absolute, and +25%; rare counts use a lower current-count gate but require +100% relative growth. Rate metrics require an explicit metric-specific gate." data-lang-zh="每次运行中，单侧原始 p 值按检测分层、指标类型与频率组成检验族，并使用 Benjamini–Hochberg 校正。告警要求 q ≤ 0.05，强异常要求 q ≤ 0.01。常见计数需满足当前至少 20 例、绝对增加 10、相对增加 25%；稀有计数可使用更低当前值门槛，但要求相对增长 100%；率值指标必须配置专属效应门槛。">Within each run, raw one-sided p values are adjusted with Benjamini–Hochberg inside detector-tier, metric-type, and cadence families. Alert requires q ≤ 0.05; strong requires q ≤ 0.01. Common counts require at least 20 current cases, +10 absolute, and +25%; rare counts use a lower current-count gate but require +100% relative growth. Rate metrics require an explicit metric-specific gate.</p></section>
    <section><h2 data-lang-en="Calibrated automation keeps publication fail-closed" data-lang-zh="校准约束自动化保持失败关闭">Calibrated automation keeps publication fail-closed</h2><p data-lang-en="Collection, modeling, FDR adjustment, evidence linking, deduplication, queueing, static builds, and deployment are automated. The checked q ≤ 0.01 publication candidate did not meet its false-candidate confidence bound, so statistical candidates remain private until independently verified. Rare-count and fallback candidates remain in the internal ledger and enter the analyst queue only when independently matched to an official event. Public-health risk always defaults to not assessed and appears only with attributable official or audited-expert evidence and rationale." data-lang-zh="采集、建模、FDR 校正、证据关联、去重、队列分流、静态构建和部署均自动运行。经检验的 q ≤ 0.01 自动发布候选未达到误报置信上界要求，因此统计候选在独立验证前保持非公开；稀有计数与回退模型候选保留在内部台账，只有独立匹配到官方事件才进入人工队列。公共卫生风险始终默认为未评估，只有存在可归因的官方或经审计专家证据与理由时才显示等级。">Collection, modeling, FDR adjustment, evidence linking, deduplication, queueing, static builds, and deployment are automated. The checked q ≤ 0.01 publication candidate did not meet its false-candidate confidence bound, so statistical candidates remain private until independently verified. Rare-count and fallback candidates remain in the internal ledger and enter the analyst queue only when independently matched to an official event. Public-health risk always defaults to not assessed and appears only with attributable official or audited-expert evidence and rationale.</p></section>
    <section><h2 data-lang-en="Events, complete period reports, and revisions" data-lang-zh="事件、完整期间报告与修订">Events, complete period reports, and revisions</h2><p data-lang-en="Official updates for the same disease within 45 days and with overlapping geographies resolve to a persisted stable timeline before review state is applied. Source facts and human decisions remain separate. Weekly and monthly reports require every UTC daily member in the closed period to exist and pass its gate; missing or failed members block publication." data-lang-zh="同一疾病在 45 天内且地理集合相交的官方更新，会先解析到已持久化的稳定时间线，再应用复核状态；来源事实与人工决定始终分开。周报和月报要求封闭周期内每个 UTC 日成员均存在且通过质量门，缺失或失败成员会阻止发布。">Official updates for the same disease within 45 days and with overlapping geographies resolve to a persisted stable timeline before review state is applied. Source facts and human decisions remain separate. Weekly and monthly reports require every UTC daily member in the closed period to exist and pass its gate; missing or failed members block publication.</p></section>
    <section><h2 data-lang-en="Immutable publication" data-lang-zh="不可变发布">Immutable publication</h2><p data-lang-en="Pydantic is the contract source for JSON Schema, OpenAPI, and generated TypeScript. Every analysis run and review decision is immutable. A report must pass its quality gate and commit to the dedicated history store before the main publication pointer advances. Archive, contract, or build failure leaves the previous public version in place." data-lang-zh="Pydantic 是 JSON Schema、OpenAPI 和生成 TypeScript 的唯一契约源。每次分析运行和复核决定均不可变。报告必须通过质量门并先提交到专用历史库，主库发布指针才能推进；归档、契约或构建失败时继续保留上一公开版本。">Pydantic is the contract source for JSON Schema, OpenAPI, and generated TypeScript. Every analysis run and review decision is immutable. A report must pass its quality gate and commit to the dedicated history store before the main publication pointer advances. Archive, contract, or build failure leaves the previous public version in place.</p></section>
  </article>
</ReportLayout>

<style>
  .methodology { color: rgb(var(--text-muted)); }
  header { border-bottom: 2px solid rgb(var(--text-strong)); margin-bottom: 2rem; padding-bottom: 1.5rem; }
  .eyebrow { color: rgb(var(--color-teal)); font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  h1, h2 { color: rgb(var(--text-strong)); font-family: 'Source Serif 4', serif; } h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.05; } h2 { font-size: 1.45rem; margin-top: 0; }
  section { border-top: 1px solid rgb(var(--border)); padding: 1.4rem 0; } p, li { line-height: 1.75; } ul, ol { padding-left: 1.25rem; }
</style>
