---
import ReportLayout from '../../../layouts/ReportLayout.astro';
import { buildAlternatePaths, type SeoDocument } from '../../../lib/seo';
import { listDigestMonths, readMonthDigests } from '../../../utils/international';
import { translateUi } from '../../../utils/i18n';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : fr ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;
const months = listDigestMonths().map(month => ({ month, digests: readMonthDigests(month) }));
const title = pick('Monthly situation overview', '每月态势汇总', 'Aperçu mensuel de la situation');
const canonicalPath = `${prefix}/situation/monthly/`;
const seo: SeoDocument = {
  title: `${title} | GIDS`,
  description: pick('Each month groups the peer-reviewed weekly briefs published for it.', '每月汇总该月发布的经同行评审的每周综述。', 'Chaque mois regroupe les synthèses hebdomadaires relues publiées pour cette période.'),
  canonicalPath,
  locale,
  alternatePaths: buildAlternatePaths(canonicalPath, locale),
  noindex: months.length === 0,
};
---

<ReportLayout title={title} description={seo.description} initialLanguage={locale} seo={seo} breadcrumbs={[{ label: pick('Situation Room', '全球态势室', 'Salle de situation'), href: `${prefix}/situation/` }, { label: pick('Monthly overview', '每月汇总', 'Aperçu mensuel') }]}>
  <div class="archive max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <header><h1>{title}</h1></header>
    {months.length ? (
      <ol>
        {months.map(({ month, digests }) => (
          <li><a href={`${prefix}/situation/monthly/${month}/`}><b>{month}</b><small>{digests.length} {pick('weekly briefs', '份周综述', 'synthèses hebdomadaires')}</small></a></li>
        ))}
      </ol>
    ) : <p class="empty">{pick('No weekly brief has been published yet.', '尚未发布每周综述。', 'Aucune synthèse hebdomadaire n’a encore été publiée.')}</p>}
  </div>
</ReportLayout>

<style>
  .archive { display: grid; gap: 1.5rem; padding-block: 2.5rem 4rem; }
  header { border-bottom: 2px solid rgb(var(--text-strong)); padding-bottom: 1rem; }
  h1 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(1.8rem, 5vw, 2.8rem); margin: 0; }
  ol { display: grid; gap: .6rem; list-style: none; margin: 0; padding: 0; }
  li a { align-items: baseline; border: 1px solid rgb(var(--border)); color: inherit; display: flex; gap: 1rem; justify-content: space-between; padding: .8rem; text-decoration: none; }
  li a:hover { border-color: rgb(var(--color-teal)); }
  li b { color: rgb(var(--text-strong)); font-family: ui-monospace, monospace; }
  li small { color: rgb(var(--text-faint)); font-size: .7rem; }
  .empty { color: rgb(var(--text-faint)); }
</style>
