---
import ReportLayout from '../../../layouts/ReportLayout.astro';
import SituationArchive from '../../../components/situation/SituationArchive';
import { buildAlternatePaths, type SeoDocument } from '../../../lib/seo';
import { listWeeks } from '../../../utils/international';
import { shouldBuildPage } from '../../../lib/page-build-plan';

export function getStaticPaths() {
  return listWeeks().map(week => week.period_key).map(period => ({
    params: { period }, props: { reportPeriod: period, locale: 'en' },
  })).filter(entry => shouldBuildPage(`situation-week:${entry.params.period}`));
}
const { reportPeriod, locale = 'en' } = Astro.props as { reportPeriod?: string; locale?: 'en' | 'zh' | 'fr' };
const period = reportPeriod ?? String(Astro.params.period ?? '');
const prefix = locale === 'en' ? '' : `/${locale}`;
const pick = (en: string, zh: string, fr: string) => locale === 'zh' ? zh : locale === 'fr' ? fr : en;
const title = pick(`Situation changes ${period}`, `${period} 态势变化`, `Changements de situation ${period}`);
const description = pick('Reviewed official outbreak alerts and changes for this reporting period.', '该报告期已审核的官方疫情警报与变化。', 'Alertes officielles relues et changements pour cette période.');
const canonicalPath = `${prefix}/situation/weekly/${period}/`;
const seo: SeoDocument = { title: `${title} | GIDS`, description, canonicalPath, locale, alternatePaths: buildAlternatePaths(canonicalPath, locale), pageType: 'Report' };
---
<ReportLayout title={title} description={description} initialLanguage={locale} seo={seo} breadcrumbs={[
  { label: pick('Situation map', '态势地图', 'Carte de situation'), href: `${prefix}/situation/` },
  { label: pick('Weekly changes', '每周变化', 'Changements hebdomadaires'), href: `${prefix}/situation/weekly/` }, { label: period },
]}>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-6">
    <h1 class="academic-title">{title}</h1>
    <SituationArchive client:load locale={locale} mode="weekly" period={period} />
  </article>
</ReportLayout>
