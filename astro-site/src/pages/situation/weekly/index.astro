---
import ReportLayout from '../../../layouts/ReportLayout.astro';
import { buildAlternatePaths, type SeoDocument } from '../../../lib/seo';
import { digestHeadline, listDigestPeriods, readDigest } from '../../../utils/international';
import { translateUi } from '../../../utils/i18n';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : fr ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;
const digests = listDigestPeriods().map(period => readDigest(period)).filter(digest => digest !== null);
const title = pick('Weekly situation briefs', '每周态势综述', 'Synthèses de situation hebdomadaires');
const canonicalPath = `${prefix}/situation/weekly/`;
const seo: SeoDocument = {
  title: `${title} | GIDS`,
  description: pick('Peer-reviewed weekly briefs of official international infectious-disease notices.', '基于国际官方传染病通报、经同行评审的每周综述。', 'Synthèses hebdomadaires relues par un pair des avis officiels internationaux sur les maladies infectieuses.'),
  canonicalPath,
  locale,
  alternatePaths: buildAlternatePaths(canonicalPath, locale),
  noindex: digests.length === 0,
};
---

<ReportLayout title={title} description={seo.description} initialLanguage={locale} seo={seo} breadcrumbs={[{ label: pick('Situation Room', '全球态势室', 'Salle de situation'), href: `${prefix}/situation/` }, { label: pick('Weekly briefs', '每周综述', 'Synthèses hebdomadaires') }]}>
  <div class="archive max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <header><h1>{title}</h1></header>
    {digests.length ? (
      <ol>
        {digests.map(digest => (
          <li><a href={`${prefix}/situation/weekly/${digest!.period_key}/`}><b>{digest!.period_key}</b><span>{digestHeadline(digest!, locale)}</span><small>{digest!.points.length} {pick('points', '条要点', 'points')} · {digest!.notice_count} {pick('notices', '条通报', 'avis')}</small></a></li>
        ))}
      </ol>
    ) : <p class="empty">{pick('No weekly brief has been published yet.', '尚未发布每周综述。', 'Aucune synthèse hebdomadaire n’a encore été publiée.')}</p>}
  </div>
</ReportLayout>

<style>
  .archive { display: grid; gap: 1.5rem; padding-block: 2.5rem 4rem; }
  header { border-bottom: 2px solid rgb(var(--text-strong)); padding-bottom: 1rem; }
  h1 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(1.8rem, 5vw, 2.8rem); margin: 0; }
  ol { display: grid; gap: .6rem; list-style: none; margin: 0; padding: 0; }
  li a { border: 1px solid rgb(var(--border)); color: inherit; display: grid; gap: .3rem 1rem; grid-template-columns: 7rem minmax(0, 1fr) auto; padding: .8rem; text-decoration: none; }
  li a:hover { border-color: rgb(var(--color-teal)); }
  li b { color: rgb(var(--text-strong)); font-family: ui-monospace, monospace; }
  li span { color: rgb(var(--text-muted)); font-size: .82rem; }
  li small { color: rgb(var(--text-faint)); font-size: .68rem; }
  .empty { color: rgb(var(--text-faint)); }
  @media (max-width: 700px) { li a { grid-template-columns: 1fr; } }
</style>
