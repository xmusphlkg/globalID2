---
import ReportLayout from '../../../layouts/ReportLayout.astro';
import { buildAlternatePaths, type SeoDocument } from '../../../lib/seo';
import { weeklyDiff } from '../../../components/situation/text';
import { listWeeks } from '../../../utils/international';
import { translateUi } from '../../../utils/i18n';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : fr ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;
const weeks = listWeeks();
const title = pick('Weekly situation changes', '每周态势变化', 'Changements hebdomadaires de la situation');
const canonicalPath = `${prefix}/situation/weekly/`;
const seo: SeoDocument = {
  title: `${title} | GIDS`,
  description: pick('Each week in words: new outbreaks, outbreaks with updates and places reported for the first time.', '用文字说明每周变化：新增疫情、有更新的疫情和首次出现的地点。', 'Chaque semaine en mots : nouvelles flambées, flambées mises à jour et lieux signalés pour la première fois.'),
  canonicalPath,
  locale,
  alternatePaths: buildAlternatePaths(canonicalPath, locale),
  noindex: weeks.length === 0,
};
---

<ReportLayout title={title} description={seo.description} initialLanguage={locale} seo={seo} breadcrumbs={[{ label: pick('Situation map', '态势地图', 'Carte de situation'), href: `${prefix}/situation/` }, { label: pick('Weekly changes', '每周变化', 'Changements hebdomadaires') }]}>
  <div class="archive max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <header><h1>{title}</h1></header>
    {weeks.length ? (
      <ol>
        {weeks.map(week => (
          <li><a href={`${prefix}/situation/weekly/${week.period_key}/`}><b>{week.period_key}</b><span>{weeklyDiff(week, locale)}</span></a></li>
        ))}
      </ol>
    ) : <p class="empty">{pick('No weekly change has been published yet.', '尚未发布每周变化。', 'Aucun changement hebdomadaire n’a encore été publié.')}</p>}
  </div>
</ReportLayout>

<style>
  .archive { display: grid; gap: 1.5rem; padding-block: 2.5rem 4rem; }
  header { border-bottom: 2px solid rgb(var(--text-strong)); padding-bottom: 1rem; }
  h1 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(1.8rem, 5vw, 2.8rem); margin: 0; }
  ol { display: grid; gap: .6rem; list-style: none; margin: 0; padding: 0; }
  li a { border: 1px solid rgb(var(--border)); color: inherit; display: grid; gap: .3rem 1rem; grid-template-columns: 7rem minmax(0, 1fr); padding: .8rem; text-decoration: none; }
  li a:hover { border-color: rgb(var(--color-teal)); }
  li b { color: rgb(var(--text-strong)); font-family: ui-monospace, monospace; }
  li span { color: rgb(var(--text-muted)); font-size: .82rem; line-height: 1.5; }
  .empty { color: rgb(var(--text-faint)); }
  @media (max-width: 700px) { li a { grid-template-columns: 1fr; } }
</style>
