---
/**
 * Situation stage: a map that fills the page under the site header.
 * Each point is one disease in one place. The island also receives a compact
 * join to national surveillance, disease pages, and research.
 */
import ReportLayout from '../../layouts/ReportLayout.astro';
import SituationExplorer from '../../components/situation/SituationExplorer';
import { buildAlternatePaths, type SeoDocument } from '../../lib/seo';
import { readMonitoring, readSituationMap, readSources } from '../../utils/international';
import { readSituationSite } from '../../utils/situationSite';
import { translateUi } from '../../utils/i18n';
import type { MapPoint } from '../../utils/situationTypes';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : fr ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;

const map = readSituationMap();
const sources = readSources();
const monitoring = readMonitoring();
const published = map !== null;
const points: MapPoint[] = map?.points ?? [];
const diseaseIds = [...new Set(points.flatMap(point => point.disease_id ? [point.disease_id] : []))];
const alertCountries = [...new Map(points.map(point => [point.country_code.toUpperCase(), {
  code: point.country_code,
  name_en: point.country_name_en,
  name_zh: point.country_name_zh,
}])).values()];
const site = map
  ? readSituationSite({
      diseaseIds,
      alertCountries,
      sparkPairs: points.flatMap(point => point.disease_id ? [`${point.country_code}:${point.disease_id}`] : []),
      prefix,
    })
  : { countries: {}, diseases: {}, series: {} };
const activeOutbreaks = (map?.outbreaks ?? []).filter(outbreak => outbreak.status === 'active').length;
const sourcesOk = sources.filter(source => source.status === 'ok').length;

const title = pick('Global Infectious Disease Situation Map', '全球传染病态势地图', 'Carte mondiale de la situation des maladies infectieuses');
const description = pick(
  'A full-page map of official outbreak reports. Recent reports breathe. Open a place to read the alert beside the national surveillance series, the disease page, and related research.',
  '铺满页面的官方疫情地图。近期报告会呼吸闪动。打开一个地点，可同时看到警报、国家级监测序列、疾病页和相关研究。',
  'Une carte pleine page des rapports officiels de flambée. Les rapports récents pulsent. Ouvrez un lieu pour lire l’alerte à côté de la série nationale, de la page maladie et de la recherche associée.',
);
const canonicalPath = `${prefix}/situation/`;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const structuredData = published ? [{
  '@type': 'Dataset',
  '@id': `${new URL(canonicalPath, siteOrigin)}#alerts`,
  name: title,
  description,
  dateModified: map?.generated_at ?? undefined,
  temporalCoverage: map?.since_date && map?.as_of ? `${map.since_date}/${map.as_of}` : undefined,
  isBasedOn: sources.map(source => source.homepage).filter(Boolean),
}] : [];
const seo: SeoDocument = {
  title: `${title} | GIDS`,
  description,
  canonicalPath,
  locale,
  alternatePaths: buildAlternatePaths(canonicalPath, locale),
  noindex: !published,
  pageType: 'Report',
  datePublished: map?.generated_at ?? null,
  dateModified: map?.generated_at ?? null,
};
---

<ReportLayout title={title} description={description} initialLanguage={locale} structuredData={structuredData} seo={seo} stage={published} breadcrumbs={published ? [] : [{ label: pick('Situation map', '态势地图', 'Carte de situation') }]}>
  {published && map ? (
    <SituationExplorer
      client:load
      locale={locale}
      asOf={map.as_of}
      generatedAt={map.generated_at}
      points={points}
      site={site}
      monitoring={monitoring}
      activeOutbreaks={activeOutbreaks}
      sourcesOk={sourcesOk}
      sourceCount={sources.length}
      links={{
        weekly: `${prefix}/situation/weekly/`,
        monthly: `${prefix}/situation/monthly/`,
        methods: `${prefix}/situation/methodology/`,
      }}
    />
  ) : (
    <section class="placeholder">
      <p class="eyebrow">{pick('Not yet published', '尚未发布', 'Pas encore publié')}</p>
      <h1>{pick('No situation data is available yet', '暂无态势数据', 'Aucune donnée de situation n’est encore disponible')}</h1>
      <p>{pick('This page appears once official reports have been collected, read and exported.', '官方报告采集、解析并导出后，本页将显示内容。', 'Cette page apparaît une fois les rapports officiels collectés, lus et exportés.')}</p>
      <a href={`${prefix}/diseases/`}>{pick('Browse disease datasets', '浏览疾病数据', 'Parcourir les données par maladie')}</a>
    </section>
  )}
</ReportLayout>

<style>
  .placeholder { background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); margin: 3rem auto; max-width: 48rem; padding: 2rem; text-align: center; }
  .placeholder .eyebrow { color: rgb(var(--color-teal)); font-size: .67rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .placeholder h1 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(1.6rem, 4vw, 2.2rem); margin: .4rem 0; }
  .placeholder p { color: rgb(var(--text-muted)); line-height: 1.65; }
  .placeholder a { color: rgb(var(--color-teal)); }
</style>
