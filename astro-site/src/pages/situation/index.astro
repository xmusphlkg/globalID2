---
/**
 * Situation Room, built on official notices from international public-health
 * authorities (WHO, ECDC, Africa CDC, PAHO) with peer-reviewed AI enrichment.
 * The page renders only exported data; it disappears into a placeholder when
 * the notice export has not run yet.
 */
import ReportLayout from '../../layouts/ReportLayout.astro';
import SituationDigest from '../../components/SituationDigest.astro';
import SituationEvents from '../../components/SituationEvents.astro';
import SituationInternational from '../../components/SituationInternational.astro';
import { buildAlternatePaths, type SeoDocument } from '../../lib/seo';
import { formatDate } from '../../utils/situation';
import {
  digestHeadline,
  listDigestPeriods,
  readDigest,
  readInternationalLatest,
  readSituationEvents,
  readWeekNotices,
} from '../../utils/international';
import { translateUi } from '../../utils/i18n';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : fr ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;

const latest = readInternationalLatest();
const events = readSituationEvents();
const periods = listDigestPeriods();
const digest = periods[0] ? readDigest(periods[0]) : null;
const digestNotices = digest ? readWeekNotices(digest.period_key) : [];
const activeEvents = events.filter(event => event.status === 'active');
const published = Boolean(latest && latest.event_count > 0);

const title = pick('Global Infectious Disease Situation Room', '全球传染病态势室', 'Salle de situation mondiale des maladies infectieuses');
const description = digest
  ? digestHeadline(digest, locale)
  : pick(
    'Official outbreak and surveillance notices from WHO, ECDC, Africa CDC and PAHO, mapped to GIDS diseases and countries and summarised by peer-reviewed AI.',
    '汇集世卫组织、欧洲疾控中心、非洲疾控中心与泛美卫生组织的官方疫情与监测通报，映射到 GIDS 疾病与国家，并由同行评审的 AI 归纳。',
    'Avis officiels d’épidémie et de surveillance de l’OMS, de l’ECDC, de l’Africa CDC et de l’OPS, rattachés aux maladies et pays GIDS et résumés par une IA relue par un pair.',
  );
const canonicalPath = `${prefix}/situation/`;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const structuredData = published ? [{
  '@type': 'Dataset',
  '@id': `${new URL(canonicalPath, siteOrigin)}#notices`,
  name: title,
  description,
  dateModified: latest?.generated_at ?? undefined,
  temporalCoverage: latest?.window?.since_date && latest?.window?.as_of ? `${latest.window.since_date}/${latest.window.as_of}` : undefined,
  isBasedOn: (latest?.sources ?? []).map(source => source.homepage).filter(Boolean),
}] : [];
const seo: SeoDocument = {
  title: `${title} | GIDS`,
  description,
  canonicalPath,
  locale,
  alternatePaths: buildAlternatePaths(canonicalPath, locale),
  noindex: !published,
  pageType: 'Report',
  datePublished: latest?.generated_at ?? null,
  dateModified: latest?.generated_at ?? null,
};
---

<ReportLayout title={title} description={description} initialLanguage={locale} structuredData={structuredData} seo={seo} breadcrumbs={[{ label: pick('Situation Room', '全球态势室', 'Salle de situation') }]}>
  <div class="situation-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {published && latest ? <>
      <header class="report-hero">
        <div>
          <p class="eyebrow">{pick('Official international notices', '国际权威机构通报', 'Avis officiels internationaux')}</p>
          <h1>{title}</h1>
          <p>{pick(
            'What WHO, ECDC, Africa CDC and PAHO have reported, grouped into events and summarised weekly. Each summary is drafted by one AI pass and audited by an independent review pass before it is published; every point links to the original notice.',
            '汇总世卫组织、欧洲疾控中心、非洲疾控中心和泛美卫生组织的通报，按事件归并并每周综述。每段摘要先由 AI 起草，再经独立评审通过后发布；每条要点都链接到原始通报。',
            'Ce que l’OMS, l’ECDC, l’Africa CDC et l’OPS ont signalé, regroupé en événements et résumé chaque semaine. Chaque résumé est rédigé par une IA puis relu indépendamment avant publication ; chaque point renvoie à l’avis d’origine.',
          )}</p>
        </div>
        <dl>
          <div><dt>{pick('Notices', '通报', 'Avis')}</dt><dd>{latest.event_count}</dd></div>
          <div><dt>{pick('Active events', '活跃事件', 'Événements actifs')}</dt><dd>{activeEvents.length}</dd></div>
          <div><dt>{pick('Sources', '来源', 'Sources')}</dt><dd>{(latest.sources ?? []).filter(source => source.status === 'ok').length} / {(latest.sources ?? []).length}</dd></div>
          <div><dt>{pick('Updated', '更新于', 'Mis à jour')}</dt><dd>{formatDate(latest.generated_at, locale)}</dd></div>
        </dl>
      </header>

      <nav class="period-nav" aria-label={pick('Situation archives', '态势归档', 'Archives de situation')}>
        <a href={`${prefix}/situation/weekly/`}>{pick('Weekly briefs', '每周综述', 'Synthèses hebdomadaires')}</a>
        <a href={`${prefix}/situation/monthly/`}>{pick('Monthly archive', '月度归档', 'Archive mensuelle')}</a>
        <a href={`${prefix}/situation/methodology/`}>{pick('Methodology', '方法说明', 'Méthodologie')}</a>
      </nav>

      {digest && <SituationDigest digest={digest} notices={digestNotices} locale={locale} periodHref={`${prefix}/situation/weekly/${digest.period_key}/`} />}

      <SituationEvents events={activeEvents} locale={locale} />

      <SituationInternational latest={latest} locale={locale} limit={30} />
    </> : <section class="placeholder"><p class="eyebrow">{pick('Not yet published', '尚未发布', 'Pas encore publié')}</p><h1>{pick('No situation data is available yet', '暂无态势数据', 'Aucune donnée de situation n’est encore disponible')}</h1><p>{pick('This page appears once official authority notices have been collected and exported.', '采集并导出官方机构通报后，本页将显示内容。', 'Cette page apparaît une fois les avis officiels collectés et exportés.')}</p><a href={`${prefix}/diseases/`}>{pick('Browse disease datasets', '浏览疾病数据', 'Parcourir les données par maladie')}</a></section>}
  </div>
</ReportLayout>

<style>
  .situation-page { display: grid; gap: 1.5rem; padding-bottom: 4rem; padding-top: 2rem; }
  .report-hero { align-items: end; background: linear-gradient(135deg, rgb(9 37 55), rgb(15 62 72)); border: 1px solid rgb(18 70 83); display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr) minmax(19rem, .42fr); padding: clamp(1.3rem, 3vw, 2.2rem); position: relative; }
  .report-hero::after { background: rgb(var(--color-accent)); bottom: 0; content: ''; height: 3px; left: 0; position: absolute; width: 9rem; }
  .report-hero > div { max-width: 55rem; }
  .eyebrow { color: rgb(var(--color-teal)); font-size: .67rem; font-weight: 800; letter-spacing: .13em; margin: 0 0 .35rem; text-transform: uppercase; }
  h1 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(2rem, 5vw, 3.1rem); line-height: 1.03; margin: 0; }
  .report-hero h1 { color: rgb(241 247 248); }
  .report-hero p { color: rgb(195 216 219); line-height: 1.65; margin: .7rem 0 0; }
  .report-hero dl { display: grid; gap: .6rem; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .report-hero dl div { border-left: 1px solid rgb(91 132 140); padding-left: .7rem; }
  .report-hero dt { color: rgb(158 190 195); font-size: .6rem; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
  .report-hero dd { color: rgb(238 246 247); font-family: ui-monospace, monospace; font-size: .72rem; margin: .15rem 0 0; }
  .period-nav { border-bottom: 1px solid rgb(var(--border)); display: flex; flex-wrap: wrap; gap: .5rem; margin-top: -1rem; padding-bottom: 1rem; }
  .period-nav a { border: 1px solid rgb(var(--border)); color: rgb(var(--color-teal)); font-size: .72rem; font-weight: 750; padding: .42rem .65rem; text-decoration: none; }
  .period-nav a:hover { background: rgb(var(--surface)); }
  .placeholder { background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); margin: 3rem auto; max-width: 48rem; padding: 2rem; text-align: center; }
  .placeholder p { color: rgb(var(--text-muted)); line-height: 1.65; }
  .placeholder a { color: rgb(var(--color-teal)); }
  @media (max-width: 900px) { .report-hero { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .situation-page { padding-top: 1rem; } .report-hero { margin-inline: -.5rem; } .report-hero dl { grid-template-columns: 1fr 1fr; } }
</style>
