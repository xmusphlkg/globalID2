---
import { listMonths, listWeeks } from '../../utils/international';

// Short links such as /situation/2026-W43/ resolve to the canonical period page.
export function getStaticPaths() {
  return [
    ...listWeeks().map(week => ({ params: { period: week.period_key }, props: { target: `/situation/weekly/${week.period_key}/` } })),
    ...listMonths().map(period => ({ params: { period }, props: { target: `/situation/monthly/${period}/` } })),
  ];
}

return Astro.redirect((Astro.props as { target: string }).target, 301);
---
