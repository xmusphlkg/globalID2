---
import { listSituationReports } from '../../lib/situation-data';

export function getStaticPaths() {
  return (['weekly', 'monthly'] as const).flatMap(kind =>
    listSituationReports(kind).map(report => ({
      params: { period: report.report.period_key },
      props: { target: `/situation/${kind}/${report.report.period_key}/` },
    })),
  );
}

return Astro.redirect((Astro.props as { target: string }).target, 301);
---
