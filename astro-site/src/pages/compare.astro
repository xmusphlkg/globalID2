---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompareWorkspace from '../components/charts/CompareWorkspace';
import { diseaseIndex } from '../lib/seo-page-data';
import { toSeoSlug } from '../lib/seo';
import { localizedDiseaseName } from '../utils/diseaseNames';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const prefix = locale === 'zh' ? '/zh' : locale === 'fr' ? '/fr' : '';
const options = diseaseIndex.map(disease => ({
    id: disease.disease_id,
    slug: disease.slug,
    href: `${prefix}/diseases/${toSeoSlug(disease.slug) || disease.slug}/#downloads`,
    en: disease.name_en,
    zh: disease.name_zh,
    fr: localizedDiseaseName({ disease_id: disease.disease_id, slug: disease.slug, name_en: disease.name_en, name_zh: disease.name_zh, name_fr: disease.name_fr }, 'fr'),
}));
const title = locale === 'zh' ? '地理区域与疾病对比' : locale === 'fr' ? 'Comparer les zones géographiques et les maladies' : 'Compare geographic areas and diseases';
---

<BaseLayout title={title} description={title} initialLanguage={locale}>
  <div class="compare-page">
    <p class="academic-kicker">GIDS / {locale === 'zh' ? '数据工具' : locale === 'fr' ? 'Outil de données' : 'Data tool'}</p>
    <h1 class="academic-title">{title}</h1>
    <p class="academic-lead mt-4">
      {locale === 'zh' ? '选择最多两种疾病和四个地理区域，按来源报告期探索趋势并分享当前选择。' : locale === 'fr' ? 'Choisissez jusqu’à deux maladies et quatre zones géographiques pour explorer les tendances et partager votre sélection.' : 'Select up to two diseases and four geographic areas to explore source-period trends and share your selection.'}
    </p>
    <CompareWorkspace client:load diseases={options} language={locale} />
  </div>
</BaseLayout>
