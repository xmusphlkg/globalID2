---
// src/pages/countries/[country]/index.astro — Country detail page
import ReportLayout from '../../../layouts/ReportLayout.astro';
import StatBar from '../../../components/StatBar.astro';
import ReportCard from '../../../components/ReportCard.astro';
import CountryFlag from '../../../components/CountryFlag.astro';
import DownloadPanel from '../../../components/DownloadPanel.astro';
import PageAnchorNav from '../../../components/PageAnchorNav.astro';
import EpidemicCurve from '../../../components/charts/EpidemicCurve';
import DiseaseHeatmap from '../../../components/charts/DiseaseHeatmap';
import ComparisonTable from '../../../components/charts/ComparisonTable';
import { buildChartSourceMeta } from '../../../utils/chartMeta';
import { hasCountryDataSnapshot } from '../../../lib/country-coverage';
import {
  buildCountryMetaDescription,
  buildDatasetDistributions,
  buildDatasetStructuredData,
  buildAlternatePaths,
  buildSeoTitle,
  formatYearRange,
  toSeoSlug,
} from '../../../lib/seo';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

export function getStaticPaths() {
  const metaPath = resolve('./src/data/meta.json');
  const meta = JSON.parse(readFileSync(metaPath, 'utf-8')) as any;
  return (meta.countries ?? []).filter(hasCountryDataSnapshot).map((c: any) => ({
    params: { country: c.code.toLowerCase() },
    props: { countryCode: c.code.toLowerCase(), locale: 'en' as 'en' | 'zh' },
  }));
}

interface Props { countryCode: string; locale?: 'en' | 'zh'; }
const { countryCode: country, locale = 'en' } = Astro.props as Props;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const localeHref = (path: string) => `${prefix}${path}`;
const fallbackCountryCode = String(country ?? '').toUpperCase();
const dataPath = resolve(`./src/data/countries/${country}.json`);
const reportsIndexPath = resolve('./src/data/reports/index.json');
const downloadsPath = resolve('./src/data/downloads.json');

let countryData: any = null;
let reports: any[] = [];
let countryDownload: any = null;

if (existsSync(dataPath)) {
  countryData = JSON.parse(readFileSync(dataPath, 'utf-8'));
}
if (existsSync(reportsIndexPath)) {
  const allReports = JSON.parse(readFileSync(reportsIndexPath, 'utf-8')) as any[];
  reports = allReports
    .filter(r => r.country_code?.toLowerCase() === country)
    .slice(0, 6);
}
if (existsSync(downloadsPath)) {
  const downloads = JSON.parse(readFileSync(downloadsPath, 'utf-8')) as any;
  countryDownload = (downloads.countries ?? []).find(
    (entry: any) => entry.code?.toLowerCase() === country
  ) ?? null;
}

function fmtNum(n: number | null | undefined) {
  if (!n) return '0';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

const stats = countryData
  ? [
      { label: 'Total Cases', labelZh: '累计病例', value: fmtNum(countryData.total_cases), accent: 'amber' as const },
      ...(countryData.total_deaths > 0
        ? [{ label: 'Total Deaths', labelZh: '累计死亡', value: fmtNum(countryData.total_deaths), accent: 'red' as const }]
        : []),
      { label: 'Diseases Tracked', labelZh: '追踪疾病数', value: countryData.disease_count ?? 0, accent: 'teal' as const },
      { label: 'Reports', labelZh: '已生成报告', value: reports.length, accent: 'blue' as const },
    ]
  : [];

const diseaseRows = countryData
  ? Object.values(countryData.disease_series as Record<string, any>).map((entry: any) => ({
      disease_id: entry.disease_id,
      name_en: entry.name_en,
      name_zh: entry.name_zh,
      category: entry.category,
      slug: entry.slug,
      total_cases: entry.total_cases,
      total_deaths: entry.total_deaths,
      latest_cases: entry.latest_cases,
      latest_deaths: entry.latest_deaths,
      incidence_rate: entry.incidence_rate,
      mortality_rate: entry.mortality_rate,
    }))
  : [];

const coverageLabel = countryData?.date_range
  ? `${countryData.date_range.start} → ${countryData.date_range.end ?? (zh ? '至今' : 'present')}`
  : '—';
const countryName = countryData?.country_name_en ?? countryData?.country_name ?? fallbackCountryCode;
const countryNameZh = countryData?.country_name_zh ?? countryDownload?.name_zh ?? countryName;
const countryBriefEn = countryData?.brief_en
  ?? `${countryName} surveillance page consolidates infectious disease records, charts, and source metadata for exploratory review.`;
const countryBriefZh = countryData?.brief_zh
  ?? `${countryNameZh}监测页面整合传染病记录、图表和来源信息，供探索性分析使用。`;
const surveillanceSystemEn = countryData?.surveillance_system_en
  ?? `Current records are built from configured public surveillance sources for ${countryName}.`;
const surveillanceSystemZh = countryData?.surveillance_system_zh
  ?? `当前记录来自 ${countryNameZh} 已配置的公开监测来源。`;
const interpretationEn = countryData?.interpretation_en
  ?? `Coverage spans ${coverageLabel} across ${countryData?.disease_count ?? 0} tracked diseases.`;
const interpretationZh = countryData?.interpretation_zh
  ?? `当前覆盖 ${coverageLabel}，纳入 ${countryData?.disease_count ?? 0} 种追踪疾病。`;
const reportingCadenceEn = countryData?.reporting_cadence_en
  ?? 'Counts remain at each source\'s declared reporting period; annual, quarterly, monthly, and weekly totals are not frequency-normalized.';
const reportingCadenceZh = countryData?.reporting_cadence_zh
  ?? '病例数保持各来源声明的报告期间；年度、季度、月度和周度总量不进行频率归一化。';
const limitationsEn = countryData?.limitations_en
  ?? 'Counts reflect reported surveillance records and can be affected by source cadence, case definitions, reporting lag, and missing denominators.';
const limitationsZh = countryData?.limitations_zh
  ?? '病例数反映已报告监测记录，可能受来源频率、病例定义、报告延迟和分母缺失影响。';
const sourceSummaryEn = countryData?.source_summary_en ?? 'Configured public surveillance sources';
const sourceSummaryZh = countryData?.source_summary_zh ?? sourceSummaryEn;
const countryBriefUpdated = countryData?.country_brief_updated_at
  ? new Date(countryData.country_brief_updated_at).toLocaleDateString(zh ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;

const chartSourceMeta = buildChartSourceMeta(
  countryDownload ? { ...countryDownload, source_info: countryData?.source_info } : null,
  `${countryName} surveillance dataset`
);
const countryDataUrl = countryDownload?.site_json_path ?? `/site-data/countries/${country}.json`;
const countryMetaDescriptionEn = buildCountryMetaDescription({
  name: countryName,
  diseaseCount: countryData?.disease_count,
  start: countryData?.date_range?.start,
  end: countryData?.date_range?.end,
});
const countryMetaDescription = zh
  ? `${countryNameZh}传染病监测数据，覆盖${coverageLabel}，包含疾病趋势、报告、官方来源与可下载数据。`
  : countryMetaDescriptionEn;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const countryPageUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const countrySourceUrls = [
  countryData?.source_info?.primary_url,
  ...(countryData?.source_info?.sources ?? []).map((source: any) => source?.url),
].filter((url): url is string => typeof url === 'string' && url.length > 0);
const countryDatasetStructuredData = buildDatasetStructuredData({
  id: `${countryPageUrl}#dataset`,
  url: countryPageUrl,
  name: zh ? `${countryNameZh}传染病监测数据集` : `${countryName} infectious disease surveillance dataset`,
  description: countryMetaDescription,
  siteOrigin,
  dateModified: countryData?.country_brief_updated_at ?? countryDownload?.generated_at,
  start: countryData?.date_range?.start,
  end: countryData?.date_range?.end,
  spatialCoverage: zh ? countryNameZh : countryName,
  keywords: zh ? [countryNameZh, '传染病监测', '公共卫生数据'] : [countryName, 'infectious disease surveillance', 'public health data'],
  distributions: buildDatasetDistributions({
    entry: countryDownload,
    siteOrigin,
    fallbackSiteJsonPath: countryDataUrl,
  }),
  sourceUrls: countrySourceUrls,
  identifier: `GIDS:COUNTRY:${String(country).toUpperCase()}`,
  version: countryData?.generated_at ?? countryDownload?.generated_at,
  variableMeasured: ['reported cases', 'reported deaths', 'incidence rate'],
  includedInDataCatalog: `${siteOrigin}#catalog`,
});
const countryPlaceStructuredData = {
  '@type': 'Place',
  '@id': `${countryPageUrl}#place`,
  name: zh ? countryNameZh : countryName,
};
const countryPageStructuredData = {
  '@type': 'WebPage',
  '@id': `${countryPageUrl}#country-webpage`,
  url: countryPageUrl,
  name: zh ? countryNameZh : countryName,
  about: { '@id': `${countryPageUrl}#place` },
  mainEntity: { '@id': `${countryPageUrl}#dataset` },
  dateModified: countryData?.generated_at ?? countryDownload?.generated_at ?? undefined,
};
const countrySeo = {
  title: zh
    ? `${countryNameZh}传染病监测数据 ${formatYearRange(countryData?.date_range?.start, countryData?.date_range?.end)} | GIDS`
    : buildSeoTitle(countryName, 'infectious disease surveillance data', formatYearRange(countryData?.date_range?.start, countryData?.date_range?.end)),
  description: countryMetaDescription,
  canonicalPath: Astro.url.pathname,
  alternatePaths: buildAlternatePaths(Astro.url.pathname, 'en'),
  pageType: 'WebPage',
  dateModified: countryData?.generated_at ?? countryDownload?.generated_at,
  structuredData: [countryPageStructuredData, countryPlaceStructuredData, countryDatasetStructuredData],
} as const;
const countrySourceSeriesUrl = countryDataUrl.replace(/\.json$/, '-source-series.json');
---

<ReportLayout
  title={zh ? countryNameZh : countryName}
  description={countryMetaDescription}
  structuredData={[countryPageStructuredData, countryPlaceStructuredData, countryDatasetStructuredData]}
  seo={countrySeo}
  initialLanguage={locale}
  breadcrumbs={[
    { label: 'Countries and Regions', labelZh: '国家/地区', href: localeHref('/countries/') },
    { label: countryName, labelZh: countryNameZh },
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <section id="overview" class="academic-hero scroll-mt-24">
      <div class="flex flex-col gap-8 xl:flex-row xl:items-end xl:justify-between">
        <div class="space-y-4">
          <p class="academic-kicker">
            {zh ? '国家/地区监测简报 | 传染病监测概览' : 'Country/Region Surveillance Brief | Infectious disease profile'}
          </p>
          <div class="flex items-center gap-3">
            <CountryFlag
              code={countryData?.country_code ?? fallbackCountryCode}
              name={countryName}
              sizeClass="w-10 h-8"
            />
            <span class="text-sm uppercase tracking-[0.18em] text-[rgb(var(--text-muted))]">{countryData?.country_code ?? fallbackCountryCode}</span>
          </div>
          <div>
            <h1 class="academic-title">
              {zh ? countryNameZh : countryName}
            </h1>
          </div>
          <p class="academic-lead">
            {zh ? countryBriefZh : countryBriefEn}
          </p>
        </div>

        <div class="space-y-4 xl:max-w-sm">
          <div class="academic-meta-grid xl:grid-cols-2">
            <div class="academic-meta-item">
              <div class="academic-meta-label">{zh ? '覆盖区间' : 'Coverage window'}</div>
              <div class="academic-meta-value text-sm font-medium">{coverageLabel}</div>
            </div>
            <div class="academic-meta-item">
              <div class="academic-meta-label">{zh ? '追踪疾病数' : 'Tracked diseases'}</div>
              <div class="academic-meta-value font-serif">{countryData?.disease_count ?? 0}</div>
            </div>
          </div>
          {reports.length > 0 && (
            <a
              href={localeHref(`/countries/${country}/reports/`)}
              class="site-action-secondary inline-flex items-center gap-2 px-4 py-2 rounded-none border text-sm font-semibold transition-all"
            >
              <span>{zh ? '查看报告归档' : 'Open report archive'}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </section>

    <PageAnchorNav locale={locale} items={[
      { href: '#indicators', label: 'Indicators', labelZh: '核心指标' },
      { href: '#trends', label: 'Trends', labelZh: '趋势' },
      { href: '#disease-directory', label: 'Diseases', labelZh: '疾病目录' },
      { href: '#reports', label: 'Reports', labelZh: '报告' },
      { href: '#downloads', label: 'Sources & downloads', labelZh: '来源与下载' },
    ]} />

    <section id="sources" class="figure-panel scroll-mt-24">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="figure-kicker">{zh ? '国家/地区简介' : 'Country/Region Brief'}</p>
          <h2 class="figure-title">
            {zh ? '如何解读本国家/地区监测画像。' : 'How to interpret this surveillance profile.'}
          </h2>
        </div>
        <div class="text-xs leading-5 text-[rgb(var(--text-muted))] sm:text-right">
          <div>{zh ? `来源：${sourceSummaryZh}` : `Sources: ${sourceSummaryEn}`}</div>
          {countryBriefUpdated && (
            <div>{zh ? `更新于 ${countryBriefUpdated}` : `Updated ${countryBriefUpdated}`}</div>
          )}
        </div>
      </div>
      <details class="country-context">
        <summary>
          <span>{zh ? '查看解读、报告频率与数据限制' : 'Review interpretation, cadence, and limitations'}</span>
          <span aria-hidden="true">＋</span>
        </summary>
      <div class="country-context-grid">
        <div class="border border-[rgb(var(--border))/0.68] bg-[rgb(var(--surface))/0.6] px-4 py-3">
          <div class="academic-meta-label">{zh ? '监测系统' : 'Surveillance system'}</div>
          <p class="mt-2 text-sm leading-6 text-[rgb(var(--text-muted))]">
            {zh ? surveillanceSystemZh : surveillanceSystemEn}
          </p>
        </div>
        <div class="border border-[rgb(var(--border))/0.68] bg-[rgb(var(--surface))/0.6] px-4 py-3">
          <div class="academic-meta-label">{zh ? '当前解读' : 'Current interpretation'}</div>
          <p class="mt-2 text-sm leading-6 text-[rgb(var(--text-muted))]">
            {zh ? interpretationZh : interpretationEn}
          </p>
        </div>
        <div class="border border-[rgb(var(--border))/0.68] bg-[rgb(var(--surface))/0.6] px-4 py-3">
          <div class="academic-meta-label">{zh ? '报告频率' : 'Reporting cadence'}</div>
          <p class="mt-2 text-sm leading-6 text-[rgb(var(--text-muted))]">
            {zh ? reportingCadenceZh : reportingCadenceEn}
          </p>
        </div>
        <div class="border border-[rgb(var(--border))/0.68] bg-[rgb(var(--surface))/0.6] px-4 py-3">
          <div class="academic-meta-label">{zh ? '数据限制' : 'Data limitations'}</div>
          <p class="mt-2 text-sm leading-6 text-[rgb(var(--text-muted))]">
            {zh ? limitationsZh : limitationsEn}
          </p>
        </div>
      </div>
      </details>
    </section>

    {stats.length > 0 && (
        <section id="indicators" class="figure-panel scroll-mt-24">
            <h2 class="figure-title">
              {zh ? '核心监测指标' : 'Key surveillance indicators'}
            </h2>
          <div class="mt-5">
            <StatBar stats={stats} locale={locale} />
          </div>
        </section>
      )}

    {diseaseRows.length > 0 && (
      <section id="disease-directory" class="figure-panel scroll-mt-24">
        <p class="figure-kicker">{zh ? '浏览数据' : 'Explore the data'}</p>
        <h2 class="figure-title">
          {zh ? '已追踪疾病画像' : 'Tracked disease profiles'}
        </h2>
        <ul class="mt-4 flex flex-wrap gap-2">
          {[...diseaseRows]
            .sort((left, right) => Number(right.total_cases ?? 0) - Number(left.total_cases ?? 0))
            .slice(0, 16)
            .map((row) => (
              <li>
                <a href={localeHref(`/diseases/${toSeoSlug(row.slug)}/`)} class="site-action-secondary inline-flex px-3 py-1.5 text-sm rounded-none border">
                  <span>{zh ? row.name_zh : row.name_en}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    )}

    <section id="trends" class="figure-panel scroll-mt-24">
        <h2 class="figure-title">
          {zh ? '各疾病监测趋势' : 'Surveillance trends by disease'}
        </h2>
        <p class="figure-caption mt-2">
          {zh ? '默认先查看一条监测序列及其历史参照；比较模式仅显示共同观测时间窗，并分开不同报告频率；暴发模式只适用于按发病时间统计的日度或周度数据。' : 'Start with one surveillance series and its historical reference. Comparison mode restricts series to their common observed window and separates unlike reporting cadences; outbreak mode is available only for daily or weekly onset-time data.'}
        </p>
      <div class="mt-5">
        {countryData?.disease_series ? (
          <EpidemicCurve
            client:visible
            dataUrl={countryDataUrl}
            sourceSeriesUrl={countrySourceSeriesUrl}
            topN={10}
            height={420}
            sourceMeta={chartSourceMeta}
            initialLanguage={locale}
          />
        ) : (
          <div class="card p-8 text-center text-[rgb(var(--text-muted))]">{zh ? '此视图暂无可展示的趋势数据。' : 'No trend data is available for this view.'}</div>
        )}
      </div>
    </section>

    <section class="figure-panel">
        <h2 class="figure-title">
          {zh ? '季节性变化' : 'Seasonal patterns'}
        </h2>
      <div class="mt-5">
        {(countryData?.heatmap?.z?.length ?? 0) > 0 ? (
          <DiseaseHeatmap
            client:visible
            dataUrl={countryDataUrl}
            height={600}
            sourceMeta={chartSourceMeta}
            initialLanguage={locale}
          />
        ) : (
          <div class="card p-8 text-center text-[rgb(var(--text-muted))]">{zh ? '当可用序列仅为年度或季度总量时，不展示月度季节性热图。' : 'A monthly seasonal heatmap is not shown when the available series are annual or quarterly totals.'}</div>
        )}
      </div>
    </section>

    <section class="figure-panel">
        <h2 class="figure-title">
          {zh ? '疾病数据对比' : 'Disease comparison'}
        </h2>
      <div class="mt-5">
        {diseaseRows.length > 0 ? (
          <ComparisonTable
            client:visible
            rows={diseaseRows}
            countryCode={country}
            dataUrl={countryDataUrl}
            initialLanguage={locale}
          />
        ) : (
          <div class="card p-8 text-center text-[rgb(var(--text-muted))]">{zh ? '此视图暂无可展示的疾病数据。' : 'No disease data is available for this view.'}</div>
        )}
      </div>
    </section>

    {reports.length > 0 && (
      <section id="reports" class="figure-panel scroll-mt-24">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between mb-6">
          <div>
            <h2 class="figure-title">
              {zh ? '近期监测摘要' : 'Recent monitoring summaries'}
            </h2>
          </div>
          <a href={localeHref(`/countries/${country}/reports/`)} class="text-sm font-semibold text-brand-500 hover:text-brand-400 transition-colors">
            <span>{zh ? '查看全部报告 →' : 'View all reports →'}</span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {reports.map((r: any) => (
            <ReportCard
              id={r.id}
              title={r.title}
              reportType={r.report_type}
              periodStart={r.period_start}
              periodEnd={r.period_end}
              createdAt={r.created_at}
              countryCode={r.country_code}
              countryName={r.country_name}
              qualityScore={r.quality_score}
              summary={r.summary}
              locale={locale}
            />
          ))}
        </div>
      </section>
    )}

    {countryDownload && (
      <div id="downloads" class="scroll-mt-24"><DownloadPanel
        entry={{ ...countryDownload, source_info: countryData?.source_info }}
        title="Download data"
        initialLanguage={locale}
        descriptionEn="Download source observations and the public compatibility projection with series definitions, reporting grain, and provenance."
        descriptionZh="下载来源观测与公开兼容投影，并保留序列定义、报告粒度和数据溯源信息。"
      /></div>
    )}
  </div>
</ReportLayout>

<style>
  .country-context { margin-top: 1rem; border-top: 1px solid rgb(var(--border)); }
  .country-context summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 0; color: rgb(var(--color-teal)); cursor: pointer; font-size: .78rem; font-weight: 650; list-style: none; }
  .country-context summary::-webkit-details-marker { display: none; }
  .country-context[open] summary span:last-child { transform: rotate(45deg); }
  .country-context-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .65rem; padding-top: .25rem; }
  @media(max-width:1024px){.country-context-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:640px){.country-context-grid{grid-template-columns:1fr}}
</style>
