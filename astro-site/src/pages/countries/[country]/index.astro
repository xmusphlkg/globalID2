---
// src/pages/countries/[country]/index.astro — Country detail page
import ReportLayout from '../../../layouts/ReportLayout.astro';
import StatBar from '../../../components/StatBar.astro';
import ReportCard from '../../../components/ReportCard.astro';
import CountryFlag from '../../../components/CountryFlag.astro';
import DownloadPanel from '../../../components/DownloadPanel.astro';
import EpidemicCurve from '../../../components/charts/EpidemicCurve';
import DiseaseHeatmap from '../../../components/charts/DiseaseHeatmap';
import ComparisonTable from '../../../components/charts/ComparisonTable';
import { buildChartSourceMeta } from '../../../utils/chartMeta';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

export async function getStaticPaths() {
  const metaPath = resolve('./src/data/meta.json');
  const meta = JSON.parse(readFileSync(metaPath, 'utf-8')) as any;
  return (meta.countries ?? []).map((c: any) => ({
    params: { country: c.code.toLowerCase() },
  }));
}

const { country } = Astro.params;
const dataPath = resolve(`./src/data/countries/${country}.json`);
const reportsIndexPath = resolve('./src/data/reports/index.json');
const downloadsPath = resolve('./src/data/downloads.json');

let countryData: any = null;
let reports: any[] = [];
let countryDownload: any = null;

if (existsSync(dataPath)) {
  countryData = JSON.parse(readFileSync(dataPath, 'utf-8'));
}
if (existsSync(reportsIndexPath)) {
  const allReports = JSON.parse(readFileSync(reportsIndexPath, 'utf-8')) as any[];
  reports = allReports
    .filter(r => r.country_code?.toLowerCase() === country)
    .slice(0, 6);
}
if (existsSync(downloadsPath)) {
  const downloads = JSON.parse(readFileSync(downloadsPath, 'utf-8')) as any;
  countryDownload = (downloads.countries ?? []).find(
    (entry: any) => entry.code?.toLowerCase() === country
  ) ?? null;
}

function fmtNum(n: number | null | undefined) {
  if (!n) return '0';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

const stats = countryData
  ? [
      { label: 'Total Cases', labelZh: '累计病例', value: fmtNum(countryData.total_cases), accent: 'amber' as const },
      ...(countryData.total_deaths > 0
        ? [{ label: 'Total Deaths', labelZh: '累计死亡', value: fmtNum(countryData.total_deaths), accent: 'red' as const }]
        : []),
      { label: 'Diseases Tracked', labelZh: '追踪疾病数', value: countryData.disease_count ?? 0, accent: 'teal' as const },
      { label: 'Reports', labelZh: '已生成报告', value: reports.length, accent: 'blue' as const },
    ]
  : [];

const diseaseRows = countryData
  ? Object.values(countryData.disease_series as Record<string, any>)
  : [];

const coverageLabel = countryData?.date_range
  ? `${countryData.date_range.start} → ${countryData.date_range.end ?? 'present'}`
  : '—';

const chartSourceMeta = buildChartSourceMeta(
  countryDownload,
  `${countryData?.country_name ?? country.toUpperCase()} surveillance dataset`
);
---

<ReportLayout
  title={countryData?.country_name ?? country.toUpperCase()}
  description={`Disease surveillance data for ${countryData?.country_name ?? country.toUpperCase()}`}
  breadcrumbs={[
    { label: 'Countries', href: '/countries/' },
    { label: countryData?.country_name ?? country.toUpperCase() },
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <section class="academic-hero">
      <div class="flex flex-col gap-8 xl:flex-row xl:items-end xl:justify-between">
        <div class="space-y-4">
          <p class="academic-kicker" data-lang-en="Country Surveillance Brief" data-lang-zh="国家监测简报">
            Country Surveillance Brief
          </p>
          <div class="flex items-center gap-3">
            <CountryFlag
              code={countryData?.country_code ?? country.toUpperCase()}
              name={countryData?.country_name ?? country.toUpperCase()}
              sizeClass="w-10 h-8"
            />
            <span class="text-sm uppercase tracking-[0.18em] text-slate-500">{countryData?.country_code ?? country.toUpperCase()}</span>
          </div>
          <div>
            <h1 class="academic-title">
              {countryData?.country_name ?? country.toUpperCase()}
            </h1>
            <p class="academic-subtitle mt-2" data-lang-en="National infectious disease surveillance overview" data-lang-zh="国家传染病监测概览">
              National infectious disease surveillance overview
            </p>
          </div>
          <p class="academic-lead" data-lang-en="This page consolidates time-series surveillance records, comparative tables, and machine-readable downloads for formal reporting and exploratory review." data-lang-zh="本页整合了时间序列监测记录、疾病对比表和机器可读下载文件，适用于正式汇报与探索性分析。">
            This page consolidates time-series surveillance records, comparative tables, and machine-readable downloads for formal reporting and exploratory review.
          </p>
        </div>

        <div class="space-y-4 xl:max-w-sm">
          <div class="academic-meta-grid xl:grid-cols-2">
            <div class="academic-meta-item">
              <div class="academic-meta-label" data-lang-en="Coverage window" data-lang-zh="覆盖区间">Coverage window</div>
              <div class="academic-meta-value text-sm font-medium">{coverageLabel}</div>
            </div>
            <div class="academic-meta-item">
              <div class="academic-meta-label" data-lang-en="Tracked diseases" data-lang-zh="追踪疾病数">Tracked diseases</div>
              <div class="academic-meta-value font-serif">{countryData?.disease_count ?? 0}</div>
            </div>
          </div>
          <a
            href={`/countries/${country}/reports/`}
            class="site-action-secondary inline-flex items-center gap-2 px-4 py-2 rounded-none border text-sm font-semibold transition-all"
          >
            <span data-lang-en="Open report archive" data-lang-zh="查看报告归档">Open report archive</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    {stats.length > 0 && <StatBar stats={stats} />}

    <section class="figure-panel">
      <p class="figure-kicker" data-lang-en="Figure 1" data-lang-zh="图 1">Figure 1</p>
      <h2 class="figure-title" data-lang-en="Epidemic Curve — Top 10 Diseases" data-lang-zh="流行曲线 — 前 10 种疾病">
        Epidemic Curve — Top 10 Diseases
      </h2>
      <p class="figure-caption" data-lang-en="Default metric uses weekly-equivalent case normalization to support fairer cross-country comparison while preserving the original reporting rhythm." data-lang-zh="默认指标采用周等价病例折算，在保留原始报告节奏的同时提高跨国比较的可比性。">
        Default metric uses weekly-equivalent case normalization to support fairer cross-country comparison while preserving the original reporting rhythm.
      </p>
      <div class="mt-6">
        {countryData?.disease_series ? (
          <EpidemicCurve
            client:only="react"
            series={countryData.disease_series}
            topN={10}
            height={420}
            sourceMeta={chartSourceMeta}
          >
            <div slot="fallback" class="chart-loading-shell" aria-hidden="true">
              <div class="chart-loading-toolbar">
                <span class="chart-loading-pill w-24"></span>
                <span class="chart-loading-pill w-32"></span>
                <span class="chart-loading-pill w-28"></span>
              </div>
              <div class="chart-loading-line w-4/5"></div>
              <div class="chart-loading-panel" style="height: 420px;"></div>
            </div>
          </EpidemicCurve>
        ) : (
          <div class="card p-8 text-center text-slate-500">No time-series data available</div>
        )}
      </div>
    </section>

    <section class="figure-panel">
      <p class="figure-kicker" data-lang-en="Figure 2" data-lang-zh="图 2">Figure 2</p>
      <h2 class="figure-title" data-lang-en="Disease × Month Heatmap" data-lang-zh="疾病 × 月份热图">
        Disease × Month Heatmap
      </h2>
      <p class="figure-caption" data-lang-en="All diseases across the full surveillance period using calendar-month aggregation. The heatmap uses a logarithmic scale to preserve visibility for both low-incidence and high-incidence diseases." data-lang-zh="展示整个监测周期内所有疾病的自然月聚合结果。热图采用对数刻度，以兼顾低发病和高发病疾病的可读性。">
        All diseases across the full surveillance period using calendar-month aggregation. The heatmap uses a logarithmic scale to preserve visibility for both low-incidence and high-incidence diseases.
      </p>
      <div class="mt-6">
        {(countryData?.disease_series || countryData?.heatmap?.z?.length) ? (
          <DiseaseHeatmap
            client:only="react"
            data={countryData.heatmap}
            series={countryData.disease_series}
            height={600}
            sourceMeta={chartSourceMeta}
          >
            <div slot="fallback" class="chart-loading-shell" aria-hidden="true">
              <div class="chart-loading-toolbar">
                <span class="chart-loading-pill w-28"></span>
                <span class="chart-loading-pill w-36"></span>
                <span class="chart-loading-pill w-24"></span>
              </div>
              <div class="chart-loading-line w-3/4"></div>
              <div class="chart-loading-panel" style="height: 600px;"></div>
            </div>
          </DiseaseHeatmap>
        ) : (
          <div class="card p-8 text-center text-slate-500">No heatmap data available</div>
        )}
      </div>
    </section>

    <section class="figure-panel">
      <p class="figure-kicker" data-lang-en="Table 1" data-lang-zh="表 1">Table 1</p>
      <h2 class="figure-title" data-lang-en="Disease Comparison Table" data-lang-zh="疾病对比表格">
        Disease Comparison Table
      </h2>
      <p class="figure-caption" data-lang-en="Totals and latest values come from the reported series and are intended to be read alongside the normalized trend view above." data-lang-zh="表中总量与最新值来自原始报告序列，建议与上方的标准化趋势图结合阅读。">
        Totals and latest values come from the reported series and are intended to be read alongside the normalized trend view above.
      </p>
      <div class="mt-6">
        {diseaseRows.length > 0 ? (
          <ComparisonTable
            client:only="react"
            rows={diseaseRows}
            countryCode={country}
            series={countryData.disease_series}
          >
            <div slot="fallback" class="chart-loading-shell" aria-hidden="true">
              <div class="chart-loading-toolbar">
                <span class="chart-loading-pill w-48"></span>
                <span class="chart-loading-pill w-24"></span>
                <span class="chart-loading-pill w-24"></span>
              </div>
              <div class="chart-loading-line w-full"></div>
              <div class="chart-loading-line w-5/6"></div>
              <div class="chart-loading-panel" style="height: 420px;"></div>
            </div>
          </ComparisonTable>
        ) : (
          <div class="card p-8 text-center text-slate-500">No disease data available</div>
        )}
      </div>
    </section>

    {reports.length > 0 && (
      <section>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between mb-6">
          <div>
            <p class="academic-kicker" data-lang-en="Recent documents" data-lang-zh="近期文档">Recent documents</p>
            <h2 class="academic-section-title" data-lang-en="Recent Reports" data-lang-zh="近期报告">
              Recent Reports
            </h2>
            <p class="academic-section-intro" data-lang-en="Most recent machine-generated analyses for this country, ordered by report publication time." data-lang-zh="按发布时间排序展示该国家最近生成的分析报告。">
              Most recent machine-generated analyses for this country, ordered by report publication time.
            </p>
          </div>
          <a href={`/countries/${country}/reports/`} class="text-sm text-brand-400 hover:text-brand-300 transition-colors">
            <span data-lang-en="View all reports →" data-lang-zh="查看全部报告 →">View all reports →</span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {reports.map((r: any) => (
            <ReportCard
              id={r.id}
              title={r.title}
              reportType={r.report_type}
              periodStart={r.period_start}
              periodEnd={r.period_end}
              createdAt={r.created_at}
              countryCode={r.country_code}
              countryName={r.country_name}
              qualityScore={r.quality_score}
            />
          ))}
        </div>
      </section>
    )}

    {countryDownload && (
      <DownloadPanel
        entry={countryDownload}
        title="Download Country Dataset"
        descriptionEn="Download the full country dataset backing this page in JSON or CSV, with source metadata included."
        descriptionZh="下载当前国家页面对应的完整数据集，支持 JSON 和 CSV，并附带数据源信息。"
      />
    )}
  </div>
</ReportLayout>
