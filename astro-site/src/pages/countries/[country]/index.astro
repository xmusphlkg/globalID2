---
// src/pages/countries/[country]/index.astro — Country detail page
import ReportLayout from '../../../layouts/ReportLayout.astro';
import SurveillanceCountryContext from '../../../components/public/SurveillanceCountryContext';
import SurveillanceSummary from '../../../components/public/SurveillanceSummary';
import SurveillanceDirectory from '../../../components/public/SurveillanceDirectory';
import ReportCard from '../../../components/ReportCard.astro';
import CountryFlag from '../../../components/CountryFlag.astro';
import PageAnchorNav from '../../../components/PageAnchorNav.astro';
import InternationalNoticePanel from '../../../components/InternationalNoticePanel.astro';
import EpidemicCurve from '../../../components/charts/EpidemicCurve';
import DiseaseHeatmap from '../../../components/charts/DiseaseHeatmap';
import ComparisonTable from '../../../components/charts/ComparisonTable';
import { reportIndex, countryDiseaseRouteIdentities } from '../../../lib/seo-page-data';
import {
  buildCountryMetaDescription,
  buildDatasetDistributions,
  buildDatasetStructuredData,
  buildAlternatePaths,
  clampSeoTitle,
  buildSeoTitle,
  formatYearRange,
} from '../../../lib/seo';
import metaRaw from '../../../data/meta.json';
import { shouldBuildPage } from '../../../lib/page-build-plan';
import { localizedRegionName } from '../../../utils/i18n';
import { siteHref } from '../../../lib/papers';

export function getStaticPaths() {
  return ((metaRaw as any).countries ?? []).filter((c: any) => shouldBuildPage(`country:${c.code.toLowerCase()}`)).map((c: any) => ({
    params: { country: c.code.toLowerCase() },
    props: { countryCode: c.code.toLowerCase(), locale: 'en' as 'en' | 'zh' | 'fr' },
  }));
}

interface Props { countryCode: string; locale?: 'en' | 'zh' | 'fr'; }
const { countryCode: country, locale = 'en' } = Astro.props as Props;
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const localeHref = (path: string) => `${prefix}${path}`;
const fallbackCountryCode = String(country ?? '').toUpperCase();

const childJurisdictions = ((metaRaw as any).countries ?? [])
  .filter((entry: any) => (
    entry.parent_code === fallbackCountryCode
  ))
  .sort((left: any, right: any) => String(
    zh ? left.name_zh ?? left.name : left.name_en ?? left.name
  ).localeCompare(String(
    zh ? right.name_zh ?? right.name : right.name_en ?? right.name
  ), zh ? 'zh-CN' : fr ? 'fr-FR' : 'en'));
// This route is a stable shell. Live observations and summaries are loaded
// from the publication manifest in the browser, without an Astro rebuild.
const countryMetadata = ((metaRaw as any).countries ?? []).find((entry: any) => String(entry.code).toLowerCase() === country);
const countryData: any = {
  country_code: fallbackCountryCode,
  country_name: countryMetadata?.name_en ?? countryMetadata?.name ?? fallbackCountryCode,
  country_name_zh: countryMetadata?.name_zh,
  country_name_fr: countryMetadata?.name_fr,
};
const countrySummaryUrl = `/site-data/countries/${country}-summary.json`;
const reports: any[] = (reportIndex as any[])
  .filter(r => r.country_code?.toLowerCase() === country)
  .slice(0, 6);
const countryDownload: any = null;
const diseaseRoutes = Object.fromEntries(countryDiseaseRouteIdentities().filter(row => row.code === country).map(row => [row.slug, localeHref(`/countries/${country}/diseases/${row.slug}/`)]));
const reportCount = (reportIndex as any[]).filter(row => row.country_code?.toLowerCase() === country).length;

const countryName = countryData?.country_name_en ?? countryData?.country_name ?? fallbackCountryCode;
const countryNameZh = countryData?.country_name_zh ?? countryDownload?.name_zh ?? countryName;
const countryNameFr = countryData?.country_name_fr ?? countryDownload?.name_fr ?? localizedRegionName('fr', country, { en: countryName });
const countryBriefEn = countryData?.brief_en
  ?? `${countryName} surveillance page consolidates infectious disease records, charts, and source metadata for exploratory review.`;
const countryBriefZh = countryData?.brief_zh
  ?? `${countryNameZh}监测页面整合传染病记录、图表和来源信息，供探索性分析使用。`;
const countryBriefFr = countryData?.brief_fr
  ?? `La page de surveillance de ${countryNameFr} rassemble les données de maladies infectieuses, graphiques et informations de source pour une analyse exploratoire.`;
const countryDataUrl = `/site-data/countries/${country}.json`;
const countryMetaDescriptionEn = buildCountryMetaDescription({
  name: countryName,
  diseaseCount: countryData?.disease_count,
  start: countryData?.date_range?.start,
  end: countryData?.date_range?.end,
});
const countryMetaDescription = zh
  ? `${countryNameZh}传染病监测数据，包含最新疾病趋势、报告、官方来源与可下载数据。`
  : fr
    ? `Données de surveillance des maladies infectieuses de ${countryNameFr}, avec tendances, rapports, sources officielles et téléchargements.`
    : countryMetaDescriptionEn;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const countryPageUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const countrySourceUrls = [
  countryData?.source_info?.primary_url,
  ...(countryData?.source_info?.sources ?? []).map((source: any) => source?.url),
].filter((url): url is string => typeof url === 'string' && url.length > 0);
const countryDatasetStructuredData = buildDatasetStructuredData({
  id: `${countryPageUrl}#dataset`,
  url: countryPageUrl,
  name: zh ? `${countryNameZh}传染病监测数据集` : fr ? `Jeu de données de surveillance des maladies infectieuses — ${countryNameFr}` : `${countryName} infectious disease surveillance dataset`,
  description: countryMetaDescription,
  siteOrigin,
  dateModified: countryData?.country_brief_updated_at ?? countryDownload?.generated_at,
  start: countryData?.date_range?.start,
  end: countryData?.date_range?.end,
  spatialCoverage: zh ? countryNameZh : fr ? countryNameFr : countryName,
  keywords: zh ? [countryNameZh, '传染病监测', '公共卫生数据'] : fr ? [countryNameFr, 'surveillance des maladies infectieuses', 'données de santé publique'] : [countryName, 'infectious disease surveillance', 'public health data'],
  distributions: buildDatasetDistributions({
    entry: countryDownload,
    siteOrigin,
    fallbackSiteJsonPath: countryDataUrl,
  }),
  sourceUrls: countrySourceUrls,
  identifier: `GIDS:COUNTRY:${String(country).toUpperCase()}`,
  version: countryData?.generated_at ?? countryDownload?.generated_at,
  variableMeasured: ['reported cases', 'reported deaths', 'incidence rate'],
  includedInDataCatalog: `${siteOrigin}#catalog`,
});
const countryPlaceStructuredData = {
  '@type': 'Place',
  '@id': `${countryPageUrl}#place`,
  name: zh ? countryNameZh : fr ? countryNameFr : countryName,
};
const countryPageStructuredData = {
  '@type': 'WebPage',
  '@id': `${countryPageUrl}#country-webpage`,
  url: countryPageUrl,
  name: zh ? countryNameZh : fr ? countryNameFr : countryName,
  about: { '@id': `${countryPageUrl}#place` },
  mainEntity: { '@id': `${countryPageUrl}#dataset` },
  dateModified: countryData?.generated_at ?? countryDownload?.generated_at ?? undefined,
};
const countrySeo = {
  title: zh
    ? `${countryNameZh}传染病监测数据 ${formatYearRange(countryData?.date_range?.start, countryData?.date_range?.end)} | GIDS`
    : fr
      ? clampSeoTitle(`${countryNameFr} — données de surveillance ${formatYearRange(countryData?.date_range?.start, countryData?.date_range?.end)} | GIDS`)
    : buildSeoTitle(countryName, 'infectious disease surveillance data', formatYearRange(countryData?.date_range?.start, countryData?.date_range?.end)),
  description: countryMetaDescription,
  canonicalPath: Astro.url.pathname,
  alternatePaths: buildAlternatePaths(Astro.url.pathname, locale),
  pageType: 'WebPage',
  dateModified: countryData?.generated_at ?? countryDownload?.generated_at,
  structuredData: [countryPageStructuredData, countryPlaceStructuredData, countryDatasetStructuredData],
} as const;
const countrySourceSeriesUrl = countryDataUrl.replace(/\.json$/, '-source-series.json');
---

<ReportLayout
  title={zh ? countryNameZh : fr ? countryNameFr : countryName}
  description={countryMetaDescription}
  structuredData={[countryPageStructuredData, countryPlaceStructuredData, countryDatasetStructuredData]}
  seo={countrySeo}
  initialLanguage={locale}
  breadcrumbs={[
    { label: 'Geographic Areas', labelZh: '区域', labelFr: 'Zones géographiques', href: localeHref('/countries/') },
    { label: countryName, labelZh: countryNameZh, labelFr: countryNameFr },
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <section id="overview" class="academic-hero scroll-mt-24">
      <div class="flex flex-col gap-8 xl:flex-row xl:items-end xl:justify-between">
        <div class="space-y-4">
          <p class="academic-kicker">
            {zh ? '区域监测简报 | 传染病监测概览' : fr ? 'Brief de surveillance par zone/région | Profil des maladies infectieuses' : 'Area Surveillance Brief | Infectious disease profile'}
          </p>
          <div class="flex items-center gap-3">
            <CountryFlag
              code={countryData?.country_code ?? fallbackCountryCode}
              name={fr ? countryNameFr : countryName}
              sizeClass="w-10 h-8"
            />
            <span class="text-sm uppercase tracking-[0.18em] text-[rgb(var(--text-muted))]">{countryData?.country_code ?? fallbackCountryCode}</span>
          </div>
          <div>
            <h1 class="academic-title">
              {zh ? countryNameZh : fr ? countryNameFr : countryName}
            </h1>
          </div>
          <p class="academic-lead">
            {zh ? countryBriefZh : fr ? countryBriefFr : countryBriefEn}
          </p>
          <a
            href={localeHref(`/subscribe/?country=${encodeURIComponent(String(countryData?.country_code ?? fallbackCountryCode).toUpperCase())}`)}
            class="site-action-secondary inline-flex items-center px-4 py-2 rounded-none border text-sm font-semibold transition-all"
          >
            {zh ? '关注此区域' : fr ? 'Suivre cette zone' : 'Follow this area'}
          </a>
        </div>

        <div class="space-y-4 xl:max-w-sm">
<SurveillanceSummary client:load dataUrl={countrySummaryUrl} mode="country-coverage" language={locale} />
          {reports.length > 0 && (
            <a
              href={siteHref(localeHref(`/countries/${country}/reports/`))}
              class="site-action-secondary inline-flex items-center gap-2 px-4 py-2 rounded-none border text-sm font-semibold transition-all"
            >
              <span>{zh ? '查看报告归档' : fr ? 'Ouvrir les rapports archivés' : 'Open report archive'}</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          )}
        </div>
      </div>
    </section>

    <PageAnchorNav locale={locale} items={[
      ...(childJurisdictions.length > 0 ? [{ href: '#subnational-data', label: 'Administrative subdivisions', labelZh: '下级行政单位', labelFr: 'Subdivisions administratives' }] : []),
      { href: '#indicators', label: 'Indicators', labelZh: '核心指标', labelFr: 'Indicateurs' },
      { href: '#trends', label: 'Trends', labelZh: '趋势', labelFr: 'Tendances' },
      { href: '#disease-directory', label: 'Diseases', labelZh: '疾病目录', labelFr: 'Maladies' },
      { href: '#reports', label: 'Reports', labelZh: '报告', labelFr: 'Rapports' },
      { href: '#downloads', label: 'Sources & downloads', labelZh: '来源与下载', labelFr: 'Sources et téléchargements' },
    ]} />

    <section id="sources" class="figure-panel scroll-mt-24">
      <p class="figure-kicker">{zh ? '区域简介' : fr ? 'Brief de la zone' : 'Area Brief'}</p>
      <h2 class="figure-title">{zh ? '如何解读本区域监测画像。' : fr ? 'Comment interpréter ce profil de surveillance.' : 'How to interpret this surveillance profile.'}</h2>
      <div class="mt-4"><SurveillanceCountryContext client:load dataUrl={countrySummaryUrl} language={locale} /></div>
    </section>

    {childJurisdictions.length > 0 && (
      <section id="subnational-data" class="figure-panel scroll-mt-24">
        <p class="figure-kicker">{zh ? '分层浏览' : fr ? 'Accès hiérarchique' : 'Hierarchical access'}</p>
        <h2 class="figure-title">
          {zh ? `${countryNameZh}下级行政单位数据` : fr ? `Jeux de données des subdivisions de ${countryNameFr}` : `${countryName} subdivision datasets`}
        </h2>
        <p class="figure-caption mt-2">{zh ? '下级行政单位序列独立展示，不与上级区域序列叠加，也不进入上级区域排行和全球汇总。' : fr ? 'Les séries des subdivisions restent séparées des séries des zones parentes, des classements et des totaux mondiaux.' : 'Subdivision series remain separate from parent-area series, rankings and global totals.'}</p>
        <div class="mt-5"><SurveillanceDirectory client:visible language={locale} parentCode={fallbackCountryCode} /></div>
      </section>
    )}

    <section id="indicators" class="figure-panel scroll-mt-24">
      <h2 class="figure-title">{zh ? '核心监测指标' : fr ? 'Indicateurs clés de surveillance' : 'Key surveillance indicators'}</h2>
      <div class="mt-5"><SurveillanceSummary client:load dataUrl={countrySummaryUrl} mode="country-indicators" language={locale} reportCount={reportCount} /></div>
    </section>
    <section id="disease-directory" class="figure-panel scroll-mt-24">
      <h2 class="figure-title">{zh ? '已追踪疾病画像' : fr ? 'Profils des maladies suivies' : 'Tracked disease profiles'}</h2>
      <SurveillanceSummary client:load dataUrl={countrySummaryUrl} mode="country-diseases" language={locale} routes={diseaseRoutes} />
    </section>

    <section id="trends" class="figure-panel scroll-mt-24">
        <h2 class="figure-title">
          {zh ? '各疾病监测趋势' : fr ? 'Tendances de surveillance par maladie' : 'Surveillance trends by disease'}
        </h2>
      <div class="mt-5">
        <EpidemicCurve client:visible dataUrl={countryDataUrl} sourceSeriesUrl={countrySourceSeriesUrl} initialLanguage={locale} />
      </div>
    </section>

    <section class="figure-panel">
        <h2 class="figure-title">
          {zh ? '季节性变化' : fr ? 'Profils saisonniers' : 'Seasonal patterns'}
        </h2>
      <div class="mt-5">
        <DiseaseHeatmap client:visible dataUrl={countryDataUrl} height={600} initialLanguage={locale} />
      </div>
    </section>

    <section class="figure-panel">
        <h2 class="figure-title">
          {zh ? '疾病数据对比' : fr ? 'Comparaison des données par maladie' : 'Disease comparison'}
        </h2>
      <div class="mt-5">
        <ComparisonTable client:visible countryCode={country} dataUrl={countryDataUrl} initialLanguage={locale} />
      </div>
    </section>

    {reports.length > 0 && (
      <section id="reports" class="figure-panel scroll-mt-24">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between mb-6">
          <div>
            <h2 class="figure-title">
              {zh ? '近期监测摘要' : fr ? 'Synthèses de surveillance récentes' : 'Recent monitoring summaries'}
            </h2>
          </div>
          <a href={siteHref(localeHref(`/countries/${country}/reports/`))} class="text-sm font-semibold text-brand-500 hover:text-brand-400 transition-colors">
            <span>{zh ? '查看全部报告 →' : fr ? 'Voir tous les rapports →' : 'View all reports →'}</span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {reports.map((r: any) => (
            <ReportCard
              id={r.id}
              title={r.title}
              reportType={r.report_type}
              periodStart={r.period_start}
              periodEnd={r.period_end}
              createdAt={r.created_at}
              countryCode={r.country_code}
              countryName={zh ? (r.country_name_local ?? r.country_name) : fr ? (r.country_name_fr ?? countryNameFr) : (r.country_name_en ?? r.country_name)}
              qualityScore={r.quality_score}
              summary={r.summary}
              titleFr={r.title_fr}
              summaryFr={r.summary_fr}
              locale={locale}
            />
          ))}
        </div>
      </section>
    )}

    <div id="international" class="scroll-mt-24">
      <InternationalNoticePanel dataUrl={`/situation/by-country/${String(country).toUpperCase()}.json`} locale={locale} mapHref={`${prefix}/situation/?country=${String(country).toUpperCase()}`} />
    </div>

    <section id="downloads" class="figure-panel scroll-mt-24">
      <h2 class="figure-title">{zh ? '来源与下载' : fr ? 'Sources et téléchargements' : 'Sources and downloads'}</h2>
      <SurveillanceSummary client:load dataUrl={countrySummaryUrl} mode="downloads" language={locale} />
    </section>
  </div>
</ReportLayout>

<style>
  .country-context { margin-top: 1rem; border-top: 1px solid rgb(var(--border)); }
  .country-context summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 0; color: rgb(var(--color-teal)); cursor: pointer; font-size: .78rem; font-weight: 650; list-style: none; }
  .country-context summary::-webkit-details-marker { display: none; }
  .country-context[open] summary span:last-child { transform: rotate(45deg); }
  .subnational-browser { border-top: 1px solid rgb(var(--border)); }
  .subnational-browser summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 0; color: rgb(var(--color-teal)); cursor: pointer; font-size: .85rem; font-weight: 650; list-style: none; }
  .subnational-browser summary::-webkit-details-marker { display: none; }
  .subnational-browser[open] summary span:last-child { transform: rotate(45deg); }
  .country-context-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .65rem; padding-top: .25rem; }
  @media(max-width:1024px){.country-context-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:640px){.country-context-grid{grid-template-columns:1fr}}
</style>
