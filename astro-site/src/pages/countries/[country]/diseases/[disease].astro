---
import ReportLayout from '../../../../layouts/ReportLayout.astro';
import CountryFlag from '../../../../components/CountryFlag.astro';
import SurveillanceSummary from '../../../../components/public/SurveillanceSummary';
import EpidemicCurve from '../../../../components/charts/EpidemicCurve';
import DiseaseResearchPanel from '../../../../components/research/DiseaseResearchPanel.astro';
import InternationalNoticePanel from '../../../../components/InternationalNoticePanel.astro';
import { countryDiseaseCandidates } from '../../../../lib/seo-page-data';
import { shouldBuildPage } from '../../../../lib/page-build-plan';
import {
  buildAlternatePaths,
  buildDatasetStructuredData,
  clampSeoTitleWithSuffix,
} from '../../../../lib/seo';
import { localizedDiseaseName } from '../../../../utils/diseaseNames';
import { localizedRegionName } from '../../../../utils/i18n';

export function getStaticPaths() {
  return countryDiseaseCandidates()
    .filter(candidate => shouldBuildPage(`country-disease:${candidate.code}:${candidate.slug}`)).map(candidate => ({
    params: { country: candidate.code, disease: candidate.slug },
    props: { countryCode: candidate.code, diseaseSlug: candidate.slug, locale: 'en' },
  }));
}

interface Props {
  code?: string;
  country?: any;
  series?: any;
  slug?: string;
  countryCode?: string;
  diseaseSlug?: string;
  locale?: 'en' | 'zh' | 'fr';
}

const props = Astro.props as Props;
const code = props.countryCode ?? props.code ?? String(Astro.params.country ?? '').toLowerCase();
const slug = props.diseaseSlug ?? props.slug ?? String(Astro.params.disease ?? '');
const candidate = props.country && props.series
  ? props
  : countryDiseaseCandidates().find(item => item.code === code && item.slug === slug);
const country = candidate?.country ?? {};
const series = candidate?.series ?? {};
const locale = props.locale ?? 'en';
const zh = locale === 'zh';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const localeHref = (href: string) => `${prefix}${href}`;
const countryNameEn = country.country_name_en ?? country.country_name ?? String(code).toUpperCase();
const countryNameZh = country.country_name_zh ?? countryNameEn;
const countryNameFr = country.country_name_fr ?? localizedRegionName('fr', code, { en: countryNameEn });
const diseaseNameEn = series.disease_name_en ?? series.disease_name ?? series.name ?? slug;
const diseaseNameZh = series.disease_name_zh ?? diseaseNameEn;
const diseaseNameFr = localizedDiseaseName({ disease_id: series.disease_id ?? slug, slug, name_en: diseaseNameEn, name_zh: diseaseNameZh, name_fr: series.disease_name_fr }, 'fr');
const countryName = zh ? countryNameZh : locale === 'fr' ? countryNameFr : countryNameEn;
const diseaseName = zh ? diseaseNameZh : locale === 'fr' ? diseaseNameFr : diseaseNameEn;
const copy = (en: string, zhValue: string, frValue: string) => zh ? zhValue : locale === 'fr' ? frValue : en;
const sourceInfo = country.source_info ?? {};
const diseaseId = String(series.disease_id ?? '');
// Only notices that name both this jurisdiction and this disease belong here.
const countryDataUrl = `/site-data/countries/${String(code).toLowerCase()}.json`;
const sourceUrls = [sourceInfo.primary_url, ...(sourceInfo.sources ?? []).map((source: any) => source?.url)]
  .filter((url): url is string => typeof url === 'string' && url.length > 0);
const canonicalPath = localeHref(`/countries/${code}/diseases/${slug}/`);
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? 'https://globalinfectiousdisease.com';
const dataset = buildDatasetStructuredData({
  id: `${siteOrigin}${canonicalPath}#dataset`,
  name: copy(`${diseaseNameEn} surveillance in ${countryNameEn}`, `${countryNameZh}${diseaseNameZh}监测`, `Surveillance de ${diseaseNameFr} en ${countryNameFr}`),
  description: copy(`Official-source ${diseaseNameEn} surveillance observations for ${countryNameEn}.`, `${countryNameZh}${diseaseNameZh}官方来源监测数据。`, `Observations de surveillance de ${diseaseNameFr} provenant de sources officielles pour ${countryNameFr}.`),
  url: `${siteOrigin}${canonicalPath}`,
  siteOrigin,
  identifier: `gids:${code}:${slug}`,
  spatialCoverage: countryName,
  variableMeasured: ['cases', 'deaths', 'incidence rate'],
  includedInDataCatalog: `${siteOrigin}#catalog`,
  distributions: country.download_url ? [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: country.download_url }] : undefined,
  sourceUrls,
});
const seo = {
  title: copy(`${diseaseNameEn} surveillance in ${countryNameEn} | GIDS`, `${countryNameZh}${diseaseNameZh}监测 | GIDS`, clampSeoTitleWithSuffix(`Surveillance de ${diseaseNameFr}`, `en ${countryNameFr} | GIDS`)),
  description: copy(`${diseaseNameEn} surveillance in ${countryNameEn}: latest published observations, official sources and downloadable data.`, `${countryNameZh}${diseaseNameZh}监测：最新已发布观测、官方来源与可下载数据。`, `Surveillance de ${diseaseNameFr} en ${countryNameFr} : observations publiées, sources officielles et données téléchargeables.`),
  locale,
  canonicalPath,
  alternatePaths: buildAlternatePaths(canonicalPath, locale),
  structuredData: dataset,
};
---

<ReportLayout title={seo.title} description={seo.description} initialLanguage={locale} seo={seo} structuredData={dataset} breadcrumbs={[
  { label: 'Geographic areas', labelZh: '区域', labelFr: 'Zones géographiques', href: localeHref('/countries/') },
  { label: countryNameEn, labelZh: countryNameZh, labelFr: countryNameFr, href: localeHref(`/countries/${code}/`) },
  { label: diseaseNameEn, labelZh: diseaseNameZh, labelFr: diseaseNameFr },
]}>
  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="academic-hero">
      <div class="flex items-center gap-3"><CountryFlag code={String(code)} name={countryName} sizeClass="h-8 w-11" /><span class="academic-kicker">{copy('Area disease surveillance profile', '区域疾病监测画像', 'Profil de surveillance par zone et maladie')}</span></div>
      <h1 class="academic-title mt-4">{copy(`${diseaseName} surveillance in ${countryName}`, `${countryName}${diseaseName}监测`, `Surveillance de ${diseaseName} en ${countryName}`)}</h1>
      <p class="academic-lead">{copy('Official-source observations, coverage details, trend context, and a direct route to the underlying area dataset.', '汇总官方来源观测、覆盖范围、趋势解释以及底层区域数据入口。', 'Observations officielles, couverture, contexte des tendances et accès direct au jeu de données national sous-jacent.')}</p>
      <SurveillanceSummary client:load dataUrl={`/site-data/countries/${code}-summary.json`} mode="country-disease-indicators" diseaseId={diseaseId} language={locale} />
    </header>
    <section class="mt-6 grid gap-6 lg:grid-cols-2">
      <div class="figure-panel">
        <h2 class="figure-title">{copy('Data and limitations', '数据与限制', 'Données et limites')}</h2>
        <p class="figure-caption mt-3">{copy('Values are surveillance reports, not estimates of true disease burden. Reporting practices, case definitions, completeness, and publication timing can change over time.', '这些数值是监测报告，不是真实疾病负担估计。报告实践、病例定义、完整性和发布时间可能随时间变化。', 'Ces valeurs sont des déclarations de surveillance et non des estimations de la charge réelle de la maladie. Les pratiques de déclaration, définitions de cas, complétude et délais de publication peuvent évoluer.')}</p>
        <a class="mt-4 inline-flex font-semibold text-brand-500 hover:underline" href={localeHref(`/countries/${code}/`)}>{copy(`Open the ${countryName} dataset →`, `打开${countryName}数据集 →`, `Ouvrir le jeu de données de ${countryName} →`)}</a>
      </div>
      <div class="figure-panel">
        <h2 class="figure-title">{copy('Official sources', '官方来源', 'Sources officielles')}</h2>
        <div class="mt-3"><SurveillanceSummary client:load dataUrl={`/site-data/countries/${code}-summary.json`} mode="sources" language={locale} /></div>
        <a class="mt-4 inline-flex font-semibold text-brand-500 hover:underline" href={localeHref(`/diseases/${slug}/`)}>{copy(`View global ${diseaseName} profile →`, `查看全球${diseaseName}画像 →`, `Voir le profil mondial de ${diseaseName} →`)}</a>
      </div>
    </section>
    <section
      id="trends"
      class="figure-panel mt-6 scroll-mt-24"
      data-disease-names={JSON.stringify({ en: diseaseNameEn, zh: diseaseNameZh, fr: diseaseNameFr })}
    >
      <h2 class="figure-title">{copy('Surveillance trend', '监测趋势', 'Tendance de surveillance')}</h2>
      <p class="figure-caption mt-2">{copy('This chart opens with this disease selected for this area. Reporting periods and source differences remain visible in the chart controls.', '图表已预选此区域和疾病；报告周期与来源差异会在图表中保留。', 'Le graphique est préconfiguré pour cette maladie et cette zone. Les périodes et différences de source restent indiquées.')}</p>
      <div class="mt-5">
        <EpidemicCurve
          client:visible
          dataUrl={countryDataUrl}
          sourceSeriesUrl={`/site-data/countries/${String(code).toLowerCase()}-source-series.json`}
          entityIds={diseaseId ? [diseaseId] : undefined}
          initialSelectionIds={diseaseId ? [`${encodeURIComponent(diseaseId)}::published`] : undefined}
          initialLanguage={locale}
        />
      </div>
    </section>
    <div class="mt-6" id="research"><DiseaseResearchPanel diseaseId={diseaseId || slug} locale={locale} /></div>
    <div class="mt-6" id="international">
      <InternationalNoticePanel dataUrl={`/situation/by-country/${String(code).toUpperCase()}.json`} diseaseId={diseaseId} locale={locale} mapHref={diseaseId ? `${prefix}/situation/?country=${String(code).toUpperCase()}&disease=${encodeURIComponent(diseaseId)}` : `${prefix}/situation/?country=${String(code).toUpperCase()}`} />
    </div>
    <section id="downloads" class="figure-panel mt-6 scroll-mt-24">
      <h2 class="figure-title">{copy('Sources and downloads', '来源与下载', 'Sources et téléchargements')}</h2>
      <SurveillanceSummary client:load dataUrl={`/site-data/countries/${code}-summary.json`} mode="downloads" language={locale} />
    </section>
  </article>
</ReportLayout>
