---
import ReportLayout from '../../../../layouts/ReportLayout.astro';
import CountryFlag from '../../../../components/CountryFlag.astro';
import { countryDiseaseCandidates } from '../../../../lib/seo-page-data';
import {
  buildAlternatePaths,
  buildDatasetStructuredData,
  buildSeoTitle,
  formatYearRange,
} from '../../../../lib/seo';

export function getStaticPaths() {
  return countryDiseaseCandidates().map(candidate => ({
    params: { country: candidate.code, disease: candidate.slug },
    props: { ...candidate, countryCode: candidate.code, diseaseSlug: candidate.slug, locale: 'en' },
  }));
}

interface Props {
  code?: string;
  country?: any;
  series?: any;
  slug?: string;
  countryCode?: string;
  diseaseSlug?: string;
  locale?: 'en' | 'zh';
}

const props = Astro.props as Props;
const code = props.countryCode ?? props.code ?? String(Astro.params.country ?? '').toLowerCase();
const slug = props.diseaseSlug ?? props.slug ?? String(Astro.params.disease ?? '');
const candidate = props.country && props.series
  ? props
  : countryDiseaseCandidates().find(item => item.code === code && item.slug === slug);
const country = candidate?.country ?? {};
const series = candidate?.series ?? {};
const locale = props.locale ?? 'en';
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const localeHref = (href: string) => `${prefix}${href}`;
const countryNameEn = country.country_name_en ?? country.country_name ?? String(code).toUpperCase();
const countryNameZh = country.country_name_zh ?? countryNameEn;
const diseaseNameEn = series.disease_name_en ?? series.disease_name ?? series.name ?? slug;
const diseaseNameZh = series.disease_name_zh ?? diseaseNameEn;
const countryName = zh ? countryNameZh : countryNameEn;
const diseaseName = zh ? diseaseNameZh : diseaseNameEn;
const dates = Array.isArray(series.dates) ? series.dates : [];
const cases = Array.isArray(series.cases) ? series.cases : [];
const coverage = formatYearRange(dates[0], dates.at(-1));
const latestCases = Number(cases.at(-1));
const sourceInfo = country.source_info ?? {};
const sourceUrls = [sourceInfo.primary_url, ...(sourceInfo.sources ?? []).map((source: any) => source?.url)]
  .filter((url): url is string => typeof url === 'string' && url.length > 0);
const canonicalPath = localeHref(`/countries/${code}/diseases/${slug}/`);
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? 'https://globalinfectiousdisease.com';
const dataset = buildDatasetStructuredData({
  id: `${siteOrigin}${canonicalPath}#dataset`,
  name: zh ? `${countryNameZh}${diseaseNameZh}监测` : `${diseaseNameEn} surveillance in ${countryNameEn}`,
  description: zh ? `${countryNameZh}${diseaseNameZh}官方来源监测数据，覆盖${coverage}。` : `Official-source ${diseaseNameEn} surveillance observations for ${countryNameEn}, covering ${coverage}.`,
  url: `${siteOrigin}${canonicalPath}`,
  siteOrigin,
  identifier: `gids:${code}:${slug}`,
  version: country.generated_at ?? undefined,
  start: dates[0],
  end: dates.at(-1),
  spatialCoverage: countryName,
  variableMeasured: ['cases', 'deaths', 'incidence rate'],
  includedInDataCatalog: `${siteOrigin}#catalog`,
  dateModified: country.generated_at,
  distributions: country.download_url ? [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: country.download_url }] : undefined,
  sourceUrls,
});
const seo = {
  title: zh ? `${countryNameZh}${diseaseNameZh}监测 ${coverage} | GIDS` : buildSeoTitle(diseaseNameEn, `surveillance in ${countryNameEn}`, coverage),
  description: zh ? `${countryNameZh}${diseaseNameZh}监测数据，覆盖${coverage}，包含最新报告值、官方来源、趋势背景和数据入口。` : `${diseaseNameEn} surveillance in ${countryNameEn}: ${coverage} coverage, latest reported value${Number.isFinite(latestCases) ? ` ${latestCases.toLocaleString()} cases` : ''}, official sources, trend context, and downloadable data.`,
  locale,
  canonicalPath,
  alternatePaths: buildAlternatePaths(canonicalPath, locale),
  dateModified: country.generated_at,
  structuredData: dataset,
};
---

<ReportLayout title={seo.title} description={seo.description} initialLanguage={locale} seo={seo} structuredData={dataset} breadcrumbs={[
  { label: 'Countries', labelZh: '国家/地区', href: localeHref('/countries/') },
  { label: countryNameEn, labelZh: countryNameZh, href: localeHref(`/countries/${code}/`) },
  { label: diseaseNameEn, labelZh: diseaseNameZh },
]}>
  <article class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
    <header class="academic-hero">
      <div class="flex items-center gap-3"><CountryFlag code={String(code)} name={countryName} sizeClass="h-8 w-11" /><span class="academic-kicker">{zh ? '国家疾病监测画像' : 'Country disease surveillance profile'}</span></div>
      <h1 class="academic-title mt-4">{zh ? `${countryName}${diseaseName}监测` : `${diseaseName} surveillance in ${countryName}`}</h1>
      <p class="academic-lead">{zh ? '汇总官方来源观测、覆盖范围、趋势解释以及底层国家数据入口。' : 'Official-source observations, coverage details, trend context, and a direct route to the underlying country dataset.'}</p>
      <dl class="academic-meta-grid mt-6">
        <div class="academic-meta-item"><dt class="academic-meta-label">{zh ? '覆盖区间' : 'Coverage'}</dt><dd class="academic-meta-value text-sm">{coverage}</dd></div>
        <div class="academic-meta-item"><dt class="academic-meta-label">{zh ? '报告粒度' : 'Reporting granularity'}</dt><dd class="academic-meta-value text-sm">{series.period_granularity ?? (zh ? '未说明' : 'Not specified')}</dd></div>
        <div class="academic-meta-item"><dt class="academic-meta-label">{zh ? '最新报告值' : 'Latest reported value'}</dt><dd class="academic-meta-value">{Number.isFinite(latestCases) ? latestCases.toLocaleString() : (zh ? '暂无' : 'Not available')}</dd></div>
      </dl>
    </header>
    <section class="mt-6 grid gap-6 lg:grid-cols-2">
      <div class="figure-panel">
        <h2 class="figure-title">{zh ? '数据与限制' : 'Data and limitations'}</h2>
        <p class="figure-caption mt-3">{zh ? '这些数值是监测报告，不是真实疾病负担估计。报告实践、病例定义、完整性和发布时间可能随时间变化。' : 'Values are surveillance reports, not estimates of true disease burden. Reporting practices, case definitions, completeness, and publication timing can change over time.'}</p>
        <a class="mt-4 inline-flex font-semibold text-brand-500 hover:underline" href={localeHref(`/countries/${code}/`)}>{zh ? `打开${countryName}数据集 →` : `Open the ${countryName} dataset →`}</a>
      </div>
      <div class="figure-panel">
        <h2 class="figure-title">{zh ? '官方来源' : 'Official sources'}</h2>
        {sourceUrls.length ? <ul class="mt-3 list-disc space-y-2 pl-5 text-sky-700">
          {sourceUrls.slice(0, 4).map((url) => <li><a href={url} rel="nofollow noopener" target="_blank" class="hover:underline">{url}</a></li>)}
        </ul> : <p class="mt-3 text-[rgb(var(--text-muted))]">{zh ? '来源 URL 已记录在国家数据集中。' : 'Source URL is recorded in the country dataset.'}</p>}
        <a class="mt-4 inline-flex font-semibold text-brand-500 hover:underline" href={localeHref(`/diseases/${slug}/`)}>{zh ? `查看全球${diseaseName}画像 →` : `View global ${diseaseName} profile →`}</a>
      </div>
    </section>
  </article>
</ReportLayout>
