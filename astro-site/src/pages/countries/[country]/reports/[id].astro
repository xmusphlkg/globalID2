---
import ReportLayout from '../../../../layouts/ReportLayout.astro';
import DownloadPanel from '../../../../components/DownloadPanel.astro';
import ReportV4Panel from '../../../../components/charts/ReportV4Panel';
import {
  isReportV4,
  reportsForCountry,
} from '../../../../lib/report-routes';
import {
  loadReportDetail,
  readPublishableReports,
} from '../../../../lib/report-data';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import { buildAlternatePaths, buildSeoTitle } from '../../../../lib/seo';

export async function getStaticPaths() {
  return readPublishableReports().map(report => ({
    params: {
      country: report.country,
      id: report.id,
    },
  }));
}

const { country, id } = Astro.params;
const downloadsPath = resolve('./src/data/downloads.json');
const countryDataPath = resolve(`./src/data/countries/${country}.json`);

let report: any = null;
let countryDownload: any = null;
let prevReport: any = null;
let nextReport: any = null;
let countryData: any = null;

const loadedReport = typeof id === 'string' ? loadReportDetail(id) : null;
report = isReportV4(loadedReport) ? loadedReport : null;

if (existsSync(countryDataPath)) {
  countryData = JSON.parse(readFileSync(countryDataPath, 'utf-8'));
}

if (existsSync(downloadsPath)) {
  const downloads = JSON.parse(readFileSync(downloadsPath, 'utf-8')) as any;
  countryDownload = (downloads.countries ?? []).find(
    (entry: any) => entry.code?.toLowerCase() === country
  ) ?? null;
}

{
  const allReports = (reportsForCountry(readPublishableReports(), country) as any[])
    .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime());
  const idx = allReports.findIndex(r => String(r.id) === id);
  if (idx > 0) prevReport = allReports[idx - 1];
  if (idx >= 0 && idx < allReports.length - 1) nextReport = allReports[idx + 1];
}

const document = report?.report_document_v4 ?? report?.metadata?.report_document_v4 ?? report;
const reportLanguage = 'en';
const countryNameEn = report?.country_name_en ?? report?.country_name ?? country?.toUpperCase();
const countryNameZh = report?.country_name_local ?? report?.country_name ?? countryNameEn;
const reportTitleEn = document?.title?.en ?? report?.title ?? `Report #${id}`;
const reportTitleZh = document?.title?.zh ?? report?.title ?? `报告 #${id}`;
const reportSummary = document?.summary?.zh ?? report?.summary ?? '';
const reportSummaryEn = document?.summary?.en ?? report?.summary ?? '';
const reportCoverage = report?.period_start && report?.period_end
  ? `${String(report.period_start).slice(0, 7)}–${String(report.period_end).slice(0, 7)}`
  : '';
const canonicalPath = `/countries/${country}/reports/${id}/`;
const reportSeo = {
  title: buildSeoTitle(countryNameEn, 'weekly infectious disease surveillance report', reportCoverage),
  description: `${countryNameEn} infectious disease surveillance report${reportCoverage ? ` for ${reportCoverage}` : ''}. Includes reporting period, summary, disease signals, official-source data, and downloads.`,
  canonicalPath,
  alternatePaths: buildAlternatePaths(canonicalPath, 'en'),
  pageType: 'MedicalWebPage',
  datePublished: report?.created_at,
  dateModified: report?.created_at,
};
const reportStructuredData = {
  '@type': 'Report',
  '@id': `${canonicalPath}#report`,
  name: reportTitleEn,
  inLanguage: 'en',
  datePublished: report?.created_at,
  dateModified: report?.created_at,
  temporalCoverage: report?.period_start && report?.period_end ? `${report.period_start}/${report.period_end}` : undefined,
  spatialCoverage: { '@type': 'Place', name: countryNameEn },
  isBasedOn: countryData?.source_info?.primary_url,
};
const scoreColor = !report?.quality_score ? 'text-slate-500'
  : report.quality_score >= 0.85 ? 'text-green-400'
  : report.quality_score >= 0.65 ? 'text-amber-400'
  : 'text-red-400';
const countryDataUrl = countryDownload?.site_json_path ?? `/site-data/countries/${country}.json`;

function numericList(value: any): number[] {
  return Array.isArray(value)
    ? value.map((item: any) => Number(item || 0)).filter((item: number) => Number.isFinite(item))
    : [];
}

function preferredCaseValues(entry: any): number[] {
  return numericList(entry?.cases);
}

function aggregateTrend(entry: any, period: 'month' | 'year', limit: number): number[] {
  const dates = Array.isArray(entry?.dates) ? entry.dates : [];
  const values = preferredCaseValues(entry);
  if (dates.length === 0 || values.length === 0) return [];

  const buckets = new Map<string, number>();
  dates.forEach((date: string, index: number) => {
    const key = String(date || '').slice(0, period === 'month' ? 7 : 4);
    if ((period === 'month' && key.length !== 7) || (period === 'year' && key.length !== 4)) return;
    buckets.set(key, (buckets.get(key) || 0) + Number(values[index] || 0));
  });

  return [...buckets.entries()]
    .sort(([left], [right]) => left.localeCompare(right))
    .map(([, value]) => value)
    .slice(-limit);
}

function latestYear(entry: any): string | null {
  const dates = Array.isArray(entry?.dates) ? entry.dates : [];
  const latest = dates.at(-1);
  const year = String(latest || '').slice(0, 4);
  return year.length === 4 ? year : null;
}

function currentYearCumulativeCases(entry: any): number | null {
  const year = latestYear(entry);
  const dates = Array.isArray(entry?.dates) ? entry.dates : [];
  const values = preferredCaseValues(entry);
  if (!year || dates.length === 0 || values.length === 0) return null;
  const total = dates.reduce((sum: number, date: string, index: number) => (
    String(date || '').startsWith(year) ? sum + Number(values[index] || 0) : sum
  ), 0);
  return Number.isFinite(total) ? total : null;
}

const directoryTrendSeries = Object.fromEntries(
  (document?.disease_directory ?? []).map((row: any) => {
    const entry = countryData?.disease_series?.[row.disease_id];
    const weekly = Array.isArray(entry?.weekly_equiv_cases) ? entry.weekly_equiv_cases.slice(-24) : [];
    const cases = Array.isArray(entry?.cases) ? entry.cases.slice(-24) : [];
    const currentYear = latestYear(entry);
    return [
      row.disease_id,
      {
        weekly_equiv_cases: weekly,
        cases,
        monthly_cases: aggregateTrend(entry, 'month', 12),
        annual_cases: aggregateTrend(entry, 'year', 10),
        current_year: currentYear,
        current_year_cumulative_cases: currentYearCumulativeCases(entry),
      },
    ];
  }).filter(([diseaseId]: [string, any]) => !!diseaseId)
);

function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

function reportTypeLabel(value: string | undefined, lang: 'zh' | 'en') {
  const key = String(value ?? '').toUpperCase();
  const labels: Record<string, { zh: string; en: string }> = {
    DAILY: { zh: '日报', en: 'Daily report' },
    WEEKLY: { zh: '周报', en: 'Weekly report' },
    MONTHLY: { zh: '月报', en: 'Monthly report' },
    QUARTERLY: { zh: '季报', en: 'Quarterly report' },
    ANNUAL: { zh: '年报', en: 'Annual report' },
  };
  return labels[key]?.[lang] ?? (lang === 'zh' ? '报告' : 'Report');
}
---

<ReportLayout
  title={reportSeo.title}
  description={reportSeo.description}
  initialLanguage={reportLanguage}
  seo={reportSeo}
  structuredData={reportStructuredData}
  breadcrumbs={[
    { label: 'Countries', labelZh: '国家/地区', href: '/countries/' },
    { label: countryNameEn, labelZh: countryNameZh, href: `/countries/${country}/` },
    { label: 'Reports', labelZh: '报告', href: `/countries/${country}/reports/` },
    { label: `#${id}` },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    {!report ? (
      <div class="text-center py-24 text-slate-500">
        <span data-lang-en={`Report #${id} is not available.`} data-lang-zh={`报告 #${id} 暂不可用。`}>报告 #{id} 暂不可用。</span>
        <a href={`/countries/${country}/reports/`} class="text-brand-400 hover:underline ml-2" data-lang-en="← Back to reports" data-lang-zh="← 返回报告列表">← 返回报告列表</a>
      </div>
    ) : (
      <>
        <section class="academic-hero">
          <div class="flex items-start justify-between flex-wrap gap-4 mb-6">
            <div>
              <p class="academic-kicker mb-3" data-lang-en="Decision brief" data-lang-zh="决策简报">决策简报</p>
              <div class="flex items-center gap-3 mb-3 flex-wrap">
                <span class="text-xs font-semibold px-2.5 py-1 rounded-none bg-brand-500/15 text-brand-300 ring-1 ring-brand-500/30">
                  <span data-lang-en={reportTypeLabel(report.report_type, 'en')} data-lang-zh={reportTypeLabel(report.report_type, 'zh')}>
                    {reportTypeLabel(report.report_type, 'zh')}
                  </span>
                </span>
                <span class="text-sm text-slate-500" data-lang-en={countryNameEn} data-lang-zh={countryNameZh}>{countryNameZh}</span>
                <span class="text-xs text-slate-600" data-lang-en="Version 4" data-lang-zh="第四版">第四版</span>
              </div>
              <h1 class="academic-title text-3xl sm:text-4xl leading-tight" data-lang-en={reportTitleEn} data-lang-zh={reportTitleZh}>
                {reportTitleEn}
              </h1>
            </div>
            {report.quality_score != null && (
              <div class="text-center">
                <div class={`font-serif text-3xl font-semibold ${scoreColor}`}>
                  {(report.quality_score * 100).toFixed(0)}%
                </div>
                <div class="text-xs text-slate-600 mt-1" data-lang-en="Data confidence" data-lang-zh="数据置信度">数据置信度</div>
              </div>
            )}
          </div>

          <div class="academic-meta-grid text-sm">
            {report.period_start && (
              <div class="academic-meta-item">
                <div class="academic-meta-label" data-lang-en="Reporting window" data-lang-zh="报告周期">报告周期</div>
                <div class="academic-meta-value text-sm font-medium">{fmtDate(report.period_start)} → {fmtDate(report.period_end)}</div>
              </div>
            )}
            {report.created_at && (
              <div class="academic-meta-item">
                <div class="academic-meta-label" data-lang-en="Generated" data-lang-zh="生成时间">生成时间</div>
                <div class="academic-meta-value text-sm font-medium">{fmtDate(report.created_at)}</div>
              </div>
            )}
            <div class="academic-meta-item">
              <div class="academic-meta-label" data-lang-en="Country" data-lang-zh="国家/地区">国家/地区</div>
              <div class="academic-meta-value text-sm font-medium" data-lang-en={countryNameEn} data-lang-zh={countryNameZh}>{countryNameZh}</div>
            </div>
            <div class="academic-meta-item">
              <div class="academic-meta-label" data-lang-en="Signals reviewed" data-lang-zh="研判信号">研判信号</div>
              <div class="academic-meta-value font-serif">{document?.metrics?.disease_count ?? document?.sections?.length ?? 0}</div>
            </div>
          </div>
        </section>

        {reportSummary && (
          <section class="figure-panel">
            <p class="figure-kicker" data-lang-en="Executive summary" data-lang-zh="执行摘要">执行摘要</p>
            <h2 class="figure-title" data-lang-en="Current Situation" data-lang-zh="当前态势">当前态势</h2>
            <p class="mt-5 text-sm leading-7 text-slate-400" data-lang-en={document?.summary?.en ?? reportSummary} data-lang-zh={reportSummary}>
              {reportSummaryEn}
            </p>
          </section>
        )}

        <ReportV4Panel
          client:visible
          report={report}
          countryDataUrl={countryDataUrl}
          sparklineSeries={directoryTrendSeries}
        />

        <div class="flex items-center justify-between pt-6 border-t border-slate-800">
          {prevReport ? (
            <a href={`/countries/${country}/reports/${prevReport.id}/`} class="flex items-center gap-2 text-sm text-slate-400 hover:text-brand-400 transition-colors group">
              <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              <span class="max-w-[200px] truncate">{prevReport.title}</span>
            </a>
          ) : <span />}

          {nextReport ? (
            <a href={`/countries/${country}/reports/${nextReport.id}/`} class="flex items-center gap-2 text-sm text-slate-400 hover:text-brand-400 transition-colors group text-right">
              <span class="max-w-[200px] truncate">{nextReport.title}</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          ) : <span />}
        </div>

        {countryDownload && (
          <DownloadPanel
            entry={{ ...countryDownload, source_info: countryData?.source_info }}
            title="Download Underlying Dataset"
            initialLanguage="en"
            descriptionEn="Download the country dataset used to generate this report, including source metadata."
            descriptionZh="下载生成本报告所依据的国家数据集，并附带数据源信息。"
          />
        )}
      </>
    )}
  </div>
</ReportLayout>
