---
// src/pages/countries/index.astro — Country coverage map
import ReportLayout from '../../layouts/ReportLayout.astro';
import CountryCard from '../../components/CountryCard.astro';
import CountryFlag from '../../components/CountryFlag.astro';
import CountriesMapView from '../../components/charts/CountriesMapView';
import {
  COUNTRY_COVERAGE,
  resolveCoverageStatus,
  type CountryCoverageItem,
} from '../../lib/country-coverage';
import metaRaw from '../../data/meta.json';

const meta = metaRaw as any;
const supportedCountries = (meta.countries ?? []) as Array<{
  code: string; name: string; name_en?: string; name_zh?: string; language: string;
  total_cases: number; total_deaths: number; disease_count: number;
  date_range: { start: string | null; end: string | null };
}>;

const metaByCode = Object.fromEntries(
  supportedCountries.map(c => [c.code.toUpperCase(), c])
) as Record<string, typeof supportedCountries[0]>;

const coverageByCode = Object.fromEntries(
  COUNTRY_COVERAGE.map(c => [c.code.toUpperCase(), c])
);

const CARD_COUNTRIES: CountryCoverageItem[] = [
  ...COUNTRY_COVERAGE,
  ...supportedCountries
    .filter(c => !coverageByCode[c.code.toUpperCase()])
    .map(c => ({
      code: c.code.toUpperCase(),
      name_en: c.name_en ?? c.name,
      name_zh: c.name_zh ?? c.name,
      lat: 0,
      lng: 0,
      status: 'Supported' as const,
      labelOffset: [80, -30] as [number, number],
    })),
];

const ORDERED_COUNTRIES = [...CARD_COUNTRIES].sort((a, b) => {
  const aSupported = resolveCoverageStatus(a, Boolean(metaByCode[a.code])) === 'Supported';
  const bSupported = resolveCoverageStatus(b, Boolean(metaByCode[b.code])) === 'Supported';
  if (aSupported === bSupported) return 0;
  return aSupported ? -1 : 1;
});

const scheduledCount = ORDERED_COUNTRIES.filter(
  c => resolveCoverageStatus(c, Boolean(metaByCode[c.code])) === 'Scheduled'
).length;

const CADENCE_ZH: Record<string, string> = {
  Weekly: '每周',
  Monthly: '每月',
  Daily: '每日',
  Weekdays: '工作日',
  Periodic: '定期',
  Annual: '每年',
  'Current aggregate': '当前汇总',
  Mixed: '混合频率',
  'To be confirmed': '待确认',
};

const TRACK_ZH: Record<string, string> = {
  'National source': '国家级来源',
  'Regional baseline': 'ECDC 基线',
  'Source research': '来源调研',
};

---

<ReportLayout
  title="Countries and Regions"
  description="Browse countries and regions with available infectious disease surveillance data."
  breadcrumbs={[{ label: 'Countries', labelZh: '国家' }]}
>
  <div class="coverage-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <section class="card coverage-surface p-6 sm:p-8">
      <div class="coverage-section-header flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <h2 class="coverage-section-title"
              data-lang-en="Data Coverage"
              data-lang-zh="数据覆盖国家/地区">
            Data Coverage
          </h2>

        </div>

        <div class="coverage-legend">
          <span class="coverage-legend-item">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-teal-500"></span>
            <span data-lang-en="Supported" data-lang-zh="已支持">Supported</span>
          </span>
          <span class="coverage-legend-item">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-slate-500"></span>
            <span data-lang-en="Scheduled" data-lang-zh="规划中">Scheduled</span>
          </span>
        </div>
      </div>

      <div class="coverage-map-frame">
        <CountriesMapView
          client:only="react"
          metaCountries={supportedCountries}
          height={520}
        />
      </div>
      <p
        class="coverage-map-note"
        data-lang-en="Countries and regions with available data are shown on the map. Select a card below to view sources and coverage."
        data-lang-zh="地图展示当前可用数据的国家和地区；选择下方卡片可查看来源与覆盖范围。"
      >
        Countries and regions with available data are shown on the map. Select a card below to view sources and coverage.
      </p>
    </section>

    <section class="card coverage-surface p-6 sm:p-8">
      <div class="coverage-section-header flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="coverage-section-title"
              data-lang-en="Countries"
              data-lang-zh="国家/地区">Countries and regions</h2>
        </div>
        <span class="coverage-summary-pill">
          <span
            data-lang-en={`${supportedCountries.length} active · ${scheduledCount} scheduled`}
            data-lang-zh={`${supportedCountries.length} 个已支持 · ${scheduledCount} 个规划中`}
          >
            {supportedCountries.length} active · {scheduledCount} scheduled
          </span>
        </span>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {ORDERED_COUNTRIES.map((c) => {
          const m = metaByCode[c.code];
          const status = resolveCoverageStatus(c, Boolean(m));
          const cadenceZh = c.cadence ? CADENCE_ZH[c.cadence] ?? c.cadence : '';
          const trackZh = c.onboarding_track ? TRACK_ZH[c.onboarding_track] ?? c.onboarding_track : '';
          if (m) {
            return (
              <CountryCard
                code={m.code}
                name={m.name_en ?? m.name}
                nameZh={m.name_zh ?? c.name_zh}
                totalCases={m.total_cases}
                totalDeaths={m.total_deaths}
                diseaseCount={m.disease_count}
                dateRange={m.date_range}
              />
            );
          }

          if (status === 'Supported') {
            return (
              <CountryCard
                code={c.code}
                name={c.name_en}
                nameZh={c.name_zh}
                totalCases={0}
                totalDeaths={0}
                diseaseCount={0}
              />
            );
          }

          return (
            <div class="coverage-scheduled-card rounded-none border p-5 transition-all">
              <div class="flex items-start justify-between mb-4">
                <div class="flex items-center gap-3">
                  <CountryFlag code={c.code} name={c.name_en} sizeClass="w-9 h-7" />
                  <div>
                    <h3
                      class="text-[rgb(var(--text-strong))] font-semibold text-base"
                      data-lang-en={c.name_en}
                      data-lang-zh={c.name_zh}
                    >
                      {c.name_en}
                    </h3>
                    <span class="text-[rgb(var(--text-faint))] text-xs font-mono tracking-[0.12em] uppercase">{c.code}</span>
                  </div>
                </div>
                <span class="coverage-scheduled-pill" data-lang-en="Planned" data-lang-zh="规划中">Planned</span>
              </div>

              <div class="coverage-source-meta">
                {c.onboarding_track && (
                  <span
                    class="coverage-source-track"
                    data-lang-en={c.onboarding_track}
                    data-lang-zh={trackZh}
                  >
                    {c.onboarding_track}
                  </span>
                )}
                {c.cadence && (
                  <span
                    class="coverage-source-cadence"
                    data-lang-en={`Update: ${c.cadence}`}
                    data-lang-zh={`更新：${cadenceZh}`}
                  >
                    Update: {c.cadence}
                  </span>
                )}
              </div>

              {c.source_url ? (
                <a
                  class="coverage-source-link"
                  href={c.source_url}
                  target="_blank"
                  rel="noreferrer"
                  aria-label={`${c.name_en} official surveillance source`}
                >
                  <span class="coverage-source-link-label" data-lang-en="Official source" data-lang-zh="官方数据源">
                    Official source
                  </span>
                  <span class="coverage-source-name">{c.source_name}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <p
                  class="coverage-source-pending"
                  data-lang-en="Source assessment in progress."
                  data-lang-zh="数据源评估中。"
                >
                  Source assessment in progress.
                </p>
              )}
            </div>
          );
        })}
      </div>
    </section>
  </div>
</ReportLayout>

<style>
.coverage-surface {
  position: relative;
  overflow: hidden;
}


.coverage-kicker {
  color: rgb(var(--text-faint));
  letter-spacing: 0.18em;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

.coverage-title {
  color: rgb(var(--text-strong));
  font-family: 'Source Serif 4', serif;
  font-size: clamp(2rem, 2.8vw, 3rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.08;
}

.coverage-lead {
  max-width: 48rem;
  color: rgb(var(--text));
  font-size: 1rem;
  line-height: 1.85;
}

.coverage-meta-grid {
  display: grid;
  gap: 0.9rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.coverage-meta-card {
  border: 1px solid rgb(var(--border) / 0.72);
  background: rgb(var(--surface) / 0.84);
  padding: 1rem 1rem 1.1rem;
}

.coverage-meta-label {
  color: rgb(var(--text-faint));
  letter-spacing: 0.14em;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

.coverage-meta-value {
  margin-top: 0.55rem;
  color: rgb(var(--text-strong));
  font-family: 'Source Serif 4', serif;
  font-size: 1.9rem;
  font-weight: 600;
  line-height: 1;
}

.coverage-section-header {
  position: relative;
  margin-bottom: 1.4rem;
  padding-left: 1rem;
}

.coverage-section-header::before {
  content: "";
  position: absolute;
  inset: 0.15rem auto 0.15rem 0;
  width: 3px;
  background: linear-gradient(180deg, rgb(var(--color-brand) / 0.82), rgb(var(--color-accent) / 0.56));
}

.coverage-section-title {
  color: rgb(var(--text-strong));
  font-family: 'Source Serif 4', serif;
  font-size: clamp(1.55rem, 2vw, 2.15rem);
  font-weight: 600;
  letter-spacing: -0.02em;
}

.coverage-section-lead {
  margin-top: 0.7rem;
  max-width: 48rem;
  color: rgb(var(--text-muted));
  font-size: 0.96rem;
  line-height: 1.75;
}

.coverage-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.coverage-legend-item {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  border: 1px solid rgb(var(--border) / 0.72);
  background: rgb(var(--surface) / 0.88);
  padding: 0.55rem 0.85rem;
  color: rgb(var(--text));
  font-size: 0.8rem;
  font-weight: 600;
}

.coverage-map-frame {
  border: 1px solid rgb(var(--border) / 0.78);
  background: linear-gradient(180deg, rgb(var(--bg-soft) / 0.72), rgb(var(--surface) / 0.86));
  padding: 1rem;
}

.coverage-map-note {
  margin-top: 0.8rem;
  color: rgb(var(--text-faint));
  font-size: 0.78rem;
  line-height: 1.6;
}

.coverage-summary-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgb(var(--border) / 0.78);
  background: rgb(var(--surface) / 0.86);
  padding: 0.7rem 0.95rem;
  color: rgb(var(--text));
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.coverage-scheduled-card {
  border-style: dashed;
  border-color: rgb(var(--border-soft));
  background: linear-gradient(180deg, rgb(var(--bg-soft) / 0.56), rgb(var(--surface) / 0.76));
}

.coverage-scheduled-pill {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgb(var(--border-soft) / 0.78);
  background: rgb(var(--surface) / 0.82);
  padding: 0.28rem 0.55rem;
  color: rgb(var(--text-faint));
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.coverage-source-meta {
  display: flex;
  min-height: 1.55rem;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.45rem;
  margin-bottom: 0.85rem;
}

.coverage-source-track,
.coverage-source-cadence {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgb(var(--border-soft) / 0.72);
  background: rgb(var(--surface) / 0.7);
  padding: 0.2rem 0.42rem;
  color: rgb(var(--text-faint));
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.coverage-source-link {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.25rem 0.5rem;
  border-top: 1px solid rgb(var(--border) / 0.6);
  padding-top: 0.8rem;
  color: rgb(var(--text));
  text-decoration: none;
  transition: color 0.15s ease;
}

.coverage-source-link:hover {
  color: rgb(var(--color-brand));
}

.coverage-source-link-label {
  grid-column: 1 / -1;
  color: rgb(var(--text-faint));
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.coverage-source-name {
  overflow: hidden;
  font-size: 0.78rem;
  font-weight: 600;
  line-height: 1.45;
  text-overflow: ellipsis;
}

.coverage-source-pending {
  border-top: 1px solid rgb(var(--border) / 0.6);
  padding-top: 0.8rem;
  color: rgb(var(--text-faint));
  font-size: 0.78rem;
  line-height: 1.5;
}

@media (max-width: 640px) {
  .coverage-meta-grid {
    grid-template-columns: 1fr;
  }

  .coverage-map-frame {
    padding: 0.7rem;
  }
}
</style>
