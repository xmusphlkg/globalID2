---
// src/pages/countries/index.astro — Country coverage map
import ReportLayout from '../../layouts/ReportLayout.astro';
import CountryCard from '../../components/CountryCard.astro';
import CountryFlag from '../../components/CountryFlag.astro';
import CountriesMapView from '../../components/charts/CountriesMapView';
import metaRaw from '../../data/meta.json';

const meta = metaRaw as any;
const supportedCountries = (meta.countries ?? []) as Array<{
  code: string; name: string; language: string;
  total_cases: number; total_deaths: number; disease_count: number;
  date_range: { start: string | null; end: string | null };
}>;

const metaByCode = Object.fromEntries(
  supportedCountries.map(c => [c.code.toUpperCase(), c])
) as Record<string, typeof supportedCountries[0]>;

// All 10 countries from support_map.js
const ALL_COUNTRIES = [
  { code: 'CN', name: 'China',          status: 'Supported' },
  { code: 'TH', name: 'Thailand',       status: 'Scheduled' },
  { code: 'AU', name: 'Australia',      status: 'Supported' },
  { code: 'US', name: 'United States',  status: 'Supported' },
  { code: 'GB', name: 'United Kingdom', status: 'Scheduled' },
  { code: 'KR', name: 'South Korea',    status: 'Scheduled' },
  { code: 'NZ', name: 'New Zealand',    status: 'Scheduled' },
  { code: 'SE', name: 'Sweden',         status: 'Scheduled' },
  { code: 'JP', name: 'Japan',          status: 'Supported' },
  { code: 'SG', name: 'Singapore',      status: 'Scheduled' },
];

const ORDERED_COUNTRIES = [...ALL_COUNTRIES].sort((a, b) => {
  const aSupported = Boolean(metaByCode[a.code]) || a.status === 'Supported';
  const bSupported = Boolean(metaByCode[b.code]) || b.status === 'Supported';
  if (aSupported === bSupported) return 0;
  return aSupported ? -1 : 1;
});

const FLAGS: Record<string, string> = {
  CN: '🇨🇳', TH: '🇹🇭', AU: '🇦🇺', US: '🇺🇸', GB: '🇬🇧',
  KR: '🇰🇷', NZ: '🇳🇿', SE: '🇸🇪', JP: '🇯🇵', SG: '🇸🇬',
};
---

<ReportLayout
  title="Countries"
  description="Global disease surveillance coverage by country."
  breadcrumbs={[{ label: 'Countries' }]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

    <!-- Page header ──────────────────────────────────────────────────────── -->
    <div class="mb-8 flex items-center gap-4">
      <img src="/logo.png" alt="GlobalID logo" class="h-12 w-auto flex-shrink-0" />
      <div>
        <h1 class="text-3xl font-bold text-slate-100 mb-1"
            data-lang-en="Disease Surveillance Coverage"
            data-lang-zh="疾病监测覆盖范围">
          Disease Surveillance Coverage
        </h1>
        <p class="text-slate-500 text-sm"
           data-lang-en="Global infectious disease surveillance data organized by country."
           data-lang-zh="全球传染病监测数据（按国家组织）。">
          Global infectious disease surveillance data organized by country.
        </p>
      </div>
    </div>

    <!-- Coverage map ─────────────────────────────────────────────────────── -->
    <div class="card p-4 mb-10 relative">
      <!-- Legend -->
      <div class="absolute top-4 right-5 flex gap-5 text-xs text-slate-400 z-20 pointer-events-none">
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-teal-500"></span>
          <span data-lang-en="Supported" data-lang-zh="已支持">Supported</span>
        </span>
        <span class="flex items-center gap-1.5">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-slate-500"></span>
          <span data-lang-en="Scheduled" data-lang-zh="规划中">Scheduled</span>
        </span>
      </div>

      <CountriesMapView
        client:only="react"
        metaCountries={supportedCountries}
        height={480}
      />
    </div>

    <!-- Country cards ────────────────────────────────────────────────────── -->
    <h2 class="text-lg font-semibold text-slate-300 mb-5"
        data-lang-en="Coverage Countries" data-lang-zh="覆盖国家">
      Coverage Countries
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {ORDERED_COUNTRIES.map((c) => {
        const m = metaByCode[c.code];
        if (m) {
          return (
            <CountryCard
              code={m.code}
              name={m.name}
              totalCases={m.total_cases}
              totalDeaths={m.total_deaths}
              diseaseCount={m.disease_count}
              dateRange={m.date_range}
            />
          );
        }

        if (c.status === 'Supported') {
          return (
            <CountryCard
              code={c.code}
              name={c.name}
              totalCases={0}
              totalDeaths={0}
              diseaseCount={0}
            />
          );
        }

        // Scheduled country card
        return (
          <div class="card p-5 opacity-60 border-slate-700/40 select-none transition-all">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <CountryFlag code={c.code} name={c.name} sizeClass="w-9 h-7" />
                <div>
                  <h3 class="text-slate-300 font-semibold text-base">{c.name}</h3>
                  <span class="text-slate-600 text-xs font-mono">{c.code}</span>
                </div>
              </div>
            </div>

            <div class="mt-1">
              <span class="inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded
                           border border-slate-700 text-slate-500">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span data-lang-en="Scheduled" data-lang-zh="规划中">Scheduled</span>
              </span>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</ReportLayout>
