---
import ReportLayout from '../../layouts/ReportLayout.astro';
import CountriesMapView from '../../components/charts/CountriesMapView';
import SurveillanceSummary from '../../components/public/SurveillanceSummary';
import SurveillanceDirectory from '../../components/public/SurveillanceDirectory';
import { buildAlternatePaths } from '../../lib/seo';
import { translateUi } from '../../utils/i18n';
const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : fr ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;

---

<ReportLayout
  title={pick('Countries and Regions', '国家和地区')}
  description={pick('Browse countries and regions with available infectious disease surveillance data.', '浏览提供传染病监测数据的国家和地区。')}
  initialLanguage={locale}
  seo={{ title: pick('Countries and Regions | GIDS', '国家和地区 | GIDS'), description: pick('Browse countries and regions with available infectious disease surveillance data.', '浏览提供传染病监测数据的国家和地区。'), locale, canonicalPath: `${prefix}/countries/`, alternatePaths: buildAlternatePaths(`${prefix}/countries/`, locale), pageType: 'WebPage' }}
  breadcrumbs={[{ label: pick('Countries', '国家') }]}
>
  <div class="coverage-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <section class="coverage-hero">
      <div>
        <p class="coverage-kicker">{pick('Current coverage', '当前覆盖')}</p>
        <h1 class="coverage-title">{pick('Countries and Regions', '国家和地区')}</h1>
      </div>
      <SurveillanceSummary client:load dataUrl="/site-data/meta.json" mode="directory-indicators" language={locale} />
    </section>

    <section class="card coverage-surface p-6 sm:p-8">
      <div class="coverage-map-header">
        <div class="coverage-map-title-block">
          <p class="coverage-map-eyebrow">{pick('Live geography layer', '实时地理覆盖层')}</p>
          <h2 class="coverage-section-title">{pick('Data coverage map', '数据覆盖地图')}</h2>
          <p class="coverage-map-description">{pick('See where GIDS has country-level data, regional data, or a planned source.', '查看 GIDS 已接入国家级、地区级数据，及计划接入的数据来源。', 'Consultez les données nationales, régionales et les sources prévues.')}</p>
        </div>
        <SurveillanceSummary client:load dataUrl="/site-data/meta.json" mode="coverage-caption" language={locale} />
      </div>

      <div class="coverage-map-toolbar">
        <div class="coverage-legend" role="list" aria-label={pick('Map legend', '地图图例')}>
          <span class="coverage-legend-item" role="listitem">
            <span class="coverage-legend-dot coverage-legend-supported"></span>
            <span>{pick('Country supported', '国家已支持')}</span>
          </span>
          <span class="coverage-legend-item" role="listitem">
            <span class="coverage-legend-dot coverage-legend-subdivision"></span>
            <span>{pick('Province / region supported', '省级/地区已支持')}</span>
          </span>
          <span class="coverage-legend-item" role="listitem">
            <span class="coverage-legend-dot coverage-legend-planned"></span>
            <span>{pick('Planned', '规划中')}</span>
          </span>
          <span class="coverage-legend-item" role="listitem">
            <span class="coverage-legend-dot coverage-legend-unsupported"></span>
            <span>{pick('Not supported', '不支持')}</span>
          </span>
        </div>
        <span class="coverage-map-toolbar-note">{pick('Hover a point for details · click a live point to open its page', '悬浮查看详情 · 单击已上线点打开详情页')}</span>
      </div>

      <div class="coverage-map-frame">
        <CountriesMapView
          client:only="react"
          dataUrl="/site-data/meta.json"
          height={520}
          initialLanguage={locale}
        />
        <p class="coverage-map-provenance">
          {pick(
            'Marker positions use the bundled open GeoJSON boundary set and ISO country catalogue; province points are maintained as approximate administrative centroids.',
            '标记位置使用站点内置的开放 GeoJSON 边界数据与 ISO 国家目录；省级点位以近似行政中心维护。',
          )}
          {' '}
          <a href="https://github.com/lipis/flag-icons" target="_blank" rel="noreferrer">flag-icons ↗</a>
        </p>
      </div>
    </section>

    <section class="card coverage-surface p-6 sm:p-8">
      <h2 class="coverage-section-title">{pick('Browse current datasets', '浏览当前数据集', 'Parcourir les données actuelles')}</h2>
      <div class="mt-5"><SurveillanceDirectory client:load language={locale} /></div>
      <p class="coverage-filter-provenance">{pick('Geographic and income classifications use the reviewed WHO and World Bank catalogue.', '地理区域和收入组采用已审核的 WHO 与世界银行分类目录。', 'Les classifications géographiques et de revenu utilisent les catalogues OMS et Banque mondiale validés.')}</p>
    </section>
  </div>
</ReportLayout>



<style>
.coverage-hero {
  display: grid;
  grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
  gap: clamp(1.5rem, 5vw, 4rem);
  align-items: end;
  border: 1px solid rgb(var(--border));
  border-top: 3px solid rgb(var(--color-teal));
  background: rgb(var(--surface));
  padding: clamp(1.5rem, 4vw, 2.25rem);
}

.coverage-surface {
  position: relative;
  overflow: hidden;
}


.coverage-kicker {
  color: rgb(var(--text-faint));
  letter-spacing: 0.18em;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

.coverage-title {
  color: rgb(var(--text-strong));
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(2rem, 2.8vw, 3rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.08;
}

.coverage-lead {
  max-width: 48rem;
  color: rgb(var(--text));
  font-size: 1rem;
  line-height: 1.85;
}

.coverage-meta-grid {
  display: grid;
  gap: 0.9rem;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.coverage-meta-card {
  border: 1px solid rgb(var(--border) / 0.72);
  background: rgb(var(--surface) / 0.84);
  padding: 1rem 1rem 1.1rem;
}

.coverage-meta-label {
  color: rgb(var(--text-faint));
  letter-spacing: 0.14em;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

.coverage-meta-value {
  margin-top: 0.55rem;
  color: rgb(var(--text-strong));
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 1.9rem;
  font-weight: 600;
  line-height: 1;
}

.coverage-meta-date {
  font-size: 1rem;
  line-height: 1.15;
}

.coverage-section-title {
  color: rgb(var(--text-strong));
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: clamp(1.55rem, 2vw, 2.15rem);
  font-weight: 600;
  letter-spacing: -0.02em;
}

.coverage-section-header {
  position: relative;
  margin-bottom: 1.4rem;
  padding-left: 1rem;
}
.coverage-section-header::before {
  content: "";
  position: absolute;
  inset: .15rem auto .15rem 0;
  width: 3px;
  background: linear-gradient(180deg, rgb(var(--color-brand) / .82), rgb(var(--color-accent) / .56));
}

.coverage-map-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  padding-bottom: 1.35rem;
  border-bottom: 1px solid rgb(var(--border));
}

.coverage-map-title-block { min-width: 0; }
.coverage-map-eyebrow {
  margin: 0 0 .45rem;
  color: rgb(var(--color-teal));
  font-size: .67rem;
  font-weight: 750;
  letter-spacing: .15em;
  text-transform: uppercase;
}
.coverage-map-description {
  max-width: 42rem;
  margin: .55rem 0 0;
  color: rgb(var(--text-muted));
  font-size: .82rem;
  line-height: 1.55;
}
.coverage-map-readout {
  display: grid;
  min-width: 9.4rem;
  padding: .75rem .9rem;
  border-left: 3px solid rgb(var(--color-teal));
  background: rgb(var(--bg-soft) / .7);
  color: rgb(var(--text-muted));
}
.coverage-map-readout strong { color: rgb(var(--text-strong)); font-size: 1.8rem; font-weight: 680; line-height: 1; }
.coverage-map-readout span { margin-top: .25rem; color: rgb(var(--text)); font-size: .72rem; font-weight: 680; }
.coverage-map-readout small { margin-top: .38rem; color: rgb(var(--text-faint)); font-size: .63rem; }

.coverage-map-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-width: 0;
  padding: .85rem 0 1rem;
}

.coverage-section-lead {
  margin-top: 0.7rem;
  max-width: 48rem;
  color: rgb(var(--text-muted));
  font-size: 0.96rem;
  line-height: 1.75;
}

.coverage-legend {
  display: flex;
  flex-wrap: wrap;
  gap: .35rem 1rem;
}

.coverage-legend-item {
  display: inline-flex;
  align-items: center;
  gap: .42rem;
  padding: .2rem 0;
  color: rgb(var(--text));
  font-size: .72rem;
  font-weight: 600;
}

.coverage-map-toolbar-note { flex: 0 0 auto; color: rgb(var(--text-faint)); font-size: .67rem; text-align: right; }

.coverage-map-frame {
  overflow: hidden;
  border: 1px solid rgb(var(--border) / .82);
  background: rgb(var(--bg-soft) / .55);
  padding: .65rem;
  box-shadow: inset 0 1px 0 rgb(255 255 255 / .4), 0 12px 28px rgb(19 48 77 / .06);
}

.coverage-map-canvas { isolation: isolate; }
:global(.coverage-map-canvas) { isolation: isolate; }
:global(.coverage-map-dot) { position: absolute; width: 1rem; height: 1rem; margin: -.5rem 0 0 -.5rem; border: 0; border-radius: 999px; background: var(--dot-color); box-shadow: 0 0 0 2px rgb(var(--surface) / .58); cursor: pointer; padding: 0; transform: translateZ(0); transition: transform .15s ease, box-shadow .15s ease; z-index: 4; }
:global(.coverage-map-dot.is-country) { width: 1rem; height: 1rem; margin: -.5rem 0 0 -.5rem; }
:global(.coverage-map-dot.is-subdivision) { width: .56rem; height: .56rem; margin: -.28rem 0 0 -.28rem; }
:global(.coverage-map-dot.is-unsupported) { width: .3rem; height: .3rem; margin: -.15rem 0 0 -.15rem; background: var(--dot-color); border: 0; box-shadow: none; cursor: pointer; opacity: .42; animation: none; }
:global(.coverage-map-dot.is-planned) { background: color-mix(in srgb, var(--dot-color) 28%, rgb(var(--surface))); border: 1px solid var(--dot-color); box-shadow: 0 0 0 2px rgb(var(--surface) / .58); }
:global(.coverage-map-dot:not(.is-unsupported)) { animation: coverage-dot-pulse 2.4s ease-out infinite; }
:global(.coverage-map-dot.is-unsupported) { animation: coverage-dot-breathe-muted 3.2s ease-in-out infinite; }
:global(.coverage-map-dot:hover), :global(.coverage-map-dot:focus-visible) { outline: none; transform: scale(1.65); box-shadow: 0 0 0 3px rgb(var(--surface) / .7), 0 0 0 5px color-mix(in srgb, var(--dot-color) 40%, transparent); }
:global(.coverage-map-dot.is-unsupported:hover), :global(.coverage-map-dot.is-unsupported:focus-visible) { transform: scale(1.9); opacity: .9; box-shadow: 0 0 0 3px rgb(var(--surface) / .7); }
:global(.coverage-map-controls) { position: absolute; top: .8rem; right: .8rem; display: grid; gap: .25rem; z-index: 8; }
:global(.coverage-map-controls button) { width: 2rem; height: 2rem; border: 1px solid rgb(var(--border)); background: rgb(var(--surface) / .9); color: rgb(var(--text-strong)); font-size: 1.1rem; line-height: 1; cursor: pointer; }
:global(.coverage-map-controls button:hover), :global(.coverage-map-controls button:focus-visible) { border-color: rgb(var(--color-teal)); color: rgb(var(--color-teal)); outline: none; }
:global(.coverage-map-hint) { position: absolute; left: .8rem; bottom: .65rem; padding: .3rem .5rem; background: rgb(var(--surface) / .82); color: rgb(var(--text-faint)); font-size: .66rem; letter-spacing: .04em; pointer-events: none; z-index: 8; }
:global(.coverage-map-tooltip) { position: absolute; width: 11.5rem; padding: .55rem .65rem; border: 1px solid; box-shadow: 0 8px 18px rgb(0 0 0 / .14); pointer-events: none; z-index: 12; }
:global(.coverage-map-tooltip-title) { display: flex; align-items: center; gap: .4rem; font-size: .74rem; line-height: 1.25; }
:global(.coverage-map-tooltip-title img) { width: 1.15rem; height: .8rem; object-fit: cover; border: 1px solid rgb(var(--border)); }
:global(.coverage-map-tooltip-meta) { margin-top: .3rem; font-size: .65rem; opacity: .76; }
:global(.coverage-map-tooltip-action) { margin-top: .35rem; color: rgb(var(--color-teal)); font-size: .64rem; font-weight: 650; }
.coverage-map-dot {
  position: absolute;
  width: 1rem;
  height: 1rem;
  margin: -0.5rem 0 0 -0.5rem;
  border: 0;
  border-radius: 999px;
  background: var(--dot-color);
  box-shadow: 0 0 0 2px rgb(var(--surface) / .58);
  cursor: pointer;
  padding: 0;
  transform: translateZ(0);
  transition: transform .15s ease, box-shadow .15s ease;
  z-index: 4;
}
.coverage-map-dot.is-country { width: .72rem; height: .72rem; margin: -.36rem 0 0 -.36rem; }
.coverage-map-dot.is-subdivision { width: .56rem; height: .56rem; margin: -.28rem 0 0 -.28rem; }
.coverage-map-dot.is-unsupported { width: .3rem; height: .3rem; margin: -.15rem 0 0 -.15rem; background: var(--dot-color); border: 0; box-shadow: none; cursor: pointer; opacity: .42; animation: none; }
.coverage-map-dot.is-planned { background: color-mix(in srgb, var(--dot-color) 28%, rgb(var(--surface))); border: 1px solid var(--dot-color); box-shadow: 0 0 0 2px rgb(var(--surface) / .58); }
.coverage-map-dot.is-subdivision:not(.is-unsupported) { animation: coverage-dot-pulse 2.4s ease-out infinite; }
.coverage-map-dot:hover, .coverage-map-dot:focus-visible { outline: none; transform: scale(1.65); box-shadow: 0 0 0 3px rgb(var(--surface) / .7), 0 0 0 5px color-mix(in srgb, var(--dot-color) 40%, transparent); }
.coverage-map-dot.is-unsupported:hover, .coverage-map-dot.is-unsupported:focus-visible { transform: scale(1.9); opacity: .9; box-shadow: 0 0 0 3px rgb(var(--surface) / .7); }
@keyframes coverage-dot-pulse { 0%, 100% { box-shadow: 0 0 0 2px rgb(var(--surface) / .58), 0 0 0 0 color-mix(in srgb, var(--dot-color) 42%, transparent); } 50% { box-shadow: 0 0 0 2px rgb(var(--surface) / .58), 0 0 0 5px color-mix(in srgb, var(--dot-color) 0%, transparent); } }
@keyframes coverage-dot-breathe-muted { 0%, 100% { opacity: .6; } 50% { opacity: 1; } }
.coverage-map-controls { position: absolute; top: .8rem; right: .8rem; display: grid; gap: .25rem; z-index: 8; }
.coverage-map-controls button { width: 2rem; height: 2rem; border: 1px solid rgb(var(--border)); background: rgb(var(--surface) / .9); color: rgb(var(--text-strong)); font-size: 1.1rem; line-height: 1; cursor: pointer; }
.coverage-map-controls button:hover, .coverage-map-controls button:focus-visible { border-color: rgb(var(--color-teal)); color: rgb(var(--color-teal)); outline: none; }
.coverage-map-hint { position: absolute; left: .8rem; bottom: .65rem; padding: .3rem .5rem; background: rgb(var(--surface) / .82); color: rgb(var(--text-faint)); font-size: .66rem; letter-spacing: .04em; pointer-events: none; z-index: 8; }
.coverage-map-provenance { margin: .65rem 0 0; color: rgb(var(--text-faint)); font-size: .68rem; line-height: 1.5; }
.coverage-map-provenance a { color: rgb(var(--color-teal)); text-decoration: underline; text-underline-offset: 2px; }
.coverage-map-tooltip { position: absolute; width: 11.5rem; padding: .55rem .65rem; border: 1px solid; box-shadow: 0 8px 18px rgb(0 0 0 / .14); pointer-events: none; z-index: 12; }
.coverage-map-tooltip-title { display: flex; align-items: center; gap: .4rem; font-size: .74rem; line-height: 1.25; }
.coverage-map-tooltip-title img { width: 1.15rem; height: .8rem; object-fit: cover; border: 1px solid rgb(var(--border)); }
.coverage-map-tooltip-meta { margin-top: .3rem; font-size: .65rem; opacity: .76; }
.coverage-map-tooltip-action { margin-top: .35rem; color: rgb(var(--color-teal)); font-size: .64rem; font-weight: 650; }
.coverage-legend-dot { display: inline-block; width: .65rem; height: .65rem; border-radius: 999px; }
.coverage-legend-supported { background: #138a70; }
.coverage-legend-subdivision { background: #14b8a6; animation: coverage-dot-pulse 2.4s ease-out infinite; }
.coverage-legend-planned { background: #a6d9b8; border: 1px solid #3aa66f; box-shadow: inset 0 0 0 1px rgb(255 255 255 / .35); }
.coverage-legend-unsupported { width: .42rem; height: .42rem; background: rgb(var(--text-faint) / .65); }

.coverage-summary-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgb(var(--border) / 0.78);
  background: rgb(var(--surface) / 0.86);
  padding: 0.7rem 0.95rem;
  color: rgb(var(--text));
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.coverage-filters {
  display: grid;
  grid-template-columns: minmax(10rem, 1.15fr) repeat(3, minmax(8rem, 1fr)) auto auto;
  align-items: end;
  gap: 0.6rem;
  margin-bottom: 1rem;
  border: 1px solid rgb(var(--border) / 0.78);
  background: rgb(var(--bg-soft) / 0.54);
  padding: 1rem;
}

.coverage-filter {
  display: grid;
  align-content: start;
  gap: 0.42rem;
  min-width: 0;
}

.coverage-filter > span {
  color: rgb(var(--text-faint));
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.coverage-filter input,
.coverage-filter select {
  width: 100%;
  min-height: 2.6rem;
  border: 1px solid rgb(var(--border));
  border-radius: 0;
  background: rgb(var(--surface));
  padding: 0.58rem 0.7rem;
  color: rgb(var(--text-strong));
  font-size: 0.8rem;
}

.coverage-filter input:focus,
.coverage-filter select:focus,
.coverage-filter-status button:focus-visible,
.coverage-filter-reset:focus-visible {
  outline: 2px solid rgb(var(--color-brand) / 0.75);
  outline-offset: 2px;
}

.coverage-filter-status {
  grid-column: auto;
}

.coverage-filter-status > div {
  display: flex;
  flex-wrap: nowrap;
  gap: 0.3rem;
}

.coverage-filter-status button,
.coverage-filter-reset {
  min-height: 2.6rem;
  border: 1px solid rgb(var(--border));
  border-radius: 0;
  background: rgb(var(--surface));
  padding: 0.48rem 0.58rem;
  color: rgb(var(--text));
  font-size: 0.74rem;
  font-weight: 650;
  transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
}

.coverage-filter-status button:hover,
.coverage-filter-reset:hover:not(:disabled) {
  border-color: rgb(var(--color-brand) / 0.58);
}

.coverage-filter-status button[aria-pressed="true"] {
  border-color: rgb(var(--color-brand) / 0.72);
  background: rgb(var(--color-brand) / 0.12);
  color: rgb(var(--text-strong));
}

.coverage-filter-reset {
  align-self: end;
  justify-self: end;
  white-space: nowrap;
}

.coverage-filter-reset:disabled {
  cursor: not-allowed;
  opacity: 0.46;
}

.coverage-filter-provenance {
  margin: 1rem 0 0;
  border-top: 1px solid rgb(var(--border) / 0.55);
  padding-top: 0.75rem;
  color: rgb(var(--text-faint));
  font-size: 0.7rem;
  line-height: 1.55;
}

.coverage-filter-provenance a {
  color: rgb(var(--color-brand));
  text-decoration: none;
}

.coverage-filter-provenance a:hover {
  text-decoration: underline;
}

.coverage-country-card {
  display: grid;
  min-width: 0;
}

.coverage-filter-empty {
  margin: 1rem 0 0;
  border: 1px dashed rgb(var(--border-soft));
  padding: 1rem;
  color: rgb(var(--text-muted));
  text-align: center;
}

.coverage-scheduled-card {
  border-style: dashed;
  border-color: rgb(var(--border-soft));
  background: linear-gradient(180deg, rgb(var(--bg-soft) / 0.56), rgb(var(--surface) / 0.76));
}

.coverage-scheduled-pill {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgb(var(--border-soft) / 0.78);
  background: rgb(var(--surface) / 0.82);
  padding: 0.28rem 0.55rem;
  color: rgb(var(--text-faint));
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.coverage-source-meta {
  display: flex;
  min-height: 1.55rem;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.45rem;
  margin-bottom: 0.85rem;
}

.coverage-source-track,
.coverage-source-cadence {
  display: inline-flex;
  align-items: center;
  border: 1px solid rgb(var(--border-soft) / 0.72);
  background: rgb(var(--surface) / 0.7);
  padding: 0.2rem 0.42rem;
  color: rgb(var(--text-faint));
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.coverage-source-link {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.25rem 0.5rem;
  border-top: 1px solid rgb(var(--border) / 0.6);
  padding-top: 0.8rem;
  color: rgb(var(--text));
  text-decoration: none;
  transition: color 0.15s ease;
}

.coverage-source-link:hover {
  color: rgb(var(--color-brand));
}

.coverage-source-link-label {
  grid-column: 1 / -1;
  color: rgb(var(--text-faint));
  font-size: 0.64rem;
  font-weight: 700;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.coverage-source-name {
  overflow: hidden;
