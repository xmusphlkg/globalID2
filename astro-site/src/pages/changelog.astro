---
import BaseLayout from '../layouts/BaseLayout.astro';
import Changelog from '../components/public/Changelog';
import { buildAlternatePaths } from '../lib/seo';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const pick = (en: string, zh: string, fr: string) => locale === 'zh' ? zh : locale === 'fr' ? fr : en;
const prefix = locale === 'en' ? '' : `/${locale}`;
const title = pick('Changelog', '更新记录', 'Journal des modifications');
const description = pick('Follow every GIDS release, including new capabilities, improvements, fixes, and release dates.', '查看每个 GIDS 公开版本的新增能力、改进、修复和发布日期。', 'Suivez chaque version de GIDS : nouveautés, améliorations, corrections et dates de publication.');
---
<BaseLayout title={title} description={description} initialLanguage={locale}
  seo={{ title: `${title} | GIDS`, description, locale, canonicalPath: `${prefix}/changelog/`, alternatePaths: buildAlternatePaths(`${prefix}/changelog/`, locale), pageType: 'WebPage' }}>
  <Changelog locale={locale} client:load />
</BaseLayout>
