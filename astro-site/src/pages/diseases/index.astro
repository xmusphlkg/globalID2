---
// src/pages/diseases/index.astro — Disease directory
import ReportLayout from '../../layouts/ReportLayout.astro';
import DiseaseCard from '../../components/DiseaseCard.astro';
import diseasesRaw from '../../data/diseases/index.json';
import { buildAlternatePaths } from '../../lib/seo';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' };
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;

const diseases = diseasesRaw as any[];

const normalizeCategory = (value: unknown) => {
  const text = typeof value === 'string' ? value.trim() : '';
  return text.length ? text : 'Other';
};

const normalizedDiseases = diseases.map((d) => ({
  ...d,
  normalized_category: normalizeCategory(d.category),
}));

const preferredCategories = ['Viral', 'Bacterial', 'Parasitic', 'Fungal'];
const discoveredCategories = [
  ...new Set(normalizedDiseases.map((d) => d.normalized_category)),
] as string[];
const categories = [
  ...preferredCategories.filter((cat) => discoveredCategories.includes(cat)),
  ...discoveredCategories.filter((cat) => !preferredCategories.includes(cat)),
];

const byCategory: Record<string, any[]> = {};
for (const d of normalizedDiseases) {
  const cat = d.normalized_category;
  if (!byCategory[cat]) byCategory[cat] = [];
  byCategory[cat].push(d);
}

const catZh: Record<string, string> = {
  Viral: '病毒性',
  Bacterial: '细菌性',
  Parasitic: '寄生虫',
  Fungal: '真菌性',
  Other: '其他',
};

const catCounts = Object.fromEntries(
  categories.map((c) => [c, (byCategory[c] ?? []).length]),
);
---

<ReportLayout
  title={pick('Disease Directory', '疾病目录')}
  description={pick(`Browse ${diseases.length} infectious diseases tracked by GIDS`, `浏览 GIDS 追踪的 ${diseases.length} 种传染病`)}
  initialLanguage={locale}
  seo={{ title: pick('Disease Directory | GIDS', '疾病目录 | GIDS'), description: pick(`Browse ${diseases.length} infectious diseases tracked by GIDS`, `浏览 GIDS 追踪的 ${diseases.length} 种传染病`), locale, canonicalPath: `${prefix}/diseases/`, alternatePaths: buildAlternatePaths(`${prefix}/diseases/`, locale), pageType: 'WebPage' }}
  breadcrumbs={[{ label: pick('Diseases', '疾病') }]}
>
  <div class="diseases-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <section class="card diseases-intro p-6 sm:p-8">
      <div class="diseases-intro-grid">
        <div>
          <h1 class="section-heading">{pick('Disease Directory', '疾病目录')}</h1>
          <p class="diseases-intro-copy mt-3">{pick(`${diseases.length} infectious diseases tracked across categories`, `追踪 ${diseases.length} 种传染病，按分类组织`)}</p>
        </div>

        <div class="diseases-meta-grid">
          <article class="diseases-meta-card">
            <div class="diseases-meta-label">{pick('Diseases', '疾病总数')}</div>
            <div class="diseases-meta-value">{diseases.length}</div>
          </article>
          <article class="diseases-meta-card">
            <div class="diseases-meta-label">{pick('Categories', '分类数量')}</div>
            <div class="diseases-meta-value">{categories.length}</div>
          </article>
        </div>
      </div>

      <div class="diseases-toolbar mt-6">
        <div class="diseases-search-row">
          <input
            id="disease-search"
            type="search"
            placeholder={pick('Search diseases or ICD code...', '搜索疾病或 ICD 编码…')}
            class="site-control-input diseases-search w-full px-3 py-2 text-sm rounded-none border focus:outline-none focus:ring-2 focus:ring-brand-500"
          />
          <button
            id="clear-disease-search"
            type="button"
            class="site-action-secondary px-3 py-2 text-xs rounded-none border font-semibold transition-colors"
            aria-label={pick('Clear search', '清除搜索')}
            disabled
          >
            {pick('Clear', '清除')}
          </button>
        </div>

        <div class="diseases-filter-row" id="cat-filters">
          <button
            class="cat-filter-btn site-control-pill is-active px-3 py-1.5 text-xs rounded-none border transition-colors"
            data-cat="All"
          >
            <span>{pick(`All (${diseases.length})`, `全部（${diseases.length}）`)}</span>
          </button>
          {categories.map((cat) => (
            <button
              class="cat-filter-btn site-control-pill px-3 py-1.5 text-xs rounded-none border transition-colors"
              data-cat={cat}
            >
              <span>{pick(`${cat} (${catCounts[cat] ?? 0})`, `${catZh[cat] ?? cat}（${catCounts[cat] ?? 0}）`)}</span>
            </button>
          ))}
        </div>
      </div>
    </section>

    {categories.map((cat) => {
      const catDiseases = byCategory[cat] ?? [];
      return (
        <section class="cat-section card diseases-category p-5 sm:p-6" data-cat={cat}>
          <div class="diseases-category-header">
            <h2 class="diseases-category-title">{pick(cat, catZh[cat] ?? cat)}</h2>
            <span class="diseases-category-count">{catDiseases.length}</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4" id={`grid-${cat.toLowerCase().replace(/\s+/g, '-')}`}>
            {catDiseases.map((d) => (
              <div
                class="disease-card-wrap"
                data-name-en={(d.name_en ?? '').toLowerCase()}
                data-name-zh={(d.name_zh ?? '').toLowerCase()}
                data-icd={(d.icd_10 ?? '').toLowerCase()}
              >
                <DiseaseCard
                  diseaseId={d.disease_id}
                  nameEn={d.name_en}
                  nameZh={d.name_zh}
                  category={d.normalized_category}
                  icd10={d.icd_10}
                  description={d.description}
                  slug={d.slug}
                  locale={locale}
                />
              </div>
            ))}
          </div>
        </section>
      );
    })}

    <div id="no-results" class="card diseases-empty hidden p-10 sm:p-12 text-center">
      <p class="diseases-empty-title">{pick('No diseases found', '未找到匹配疾病')}</p>
      <p class="diseases-empty-copy mt-2">{pick('Try a different keyword, category, or ICD code.', '请尝试其他关键词、分类或 ICD 编码。')}</p>
    </div>
  </div>
</ReportLayout>

<script>
  const searchInput = document.getElementById('disease-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-disease-search') as HTMLButtonElement | null;
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.cat-filter-btn'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.cat-section'));
  const noResults = document.getElementById('no-results') as HTMLElement | null;

  let activeCat = 'All';

  function updateFilterButtonState() {
    filterBtns.forEach((btn) => {
      const isActive = btn.dataset.cat === activeCat;
      btn.classList.toggle('is-active', isActive);
    });
  }

  function applyFilters() {
    const q = (searchInput?.value ?? '').trim().toLowerCase();
    let anyVisible = false;

    sections.forEach((section) => {
      const cat = section.dataset.cat ?? '';
      const showSection = activeCat === 'All' || activeCat === cat;

      if (!showSection) {
        section.classList.add('hidden');
        return;
      }

      let sectionHasVisible = false;
      section.querySelectorAll<HTMLElement>('.disease-card-wrap').forEach((card) => {
        const nameEn = (card.dataset.nameEn ?? '').toLowerCase();
        const nameZh = (card.dataset.nameZh ?? '').toLowerCase();
        const icd = (card.dataset.icd ?? '').toLowerCase();

        const matches = !q || nameEn.includes(q) || nameZh.includes(q) || icd.includes(q);
        card.classList.toggle('hidden', !matches);

        if (matches) sectionHasVisible = true;
      });

      section.classList.toggle('hidden', !sectionHasVisible);
      if (sectionHasVisible) anyVisible = true;
    });

    if (noResults) noResults.classList.toggle('hidden', anyVisible);
    if (clearBtn) clearBtn.disabled = q.length === 0;
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat ?? 'All';
      updateFilterButtonState();
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', applyFilters);
  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      searchInput.value = '';
      applyFilters();
    }
  });

  clearBtn?.addEventListener('click', () => {
    if (!searchInput) return;
    searchInput.value = '';
    searchInput.focus();
    applyFilters();
  });

  updateFilterButtonState();
  applyFilters();
</script>

<style>
.diseases-intro-grid {
  display: grid;
  gap: 1.25rem;
}

.diseases-intro-copy {
  max-width: 48rem;
  color: rgb(var(--text-muted));
  line-height: 1.75;
}

.diseases-meta-grid {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.diseases-meta-card {
  border: 1px solid rgb(var(--border) / 0.72);
  background: rgb(var(--surface) / 0.84);
  padding: 0.9rem 1rem;
}

.diseases-meta-label {
  color: rgb(var(--text-faint));
  letter-spacing: 0.14em;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
}

.diseases-meta-value {
  margin-top: 0.55rem;
  color: rgb(var(--text-strong));
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 1.85rem;
  font-weight: 600;
  line-height: 1;
}

.diseases-toolbar {
  display: grid;
  gap: 0.8rem;
}

.diseases-search-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.55rem;
}

.diseases-search {
  flex: 1 1 18rem;
}

.diseases-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.cat-filter-btn.is-active {
  border-color: rgb(var(--color-brand) / 0.92);
  background: rgb(var(--color-brand));
  color: rgb(255 255 255);
  box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12);
}

.cat-filter-btn:disabled {
  opacity: 0.62;
  cursor: not-allowed;
}

.diseases-category-header {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 1.1rem;
  padding-left: 0.9rem;
}

.diseases-category-header::before {
  content: '';
  position: absolute;
  inset: 0.18rem auto 0.18rem 0;
  width: 3px;
  background: linear-gradient(180deg, rgb(var(--color-brand) / 0.82), rgb(var(--color-accent) / 0.56));
}

.diseases-category-title {
  color: rgb(var(--text-strong));
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.diseases-category-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.2rem;
  border: 1px solid rgb(var(--border) / 0.74);
  background: rgb(var(--surface) / 0.88);
  padding: 0.18rem 0.5rem;
  color: rgb(var(--text-faint));
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.1em;
}

.diseases-empty-title {
  color: rgb(var(--text-strong));
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 1.4rem;
  font-weight: 600;
}

.diseases-empty-copy {
  color: rgb(var(--text-muted));
}

@media (min-width: 1024px) {
  .diseases-intro-grid {
    grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.7fr);
    align-items: end;
  }

  .diseases-toolbar {
    gap: 0.9rem;
  }
}

@media (max-width: 640px) {
  .diseases-meta-grid {
    grid-template-columns: 1fr;
  }

  .diseases-category-header {
    align-items: center;
  }
}
</style>
