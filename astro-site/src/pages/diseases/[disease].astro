---
// src/pages/diseases/[disease].astro — Individual disease detail page
import ReportLayout from '../../layouts/ReportLayout.astro';
import CountryFlag from '../../components/CountryFlag.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
import PageAnchorNav from '../../components/PageAnchorNav.astro';
import DiseaseResearchPanel from '../../components/research/DiseaseResearchPanel.astro';
import DiseaseMonthlyBar from '../../components/charts/DiseaseMonthlyBar';
import DiseaseCountryCurve from '../../components/charts/DiseaseCountryCurve';
import { buildChartSourceMeta } from '../../utils/chartMeta';
import { getCountryCoverage } from '../../lib/country-coverage';
import {
  formatReferenceCitation,
  hasCitations,
  normalizeCitationSources,
  referenceLinkLabel,
  referenceTooltip,
  referenceUrl,
  renderCitations,
} from '../../utils/citations';
import { resolveKnowledgeText } from '../../utils/knowledge';
import {
  buildDatasetDistributions,
  buildDatasetStructuredData,
  buildDiseaseMetaDescription,
  buildAlternatePaths,
  buildSeoTitle,
  formatYearRange,
  isIndexableDisease,
  toSeoSlug,
} from '../../lib/seo';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';
import metaRaw from '../../data/meta.json';

export async function getStaticPaths() {
  const diseasesPath = resolve('./src/data/diseases/index.json');
  if (!existsSync(diseasesPath)) return [];
  const diseases = JSON.parse(readFileSync(diseasesPath, 'utf-8')) as any[];
  return diseases.map(d => {
    const disease = toSeoSlug(d.slug) || d.slug;
    return {
      params: { disease },
      props: { diseaseId: d.disease_id, diseaseSlug: disease, locale: 'en' as 'en' | 'zh' },
    };
  });
}

interface Props { diseaseId: string; diseaseSlug: string; locale?: 'en' | 'zh'; }
const { diseaseId, diseaseSlug: disease, locale = 'en' } = Astro.props as Props;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const localeHref = (path: string) => `${prefix}${path}`;

const dataPath = resolve(`./src/data/diseases/${diseaseId.toLowerCase()}.json`);
const knowledgePath = resolve(`./src/data/disease-knowledge/${diseaseId.toLowerCase()}.json`);
const downloadsPath = resolve('./src/data/downloads.json');
let diseaseData: any = null;
let knowledgeData: any = null;
let diseaseDownload: any = null;
if (existsSync(dataPath)) {
  diseaseData = JSON.parse(readFileSync(dataPath, 'utf-8'));
}
if (existsSync(knowledgePath)) {
  knowledgeData = JSON.parse(readFileSync(knowledgePath, 'utf-8'));
}
if (existsSync(downloadsPath)) {
  const downloads = JSON.parse(readFileSync(downloadsPath, 'utf-8')) as any;
  diseaseDownload = (downloads.diseases ?? []).find(
    (entry: any) =>
      entry.disease_id === diseaseId ||
      entry.slug === disease ||
      entry.id === diseaseId.toLowerCase()
  ) ?? null;
}

const categoryZh: Record<string, string> = {
  Viral: '病毒性', Bacterial: '细菌性', Parasitic: '寄生虫', Fungal: '真菌性',
};

const categoryStyles: Record<string, string> = {
  Viral: 'badge-viral',
  Bacterial: 'badge-bacterial',
  Parasitic: 'badge-parasitic',
  Fungal: 'badge-fungal',
};

type BriefSection = {
  key: string;
  labelEn: string;
  labelZh: string;
  en: string;
  zh: string;
  availableEn: boolean;
  availableZh: boolean;
};

const badgeClass = categoryStyles[diseaseData?.category] ?? 'badge-other';
const knowledgeStatus = knowledgeData?.knowledge_status ?? diseaseData?.knowledge_status ?? null;
const knowledgePayloads = [knowledgeData, diseaseData].filter((payload) => (
  payload && (!payload.knowledge_status || payload.knowledge_status === 'published')
));
const missingSectionEn = 'Evidence-backed detail for this section is not available yet.';
const missingSectionZh = '本章节暂无经来源支持的信息。';
const officialSummaryEn = resolveKnowledgeText(knowledgePayloads, 'official_summary', 'en', ['official_intro']);
const officialSummaryZh = resolveKnowledgeText(knowledgePayloads, 'official_summary', 'zh', ['official_intro']);
const officialDefinitionEn = resolveKnowledgeText(knowledgePayloads, 'official_definition', 'en');
const officialDefinitionZh = resolveKnowledgeText(knowledgePayloads, 'official_definition', 'zh');
const clinicalFeaturesEn = resolveKnowledgeText(knowledgePayloads, 'clinical_features', 'en', ['clinical_summary']);
const clinicalFeaturesZh = resolveKnowledgeText(knowledgePayloads, 'clinical_features', 'zh', ['clinical_summary']);
const epidemiologyEn = resolveKnowledgeText(knowledgePayloads, 'epidemiology', 'en');
const epidemiologyZh = resolveKnowledgeText(knowledgePayloads, 'epidemiology', 'zh');
const transmissionEn = resolveKnowledgeText(knowledgePayloads, 'transmission', 'en');
const transmissionZh = resolveKnowledgeText(knowledgePayloads, 'transmission', 'zh');
const riskGroupsEn = resolveKnowledgeText(knowledgePayloads, 'risk_groups', 'en');
const riskGroupsZh = resolveKnowledgeText(knowledgePayloads, 'risk_groups', 'zh');
const preventionEn = resolveKnowledgeText(knowledgePayloads, 'prevention', 'en');
const preventionZh = resolveKnowledgeText(knowledgePayloads, 'prevention', 'zh');
const surveillanceNoteEn = resolveKnowledgeText(knowledgePayloads, 'surveillance_note', 'en');
const surveillanceNoteZh = resolveKnowledgeText(knowledgePayloads, 'surveillance_note', 'zh');
const knowledgeSectionLabels = knowledgeData?.knowledge_section_labels ?? diseaseData?.knowledge_section_labels ?? {};
const sectionLabel = (field: string, language: 'en' | 'zh', fallback: string) => (
  knowledgeSectionLabels?.[field]?.[language] ?? fallback
);
const knowledgeSources = Array.isArray(knowledgeData?.knowledge_sources)
  ? knowledgeData.knowledge_sources
  : Array.isArray(diseaseData?.knowledge_sources)
    ? diseaseData.knowledge_sources
    : [];
const makeSection = (
  key: string,
  labelEn: string,
  labelZh: string,
  en: string | null,
  zh: string | null,
): BriefSection | null => en || zh ? ({
  key,
  labelEn,
  labelZh,
  en: en ?? missingSectionEn,
  zh: zh ?? missingSectionZh,
  availableEn: Boolean(en),
  availableZh: Boolean(zh),
}) : null;
const briefSections = [
  makeSection(
    'definition',
    sectionLabel('definition', 'en', 'Definition'), sectionLabel('definition', 'zh', '定义'), officialDefinitionEn, officialDefinitionZh,
  ),
  makeSection('clinical-features', sectionLabel('clinical_features', 'en', 'Clinical features'), sectionLabel('clinical_features', 'zh', '临床特征'), clinicalFeaturesEn, clinicalFeaturesZh),
  makeSection('epidemiology', sectionLabel('epidemiology', 'en', 'Epidemiology'), sectionLabel('epidemiology', 'zh', '流行病学'), epidemiologyEn, epidemiologyZh),
  makeSection('transmission', sectionLabel('transmission', 'en', 'Transmission'), sectionLabel('transmission', 'zh', '传播/暴露'), transmissionEn, transmissionZh),
  makeSection('risk-groups', sectionLabel('risk_groups', 'en', 'Risk groups'), sectionLabel('risk_groups', 'zh', '高风险人群'), riskGroupsEn, riskGroupsZh),
  makeSection('prevention', sectionLabel('prevention', 'en', 'Prevention'), sectionLabel('prevention', 'zh', '预防'), preventionEn, preventionZh),
  makeSection('surveillance-note', sectionLabel('surveillance_note', 'en', 'Surveillance note'), sectionLabel('surveillance_note', 'zh', '监测说明'), surveillanceNoteEn, surveillanceNoteZh),
].filter(Boolean) as BriefSection[];
const knowledgeProfileAvailable = Boolean(
  briefSections.length > 0
  && (officialSummaryEn || officialSummaryZh || officialDefinitionEn || officialDefinitionZh)
);
const enAvailableSectionCount = briefSections.filter((section) => section.availableEn).length;
const zhAvailableSectionCount = briefSections.filter((section) => section.availableZh).length;
const declaredKnowledgeDisplayMode = knowledgeData?.knowledge_display_mode ?? diseaseData?.knowledge_display_mode;
const knowledgeDisplayMode = knowledgeProfileAvailable
  ? declaredKnowledgeDisplayMode === 'full' ? 'full' : 'partial'
  : 'blocked';
const applicableSectionCount = knowledgeData?.knowledge_applicable_section_count
  ?? diseaseData?.knowledge_applicable_section_count
  ?? 7;
const displaySummaryEn = officialSummaryEn ?? missingSectionEn;
const displaySummaryZh = officialSummaryZh ?? missingSectionZh;
const rawKnowledgeSourceEntries = knowledgeProfileAvailable
  ? knowledgeSources.filter((source: any) => source?.url)
  : [];
const citationTextCorpus = [
  officialSummaryEn,
  officialSummaryZh,
  ...briefSections.flatMap((section) => [section.en, section.zh]),
];
const knowledgeSourceEntries = normalizeCitationSources(rawKnowledgeSourceEntries, citationTextCorpus);
const knowledgeUpdatedAt = knowledgeData?.knowledge_updated_at ?? diseaseData?.knowledge_updated_at ?? null;
const knowledgeUpdatedEn = knowledgeUpdatedAt
  ? new Date(knowledgeUpdatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
const knowledgeUpdatedZh = knowledgeUpdatedAt
  ? new Date(knowledgeUpdatedAt).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
const profileUnavailableMessageEn = knowledgeStatus === 'automating'
  ? 'Evidence enrichment is in progress for this disease profile. Verified surveillance data, coding information, and downloads remain available.'
  : knowledgeStatus === 'requires_review'
    ? 'The available material does not yet pass the evidence-quality threshold for a public disease profile. Verified surveillance data, coding information, and downloads remain available.'
    : 'Source-backed disease background is not available yet. Verified surveillance data, coding information, and downloads remain available.';
const profileUnavailableMessageZh = knowledgeStatus === 'automating'
  ? '该疾病画像正在自动补全可追溯证据。已核验的监测数据、疾病编码和下载功能仍可正常使用。'
  : knowledgeStatus === 'requires_review'
    ? '现有材料尚未达到公开疾病画像的证据质量门槛。已核验的监测数据、疾病编码和下载功能仍可正常使用。'
    : '当前暂无基于可追溯来源的疾病背景信息。已核验的监测数据、疾病编码和下载功能仍可正常使用。';

function fmtNum(n: number | null | undefined) {
  if (!n) return '0';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

let peakMonth = '—';
if (diseaseData?.global_monthly?.cases?.length > 0) {
  const maxIdx = diseaseData.global_monthly.cases.reduce(
    (maxI: number, v: number, i: number, arr: number[]) => v > arr[maxI] ? i : maxI,
    0
  );
  peakMonth = diseaseData.global_monthly.months[maxIdx] ?? '—';
}

const countryMetaByCode = new Map(
  ((metaRaw as any).countries ?? []).map((country: any) => [String(country.code).toUpperCase(), country]),
);
const isSubdivision = (rawCode: string) => {
  const code = rawCode.toUpperCase();
  const metadata = countryMetaByCode.get(code) as any;
  return metadata?.location_type === 'subdivision' || Boolean(metadata?.parent_code) || code.includes('-');
};
const nationalCountrySeries = Object.fromEntries(
  Object.entries(diseaseData?.country_series ?? {}).filter(([code]) => !isSubdivision(code)),
);
const coverageDates = Object.values(nationalCountrySeries)
  .flatMap((series: any) => Array.isArray(series?.dates) ? series.dates : [])
  .filter((date): date is string => typeof date === 'string' && date.length > 0)
  .sort();
const coverageStart = coverageDates[0] ?? null;
const coverageEnd = coverageDates.at(-1) ?? null;
const coverageLabel = coverageStart && coverageEnd ? `${coverageStart} → ${coverageEnd}` : '—';
const reportingCountries = Object.keys(diseaseData?.country_series ?? {})
  .filter((rawCode) => !isSubdivision(rawCode))
  .map((rawCode) => {
    const code = rawCode.toUpperCase();
    const metadata = countryMetaByCode.get(code) as any;
    const coverage = getCountryCoverage(code);
    const nameEn = metadata?.name_en ?? metadata?.name ?? coverage?.name_en ?? code;
    const nameZh = metadata?.name_zh ?? coverage?.name_zh ?? nameEn;
    return { code, nameEn, nameZh };
  })
  .sort((a, b) => a.nameEn.localeCompare(b.nameEn, 'en'));
const countryCount = reportingCountries.length;
const hasDeathsData = diseaseData?.total_deaths > 0
  || Object.values(nationalCountrySeries).some((series: any) =>
    Array.isArray(series?.deaths) && series.deaths.some((value: number) => value > 0)
  );
const chartSourceMeta = buildChartSourceMeta(
  diseaseDownload ? { ...diseaseDownload, source_info: diseaseData?.source_info } : null,
  `${diseaseData?.name_en ?? disease} surveillance dataset`
);
const diseaseDataUrl = diseaseDownload?.site_json_path ?? `/site-data/diseases/${diseaseId.toLowerCase()}.json`;
const diseaseNameEn = diseaseData?.name_en ?? disease ?? 'Disease';
const diseaseNameZh = diseaseData?.name_zh ?? diseaseNameEn;
const diseaseName = zh ? diseaseNameZh : diseaseNameEn;
const diseaseMetaDescriptionEn = buildDiseaseMetaDescription({
  name: diseaseNameEn,
  category: diseaseData?.category,
  countryCount,
  start: coverageStart,
  end: coverageEnd,
});
const diseaseMetaDescription = zh
  ? `${diseaseNameZh}全球监测数据，覆盖${countryCount}个报告国家和地区，包含趋势、国家比较、来源与下载。`
  : diseaseMetaDescriptionEn;
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const diseasePageUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const diseaseSourceUrls = [
  diseaseData?.source_info?.primary_url,
  ...(diseaseData?.source_info?.sources ?? []).map((source: any) => source?.url),
  ...knowledgeSourceEntries.map((source: any) => source?.url),
].filter((url): url is string => typeof url === 'string' && url.length > 0);
const diseaseDatasetStructuredData = buildDatasetStructuredData({
  id: `${diseasePageUrl}#dataset`,
  url: diseasePageUrl,
  name: zh ? `${diseaseNameZh}全球监测数据集` : `${diseaseNameEn} infectious disease surveillance dataset`,
  description: diseaseMetaDescription,
  siteOrigin,
  dateModified: diseaseDownload?.generated_at ?? knowledgeUpdatedAt,
  start: coverageStart,
  end: coverageEnd,
  keywords: (zh ? [diseaseNameZh, diseaseData?.category, '传染病监测', '公共卫生数据'] : [diseaseNameEn, diseaseData?.category, 'infectious disease surveillance', 'public health data'])
    .filter((keyword): keyword is string => typeof keyword === 'string' && keyword.length > 0),
  distributions: buildDatasetDistributions({
    entry: diseaseDownload,
    siteOrigin,
    fallbackSiteJsonPath: diseaseDataUrl,
  }),
  sourceUrls: diseaseSourceUrls,
  identifier: `GIDS:${diseaseId}`,
  version: diseaseDownload?.generated_at ?? knowledgeUpdatedAt,
  variableMeasured: ['reported cases', 'reported deaths', 'incidence rate'],
  includedInDataCatalog: `${siteOrigin}#catalog`,
});
const diseaseConditionStructuredData = {
  '@type': 'MedicalCondition',
  '@id': `${diseasePageUrl}#condition`,
  name: diseaseName,
  alternateName: [diseaseData?.name_zh, diseaseData?.icd_10, diseaseData?.icd_11]
    .filter((value): value is string => typeof value === 'string' && value.length > 0),
  ...(diseaseData?.icd_10 ? {
    code: {
      '@type': 'MedicalCode',
      code: diseaseData.icd_10,
      codingSystem: 'ICD-10',
    },
  } : {}),
  url: diseasePageUrl,
};
const diseaseMedicalPageStructuredData = {
  '@type': 'MedicalWebPage',
  '@id': `${diseasePageUrl}#medical-webpage`,
  url: diseasePageUrl,
  name: diseaseName,
  about: { '@id': `${diseasePageUrl}#condition` },
  mainEntity: { '@id': `${diseasePageUrl}#dataset` },
  dateModified: diseaseDownload?.generated_at ?? knowledgeUpdatedAt ?? undefined,
  medicalAudience: 'MedicalAudience',
};
const diseaseCoverage = formatYearRange(coverageStart, coverageEnd);
const diseaseIndexable = isIndexableDisease({
  countrySeries: diseaseData?.country_series,
  knowledgeStatus,
  knowledgeSources,
});
const diseaseSeo = {
  title: zh ? `${diseaseNameZh}监测数据 ${diseaseCoverage} | GIDS` : buildSeoTitle(diseaseNameEn, 'surveillance data', diseaseCoverage),
  description: diseaseMetaDescription,
  canonicalPath: Astro.url.pathname,
  alternatePaths: diseaseIndexable
    ? buildAlternatePaths(Astro.url.pathname, locale)
    : { en: Astro.url.pathname },
  noindex: !diseaseIndexable,
  pageType: 'MedicalWebPage',
  dateModified: diseaseDownload?.generated_at ?? knowledgeUpdatedAt,
  structuredData: [diseaseMedicalPageStructuredData, diseaseConditionStructuredData, diseaseDatasetStructuredData],
} as const;
---

<ReportLayout
  title={diseaseName}
  description={diseaseMetaDescription}
  structuredData={[diseaseMedicalPageStructuredData, diseaseConditionStructuredData, diseaseDatasetStructuredData]}
  seo={diseaseSeo}
  initialLanguage={locale}
  hideLanguageToggle={!diseaseIndexable}
  breadcrumbs={[
    { label: 'Diseases', labelZh: '疾病', href: localeHref('/diseases/') },
    { label: diseaseData?.name_en ?? disease, labelZh: diseaseData?.name_zh ?? diseaseData?.name_en ?? disease },
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    {!diseaseData ? (
      <div class="card p-10 sm:p-12 text-center text-[rgb(var(--text-muted))]">
        {zh ? '未找到疾病数据。' : 'Disease data not found.'} <a href={localeHref('/diseases/')} class="text-brand-400 hover:underline">{zh ? '← 返回疾病目录' : '← Back to directory'}</a>
      </div>
    ) : (
      <>
        <section id="overview" class="academic-hero scroll-mt-24">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[rgb(var(--border))/0.68] pb-3">
            <p class="academic-kicker">
              {zh ? '疾病概览' : 'Disease overview'}
            </p>
            <span class={`inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-semibold ${badgeClass}`}>
              <span>
                {zh ? categoryZh[diseaseData.category] ?? diseaseData.category : diseaseData.category}
              </span>
            </span>
          </div>

          <div class="mt-5 space-y-4">
            <div class="space-y-4">
              <div>
                <h1 class="academic-title leading-tight">
                  <span>
                    {zh ? diseaseData.name_zh : diseaseData.name_en}
                  </span>
                </h1>
                <p class="academic-subtitle mt-2">
                  <span>
                    {zh ? diseaseData.name_en : diseaseData.name_zh}
                  </span>
                </p>
              </div>

              {knowledgeProfileAvailable ? (
                <div class="space-y-5">
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-[rgb(var(--border))/0.5] py-2 text-xs text-[rgb(var(--text-faint))]">
                    <span
                      class="font-semibold uppercase tracking-[0.1em]"
                    >
                      {zh ? '有证据支持的资料' : 'Evidence-backed information'}
                    </span>
                    <span>
                      {zh ? `英文 ${enAvailableSectionCount}/${applicableSectionCount} 个适用章节 · 中文 ${zhAvailableSectionCount}/${applicableSectionCount} 个适用章节` : `EN ${enAvailableSectionCount}/${applicableSectionCount} applicable sections · ZH ${zhAvailableSectionCount}/${applicableSectionCount} applicable sections`}
                    </span>
                    {knowledgeUpdatedAt && (
                      <span>{zh ? `更新于 ${knowledgeUpdatedZh}` : `Updated ${knowledgeUpdatedEn}`}</span>
                    )}
                  </div>

                  {knowledgeDisplayMode === 'partial' && (
                    <p
                      class="academic-note"
                    >
                      {zh ? '仅展示有可用来源支持的信息。' : 'Only information supported by available sources is shown.'}
                    </p>
                  )}

                  {(officialSummaryEn || officialSummaryZh) && (
                    hasCitations(displaySummaryEn) || hasCitations(displaySummaryZh) ? (
                      <p class="max-w-4xl text-sm leading-6 text-[rgb(var(--text))] citation-text"
                        set:html={renderCitations(zh ? displaySummaryZh : displaySummaryEn, knowledgeSourceEntries)}
                      />
                    ) : (
                      <p class="max-w-4xl text-sm leading-6 text-[rgb(var(--text))]">
                        {zh ? displaySummaryZh : displaySummaryEn}
                      </p>
                    )
                  )}

                  <details class="disease-profile-details">
                    <summary>
                      <span>{zh ? '阅读完整临床与流行病学资料' : 'Read the full clinical and epidemiological profile'}</span>
                      <span>{briefSections.length + (knowledgeSourceEntries.length > 0 ? 1 : 0)}</span>
                    </summary>
                  <div class="profile-flow">
                    {briefSections.map((section) => (
                      <article class="profile-flow-item">
                        <div class="academic-meta-label">
                          {zh ? section.labelZh : section.labelEn}
                        </div>
                        {section.availableEn !== section.availableZh && (
                          <div
                            class="mt-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-amber-500"
                          >
                            {zh ? (section.availableZh ? '仅有中文来源内容' : '仅有英文来源内容') : (section.availableEn ? 'English source text only' : 'Chinese source text only')}
                          </div>
                        )}
                        {hasCitations(section.en) || hasCitations(section.zh) ? (
                          <p class="mt-1 text-sm leading-6 text-[rgb(var(--text-muted))] citation-text"
                            set:html={renderCitations(zh ? section.zh : section.en, knowledgeSourceEntries)}
                          />
                        ) : (
                          <p class="mt-1 text-sm leading-6 text-[rgb(var(--text-muted))]">
                            {zh ? section.zh : section.en}
                          </p>
                        )}
                      </article>
                    ))}

                    {knowledgeSourceEntries.length > 0 && (
                    <article class="profile-flow-item">
                      <div class="academic-meta-label">{zh ? '参考文献' : 'References'}</div>
                      <ol class="mt-3 space-y-2">
                        {knowledgeSourceEntries.map((source: any, index: number) => {
                          const citationIndex = Number(source.citation_index ?? index + 1);
                          const sourceUrl = referenceUrl(source);
                          return (
                          <li id={`ref-${citationIndex}`}>
                            <div
                              title={referenceTooltip(source, citationIndex)}
                              class="group flex items-start gap-3 text-sm leading-6 text-[rgb(var(--text-muted))]"
                            >
                              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center border border-[rgb(var(--border))/0.72] bg-[rgb(var(--surface-raised))/0.34] font-mono text-[10px] font-semibold text-[rgb(var(--text-faint))]">
                                {citationIndex}
                              </span>
                              <span class="min-w-0">
                                <span class="font-semibold text-[rgb(var(--text-strong))]">
                                  {formatReferenceCitation(source)}
                                </span>
                                {sourceUrl && (
                                  <span class="mt-1 block break-all text-xs text-[rgb(var(--text-faint))]">
                                    {referenceLinkLabel(source)}:{' '}
                                    <a
                                      href={sourceUrl}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="text-[rgb(var(--color-brand))] underline-offset-2 hover:underline"
                                    >
                                      {sourceUrl}
                                    </a>
                                  </span>
                                )}
                              </span>
                            </div>
                          </li>
                          );
                        })}
                      </ol>
                    </article>
                    )}
                  </div>
                  </details>
                </div>
              ) : (
                <div class="space-y-3">
                  <p class="academic-kicker">
                    {zh ? '背景资料' : 'Background information'}
                  </p>
                  <p class="max-w-none text-sm leading-6 text-[rgb(var(--text-muted))]">
                    {zh ? profileUnavailableMessageZh : profileUnavailableMessageEn}
                  </p>
                </div>
              )}

              <div class="grid gap-5 border-t border-[rgb(var(--border))/0.58] pt-5 lg:grid-cols-2">
                <article class="academic-note bg-transparent">
                  <div class="academic-meta-label">{zh ? '编码登记' : 'Coding Register'}</div>
                  <dl class="mt-3 grid gap-4 sm:grid-cols-2">
                    <div>
                      <dt class="academic-meta-label">ICD-10</dt>
                      <dd class="mt-1 font-mono text-sm text-[rgb(var(--text-strong))]">{diseaseData.icd_10 ?? '—'}</dd>
                    </div>
                    <div>
                      <dt class="academic-meta-label">ICD-11</dt>
                      <dd class="mt-1 font-mono text-sm text-[rgb(var(--text-strong))]">{diseaseData.icd_11 ?? '—'}</dd>
                    </div>
                  </dl>
                </article>

                <article class="academic-note bg-transparent">
                  <div class="academic-meta-label">{zh ? '核心统计' : 'Key Statistics'}</div>
                  <dl class="mt-3 grid gap-4 sm:grid-cols-2">
                    <div>
                      <dt class="academic-meta-label">{zh ? '累计病例' : 'Total cases'}</dt>
                      <dd class="academic-meta-value font-serif">{fmtNum(diseaseData.total_cases)}</dd>
                    </div>
                    {hasDeathsData && (
                      <div>
                        <dt class="academic-meta-label">{zh ? '累计死亡' : 'Total deaths'}</dt>
                        <dd class="academic-meta-value font-serif text-red-400">{fmtNum(diseaseData.total_deaths)}</dd>
                      </div>
                    )}
                    <div>
                      <dt class="academic-meta-label">{zh ? '峰值月份' : 'Peak month'}</dt>
                      <dd class="academic-meta-value font-serif text-amber-400">{peakMonth}</dd>
                    </div>
                    <div>
                      <dt class="academic-meta-label">{zh ? '覆盖区间' : 'Coverage'}</dt>
                      <dd
                        class="academic-meta-value text-sm font-medium"
                      >
                        {zh ? `${countryCount} 个报告国家 · ${coverageLabel}` : `${countryCount} reporting countries · ${coverageLabel}`}
                      </dd>
                    </div>
                  </dl>
                </article>
              </div>
            </div>
          </div>
        </section>

        <PageAnchorNav locale={locale} items={[
          { href: '#coverage', label: 'Coverage', labelZh: '覆盖范围' },
          { href: '#trends', label: 'Trends & comparison', labelZh: '趋势与比较' },
          { href: '#research', label: 'Research', labelZh: '研究证据' },
          { href: '#downloads', label: 'Download & methods', labelZh: '下载与方法' },
        ]} />

        {countryCount > 0 && (
          <section id="coverage" class="figure-panel scroll-mt-24">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <p class="figure-kicker">{zh ? '数据覆盖' : 'Coverage'}</p>
                <h2 class="figure-title">
                  {zh ? '报告国家和地区' : 'Reporting countries and regions'}
                </h2>
              </div>
              <span
                class="site-control-pill inline-flex w-fit items-center border px-3 py-1.5 text-xs"
              >
                {zh ? `${countryCount} 个国家/地区` : `${countryCount} ${countryCount === 1 ? 'location' : 'locations'}`}
              </span>
            </div>
            <ul class="reporting-country-grid">
              {reportingCountries.map(({ code, nameEn, nameZh }) => (
                <li>
                  <a
                    href={localeHref(`/countries/${code.toLowerCase()}/`)}
                    class="reporting-country-link focus-ring group"
                    aria-label={zh ? `${nameZh}监测资料` : `${nameEn} surveillance profile`}
                  >
                    <CountryFlag code={code} name={`${nameEn} flag`} sizeClass="h-8 w-11 shrink-0" />
                    <span class="min-w-0 flex-1">
                      <span
                        class="reporting-country-name"
                      >
                        {zh ? nameZh : nameEn}
                      </span>
                      <span class="reporting-country-code">{code}</span>
                    </span>
                    <svg class="reporting-country-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="m7.5 4.5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {countryCount > 0 && (
          <section id="trends" class="figure-panel scroll-mt-24">
              <h2 class="figure-title">
                {zh ? '各报告国家的趋势' : 'Trends by reporting country'}
              </h2>
              <div class="mt-5">
              <DiseaseCountryCurve
                client:visible
                dataUrl={diseaseDataUrl}
                topN={countryCount}
                height={380}
                sourceMeta={chartSourceMeta}
                initialLanguage={locale}
              />
            </div>
          </section>
        )}

        {diseaseData.global_monthly?.months?.length > 0 && (
          <section class="figure-panel">
              <h2 class="figure-title">
                {zh ? '月度变化趋势' : 'Monthly patterns over time'}
              </h2>
              <div class="mt-5">
              <DiseaseMonthlyBar
                client:visible
                dataUrl={diseaseDataUrl}
                height={360}
                sourceMeta={chartSourceMeta}
                initialLanguage={locale}
              />
            </div>
          </section>
        )}

        <div id="research" class="scroll-mt-24"><DiseaseResearchPanel diseaseId={diseaseId} locale={locale} /></div>

        {diseaseDownload && (
          <div id="downloads" class="scroll-mt-24"><DownloadPanel
            entry={{ ...diseaseDownload, source_info: diseaseData?.source_info }}
            title="Data access"
            initialLanguage={locale}
            descriptionEn="Page dataset index with source links and update metadata."
            descriptionZh="本页面数据索引，含来源链接和更新信息。"
          /></div>
        )}

        <div class="border-t border-[rgb(var(--border))/0.72] pt-4">
          <a href={localeHref('/diseases/')} class="flex items-center gap-2 text-sm text-[rgb(var(--text-muted))] transition-colors hover:text-brand-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span>{zh ? '返回疾病目录' : 'Back to Disease Directory'}</span>
          </a>
        </div>
      </>
    )}
  </div>
</ReportLayout>

<style>
  .reporting-country-grid { display: grid; grid-template-columns: 1fr; gap: .75rem; margin-top: 1.25rem; }
  .reporting-country-link { display: flex; min-height: 3.5rem; align-items: center; gap: .75rem; padding: .5rem .75rem; color: rgb(var(--text-strong)); background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); transition: border-color .18s ease, background-color .18s ease; }
  .reporting-country-link:hover { background: rgb(var(--bg-soft)); border-color: rgb(var(--border-soft)); }
  .reporting-country-name { display: block; overflow: hidden; font-size: .875rem; font-weight: 600; line-height: 1.25rem; text-overflow: ellipsis; white-space: nowrap; }
  .reporting-country-code { display: block; margin-top: .125rem; color: rgb(var(--text-faint)); font-family: ui-monospace, monospace; font-size: .625rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; }
  .reporting-country-arrow { width: 1rem; height: 1rem; flex: 0 0 auto; color: rgb(var(--text-faint)); transition: color .18s ease, transform .18s ease; }
  .reporting-country-link:hover .reporting-country-arrow { color: rgb(var(--color-brand)); transform: translateX(2px); }
  .profile-flow { column-count: 1; column-gap: 2rem; }
  .profile-flow-item { display: inline-block; width: 100%; margin: 0 0 1.25rem; padding-left: 1rem; border-left: 2px solid rgb(var(--border) / .56); break-inside: avoid; }
  .disease-profile-details { border-top: 1px solid rgb(var(--border)); }
  .disease-profile-details > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .8rem 0; color: rgb(var(--color-teal)); cursor: pointer; font-size: .78rem; font-weight: 650; list-style: none; }
  .disease-profile-details > summary::-webkit-details-marker { display: none; }
  .disease-profile-details > summary span:last-child { display: grid; min-width: 1.8rem; height: 1.8rem; place-items: center; color: rgb(var(--text-muted)); border: 1px solid rgb(var(--border)); font-family: ui-monospace, monospace; font-size: .64rem; }
  .disease-profile-details .profile-flow { padding-top: .75rem; }
  @media (min-width: 640px) { .reporting-country-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1024px) { .reporting-country-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } .profile-flow { column-count: 2; column-gap: 2.5rem; column-rule: 1px solid rgb(var(--border) / .5); } }
  @media (min-width: 1280px) { .reporting-country-grid { grid-template-columns: repeat(4,minmax(0,1fr)); } }
</style>
