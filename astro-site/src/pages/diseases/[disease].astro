---
// src/pages/diseases/[disease].astro — Individual disease detail page
import ReportLayout from '../../layouts/ReportLayout.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
import DiseaseMonthlyBar from '../../components/charts/DiseaseMonthlyBar';
import DiseaseCountryCurve from '../../components/charts/DiseaseCountryCurve';
import { buildChartSourceMeta } from '../../utils/chartMeta';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

export async function getStaticPaths() {
  const diseasesPath = resolve('./src/data/diseases/index.json');
  if (!existsSync(diseasesPath)) return [];
  const diseases = JSON.parse(readFileSync(diseasesPath, 'utf-8')) as any[];
  return diseases.map(d => ({
    params: { disease: d.slug },
    props: { diseaseId: d.disease_id },
  }));
}

const { disease } = Astro.params;
const { diseaseId } = Astro.props as { diseaseId: string };

const dataPath = resolve(`./src/data/diseases/${diseaseId.toLowerCase()}.json`);
const downloadsPath = resolve('./src/data/downloads.json');
let diseaseData: any = null;
let diseaseDownload: any = null;
if (existsSync(dataPath)) {
  diseaseData = JSON.parse(readFileSync(dataPath, 'utf-8'));
}
if (existsSync(downloadsPath)) {
  const downloads = JSON.parse(readFileSync(downloadsPath, 'utf-8')) as any;
  diseaseDownload = (downloads.diseases ?? []).find(
    (entry: any) =>
      entry.disease_id === diseaseId ||
      entry.slug === disease ||
      entry.id === diseaseId.toLowerCase()
  ) ?? null;
}

const categoryZh: Record<string, string> = {
  Viral: '病毒性', Bacterial: '细菌性', Parasitic: '寄生虫', Fungal: '真菌性',
};

const categoryStyles: Record<string, string> = {
  Viral: 'bg-blue-500/15 text-blue-300 ring-1 ring-blue-500/30',
  Bacterial: 'bg-amber-500/15 text-amber-300 ring-1 ring-amber-500/30',
  Parasitic: 'bg-green-500/15 text-green-300 ring-1 ring-green-500/30',
  Fungal: 'bg-purple-500/15 text-purple-300 ring-1 ring-purple-500/30',
};

const badgeClass = categoryStyles[diseaseData?.category] ?? 'bg-slate-500/15 text-slate-300 ring-1 ring-slate-500/30';

function fmtNum(n: number | null | undefined) {
  if (!n) return '0';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

let peakMonth = '—';
if (diseaseData?.global_monthly?.cases?.length > 0) {
  const maxIdx = diseaseData.global_monthly.cases.reduce(
    (maxI: number, v: number, i: number, arr: number[]) => v > arr[maxI] ? i : maxI,
    0
  );
  peakMonth = diseaseData.global_monthly.months[maxIdx] ?? '—';
}

const coverageDates = Object.values(diseaseData?.country_series ?? {})
  .flatMap((series: any) => Array.isArray(series?.dates) ? series.dates : []);
const coverageStart = coverageDates[0] ?? null;
const coverageEnd = coverageDates.at(-1) ?? null;
const coverageLabel = coverageStart && coverageEnd ? `${coverageStart} → ${coverageEnd}` : '—';
const countryCount = Object.keys(diseaseData?.country_series ?? {}).length;
const hasDeathsData = diseaseData?.total_deaths > 0
  || Object.values(diseaseData?.country_series ?? {}).some((series: any) =>
    Array.isArray(series?.deaths) && series.deaths.some((value: number) => value > 0)
  );
const chartSourceMeta = buildChartSourceMeta(
  diseaseDownload,
  `${diseaseData?.name_en ?? disease} surveillance dataset`
);
const diseaseDataUrl = diseaseDownload?.site_json_path ?? `/site-data/diseases/${diseaseId.toLowerCase()}.json`;
---

<ReportLayout
  title={diseaseData?.name_en ?? disease}
  description={diseaseData?.description ?? `Disease surveillance data for ${diseaseData?.name_en ?? disease}`}
  breadcrumbs={[
    { label: 'Diseases', href: '/diseases/' },
    { label: diseaseData?.name_en ?? disease },
  ]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    {!diseaseData ? (
      <div class="text-center py-24 text-slate-500">
        Disease data not found. <a href="/diseases/" class="text-brand-400 hover:underline">← Back to directory</a>
      </div>
    ) : (
      <>
        <section class="academic-hero">
          <div class="flex items-start justify-between flex-wrap gap-4 mb-6">
            <div class="space-y-4">
              <p class="academic-kicker" data-lang-en="Disease Monograph" data-lang-zh="疾病专题档案">
                Disease Monograph
              </p>
              <span class={`inline-flex items-center rounded-full px-3 py-1 text-sm font-medium ${badgeClass}`}>
                <span data-lang-en={diseaseData.category} data-lang-zh={categoryZh[diseaseData.category] ?? diseaseData.category}>
                  {diseaseData.category}
                </span>
              </span>
            </div>
            <div class="flex items-center gap-3 text-xs text-slate-600 font-mono">
              {diseaseData.icd_10 && <span>ICD-10: {diseaseData.icd_10}</span>}
              {diseaseData.icd_11 && <span>ICD-11: {diseaseData.icd_11}</span>}
            </div>
          </div>

          <h1 class="academic-title mb-2">
            <span data-lang-en={diseaseData.name_en} data-lang-zh={diseaseData.name_zh}>
              {diseaseData.name_en}
            </span>
          </h1>
          <p class="academic-subtitle mb-5">
            <span data-lang-en={diseaseData.name_zh} data-lang-zh={diseaseData.name_en}>
              {diseaseData.name_zh}
            </span>
          </p>

          {diseaseData.description && (
            <p class="academic-lead border-t border-slate-700/50 pt-5">
              {diseaseData.description}
            </p>
          )}

          <div class="academic-meta-grid mt-6 pt-6 border-t border-slate-700/50">
            <div class="academic-meta-item">
              <div class="academic-meta-label" data-lang-en="Total cases" data-lang-zh="累计病例">Total cases</div>
              <div class="academic-meta-value font-serif">{fmtNum(diseaseData.total_cases)}</div>
            </div>
            {hasDeathsData && (
              <div class="academic-meta-item">
                <div class="academic-meta-label" data-lang-en="Total deaths" data-lang-zh="累计死亡">Total deaths</div>
                <div class="academic-meta-value font-serif text-red-400">{fmtNum(diseaseData.total_deaths)}</div>
              </div>
            )}
            <div class="academic-meta-item">
              <div class="academic-meta-label" data-lang-en="Peak month" data-lang-zh="峰值月份">Peak month</div>
              <div class="academic-meta-value font-serif text-amber-400">{peakMonth}</div>
            </div>
            <div class="academic-meta-item">
              <div class="academic-meta-label" data-lang-en="Coverage" data-lang-zh="覆盖区间">Coverage</div>
              <div class="academic-meta-value text-sm font-medium">{coverageLabel}</div>
            </div>
          </div>

          <div class="academic-note mt-6">
            <span data-lang-en="Coverage spans " data-lang-zh="当前条目覆盖 ">Coverage spans </span>
            <span class="font-semibold text-slate-200">{countryCount}</span>
            <span data-lang-en=" reporting countries in the harmonised site dataset." data-lang-zh=" 个国家的标准化站点数据。"> reporting countries in the harmonised site dataset.</span>
          </div>
        </section>

        {countryCount > 0 && (
          <section class="figure-panel">
            <p class="figure-kicker" data-lang-en="Figure 1" data-lang-zh="图 1">Figure 1</p>
            <h2 class="figure-title" data-lang-en="Full Historical Trend" data-lang-zh="完整历史趋势">
              Full Historical Trend
            </h2>
            <p class="figure-caption" data-lang-en="Country-level historical trajectories for this disease across all available reporting jurisdictions." data-lang-zh="展示该疾病在所有可用报告国家中的历史变化轨迹。">
              Country-level historical trajectories for this disease across all available reporting jurisdictions.
            </p>
            <div class="mt-6">
              <DiseaseCountryCurve
                client:only="react"
                dataUrl={diseaseDataUrl}
                topN={countryCount}
                height={380}
                sourceMeta={chartSourceMeta}
              />
            </div>
          </section>
        )}

        {diseaseData.global_monthly?.months?.length > 0 && (
          <section class="figure-panel">
            <p class="figure-kicker" data-lang-en="Figure 2" data-lang-zh="图 2">Figure 2</p>
            <h2 class="figure-title" data-lang-en="Year-over-Year Monthly Comparison" data-lang-zh="逐年月度对比">
              Year-over-Year Monthly Comparison
            </h2>
            <p class="figure-caption" data-lang-en="Calendar-month totals compared year over year to highlight seasonality and structural shifts in reporting intensity." data-lang-zh="按自然月进行逐年对比，用于观察季节性及报告强度的结构性变化。">
              Calendar-month totals compared year over year to highlight seasonality and structural shifts in reporting intensity.
            </p>
            <div class="mt-6">
              <DiseaseMonthlyBar
                client:only="react"
                dataUrl={diseaseDataUrl}
                height={360}
                sourceMeta={chartSourceMeta}
              />
            </div>
          </section>
        )}

        {diseaseDownload && (
          <DownloadPanel
            entry={diseaseDownload}
            title="Download Disease Dataset"
            descriptionEn="Download the full multi-country disease dataset behind this page in JSON or CSV, including source metadata."
            descriptionZh="下载当前疾病页面对应的多国家数据集，支持 JSON 和 CSV，并附带数据源信息。"
          />
        )}

        <div class="border-t border-slate-800 pt-4">
          <a href="/diseases/" class="flex items-center gap-2 text-sm text-slate-500 transition-colors hover:text-brand-400">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span data-lang-en="Back to Disease Directory" data-lang-zh="返回疾病目录">Back to Disease Directory</span>
          </a>
        </div>
      </>
    )}
  </div>
</ReportLayout>
