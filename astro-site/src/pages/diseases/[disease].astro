---
// src/pages/diseases/[disease].astro — Individual disease detail page
import ReportLayout from '../../layouts/ReportLayout.astro';
import DownloadPanel from '../../components/DownloadPanel.astro';
import DiseaseMonthlyBar from '../../components/charts/DiseaseMonthlyBar';
import DiseaseCountryCurve from '../../components/charts/DiseaseCountryCurve';
import { buildChartSourceMeta } from '../../utils/chartMeta';
import {
  formatReferenceCitation,
  hasCitations,
  normalizeCitationSources,
  referenceLinkLabel,
  referenceTooltip,
  referenceUrl,
  renderCitations,
} from '../../utils/citations';
import { readFileSync, existsSync } from 'fs';
import { resolve } from 'path';

export async function getStaticPaths() {
  const diseasesPath = resolve('./src/data/diseases/index.json');
  if (!existsSync(diseasesPath)) return [];
  const diseases = JSON.parse(readFileSync(diseasesPath, 'utf-8')) as any[];
  return diseases.map(d => ({
    params: { disease: d.slug },
    props: { diseaseId: d.disease_id },
  }));
}

const { disease } = Astro.params;
const { diseaseId } = Astro.props as { diseaseId: string };

const dataPath = resolve(`./src/data/diseases/${diseaseId.toLowerCase()}.json`);
const knowledgePath = resolve(`./src/data/disease-knowledge/${diseaseId.toLowerCase()}.json`);
const downloadsPath = resolve('./src/data/downloads.json');
let diseaseData: any = null;
let knowledgeData: any = null;
let diseaseDownload: any = null;
if (existsSync(dataPath)) {
  diseaseData = JSON.parse(readFileSync(dataPath, 'utf-8'));
}
if (existsSync(knowledgePath)) {
  knowledgeData = JSON.parse(readFileSync(knowledgePath, 'utf-8'));
}
if (existsSync(downloadsPath)) {
  const downloads = JSON.parse(readFileSync(downloadsPath, 'utf-8')) as any;
  diseaseDownload = (downloads.diseases ?? []).find(
    (entry: any) =>
      entry.disease_id === diseaseId ||
      entry.slug === disease ||
      entry.id === diseaseId.toLowerCase()
  ) ?? null;
}

const categoryZh: Record<string, string> = {
  Viral: '病毒性', Bacterial: '细菌性', Parasitic: '寄生虫', Fungal: '真菌性',
};

const categoryStyles: Record<string, string> = {
  Viral: 'badge-viral',
  Bacterial: 'badge-bacterial',
  Parasitic: 'badge-parasitic',
  Fungal: 'badge-fungal',
};

type BriefSection = {
  key: string;
  labelEn: string;
  labelZh: string;
  en: string;
  zh: string;
};

const badgeClass = categoryStyles[diseaseData?.category] ?? 'badge-other';
const knowledgeStatus = knowledgeData?.knowledge_status ?? diseaseData?.knowledge_status ?? null;
const knowledgeProfileAvailable = Boolean(
  knowledgeData?.knowledge_profile_available ?? diseaseData?.knowledge_profile_available ?? false
);
const officialIntroEn = knowledgeProfileAvailable
  ? (knowledgeData?.official_intro_en ?? diseaseData?.official_intro_en ?? diseaseData?.official_summary_en ?? null)
  : null;
const officialIntroZh = knowledgeProfileAvailable
  ? (knowledgeData?.official_intro_zh ?? diseaseData?.official_intro_zh ?? diseaseData?.official_summary_zh ?? null)
  : null;
const officialSummaryEn = knowledgeProfileAvailable
  ? (knowledgeData?.official_summary_en ?? diseaseData?.official_summary_en ?? officialIntroEn ?? null)
  : null;
const officialSummaryZh = knowledgeProfileAvailable
  ? (knowledgeData?.official_summary_zh ?? diseaseData?.official_summary_zh ?? officialIntroZh ?? officialSummaryEn)
  : null;
const officialDefinitionEn = knowledgeProfileAvailable ? (knowledgeData?.official_definition_en ?? diseaseData?.official_definition_en ?? null) : null;
const officialDefinitionZh = knowledgeProfileAvailable ? (knowledgeData?.official_definition_zh ?? diseaseData?.official_definition_zh ?? null) : null;
const clinicalFeaturesEn = knowledgeProfileAvailable ? (knowledgeData?.clinical_features_en ?? diseaseData?.clinical_features_en ?? diseaseData?.clinical_summary_en ?? null) : null;
const clinicalFeaturesZh = knowledgeProfileAvailable ? (knowledgeData?.clinical_features_zh ?? diseaseData?.clinical_features_zh ?? diseaseData?.clinical_summary_zh ?? null) : null;
const epidemiologyEn = knowledgeProfileAvailable ? (knowledgeData?.epidemiology_en ?? diseaseData?.epidemiology_en ?? null) : null;
const epidemiologyZh = knowledgeProfileAvailable ? (knowledgeData?.epidemiology_zh ?? diseaseData?.epidemiology_zh ?? null) : null;
const transmissionEn = knowledgeProfileAvailable ? (knowledgeData?.transmission_en ?? diseaseData?.transmission_en ?? null) : null;
const transmissionZh = knowledgeProfileAvailable ? (knowledgeData?.transmission_zh ?? diseaseData?.transmission_zh ?? null) : null;
const riskGroupsEn = knowledgeProfileAvailable ? (knowledgeData?.risk_groups_en ?? diseaseData?.risk_groups_en ?? null) : null;
const riskGroupsZh = knowledgeProfileAvailable ? (knowledgeData?.risk_groups_zh ?? diseaseData?.risk_groups_zh ?? null) : null;
const preventionEn = knowledgeProfileAvailable ? (knowledgeData?.prevention_en ?? diseaseData?.prevention_en ?? null) : null;
const preventionZh = knowledgeProfileAvailable ? (knowledgeData?.prevention_zh ?? diseaseData?.prevention_zh ?? null) : null;
const surveillanceNoteEn = knowledgeProfileAvailable ? (knowledgeData?.surveillance_note_en ?? diseaseData?.surveillance_note_en ?? null) : null;
const surveillanceNoteZh = knowledgeProfileAvailable ? (knowledgeData?.surveillance_note_zh ?? diseaseData?.surveillance_note_zh ?? null) : null;
const knowledgeSources = Array.isArray(knowledgeData?.knowledge_sources)
  ? knowledgeData.knowledge_sources
  : Array.isArray(diseaseData?.knowledge_sources)
    ? diseaseData.knowledge_sources
    : [];
const rawKnowledgeSourceEntries = knowledgeProfileAvailable
  ? knowledgeSources.filter((source: any) => source?.url)
  : [];
const briefSections = [
  officialDefinitionEn && {
    key: 'definition',
    labelEn: 'Definition',
    labelZh: '定义',
    en: officialDefinitionEn,
    zh: officialDefinitionZh ?? officialDefinitionEn,
  },
  clinicalFeaturesEn && {
    key: 'clinical-features',
    labelEn: 'Clinical features',
    labelZh: '临床特征',
    en: clinicalFeaturesEn,
    zh: clinicalFeaturesZh ?? clinicalFeaturesEn,
  },
  epidemiologyEn && {
    key: 'epidemiology',
    labelEn: 'Epidemiology',
    labelZh: '流行病学',
    en: epidemiologyEn,
    zh: epidemiologyZh ?? epidemiologyEn,
  },
  transmissionEn && {
    key: 'transmission',
    labelEn: 'Transmission',
    labelZh: '传播/暴露',
    en: transmissionEn,
    zh: transmissionZh ?? transmissionEn,
  },
  riskGroupsEn && {
    key: 'risk-groups',
    labelEn: 'Risk groups',
    labelZh: '高风险人群',
    en: riskGroupsEn,
    zh: riskGroupsZh ?? riskGroupsEn,
  },
  preventionEn && {
    key: 'prevention',
    labelEn: 'Prevention',
    labelZh: '预防',
    en: preventionEn,
    zh: preventionZh ?? preventionEn,
  },
  surveillanceNoteEn && {
    key: 'surveillance-note',
    labelEn: 'Surveillance note',
    labelZh: '监测说明',
    en: surveillanceNoteEn,
    zh: surveillanceNoteZh ?? surveillanceNoteEn,
  },
].filter(Boolean) as BriefSection[];
const citationTextCorpus = [
  officialSummaryEn,
  officialSummaryZh,
  ...briefSections.flatMap((section) => [section.en, section.zh]),
];
const knowledgeSourceEntries = normalizeCitationSources(rawKnowledgeSourceEntries, citationTextCorpus);
const knowledgeUpdatedAt = knowledgeData?.knowledge_updated_at ?? diseaseData?.knowledge_updated_at ?? null;
const knowledgeUpdatedEn = knowledgeUpdatedAt
  ? new Date(knowledgeUpdatedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
const knowledgeUpdatedZh = knowledgeUpdatedAt
  ? new Date(knowledgeUpdatedAt).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })
  : null;
const profileUnavailableMessageEn = knowledgeStatus === 'requires_review'
  ? 'This disease profile is still under review and will be generated by the multi-expert pipeline when ready. Surveillance charts and downloadable datasets remain available below.'
  : 'A public disease profile is not shown for this disease at the moment. Surveillance charts and downloadable datasets remain available below.';
const profileUnavailableMessageZh = knowledgeStatus === 'requires_review'
  ? '该疾病的 Disease Profile 目前仍在复核中，后续会由多专家流程生成。下方仍保留监测图表与可下载数据。'
  : '该疾病当前暂不展示公开 Disease Profile。下方仍保留监测图表与可下载数据。';

function fmtNum(n: number | null | undefined) {
  if (!n) return '0';
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

let peakMonth = '—';
if (diseaseData?.global_monthly?.cases?.length > 0) {
  const maxIdx = diseaseData.global_monthly.cases.reduce(
    (maxI: number, v: number, i: number, arr: number[]) => v > arr[maxI] ? i : maxI,
    0
  );
  peakMonth = diseaseData.global_monthly.months[maxIdx] ?? '—';
}

const coverageDates = Object.values(diseaseData?.country_series ?? {})
  .flatMap((series: any) => Array.isArray(series?.dates) ? series.dates : []);
const coverageStart = coverageDates[0] ?? null;
const coverageEnd = coverageDates.at(-1) ?? null;
const coverageLabel = coverageStart && coverageEnd ? `${coverageStart} → ${coverageEnd}` : '—';
const countryCount = Object.keys(diseaseData?.country_series ?? {}).length;
const hasDeathsData = diseaseData?.total_deaths > 0
  || Object.values(diseaseData?.country_series ?? {}).some((series: any) =>
    Array.isArray(series?.deaths) && series.deaths.some((value: number) => value > 0)
  );
const chartSourceMeta = buildChartSourceMeta(
  diseaseDownload,
  `${diseaseData?.name_en ?? disease} surveillance dataset`
);
const diseaseDataUrl = diseaseDownload?.site_json_path ?? `/site-data/diseases/${diseaseId.toLowerCase()}.json`;
---

<ReportLayout
  title={diseaseData?.name_en ?? disease}
  description={diseaseData?.description ?? `Disease surveillance data for ${diseaseData?.name_en ?? disease}`}
  breadcrumbs={[
    { label: 'Diseases', href: '/diseases/' },
    { label: diseaseData?.name_en ?? disease },
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    {!diseaseData ? (
      <div class="card p-10 sm:p-12 text-center text-[rgb(var(--text-muted))]">
        Disease data not found. <a href="/diseases/" class="text-brand-400 hover:underline">← Back to directory</a>
      </div>
    ) : (
      <>
        <section class="academic-hero">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[rgb(var(--border))/0.68] pb-3">
            <p class="academic-kicker" data-lang-en={knowledgeProfileAvailable ? 'Disease Profile' : 'Disease Data Overview'} data-lang-zh={knowledgeProfileAvailable ? '疾病画像' : '疾病数据概览'}>
              {knowledgeProfileAvailable ? 'Disease Profile' : 'Disease Data Overview'}
            </p>
            <span class={`inline-flex items-center rounded-none px-2.5 py-0.5 text-xs font-semibold ${badgeClass}`}>
              <span data-lang-en={diseaseData.category} data-lang-zh={categoryZh[diseaseData.category] ?? diseaseData.category}>
                {diseaseData.category}
              </span>
            </span>
          </div>

          <div class="mt-5 space-y-4">
            <div class="space-y-4">
              <div>
                <h1 class="academic-title leading-tight">
                  <span data-lang-en={diseaseData.name_en} data-lang-zh={diseaseData.name_zh}>
                    {diseaseData.name_en}
                  </span>
                </h1>
                <p class="academic-subtitle mt-2">
                  <span data-lang-en={diseaseData.name_zh} data-lang-zh={diseaseData.name_en}>
                    {diseaseData.name_zh}
                  </span>
                </p>
              </div>

              {knowledgeProfileAvailable ? (
                <div class="space-y-5">
                  {officialSummaryEn && (
                    hasCitations(officialSummaryEn) ? (
                      <p class="max-w-4xl text-sm leading-6 text-[rgb(var(--text))] citation-text"
                        data-lang-en-html={renderCitations(officialSummaryEn, knowledgeSourceEntries)}
                        data-lang-zh-html={renderCitations(officialSummaryZh ?? officialSummaryEn, knowledgeSourceEntries)}
                        set:html={renderCitations(officialSummaryEn, knowledgeSourceEntries)}
                      />
                    ) : (
                      <p class="max-w-4xl text-sm leading-6 text-[rgb(var(--text))]" data-lang-en={officialSummaryEn} data-lang-zh={officialSummaryZh ?? officialSummaryEn}>
                        {officialSummaryEn}
                      </p>
                    )
                  )}

                  <div class="profile-flow">
                    {briefSections.map((section) => (
                      <article class="profile-flow-item">
                        <div class="academic-meta-label" data-lang-en={section.labelEn} data-lang-zh={section.labelZh}>
                          {section.labelEn}
                        </div>
                        {hasCitations(section.en) ? (
                          <p class="mt-1 text-sm leading-6 text-[rgb(var(--text-muted))] citation-text"
                            data-lang-en-html={renderCitations(section.en, knowledgeSourceEntries)}
                            data-lang-zh-html={renderCitations(section.zh, knowledgeSourceEntries)}
                            set:html={renderCitations(section.en, knowledgeSourceEntries)}
                          />
                        ) : (
                          <p class="mt-1 text-sm leading-6 text-[rgb(var(--text-muted))]" data-lang-en={section.en} data-lang-zh={section.zh}>
                            {section.en}
                          </p>
                        )}
                      </article>
                    ))}

                    <article class="profile-flow-item">
                      <div class="academic-meta-label" data-lang-en="References" data-lang-zh="参考文献">References</div>
                      <ol class="mt-3 space-y-2">
                        {knowledgeSourceEntries.length > 0 ? knowledgeSourceEntries.map((source: any, index: number) => {
                          const citationIndex = Number(source.citation_index ?? index + 1);
                          const sourceUrl = referenceUrl(source);
                          return (
                          <li id={`ref-${citationIndex}`}>
                            <div
                              title={referenceTooltip(source, citationIndex)}
                              class="group flex items-start gap-3 text-sm leading-6 text-[rgb(var(--text-muted))]"
                            >
                              <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center border border-[rgb(var(--border))/0.72] bg-[rgb(var(--surface-raised))/0.34] font-mono text-[10px] font-semibold text-[rgb(var(--text-faint))]">
                                {citationIndex}
                              </span>
                              <span class="min-w-0">
                                <span class="font-semibold text-[rgb(var(--text-strong))]">
                                  {formatReferenceCitation(source)}
                                </span>
                                {sourceUrl && (
                                  <span class="mt-1 block break-all text-xs text-[rgb(var(--text-faint))]">
                                    {referenceLinkLabel(source)}:{' '}
                                    <a
                                      href={sourceUrl}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      class="text-[rgb(var(--color-brand))] underline-offset-2 hover:underline"
                                    >
                                      {sourceUrl}
                                    </a>
                                  </span>
                                )}
                              </span>
                            </div>
                          </li>
                          );
                        }) : (
                          <li class="academic-note border-0 bg-transparent px-0" data-lang-en="No references recorded yet." data-lang-zh="尚未记录参考文献。">
                            No references recorded yet.
                          </li>
                        )}
                      </ol>
                    </article>

                    <article class="profile-flow-item">
                      <div class="academic-meta-label" data-lang-en="Coding Register" data-lang-zh="编码登记">Coding Register</div>
                      <dl class="mt-3 grid gap-4 sm:grid-cols-2">
                        <div>
                          <dt class="academic-meta-label">ICD-10</dt>
                          <dd class="mt-1 font-mono text-sm text-[rgb(var(--text-strong))]">
                            {diseaseData.icd_10 ?? '—'}
                          </dd>
                        </div>
                        <div>
                          <dt class="academic-meta-label">ICD-11</dt>
                          <dd class="mt-1 font-mono text-sm text-[rgb(var(--text-strong))]">
                            {diseaseData.icd_11 ?? '—'}
                          </dd>
                        </div>
                      </dl>
                    </article>

                    <article class="profile-flow-item">
                      <div class="academic-meta-label" data-lang-en="Key Statistics" data-lang-zh="核心统计">Key Statistics</div>
                      <dl class="mt-3 grid gap-4 sm:grid-cols-2">
                        <div>
                          <dt class="academic-meta-label" data-lang-en="Total cases" data-lang-zh="累计病例">Total cases</dt>
                          <dd class="academic-meta-value font-serif">{fmtNum(diseaseData.total_cases)}</dd>
                        </div>
                        {hasDeathsData && (
                          <div>
                            <dt class="academic-meta-label" data-lang-en="Total deaths" data-lang-zh="累计死亡">Total deaths</dt>
                            <dd class="academic-meta-value font-serif text-red-400">{fmtNum(diseaseData.total_deaths)}</dd>
                          </div>
                        )}
                        <div>
                          <dt class="academic-meta-label" data-lang-en="Peak month" data-lang-zh="峰值月份">Peak month</dt>
                          <dd class="academic-meta-value font-serif text-amber-400">{peakMonth}</dd>
                        </div>
                        <div>
                          <dt class="academic-meta-label" data-lang-en="Coverage" data-lang-zh="覆盖区间">Coverage</dt>
                          <dd
                            class="academic-meta-value text-sm font-medium"
                            data-lang-en={`${countryCount} reporting countries · ${coverageLabel}`}
                            data-lang-zh={`${countryCount} 个报告国家 · ${coverageLabel}`}
                          >
                            {countryCount} reporting countries · {coverageLabel}
                          </dd>
                        </div>
                      </dl>
                    </article>
                  </div>
                </div>
              ) : (
                <div class="space-y-3">
                  <p class="academic-kicker" data-lang-en="Profile Availability" data-lang-zh="画像可用性">
                    Profile Availability
                  </p>
                  <p class="max-w-none text-sm leading-6 text-[rgb(var(--text-muted))]" data-lang-en={profileUnavailableMessageEn} data-lang-zh={profileUnavailableMessageZh}>
                    {profileUnavailableMessageEn}
                  </p>
                </div>
              )}
            </div>
          </div>
        </section>

        {countryCount > 0 && (
          <section class="figure-panel">
              <h2 class="figure-title" data-lang-en="Figure 1 | Full historical trajectories across all reporting countries." data-lang-zh="图 1 | 全部报告国家的完整历史轨迹。">
                Figure 1 | Full historical trajectories across all reporting countries.
              </h2>
              <div class="mt-5">
              <DiseaseCountryCurve
                client:only="react"
                dataUrl={diseaseDataUrl}
                topN={countryCount}
                height={380}
                sourceMeta={chartSourceMeta}
              />
            </div>
          </section>
        )}

        {diseaseData.global_monthly?.months?.length > 0 && (
          <section class="figure-panel">
              <h2 class="figure-title" data-lang-en="Figure 2 | Year-over-year monthly comparison for seasonality and structural shifts." data-lang-zh="图 2 | 逐年月度对比，用于识别季节性与结构性变化。">
                Figure 2 | Year-over-year monthly comparison for seasonality and structural shifts.
              </h2>
              <div class="mt-5">
              <DiseaseMonthlyBar
                client:only="react"
                dataUrl={diseaseDataUrl}
                height={360}
                sourceMeta={chartSourceMeta}
              />
            </div>
          </section>
        )}

        {diseaseDownload && (
          <DownloadPanel
            entry={diseaseDownload}
            title="Supplementary Data | Multi-country disease dataset"
            descriptionEn="Machine-readable multi-country disease dataset (JSON/CSV) with source metadata."
            descriptionZh="可下载机器可读多国家疾病数据集（JSON/CSV），含数据源元信息。"
          />
        )}

        <div class="border-t border-[rgb(var(--border))/0.72] pt-4">
          <a href="/diseases/" class="flex items-center gap-2 text-sm text-[rgb(var(--text-muted))] transition-colors hover:text-brand-500">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            <span data-lang-en="Back to Disease Directory" data-lang-zh="返回疾病目录">Back to Disease Directory</span>
          </a>
        </div>
      </>
    )}
  </div>
</ReportLayout>
