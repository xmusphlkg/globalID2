---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicDownloads from '../../components/public/PublicDownloads.astro';
const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
---
<BaseLayout title={zh ? '数据下载' : locale === 'fr' ? 'Téléchargement des données' : 'Data downloads'} description={zh ? '搜索并下载 CSV、JSON 和 XLSX 格式的 GIDS 公开监测数据集。' : locale === 'fr' ? 'Recherchez et téléchargez les jeux de données publics GIDS aux formats CSV, JSON et XLSX.' : 'Search and download GIDS public surveillance datasets in CSV, JSON, and XLSX formats.'} initialLanguage={locale} seo={{ title: zh ? '数据下载 | GIDS' : locale === 'fr' ? 'Téléchargement des données | GIDS' : 'Data downloads | GIDS', description: zh ? '搜索并下载带有覆盖范围和来源说明的公开传染病监测数据集。' : locale === 'fr' ? 'Recherchez et téléchargez les jeux de données publics GIDS avec leur couverture et leurs sources.' : 'Search and download public GIDS surveillance datasets with coverage and provenance notes.', locale, canonicalPath: zh ? '/zh/downloads/' : locale === 'fr' ? '/fr/downloads/' : '/downloads/', alternatePaths: { en: '/downloads/', zh: '/zh/downloads/', fr: '/fr/downloads/' } }}>
  <PublicDownloads locale={locale} />
</BaseLayout>
