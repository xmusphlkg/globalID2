---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicHomeRedesign from '../components/public/PublicHomeRedesign.astro';
const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const pageTitle = zh
  ? '全球传染病监测平台'
  : fr
    ? 'Surveillance mondiale des maladies infectieuses'
    : 'Global Infectious Disease Surveillance';
const pageDescription = zh
  ? '洞察疫情动态，追溯科学证据。探索全球传染病监测数据、公共卫生事件、趋势与研究，查找官方来源并下载开放数据。'
  : fr
    ? 'Détecter les signaux. Comprendre les données. Explorez les données mondiales de surveillance des maladies infectieuses, les événements de santé publique, les tendances et les recherches à partir de sources officielles.'
    : 'See the signals. Understand the evidence. Explore infectious disease surveillance data, public health events, trends, and research from official sources.';
const seoTitle = `${pageTitle} | GIDS`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  initialLanguage={locale}
  seo={{ title: seoTitle, description: pageDescription, locale, canonicalPath: zh ? '/zh/' : fr ? '/fr/' : '/', alternatePaths: { en: '/', zh: '/zh/', fr: '/fr/' } }}
>
  <PublicHomeRedesign locale={locale} />
</BaseLayout>
