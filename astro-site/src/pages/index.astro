<style>
/* ─── Hero background ─── */
.hero-bg {
  background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(59,130,246,0.12) 0%, transparent 70%),
              radial-gradient(ellipse 60% 50% at 80% 50%, rgba(20,184,166,0.07) 0%, transparent 60%),
              rgb(var(--bg));
}

html[data-theme='light'] .hero-bg {
  background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(59,130,246,0.08) 0%, transparent 70%),
              radial-gradient(ellipse 60% 50% at 80% 50%, rgba(20,184,166,0.05) 0%, transparent 60%),
              rgb(var(--bg));
}

/* Animated orbs */
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  animation: orb-drift 20s ease-in-out infinite;
}
.orb-1 {
  width: 600px; height: 600px;
  top: -200px; left: -100px;
  background: radial-gradient(circle, rgba(59,130,246,0.06) 0%, transparent 70%);
  animation-delay: 0s;
}
.orb-2 {
  width: 500px; height: 500px;
  top: 100px; right: -150px;
  background: radial-gradient(circle, rgba(20,184,166,0.05) 0%, transparent 70%);
  animation-delay: -7s;
}
.orb-3 {
  width: 400px; height: 400px;
  bottom: -100px; left: 30%;
