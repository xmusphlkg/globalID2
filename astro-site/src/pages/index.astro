    </a>
  </div>

  {categories.map(cat => {
    const catDiseases = diseases.filter(d => d.category === cat).slice(0, 4);
    if (!catDiseases.length) return null;
    const catColors = {
      Viral: 'home-category-chip home-category-chip-viral',
      Bacterial: 'home-category-chip home-category-chip-bacterial',
      Parasitic: 'home-category-chip home-category-chip-parasitic',
      Fungal: 'home-category-chip home-category-chip-fungal',
    } as { [k: string]: string };
    return (
      <div class="mb-10">
        <h3 class={`text-sm font-bold uppercase tracking-widest mb-4 inline-flex items-center gap-2 ${catColors[cat] ?? 'home-category-chip home-category-chip-neutral'}`}>
          <span data-lang-en={cat} data-lang-zh={catZh[cat] ?? cat}>{cat}</span>
        </h3>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {catDiseases.map(d => (
            <DiseaseCard
              diseaseId={d.disease_id}
              nameEn={d.name_en}
              nameZh={d.name_zh}
              category={d.category}
              icd10={d.icd_10}
              description={d.description}
              slug={d.slug}
            />
          ))}
        </div>
      </div>
    );
  })}
