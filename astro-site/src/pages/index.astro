---
// src/pages/index.astro — Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import StatBar from '../components/StatBar.astro';
import CountryCard from '../components/CountryCard.astro';
import DiseaseCard from '../components/DiseaseCard.astro';
import ReportCard from '../components/ReportCard.astro';

import metaRaw from '../data/meta.json';
import diseasesRaw from '../data/diseases/index.json';
import reportsRaw from '../data/reports/index.json';

const meta = metaRaw as any;
const diseases = diseasesRaw as any[];
const reports = (reportsRaw as any[]).slice(0, 6);

function fmtNum(n: number) {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

const totalCases  = (meta.countries ?? []).reduce((s: number, c: any) => s + (c.total_cases  ?? 0), 0);
const totalDeaths = (meta.countries ?? []).reduce((s: number, c: any) => s + (c.total_deaths ?? 0), 0);

const stats = [
  { label: 'Countries',         labelZh: '国家数',    value: meta.total_countries ?? '—', accent: 'teal'  as const },
  { label: 'Diseases Tracked',  labelZh: '追踪疾病',  value: meta.total_diseases  ?? '—', accent: 'blue'  as const },
  { label: 'Total Cases',       labelZh: '累计病例',  value: fmtNum(totalCases),           accent: 'amber' as const },
  { label: 'Reports Generated', labelZh: '已生成报告', value: meta.total_reports  ?? '—', accent: 'teal'  as const },
];

const categories = ['Viral', 'Bacterial', 'Parasitic', 'Fungal'];
const catZh: Record<string, string> = {
  Viral: '病毒性', Bacterial: '细菌性', Parasitic: '寄生虫', Fungal: '真菌性',
};

const features = [
  {
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
    color: 'teal',
    titleEn: 'Real-time Surveillance',   titleZh: '实时监测',
    descEn:  'Automated scrapers refresh data monthly as official bulletins are published.',
    descZh:  '自动爬虫随官方公报发布每月刷新数据。',
  },
  {
    icon: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5',
    color: 'blue',
    titleEn: 'AI-powered Analysis',  titleZh: 'AI 驱动分析',
    descEn:  'Large language models generate bilingual epidemiological reports with trend insights.',
    descZh:  '大型语言模型生成含趋势洞察的中英双语流行病学报告。',
  },
  {
    icon: 'M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z',
    color: 'amber',
    titleEn: 'Interactive Charts', titleZh: '交互图表',
    descEn:  'Line charts, bar charts, and heatmaps reveal seasonal patterns and outbreak signals.',
    descZh:  '折线图、柱状图和热力图揭示季节规律与疫情信号。',
  },
  {
    icon: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 2.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
    color: 'purple',
    titleEn: 'Open Data',  titleZh: '开放数据',
    descEn:  'All data sourced from official health authorities — transparent, free, and reproducible.',
    descZh:  '全部数据来源于官方卫生机构，透明、免费、可复现。',
  },
];
---

<BaseLayout
  title="Global Infectious Disease Surveillance"
  description="Track 150+ infectious diseases across countries with official-source surveillance data, bilingual reports, and interactive outbreak charts."
>
<div class="home-page">

<!-- ═══════════════════════════ HERO ═══════════════════════════ -->
<section class="home-hero relative overflow-hidden min-h-[88vh] flex items-center">

  <!-- Animated background layers: Global Radar Surveillance -->
  <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
    <!-- Base gradient -->
    <div class="absolute inset-0 hero-bg" />

    <!-- Abstract Global Radar Element -->
    <div class="home-hero-visual hidden md:block absolute right-[-30%] top-[54%] -translate-y-1/2 w-[580px] h-[580px] md:w-[720px] md:h-[720px] lg:right-[-6%] lg:w-[780px] lg:h-[780px]">
      <!-- Glow behind the radar -->
      <div class="absolute inset-0 rounded-full bg-brand-500/10 blur-[100px]" />
      
      <!-- SVG Network representing the Globe -->
      <svg viewBox="0 0 400 400" class="w-full h-full absolute inset-0 animate-[spin_60s_linear_infinite]">
        <style>
          .radar-pulse { animation: radar-pulse-ring 3s cubic-bezier(0.215, 0.61, 0.355, 1) infinite; }
          @keyframes radar-pulse-ring {
            0% { transform: scale(0.8); opacity: 0.8; }
            100% { transform: scale(3.5); opacity: 0; }
          }
        </style>

        <!-- Vectors for Pathogen Icons -->
        <defs>
          <g id="icon-virus" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="0" cy="0" r="3" fill="currentColor" opacity="0.3" class="animate-pulse" />
            <circle cx="0" cy="0" r="3" />
            <!-- Spikes -->
            <path d="M0 -3 L0 -5 M0 3 L0 5 M-3 0 L-5 0 M3 0 L5 0 M-2 -2 L-3.5 -3.5 M2 2 L3.5 3.5 M-2 2 L-3.5 3.5 M2 -2 L3.5 -3.5" />
            <circle cx="0" cy="-5" r="0.5" fill="currentColor" />
            <circle cx="0" cy="5" r="0.5" fill="currentColor" />
            <circle cx="-5" cy="0" r="0.5" fill="currentColor" />
            <circle cx="5" cy="0" r="0.5" fill="currentColor" />
            <circle cx="-3.5" cy="-3.5" r="0.5" fill="currentColor" />
            <circle cx="3.5" cy="3.5" r="0.5" fill="currentColor" />
            <circle cx="-3.5" cy="3.5" r="0.5" fill="currentColor" />
            <circle cx="3.5" cy="-3.5" r="0.5" fill="currentColor" />
          </g>
          
          <g id="icon-bacteria" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Capsule -->
            <rect x="-2.5" y="-4.5" width="5" height="9" rx="2.5" fill="currentColor" opacity="0.3" class="animate-pulse" />
            <rect x="-2.5" y="-4.5" width="5" height="9" rx="2.5" />
            <!-- Flagella -->
            <path d="M-1,4.5 Q-3,6.5 0,8 T-1,11" />
            <path d="M1,4.5 Q3,7 0,9 T1,12" />
          </g>

          <g id="icon-parasite" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
             <!-- Worm shape -->
             <path d="M-4,-4 C-2,-6 2,-5 4,-2 C5,0 4,3 2,4 C-1,6 -3,4 -4,6" fill="currentColor" opacity="0.3" class="animate-pulse" />
             <path d="M-4,-4 C-2,-6 2,-5 4,-2 C5,0 4,3 2,4 C-1,6 -3,4 -4,6" />
          </g>
        </defs>
        
        <!-- Lat/Long abstract rings -->
        <circle cx="200" cy="200" r="180" fill="none" stroke="currentColor" stroke-width="0.5" class="text-brand-600/30 dark:text-brand-500/30" stroke-dasharray="4 6" />
        <circle cx="200" cy="200" r="130" fill="none" stroke="currentColor" stroke-width="0.5" class="text-brand-600/20 dark:text-brand-500/20" />
        <circle cx="200" cy="200" r="80"  fill="none" stroke="currentColor" stroke-width="0.5" class="text-brand-600/30 dark:text-brand-500/30" stroke-dasharray="2 4" />
        
        <!-- Surveillance Connection Lines -->
        <g stroke="currentColor" stroke-width="0.75" class="text-brand-600/20 dark:text-brand-400/20">
          <line x1="200" y1="20"  x2="310" y2="80" />
          <line x1="310" y1="80"  x2="340" y2="200" />
          <line x1="340" y1="200" x2="260" y2="310" />
          <line x1="260" y1="310" x2="140" y2="310" />
          <line x1="140" y1="310" x2="60"  y2="200" />
          <line x1="60"  y1="200" x2="90"  y2="80" />
          <line x1="90"  y1="80"  x2="200" y2="20" />

          <!-- Inner connections -->
          <line x1="310" y1="80"  x2="140" y2="310" />
          <line x1="90"  y1="80"  x2="260" y2="310" />
          <line x1="60"  y1="200" x2="340" y2="200" />
        </g>
        
        <!-- Outbreak/Monitoring Nodes (Icons with Pulsing rings) -->
        <g class="text-teal-600 dark:text-teal-400" transform="translate(310, 80)">
          <use href="#icon-virus" transform="scale(1) rotate(15)" />
          <circle cx="0" cy="0" r="10" fill="none" stroke="currentColor" stroke-width="1.2" class="radar-pulse" />
        </g>
        <g class="text-rose-600 dark:text-rose-400" transform="translate(340, 200)">
          <use href="#icon-bacteria" transform="scale(0.9) rotate(-20)" />
          <circle cx="0" cy="0" r="12" fill="none" stroke="currentColor" stroke-width="1.2" class="radar-pulse" style="animation-delay: 1.2s;" />
        </g>
        <g class="text-amber-600 dark:text-amber-400" transform="translate(140, 310)">
          <use href="#icon-parasite" transform="scale(1.1) rotate(45)" />
          <circle cx="0" cy="0" r="10" fill="none" stroke="currentColor" stroke-width="1.2" class="radar-pulse" style="animation-delay: 0.5s;" />
        </g>
        <g class="text-blue-600 dark:text-blue-400" transform="translate(60, 200)">
          <use href="#icon-virus" transform="scale(0.8) rotate(-10)" />
          <circle cx="0" cy="0" r="8" fill="none" stroke="currentColor" stroke-width="1.2" class="radar-pulse" style="animation-delay: 2.1s;" />
        </g>
        <g class="text-purple-600 dark:text-purple-400" transform="translate(90, 80)">
          <use href="#icon-bacteria" transform="scale(1) rotate(60)" />
          <circle cx="0" cy="0" r="11" fill="none" stroke="currentColor" stroke-width="1.2" class="radar-pulse" style="animation-delay: 0.8s;" />
        </g>
        <g class="text-indigo-600 dark:text-brand-300" transform="translate(260, 310)">
          <use href="#icon-virus" transform="scale(0.8) rotate(30)" />
          <circle cx="0" cy="0" r="9" fill="none" stroke="currentColor" stroke-width="1.2" class="radar-pulse" style="animation-delay: 1.7s;" />
        </g>
      </svg>
      
      <!-- Radar Sweep Effect -->
      <div class="absolute inset-0 rounded-full border border-brand-500/20"></div>
      <div class="absolute inset-0 rounded-full bg-[conic-gradient(from_0deg,transparent_75%,rgba(20,184,166,0.15)_100%)] animate-[spin_4s_linear_infinite]"></div>
    </div>
    
    <!-- Subtle grid & noise -->
    <div class="home-hero-grid-layer absolute inset-0 hero-grid" />
    <div class="home-hero-noise-layer absolute inset-0 hero-noise" />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 w-full relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: copy -->
      <div class="home-hero-copy-block animate-fade-up">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-none hero-badge mb-8 border border-brand-500/20 bg-brand-500/10 transition-all hover:bg-brand-500/20">
          <span class="relative flex h-2.5 w-2.5 items-center justify-center">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75" />
            <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-500" />
          </span>
          <span class="home-hero-badge-label text-xs font-semibold tracking-wide flex items-center gap-1.5" data-lang-en="Official-source surveillance data" data-lang-zh="官方来源监测数据">
            Official-source surveillance data
          </span>
        </div>

        <!-- Heading -->
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-semibold tracking-tight leading-[1.08] mb-6">
          <span class="home-hero-line block" data-lang-en="Global" data-lang-zh="全球">Global</span>
          <span class="hero-gradient-text block" data-lang-en="Infectious Disease" data-lang-zh="传染病">Infectious Disease</span>
          <span class="home-hero-line-muted text-4xl sm:text-5xl lg:text-5xl font-medium block mt-1" data-lang-en="Surveillance" data-lang-zh="监测">Surveillance</span>
        </h1>

        <!-- Subtext -->
        <p class="home-hero-copy text-lg leading-relaxed max-w-xl mb-10" data-lang-en="Track 150+ infectious diseases across countries with structured archives, bilingual reports, and publication-ready charts." data-lang-zh="追踪全球多国 150+ 种传染病，提供结构化归档、双语报告与可直接发表的图表。">
          Track 150+ infectious diseases across countries with structured archives,
          bilingual reports, and publication-ready charts.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 relative z-20">
          <a href="/countries/"
            class="hero-cta-primary group inline-flex items-center gap-2 px-6 py-3 rounded-none font-semibold text-sm transition-all relative z-20 pointer-events-auto">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span data-lang-en="Browse Countries" data-lang-zh="浏览国家">Browse Countries</span>
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/diseases/"
            class="hero-cta-secondary inline-flex items-center gap-2 px-6 py-3 rounded-none font-semibold text-sm transition-all relative z-20 pointer-events-auto">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span data-lang-en="Disease Directory" data-lang-zh="疾病目录">Disease Directory</span>
          </a>
          <a href="https://github.com/xmusphlkg/globalID2" target="_blank" rel="noopener noreferrer"
            class="hero-cta-ghost inline-flex items-center gap-2 px-5 py-3 rounded-none font-semibold text-sm transition-all relative z-20 pointer-events-auto">
            <!-- GitHub icon -->
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>GitHub</span>
          </a>
        </div>

      </div>

      <!-- Right: animated feature cards -->
      <div class="home-hero-aside hidden lg:block animate-fade-up-delay">
        <div class="grid grid-cols-2 gap-4">
          {features.map((f, i) => (
            <div class={`feature-card feature-card-${f.color} p-5 rounded-none`}
              style={`animation-delay: ${i * 120}ms`}>
              <div class={`w-10 h-10 rounded-none feature-icon-${f.color} flex items-center justify-center mb-4`}>
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={f.icon} />
                </svg>
              </div>
              <h3 class="home-feature-title font-semibold text-sm mb-1.5"
                data-lang-en={f.titleEn} data-lang-zh={f.titleZh}>{f.titleEn}</h3>
              <p class="home-feature-copy text-xs leading-relaxed"
                data-lang-en={f.descEn} data-lang-zh={f.descZh}>{f.descEn}</p>
            </div>
          ))}
        </div>

        <!-- Floating data card -->
        <div class="home-floating-stat mt-4 floating-stat-card rounded-none p-4 flex items-center gap-4">
          <div class="w-10 h-10 rounded-none bg-teal-500/15 border border-teal-500/25 flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
            </svg>
          </div>
          <div>
            <div class="home-floating-label text-xs mb-0.5" data-lang-en="Tracking this month" data-lang-zh="本月追踪">Tracking this month</div>
            <div class="home-floating-text font-bold">
              <span class="text-teal-400">{meta.total_diseases ?? 124}</span>
              <span class="home-floating-copy text-sm font-normal ml-1.5" data-lang-en="diseases across" data-lang-zh="种疾病覆盖">diseases across</span>
              <span class="text-blue-400 ml-1.5">{meta.total_countries ?? 1}</span>
              <span class="home-floating-copy text-sm font-normal ml-1.5" data-lang-en="countries" data-lang-zh="个国家">countries</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 scroll-indicator">
    <svg class="home-scroll-icon w-6 h-6 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

<!-- ═══════════════════════ STATS ════════════════════════ -->
<section class="home-band home-band-stat">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <StatBar stats={stats} />
  </div>
</section>

<!-- ══════════════════════ COUNTRIES ═════════════════════ -->
<section class="home-band">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="home-section-header flex items-center justify-between mb-8">
    <div>
      <h2 class="section-heading" data-lang-en="Countries" data-lang-zh="国家">Countries</h2>
      <p class="home-section-copy text-sm mt-1" data-lang-en="Surveillance coverage by country" data-lang-zh="各国监测覆盖情况">Surveillance coverage by country</p>
    </div>
    <a href="/countries/" class="home-section-link inline-flex items-center gap-1 text-sm transition-colors">
      <span data-lang-en="View all" data-lang-zh="查看全部">View all</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {(meta.countries ?? []).map((c: any) => (
      <CountryCard
        code={c.code}
        name={c.name}
        totalCases={c.total_cases}
        totalDeaths={c.total_deaths}
        diseaseCount={c.disease_count}
        dateRange={c.date_range}
      />
    ))}
  </div>
  </div>
</section>

<!-- ══════════════════════ DISEASES ══════════════════════ -->
<section class="home-band">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="home-section-header flex items-center justify-between mb-8">
    <div>
      <h2 class="section-heading" data-lang-en="Disease Directory" data-lang-zh="疾病目录">Disease Directory</h2>
      <p class="home-section-copy text-sm mt-1" data-lang-en="Categorised by pathogen type" data-lang-zh="按病原体类型分类">Categorised by pathogen type</p>
