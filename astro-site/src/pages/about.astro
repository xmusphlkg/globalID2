---
import BaseLayout from '../layouts/BaseLayout.astro';
import { acknowledgementEntries, acknowledgementIntro } from '../data/acknowledgements';
import aboutRaw from '../data/about.json';

const about = aboutRaw as any;
const aboutMetrics = about.metrics ?? [];
const aboutPipeline = about.pipeline_steps ?? [];
const aboutFeatures = about.features ?? [];
const aboutSources = about.data_sources ?? [];
const summary = about.summary ?? {};
const architecture = about.architecture ?? {};

const toneStyles = {
  amber: {
    icon: 'bg-amber-600/20 border-amber-500/30 text-amber-400',
    pill: 'bg-amber-600/15 border-amber-500/25 text-amber-300',
  },
  brand: {
    icon: 'bg-brand-600/20 border-brand-500/30 text-brand-400',
    pill: 'bg-brand-600/15 border-brand-500/25 text-brand-300',
  },
  green: {
    icon: 'bg-green-600/20 border-green-500/30 text-green-400',
    pill: 'bg-green-600/15 border-green-500/25 text-green-300',
  },
  purple: {
    icon: 'bg-purple-600/20 border-purple-500/30 text-purple-400',
    pill: 'bg-purple-600/15 border-purple-500/25 text-purple-300',
  },
  teal: {
    icon: 'bg-teal-600/20 border-teal-500/30 text-teal-400',
    pill: 'bg-teal-600/15 border-teal-500/25 text-teal-300',
  },
} as const;

type ToneKey = keyof typeof toneStyles;

function getTone(accent: string | undefined) {
  return toneStyles[(accent as ToneKey) ?? 'brand'] ?? toneStyles.brand;
}

function formatMetricValue(value: unknown, valueType?: string) {
  if (valueType === 'number') {
    const num = Number(value ?? 0);
    return Number.isFinite(num) ? num.toLocaleString() : '0';
  }
  return String(value ?? '—');
}

const generatedAtEn = about.generated_at
  ? new Date(about.generated_at).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'Unknown';

const generatedAtZh = about.generated_at
  ? new Date(about.generated_at).toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '未知';

const coverageStart = summary.coverage_start ?? 'N/A';
const coverageEnd = summary.coverage_end ?? 'N/A';
---

<BaseLayout
  title="About"
  description="Learn how GIDS monitors infectious diseases worldwide using automated data collection and AI-powered analysis."
>
  <div class="about-page">
    <section class="relative overflow-hidden py-16 sm:py-24">
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-0 left-1/2 h-[400px] w-[700px] -translate-x-1/2 rounded-full bg-brand-600/10 blur-3xl" />
      </div>
      <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
        <div class="mb-6 inline-flex items-center gap-2 rounded-none border border-teal-500/20 bg-teal-500/10 px-3 py-1.5 text-xs font-medium text-teal-400">
          <span data-lang-en="How it works" data-lang-zh="项目介绍">How it works</span>
        </div>
        <h1 class="mb-6 text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl">
          <span data-lang-en="About GIDS" data-lang-zh="关于 GIDS">About GIDS</span>
        </h1>
        <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-400">
          <span data-lang-en="GIDS (Global Infectious Disease Surveillance) is an automated infectious disease surveillance platform that collects, processes, and visualises data from official public health authorities around the world." data-lang-zh="GIDS（Global Infectious Disease Surveillance）是一套自动化传染病监测平台，负责从全球各官方公共卫生机构收集、处理和可视化数据。">
            GIDS (Global Infectious Disease Surveillance) is an automated infectious disease surveillance platform that collects, processes, and visualises data from official public health authorities around the world.
          </span>
        </p>
        <p
          class="mx-auto mt-4 max-w-3xl text-sm leading-relaxed text-slate-500"
          data-lang-en={`This page is rebuilt from the latest PostgreSQL snapshot. The current data version is ${generatedAtEn}, covering ${coverageStart} to ${coverageEnd}.`}
          data-lang-zh={`本页会在构建前从最新 PostgreSQL 快照重建，当前数据版本日期为 ${generatedAtZh}，覆盖范围为 ${coverageStart} 至 ${coverageEnd}。`}
        >
          This page is rebuilt from the latest PostgreSQL snapshot. The current data version is {generatedAtEn}, covering {coverageStart} to {coverageEnd}.
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-5xl px-4 pb-20 sm:px-6 lg:px-8">
      <section class="about-section">
        <div class="about-section-header">
          <h2 class="about-section-title" data-lang-en="Live Database Snapshot" data-lang-zh="数据库实时快照">
            Live Database Snapshot
          </h2>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {aboutMetrics.map((metric: any) => {
            const tone = getTone(metric.accent);
            return (
              <article class="about-surface-card rounded-none p-5">
                <div class={`inline-flex h-11 w-11 items-center justify-center rounded-none border text-sm font-bold ${tone.icon}`}>
                  {metric.value_type === 'date' ? 'DB' : '#'}
                </div>
                <p class="mt-4 text-xs font-semibold uppercase tracking-[0.12em] text-slate-500" data-lang-en={metric.label_en} data-lang-zh={metric.label_zh}>
                  {metric.label_en}
                </p>
                <p class="mt-2 text-2xl font-bold text-slate-100">
                  {formatMetricValue(metric.value, metric.value_type)}
                </p>
                <p class="mt-2 text-xs leading-relaxed text-slate-500" data-lang-en={metric.note_en} data-lang-zh={metric.note_zh}>
                  {metric.note_en}
                </p>
              </article>
            );
          })}
        </div>
      </section>

      <section class="about-section">
        <div class="about-section-header">
          <h2 class="about-section-title" data-lang-en="How the Pipeline Works" data-lang-zh="数据处理流程">
            How the Pipeline Works
          </h2>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {aboutPipeline.map((step: any) => {
            const tone = getTone(step.accent);
            return (
              <div class="about-surface-panel relative flex flex-col gap-3 rounded-none p-6">
                <div class={`flex h-10 w-10 items-center justify-center rounded-none border text-lg font-bold ${tone.icon}`}>
                  {step.step}
                </div>
                <h3 class="font-semibold text-slate-200" data-lang-en={step.title_en} data-lang-zh={step.title_zh}>
                  {step.title_en}
                </h3>
                <p class="text-sm leading-relaxed text-slate-500" data-lang-en={step.description_en} data-lang-zh={step.description_zh}>
                  {step.description_en}
                </p>
              </div>
            );
          })}
        </div>
      </section>

      <section class="about-section">
        <div class="about-section-header">
          <h2 class="about-section-title" data-lang-en="System Architecture" data-lang-zh="系统架构">
            System Architecture
          </h2>
        </div>
        <div class="about-surface-panel rounded-none p-8">
          <div class="flex flex-col flex-wrap items-center justify-center gap-3 text-sm sm:flex-row">
            <div class="flex flex-col items-center gap-2 text-center">
              <div class="flex h-16 w-16 items-center justify-center rounded-none border border-brand-500/30 bg-brand-600/20">
                <svg class="h-7 w-7 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                </svg>
              </div>
              <span class="font-medium text-slate-400" data-lang-en={architecture.source_label_en} data-lang-zh={architecture.source_label_zh}>
                {architecture.source_label_en}
              </span>
              <span class="text-xs text-slate-600" data-lang-en={architecture.source_detail_en} data-lang-zh={architecture.source_detail_zh}>
                {architecture.source_detail_en}
              </span>
            </div>

          <svg class="h-6 w-6 shrink-0 rotate-90 text-slate-600 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>

          <div class="flex flex-col items-center gap-2 text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-none border border-teal-500/30 bg-teal-600/20">
              <svg class="h-7 w-7 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </div>
            <span class="font-medium text-slate-400" data-lang-en={architecture.scraper_label_en} data-lang-zh={architecture.scraper_label_zh}>
              {architecture.scraper_label_en}
            </span>
            <span class="text-xs text-slate-600" data-lang-en={architecture.scraper_detail_en} data-lang-zh={architecture.scraper_detail_zh}>
              {architecture.scraper_detail_en}
            </span>
          </div>

          <svg class="h-6 w-6 shrink-0 rotate-90 text-slate-600 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>

          <div class="flex flex-col items-center gap-2 text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-none border border-amber-500/30 bg-amber-600/20">
              <svg class="h-7 w-7 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
              </svg>
            </div>
            <span class="font-medium text-slate-400" data-lang-en={architecture.database_label_en} data-lang-zh={architecture.database_label_zh}>
              {architecture.database_label_en}
            </span>
            <span class="text-xs text-slate-600" data-lang-en={architecture.database_detail_en} data-lang-zh={architecture.database_detail_zh}>
              {architecture.database_detail_en}
            </span>
          </div>

          <svg class="h-6 w-6 shrink-0 rotate-90 text-slate-600 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>

          <div class="flex flex-col items-center gap-2 text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-none border border-purple-500/30 bg-purple-600/20">
              <svg class="h-7 w-7 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="font-medium text-slate-400" data-lang-en={architecture.llm_label_en} data-lang-zh={architecture.llm_label_zh}>
              {architecture.llm_label_en}
            </span>
            <span class="text-xs text-slate-600" data-lang-en={architecture.llm_detail_en} data-lang-zh={architecture.llm_detail_zh}>
              {architecture.llm_detail_en}
            </span>
          </div>

          <svg class="h-6 w-6 shrink-0 rotate-90 text-slate-600 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>

          <div class="flex flex-col items-center gap-2 text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-none border border-green-500/30 bg-green-600/20">
              <svg class="h-7 w-7 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3H5.25A2.25 2.25 0 003 5.25v13.5A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V9.75m-11.25 0V3m0 6.75h6m-6 3.375h6m-6 3.375h3.75M14.25 3l6 6h-6V3z" />
              </svg>
            </div>
            <span class="font-medium text-slate-400" data-lang-en={architecture.website_label_en} data-lang-zh={architecture.website_label_zh}>
              {architecture.website_label_en}
            </span>
            <span class="text-xs text-slate-600" data-lang-en={architecture.website_detail_en} data-lang-zh={architecture.website_detail_zh}>
              {architecture.website_detail_en}
            </span>
          </div>
          </div>
        </div>
      </section>

    <section class="about-section">
      <div class="about-section-header">
        <h2 class="about-section-title" data-lang-en="Key Features" data-lang-zh="主要功能">
          Key Features
        </h2>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {aboutFeatures.map((feature: any) => {
          const tone = getTone(feature.accent);
          return (
            <div class="about-surface-card flex gap-4 rounded-none p-5">
              <div class={`mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-none border ${tone.icon}`}>
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={feature.icon} />
                </svg>
              </div>
              <div>
                <h3 class="mb-1 text-sm font-medium text-slate-200" data-lang-en={feature.title_en} data-lang-zh={feature.title_zh}>
                  {feature.title_en}
                </h3>
                <p class="text-xs leading-relaxed text-slate-500" data-lang-en={feature.description_en} data-lang-zh={feature.description_zh}>
                  {feature.description_en}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="about-section">
      <div class="about-section-header">
        <h2 class="about-section-title" data-lang-en="Free & Open Source" data-lang-zh="免费 & 开源">
          Free & Open Source
        </h2>
      </div>
      <div class="about-surface-panel overflow-hidden rounded-none">
        <div class="p-8 sm:p-10">
          <div class="flex flex-col gap-6 sm:flex-row sm:items-center">
            <div class="about-icon-shell flex h-16 w-16 flex-shrink-0 items-center justify-center rounded-none">
              <svg class="h-8 w-8 text-slate-200" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="mb-3 inline-flex items-center gap-2 rounded-none border border-teal-500/20 bg-teal-500/10 px-3 py-1 text-xs font-semibold text-teal-400">
                <span data-lang-en="Open Source Project" data-lang-zh="开源项目">Open Source Project</span>
              </div>
              <p class="mb-5 text-sm leading-relaxed text-slate-400" data-lang-en="GIDS is fully open source under the MIT licence. The entire pipeline, from data collection and AI analysis to frontend visualisation, is available for inspection, reuse, and contribution." data-lang-zh="GIDS 采用 MIT 协议完全开源。从数据采集、AI 分析到前端可视化的完整流水线均可查看、复用和贡献。">
                GIDS is fully open source under the MIT licence. The entire pipeline, from data collection and AI analysis to frontend visualisation, is available for inspection, reuse, and contribution.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="https://github.com/xmusphlkg/globalID2"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-none bg-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-900 shadow-lg shadow-slate-900/20 transition-all hover:bg-white"
                >
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                  <span data-lang-en="xmusphlkg/globalID2" data-lang-zh="xmusphlkg/globalID2">xmusphlkg/globalID2</span>
                </a>
                <a
                  href="https://github.com/xmusphlkg/globalID2/issues"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="about-outline-button inline-flex items-center gap-2 rounded-none px-5 py-2.5 text-sm font-semibold transition-all"
                >
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                  </svg>
                  <span data-lang-en="Report an Issue" data-lang-zh="提交问题">Report an Issue</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="about-section-header">
        <h2 class="about-section-title" data-lang-en="Author" data-lang-zh="作者">Author</h2>
      </div>
      <div class="about-surface-panel mx-auto flex max-w-lg flex-col items-center gap-6 rounded-none p-8 text-center sm:flex-row sm:text-left">
        <div class="flex h-20 w-20 flex-shrink-0 items-center justify-center rounded-none border border-teal-500/20 bg-gradient-to-br from-teal-500/30 to-brand-500/30 text-3xl">
          👨‍🔬
        </div>
        <div>
          <h3 class="mb-1 text-xl font-bold text-slate-100">Kangguo Li</h3>
          <p class="mb-4 text-sm text-slate-400" data-lang-en="Epidemiologist & developer. Building tools that make infectious disease data more accessible and actionable." data-lang-zh="流行病学研究者与开发者，致力于构建让传染病数据更易访问、更有价值的工具。">
            Epidemiologist & developer. Building tools that make infectious disease data more accessible and actionable.
          </p>
          <div class="flex flex-wrap justify-center gap-3 sm:justify-start">
            <a
              href="https://kangguo.online/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-none border border-brand-500/30 bg-brand-600/20 px-4 py-2 text-sm font-medium text-brand-400 transition-all hover:border-brand-400/50 hover:text-brand-300"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
              <span>kangguo.online</span>
            </a>
            <a
              href="https://github.com/xmusphlkg"
              target="_blank"
              rel="noopener noreferrer"
              class="about-outline-button inline-flex items-center gap-2 rounded-none px-4 py-2 text-sm font-medium transition-all"
            >
