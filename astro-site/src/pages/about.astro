---
// src/pages/about.astro — About page
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Learn how GlobalID monitors infectious diseases worldwide using automated data collection and AI-powered analysis."
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-16 sm:py-24">
    <div class="absolute inset-0 -z-10">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-brand-600/10 rounded-full blur-3xl" />
    </div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-medium mb-6">
        <span data-lang-en="How it works" data-lang-zh="项目介绍">How it works</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-100 tracking-tight mb-6">
        <span data-lang-en="About GlobalID" data-lang-zh="关于 GlobalID">About GlobalID</span>
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed max-w-2xl mx-auto">
        <span data-lang-en="GlobalID is an automated infectious disease surveillance system that collects, processes, and visualises data from official public health authorities around the world." data-lang-zh="GlobalID 是一套自动化传染病监测系统，负责从全球各官方公共卫生机构收集、处理和可视化数据。">
          GlobalID is an automated infectious disease surveillance system that collects, processes, and visualises data from official public health authorities around the world.
        </span>
      </p>
    </div>
  </section>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">

    <!-- Pipeline overview -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-slate-100 mb-8 text-center" data-lang-en="How the Pipeline Works" data-lang-zh="数据处理流程">
        How the Pipeline Works
      </h2>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- Step 1 -->
        <div class="relative rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-brand-600/20 border border-brand-500/30 flex items-center justify-center text-brand-400 font-bold text-lg">1</div>
          <h3 class="text-slate-200 font-semibold" data-lang-en="Data Collection" data-lang-zh="数据采集">Data Collection</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-lang-en="Automated scrapers fetch monthly disease reports and bulletins from official national health authorities such as the China CDC, WHO, and ECDC." data-lang-zh="自动爬虫从中国疾控中心、世卫组织、欧洲疾控中心等官方机构获取每月疾病报告与公报。">
            Automated scrapers fetch monthly disease reports and bulletins from official national health authorities such as the China CDC, WHO, and ECDC.
          </p>
        </div>

        <!-- Step 2 -->
        <div class="relative rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-teal-600/20 border border-teal-500/30 flex items-center justify-center text-teal-400 font-bold text-lg">2</div>
          <h3 class="text-slate-200 font-semibold" data-lang-en="Parsing & Normalisation" data-lang-zh="解析与标准化">Parsing & Normalisation</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-lang-en="Raw HTML, PDF, and API responses are parsed, cleaned, and normalised into a unified schema covering disease name, case counts, deaths, and time period." data-lang-zh="原始 HTML、PDF 和 API 响应经过解析、清洗，统一归入涵盖病名、病例数、死亡数和时间段的标准数据模型。">
            Raw HTML, PDF, and API responses are parsed, cleaned, and normalised into a unified schema covering disease name, case counts, deaths, and time period.
          </p>
        </div>

        <!-- Step 3 -->
        <div class="relative rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-amber-600/20 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold text-lg">3</div>
          <h3 class="text-slate-200 font-semibold" data-lang-en="AI Analysis" data-lang-zh="AI 分析">AI Analysis</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-lang-en="A large language model analyses trends, compares data against historical baselines, and generates structured epidemiological reports in both English and Chinese." data-lang-zh="大型语言模型分析疾病趋势，与历史基线对比，并生成中英双语的结构化流行病学报告。">
            A large language model analyses trends, compares data against historical baselines, and generates structured epidemiological reports in both English and Chinese.
          </p>
        </div>

        <!-- Step 4 -->
        <div class="relative rounded-2xl border border-slate-700/50 bg-slate-800/40 p-6 flex flex-col gap-3">
          <div class="w-10 h-10 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-400 font-bold text-lg">4</div>
          <h3 class="text-slate-200 font-semibold" data-lang-en="Visualisation & Publishing" data-lang-zh="可视化与发布">Visualisation & Publishing</h3>
          <p class="text-slate-500 text-sm leading-relaxed" data-lang-en="Reports, charts, and statistics are published to this website automatically via a static-site build process, ensuring data is always up to date." data-lang-zh="报告、图表和统计数据通过静态网站构建流程自动发布到本网站，确保数据始终保持最新。">
            Reports, charts, and statistics are published to this website automatically via a static-site build process, ensuring data is always up to date.
          </p>
        </div>
      </div>
    </section>

    <!-- Architecture diagram (flow) -->
    <section class="mb-16">
      <div class="rounded-2xl border border-slate-700/50 bg-slate-800/30 p-8">
        <h2 class="text-xl font-bold text-slate-100 mb-8 text-center" data-lang-en="System Architecture" data-lang-zh="系统架构">System Architecture</h2>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 text-sm flex-wrap">
          <!-- Source -->
          <div class="flex flex-col items-center gap-2 text-center">
            <div class="w-16 h-16 rounded-2xl bg-brand-600/20 border border-brand-500/30 flex items-center justify-center">
              <svg class="w-7 h-7 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
              </svg>
            </div>
            <span class="text-slate-400 font-medium" data-lang-en="Health Authorities" data-lang-zh="卫生机构">Health Authorities</span>
            <span class="text-slate-600 text-xs" data-lang-en="CDC / WHO / ECDC" data-lang-zh="疾控中心 / 世卫 / 欧洲疾控">CDC / WHO / ECDC</span>
          </div>

          <svg class="w-6 h-6 text-slate-600 shrink-0 rotate-90 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>

          <!-- Scraper -->
          <div class="flex flex-col items-center gap-2 text-center">
            <div class="w-16 h-16 rounded-2xl bg-teal-600/20 border border-teal-500/30 flex items-center justify-center">
              <svg class="w-7 h-7 text-teal-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
            </div>
            <span class="text-slate-400 font-medium" data-lang-en="Scrapers" data-lang-zh="爬虫">Scrapers</span>
            <span class="text-slate-600 text-xs" data-lang-en="Python / Playwright" data-lang-zh="Python / Playwright">Python / Playwright</span>
          </div>

          <svg class="w-6 h-6 text-slate-600 shrink-0 rotate-90 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>

          <!-- Parser / DB -->
          <div class="flex flex-col items-center gap-2 text-center">
            <div class="w-16 h-16 rounded-2xl bg-amber-600/20 border border-amber-500/30 flex items-center justify-center">
              <svg class="w-7 h-7 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4" />
              </svg>
            </div>
            <span class="text-slate-400 font-medium" data-lang-en="Parser + DB" data-lang-zh="解析器 + 数据库">Parser + DB</span>
            <span class="text-slate-600 text-xs">PostgreSQL</span>
          </div>

          <svg class="w-6 h-6 text-slate-600 shrink-0 rotate-90 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>

          <!-- LLM -->
          <div class="flex flex-col items-center gap-2 text-center">
            <div class="w-16 h-16 rounded-2xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center">
              <svg class="w-7 h-7 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <span class="text-slate-400 font-medium" data-lang-en="AI Report Engine" data-lang-zh="AI 报告引擎">AI Report Engine</span>
            <span class="text-slate-600 text-xs">LLM Analysis</span>
          </div>

          <svg class="w-6 h-6 text-slate-600 shrink-0 rotate-90 sm:rotate-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>

          <!-- Website -->
          <div class="flex flex-col items-center gap-2 text-center">
            <div class="w-16 h-16 rounded-2xl bg-green-600/20 border border-green-500/30 flex items-center justify-center">
              <svg class="w-7 h-7 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3H5.25A2.25 2.25 0 003 5.25v13.5A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V9.75m-11.25 0V3m0 6.75h6m-6 3.375h6m-6 3.375h3.75M14.25 3l6 6h-6V3z" />
              </svg>
            </div>
            <span class="text-slate-400 font-medium" data-lang-en="This Website" data-lang-zh="本网站">This Website</span>
            <span class="text-slate-600 text-xs">Astro SSG</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Key features -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-slate-100 mb-8 text-center" data-lang-en="Key Features" data-lang-zh="主要功能">Key Features</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {[
          {
            icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
            title: 'Real-time Updates', titleZh: '实时更新',
            desc: 'Data is refreshed monthly as new bulletins are published by health authorities.', descZh: '每月随卫生机构发布新公报时同步刷新数据。',
            color: 'brand',
          },
          {
            icon: 'M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z',
            title: 'Multi-country Coverage', titleZh: '多国覆盖',
            desc: 'Track disease trends across multiple countries with standardised comparison metrics.', descZh: '通过标准化对比指标，追踪多国疾病趋势。',
            color: 'teal',
          },
          {
            icon: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z',
            title: 'Trend Analysis', titleZh: '趋势分析',
            desc: 'Interactive charts reveal seasonal patterns and outbreak signals against historical baselines.', descZh: '交互式图表揭示季节性规律，并与历史基线对比发现疫情信号。',
            color: 'amber',
          },
          {
            icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
            title: 'AI-generated Reports', titleZh: 'AI 生成报告',
            desc: 'Detailed epidemiological summaries are written by a large language model, available in English and Chinese.', descZh: '由大型语言模型撰写详细流行病学摘要，提供中英双语版本。',
            color: 'purple',
          },
          {
            icon: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 2.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125m16.5 5.625c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
            title: 'Open Data', titleZh: '开放数据',
            desc: 'All underlying data is sourced from official public health authorities and is freely accessible.', descZh: '所有基础数据来源于官方公共卫生机构，可免费获取。',
            color: 'teal',
          },
          {
            icon: 'M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 8.25h3m-3 3.75h3m-3 3.75h3',
            title: 'Bilingual Interface', titleZh: '双语界面',
            desc: 'The entire site supports both English and Chinese, with a single click to switch language.', descZh: '整站支持中英双语，一键切换语言。',
            color: 'brand',
          },
        ].map(({ icon, title, titleZh, desc, descZh, color }) => (
          <div class="rounded-xl border border-slate-700/50 bg-slate-800/30 p-5 flex gap-4">
            <div class={`mt-0.5 w-9 h-9 shrink-0 rounded-lg bg-${color}-600/15 border border-${color}-500/25 flex items-center justify-center`}>
              <svg class={`w-5 h-5 text-${color}-400`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={icon} />
              </svg>
            </div>
            <div>
              <h3 class="text-slate-200 font-medium text-sm mb-1" data-lang-en={title} data-lang-zh={titleZh}>{title}</h3>
              <p class="text-slate-500 text-xs leading-relaxed" data-lang-en={desc} data-lang-zh={descZh}>{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Open Source -->
    <section class="mb-16">
      <div class="rounded-2xl border border-slate-700/50 bg-slate-800/30 overflow-hidden">
        <div class="p-8 sm:p-10">
          <div class="flex flex-col sm:flex-row sm:items-center gap-6">
            <!-- GitHub icon -->
            <div class="w-16 h-16 rounded-2xl bg-slate-700/50 border border-slate-600/50 flex items-center justify-center flex-shrink-0">
              <svg class="w-8 h-8 text-slate-200" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>
            </div>
            <div class="flex-1">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-400 text-xs font-semibold mb-3">
                <span data-lang-en="Open Source Project" data-lang-zh="开源项目">Open Source Project</span>
              </div>
              <h2 class="text-2xl font-bold text-slate-100 mb-2" data-lang-en="Free & Open Source" data-lang-zh="免费 &amp; 开源">
                Free &amp; Open Source
              </h2>
              <p class="text-slate-400 text-sm leading-relaxed mb-5" data-lang-en="GlobalID is fully open source under the MIT licence. The entire pipeline — from data collection and AI analysis to frontend visualisation — is available for inspection, reuse, and contribution." data-lang-zh="GlobalID 采用 MIT 协议完全开源。从数据采集、AI 分析到前端可视化的完整流水线均可查看、复用和贡献。">
                GlobalID is fully open source under the MIT licence. The entire pipeline — from data collection and AI analysis to frontend visualisation — is available for inspection, reuse, and contribution.
              </p>
              <div class="flex flex-wrap gap-3">
                <a
                  href="https://github.com/xmusphlkg/globalID2"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-200 hover:bg-white text-slate-900 font-semibold text-sm transition-all shadow-lg shadow-slate-900/20"
                >
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                  <span data-lang-en="xmusphlkg/globalID2" data-lang-zh="xmusphlkg/globalID2">xmusphlkg/globalID2</span>
                </a>
                <a
                  href="https://github.com/xmusphlkg/globalID2/issues"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-700 hover:border-slate-500 text-slate-300 hover:text-slate-100 font-semibold text-sm transition-all"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/>
                  </svg>
                  <span data-lang-en="Report an Issue" data-lang-zh="提交问题">Report an Issue</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Author -->
    <section class="mb-16">
