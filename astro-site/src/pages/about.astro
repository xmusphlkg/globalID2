---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicAbout from '../components/public/PublicAbout.astro';
const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' };
const zh = locale === 'zh';
---
<BaseLayout title={zh ? '方法与关于' : 'Methods & About'} description={zh ? '了解 GIDS 如何采集、标准化、发布和解释官方来源的传染病监测数据。' : 'How GIDS collects, standardizes, publishes, and explains official-source infectious disease surveillance data.'} initialLanguage={locale} seo={{ title: zh ? '方法与关于 | GIDS' : 'Methods & About | GIDS', description: zh ? '了解 GIDS 如何采集、标准化、发布和解释官方来源的传染病监测数据。' : 'How GIDS collects, standardizes, publishes, and explains official-source infectious disease surveillance data.', locale, canonicalPath: zh ? '/zh/about/' : '/about/', alternatePaths: { en: '/about/', zh: '/zh/about/' } }}>
  <PublicAbout locale={locale} />
</BaseLayout>
