---
import ReportLayout from '../../layouts/ReportLayout.astro';
import researchData from '../../data/research/index.json';
import { buildAlternatePaths } from '../../lib/seo';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' | 'fr' };
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => zh ? zhValue : fr ? (frValue ?? en) : en;

const graph: any = (researchData as any).knowledge_graph ?? { nodes: [], edges: [], stats: {}, quality: {} };
const nodes: any[] = (graph.nodes ?? []).map((node: any) => ({
  id: node.id,
  type: node.type,
  label: node.label,
  ...(node.url ? { url: node.url } : {}),
}));
const edgeCount = Array.isArray(graph.edges) ? graph.edges.length : 0;
const nodeTypes = [...new Set(nodes.map((node: any) => String(node.type || 'unknown')))].sort();
const relationLabels: Record<string, { en: string; zh: string; fr: string }> = {
  ABOUT_DISEASE: { en: 'About disease', zh: '涉及疾病', fr: 'Concerne la maladie' },
  STUDIED_IN: { en: 'Studied in', zh: '研究地区', fr: 'Étudié dans' },
  ADDRESSES_TOPIC: { en: 'Addresses topic', zh: '涉及主题', fr: 'Traite le thème' },
  USES_STUDY_DESIGN: { en: 'Uses study design', zh: '采用研究设计', fr: 'Utilise le plan d’étude' },
  STUDIES_PATHOGEN: { en: 'Studies pathogen', zh: '研究病原体', fr: 'Étudie l’agent pathogène' },
  STUDIED_POPULATION_SETTING: { en: 'Population and setting', zh: '研究人群与场景', fr: 'Population et contexte' },
  EVALUATES_INTERVENTION: { en: 'Evaluates intervention', zh: '评估干预', fr: 'Évalue l’intervention' },
  INFORMS_POLICY_DOMAIN: { en: 'Informs policy domain', zh: '关联政策领域', fr: 'Éclaire le domaine politique' },
};
---

<ReportLayout
  title={pick('Research evidence graph', '研究证据图谱', 'Graphe des preuves de recherche')}
  description={pick('Browse auditable relationships among GIDS Research Radar articles, diseases, places, topics, study designs, pathogens, populations, interventions, and policy domains.', '浏览 GIDS 研究雷达中文献、疾病、地区、主题、研究设计、病原体、人群、干预和政策领域之间的可审计关系。', 'Explorez les relations auditables entre les publications, maladies, lieux, thèmes, plans d’étude, agents pathogènes, populations, interventions et domaines politiques du Radar de recherche GIDS.')}
  initialLanguage={locale}
  seo={{
    title: pick('Research evidence graph | GIDS', '研究证据图谱 | GIDS', 'Graphe des preuves de recherche | GIDS'),
    description: pick('Explore provenance-preserving Research Radar evidence relationships.', '探索保留来源信息的研究雷达证据关系。', 'Explorez les relations de preuves du Radar de recherche en conservant leur provenance.'),
    locale,
    canonicalPath: `${prefix}/research/graph/`,
    alternatePaths: buildAlternatePaths(`${prefix}/research/graph/`, locale),
    pageType: 'WebPage',
  }}
  breadcrumbs={[
    { label: pick('Research Radar', '研究雷达', 'Radar de recherche'), href: `${prefix}/research/` },
    { label: pick('Evidence graph', '证据图谱', 'Graphe des preuves') },
  ]}
>
  <div class="graph-page">
    <header class="academic-hero graph-hero">
      <p class="academic-kicker">{pick('Auditable relationships', '可审计关系', 'Relations auditables')}</p>
      <h1>{pick('Research evidence graph', '研究证据图谱', 'Graphe des preuves de recherche')}</h1>
      <p>{pick('Browse deterministic classifier links and quality-gated summary relationships. The graph does not infer causality or scientific credibility.', '浏览确定性分类关系与通过质量门控的摘要关系。本图谱不推断因果关系或科学可信度。', 'Parcourez les liens déterministes du classificateur et les relations de résumés contrôlées par la qualité. Le graphe n’infère ni causalité ni crédibilité scientifique.')}</p>
      <dl>
        <div><dt>{pick('Nodes', '节点', 'Nœuds')}</dt><dd>{graph.stats?.nodes ?? nodes.length}</dd></div>
        <div><dt>{pick('Relationships', '关系', 'Relations')}</dt><dd>{graph.stats?.edges ?? edgeCount}</dd></div>
        <div><dt>{pick('Articles', '论文', 'Publications')}</dt><dd>{graph.stats?.articles ?? 0}</dd></div>
        <div><dt>{pick('Filtered low-confidence links', '已过滤低置信度关系', 'Liens à faible confiance filtrés')}</dt><dd>{graph.quality?.skipped_low_confidence_edges ?? 0}</dd></div>
      </dl>
    </header>

    <section class="card graph-workspace" data-evidence-graph data-graph-locale={locale} data-graph-prefix={prefix} data-graph-src="/site-data/research-graph.json">
      <div class="graph-controls">
        <label>
          <span>{pick('Search nodes', '搜索节点', 'Rechercher des nœuds')}</span>
          <input class="site-control-input" type="search" data-graph-search placeholder={pick('Search articles, diseases, places, or topics', '搜索论文、疾病、地区或主题', 'Rechercher des publications, maladies, lieux ou thèmes')} />
        </label>
        <label>
          <span>{pick('Node type', '节点类型', 'Type de nœud')}</span>
          <select class="site-control-input" data-graph-type>
            <option value="">{pick('All node types', '全部节点类型', 'Tous les types de nœuds')}</option>
            {nodeTypes.map(type => <option value={type}>{type.replaceAll('_', ' ')}</option>)}
          </select>
        </label>
      </div>

      <div class="graph-columns">
        <section aria-labelledby="graph-node-heading">
          <div class="graph-section-heading"><h2 id="graph-node-heading">{pick('Entities', '实体', 'Entités')}</h2><span data-graph-count>{nodes.length}</span></div>
          <div class="graph-node-list" data-graph-node-list></div>
          <noscript><p class="graph-script-note">{pick('Enable JavaScript to browse graph entities and relationships.', '请启用 JavaScript 以浏览图谱实体和关系。', 'Activez JavaScript pour parcourir les entités et relations du graphe.')}</p></noscript>
          <button class="graph-more" type="button" data-graph-more>{pick('Show more entities', '显示更多实体', 'Afficher davantage d’entités')}</button>
        </section>
        <section aria-labelledby="graph-relation-heading" class="graph-detail">
          <div class="graph-section-heading"><h2 id="graph-relation-heading">{pick('Selected relationships', '所选关系', 'Relations sélectionnées')}</h2></div>
          <div data-graph-detail>
            <p>{pick('Loading evidence graph relationships.', '正在加载证据图谱关系。', 'Chargement des relations du graphe des preuves.')}</p>
          </div>
        </section>
      </div>
    </section>

    <section class="graph-method card">
      <h2>{pick('Provenance and limits', '来源与限制', 'Provenance et limites')}</h2>
      <p>{pick('Disease, country, topic, pathogen, and study-design edges retain classifier confidence. Population-setting edges copy only a bilingual, quality-gated structured-summary field. Intervention and policy edges use a small published topic mapping. No raw abstracts, PDFs, or private source payloads are exported.', '疾病、国家、主题、病原体和研究设计关系保留分类置信度；人群与场景关系仅来自通过质量门控的双语结构化摘要；干预和政策关系使用小型公开主题映射。系统不会导出原始摘要、PDF 或私有来源负载。', 'Les liens de maladie, pays, thème, agent pathogène et plan d’étude conservent la confiance du classificateur. Les liens de population et de contexte ne reprennent qu’un champ de résumé structuré contrôlé par la qualité. Aucun résumé brut, PDF ou contenu privé n’est exporté.')}</p>
    </section>
  </div>

  <script is:inline define:vars={{ relationLabels }}>
    (() => {
      const root = document.querySelector('[data-evidence-graph]');
      if (!root) return;
      let graph = { nodes: [], edges: [] };
      let nodes = new Map();
      const search = root.querySelector('[data-graph-search]');
      const type = root.querySelector('[data-graph-type]');
      const count = root.querySelector('[data-graph-count]');
      const more = root.querySelector('[data-graph-more]');
      const detail = root.querySelector('[data-graph-detail]');
      const nodeList = root.querySelector('[data-graph-node-list]');
      let visibleLimit = 80;
      let selectedNodeId = '';

      const lang = () => root.dataset.graphLocale === 'zh' ? 'zh' : root.dataset.graphLocale === 'fr' ? 'fr' : 'en';
      const routePrefix = root.dataset.graphPrefix || '';
      const setStatus = (en, zh, fr) => {
        if (!detail) return;
        const message = document.createElement('p');
        message.textContent = lang() === 'zh' ? zh : lang() === 'fr' ? (fr || en) : en;
        detail.replaceChildren(message);
      };
      const refresh = () => {
        const query = String(search?.value || '').trim().toLowerCase();
        const selectedType = String(type?.value || '');
        const matching = (graph.nodes || []).filter((node) => (!selectedType || node.type === selectedType)
          && (!query || String(node.label || '').toLowerCase().includes(query)));
        const visible = matching.slice(0, visibleLimit);
        if (nodeList) {
          const fragment = document.createDocumentFragment();
          visible.forEach((node) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.dataset.nodeId = node.id;
            button.setAttribute('aria-pressed', String(node.id === selectedNodeId));
            const label = document.createElement('span');
            label.textContent = node.label;
            const nodeType = document.createElement('small');
            nodeType.textContent = String(node.type || '').replaceAll('_', ' ');
            button.append(label, nodeType);
            button.addEventListener('click', () => showNode(node.id));
            fragment.append(button);
          });
          nodeList.replaceChildren(fragment);
        }
        if (count) count.textContent = `${Math.min(matching.length, visibleLimit)} / ${matching.length}`;
        if (more) more.hidden = matching.length <= visibleLimit;
      };
      const showNode = (nodeId) => {
        const node = nodes.get(nodeId);
        if (!node || !detail) return;
        selectedNodeId = nodeId;
        root.querySelectorAll('[data-node-id]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.nodeId === nodeId)));
        const linked = (graph.edges || []).filter((edge) => edge.source === nodeId || edge.target === nodeId);
        const title = document.createElement('h3');
        title.textContent = node.label;
        const meta = document.createElement('p');
        meta.textContent = `${String(node.type || '').replaceAll('_', ' ')} · ${linked.length} ${lang() === 'zh' ? '条关系' : lang() === 'fr' ? 'relations' : 'relationships'}`;
        const list = document.createElement('ul');
        linked.forEach((edge) => {
          const outbound = edge.source === nodeId;
          const other = nodes.get(outbound ? edge.target : edge.source);
          const item = document.createElement('li');
          const relation = relationLabels[edge.relation] || { en: String(edge.relation).replaceAll('_', ' '), zh: String(edge.relation).replaceAll('_', ' '), fr: String(edge.relation).replaceAll('_', ' ') };
          const label = document.createElement('span');
          label.textContent = `${outbound ? '→' : '←'} ${relation[lang()]}`;
          const target = other?.url ? document.createElement('a') : document.createElement('strong');
          target.textContent = other?.label || (outbound ? edge.target : edge.source);
          if (other?.url) target.href = routePrefix && other.url.startsWith('/') ? `${routePrefix}${other.url}` : other.url;
          const confidence = document.createElement('small');
          confidence.textContent = edge.confidence == null ? (edge.provenance || '') : `${Math.round(Number(edge.confidence) * 100)}%`;
          item.append(label, target, confidence);
          list.append(item);
        });
        detail.replaceChildren(title, meta, list);
      };

      search?.addEventListener('input', () => { visibleLimit = 80; refresh(); });
      type?.addEventListener('change', () => { visibleLimit = 80; refresh(); });
      more?.addEventListener('click', () => { visibleLimit += 80; refresh(); });
      const loadGraph = async () => {
        try {
          const response = await fetch(root.dataset.graphSrc || '/site-data/research-graph.json', { headers: { Accept: 'application/json' } });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          graph = await response.json();
          nodes = new Map((graph.nodes || []).map((node) => [node.id, node]));
          refresh();
          setStatus('Choose an entity to inspect every public relationship attached to it.', '选择一个实体，查看与其关联的全部公开关系。', 'Choisissez une entité pour afficher toutes ses relations publiques.');
        } catch (error) {
          setStatus('The evidence graph could not be loaded. Please try again later.', '证据图谱暂时无法加载，请稍后重试。', 'Le graphe des preuves est indisponible. Réessayez plus tard.');
        }
      };
      loadGraph();
    })();
  </script>
</ReportLayout>

<style>
  .graph-page { width: min(1180px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 4rem; }
  .graph-hero { padding: clamp(1.5rem, 4vw, 3.5rem); }
  .graph-hero h1 { margin-top: .75rem; color: rgb(var(--text-strong)); font: 600 clamp(2.2rem, 5vw, 4.3rem)/1 'IBM Plex Sans', sans-serif; }
  .graph-hero > p:last-of-type { max-width: 52rem; margin-top: 1rem; color: rgb(var(--text-muted)); line-height: 1.7; }
  .graph-hero dl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; padding-top: 1.4rem; border-top: 1px solid rgb(var(--border)); }
  .graph-hero dt { color: rgb(var(--text-faint)); font-size: .68rem; }
  .graph-hero dd { margin-top: .25rem; color: rgb(var(--text-strong)); font: 600 1.6rem/1 'IBM Plex Sans', sans-serif; }
  .graph-workspace, .graph-method { margin-top: 1.5rem; padding: clamp(1.25rem, 3vw, 2rem); }
  .graph-controls { display: grid; grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr); gap: 1rem; }
  .graph-controls label > span { display: block; margin-bottom: .4rem; color: rgb(var(--text-muted)); font-size: .72rem; font-weight: 700; }
  .graph-controls input, .graph-controls select { width: 100%; padding: .72rem .8rem; }
  .graph-columns { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 1.5rem; margin-top: 1.5rem; }
  .graph-section-heading { display: flex; align-items: baseline; justify-content: space-between; padding-bottom: .8rem; border-bottom: 1px solid rgb(var(--border)); }
  .graph-section-heading h2, .graph-method h2 { color: rgb(var(--text-strong)); font: 600 1.35rem/1.2 'IBM Plex Sans', sans-serif; }
  .graph-section-heading span { color: rgb(var(--text-faint)); font: 500 .7rem/1 ui-monospace, monospace; }
  .graph-node-list { display: grid; gap: .4rem; max-height: 36rem; margin-top: .8rem; overflow-y: auto; }
  .graph-node-list button { display: flex; align-items: center; justify-content: space-between; gap: 1rem; width: 100%; border: 1px solid rgb(var(--border) / .7); background: rgb(var(--surface-raised) / .35); padding: .65rem .75rem; text-align: left; }
  .graph-node-list button:hover, .graph-node-list button[aria-pressed="true"] { border-color: rgb(var(--color-brand) / .7); background: rgb(var(--color-brand) / .08); }
  .graph-node-list span { color: rgb(var(--text)); font-size: .78rem; line-height: 1.35; }
  .graph-node-list small { flex: 0 0 auto; color: rgb(var(--text-faint)); font-size: .6rem; text-transform: uppercase; }
  .graph-script-note { margin-top: .8rem; color: rgb(var(--text-muted)); font-size: .75rem; }
  .graph-more { width: 100%; margin-top: .7rem; border: 1px solid rgb(var(--border)); padding: .65rem; color: rgb(var(--text-muted)); font-size: .72rem; }
  .graph-detail { border-left: 1px solid rgb(var(--border)); padding-left: 1.5rem; }
  .graph-detail [data-graph-detail] > p { margin-top: 1rem; color: rgb(var(--text-muted)); font-size: .8rem; line-height: 1.6; }
  .graph-detail h3 { margin-top: 1rem; color: rgb(var(--text-strong)); font: 600 1.25rem/1.25 'IBM Plex Sans', sans-serif; }
  .graph-detail ul { display: grid; gap: .45rem; margin-top: 1rem; max-height: 34rem; overflow-y: auto; }
  .graph-detail li { display: grid; grid-template-columns: minmax(8rem, .7fr) minmax(0, 1fr) auto; gap: .7rem; align-items: center; border-bottom: 1px solid rgb(var(--border) / .55); padding: .55rem 0; }
  .graph-detail li span, .graph-detail li small { color: rgb(var(--text-faint)); font-size: .65rem; }
  .graph-detail li strong, .graph-detail li a { color: rgb(var(--text)); font-size: .75rem; }
  .graph-detail li a:hover { color: rgb(var(--color-brand)); }
  .graph-method p { margin-top: .75rem; color: rgb(var(--text-muted)); font-size: .8rem; line-height: 1.7; }
  @media (max-width: 760px) { .graph-hero dl { grid-template-columns: repeat(2, 1fr); } .graph-controls, .graph-columns { grid-template-columns: 1fr; } .graph-detail { border-left: 0; border-top: 1px solid rgb(var(--border)); padding: 1.5rem 0 0; } }
</style>
