---
import ReportLayout from '../../../layouts/ReportLayout.astro';
import DiseaseLiteratureExplorer from '../../../components/research/DiseaseLiteratureExplorer';
import { shouldBuildPage } from '../../../lib/page-build-plan';
import { buildAlternatePaths, clampSeoTitle, isIndexableResearchCollection } from '../../../lib/seo';
import { diseaseLiteratureCatalogue } from '../../../lib/research-literature-server';
import { diseaseLiteratureSearchStrategy, literatureTrend } from '../../../lib/research-literature';
import { localizedDiseaseName } from '../../../utils/diseaseNames';
import { researchFeedCatalogue } from '../../../lib/research-feed-catalogue';

export function getStaticPaths() {
  const { diseaseFacets } = diseaseLiteratureCatalogue();
  return [...diseaseFacets.values()].filter((facet: any) => shouldBuildPage(`research:diseases:${facet.slug}`)).map((facet: any) => ({ params: { slug: facet.slug }, props: { facet, diseaseSlug: facet.slug, locale: 'en' } }));
}
interface Props { facet?: any; diseaseSlug?: string; locale?: 'en' | 'zh' | 'fr' }
const { locale = 'en', diseaseSlug = '' } = Astro.props as Props;
const { byDisease, diseaseFacets, generatedAt } = diseaseLiteratureCatalogue();
const facet = (Astro.props as Props).facet ?? [...diseaseFacets.values()].find((row: any) => row.slug === diseaseSlug);
if (!facet) return Astro.redirect('/research/');
const articles = byDisease.get(String(facet.disease_id).toLowerCase()) ?? [];
const prefix = locale === 'en' ? '' : `/${locale}`;
const pick = (en: string, zh: string, fr: string) => locale === 'zh' ? zh : locale === 'fr' ? fr : en;
const name = locale === 'zh' ? facet.name_zh || facet.name_en : locale === 'fr' ? localizedDiseaseName(facet, 'fr') : facet.name_en;
const title = pick(`${name} literature`, `${name}文献`, `Publications sur ${name}`);
const seoTitle = clampSeoTitle(pick(`Literature: ${name} | GIDS`, `${name}文献 | GIDS`, `Publications : ${name} | GIDS`));
const description = pick(`Browse all ${name} publications indexed by GIDS. Filter by date, country, topic, study type and access, explore publication trends, and continue searching PubMed with a built-in query.`, `集中浏览 GIDS 收录的${name}相关文献，按年份、地区、主题、研究类型和全文获取方式筛选，查看发文趋势，并使用内置检索式继续检索 PubMed 等数据库。`, `Consultez les publications sur ${name} répertoriées par GIDS, filtrez les résultats et explorez leur évolution, puis poursuivez dans PubMed avec une requête intégrée.`);
const canonicalPath = `${prefix}/research/diseases/${facet.slug}/`;
const countries = new Map<string, any>();
for (const article of articles) for (const country of article.countries ?? []) if (country.code) countries.set(country.code, country);
const facets = { countries: [...countries.values()].sort((a, b) => String(a.name_en).localeCompare(String(b.name_en))), studies: [...new Set(articles.map(row => row.study_type).filter(Boolean))].sort() as string[], topics: [...new Set(articles.flatMap(row => (row.topics ?? []).map((topic: any) => topic.name)).filter(Boolean))].sort() as string[] };
const strategy = diseaseLiteratureSearchStrategy(facet);
const rss = researchFeedCatalogue().definitions.find(row => row.scope === 'diseases' && row.value === facet.slug);
const summaryCount = articles.filter(row => row.detail_available !== false).length;
---
<ReportLayout title={seoTitle} description={description} initialLanguage={locale} seo={{ title: seoTitle, description, locale, canonicalPath, alternatePaths: buildAlternatePaths(canonicalPath, locale), pageType: 'CollectionPage', noindex: !isIndexableResearchCollection(articles.length) }} structuredData={{ '@type': 'CollectionPage', name: title, description, mainEntity: { '@type': 'ItemList', numberOfItems: articles.length } }} breadcrumbs={[{ label: 'Research Radar', labelZh: '研究雷达', labelFr: 'Radar de recherche', href: `${prefix}/research/` }, { label: `${facet.name_en} literature`, labelZh: `${facet.name_zh || facet.name_en}文献`, labelFr: `Publications sur ${localizedDiseaseName(facet, 'fr')}` }]}>
  <div class="disease-literature-page">
    <header class="academic-hero literature-hero">
      <p class="academic-kicker">{pick('Disease literature', '疾病文献专题', 'Publications par maladie')}</p>
      <h1>{title}</h1>
      <p class="literature-lead">{description}</p>
      <div class="literature-hero-links"><a href={`${prefix}/diseases/${facet.slug}/`}>{pick('Disease surveillance', '查看疾病监测', 'Surveillance de la maladie')} →</a>{rss && <a href={`${prefix}${rss.path}`}>{pick('Subscribe via RSS', 'RSS 订阅该疾病文献', 'S’abonner au flux RSS')} →</a>}<a href="#literature-strategy">{pick('Search PubMed & more', '使用数据库检索策略', 'Rechercher dans PubMed et ailleurs')} ↓</a></div>
      <dl class="literature-hero-metrics"><div><dt>{pick('Related publications', '相关文献', 'Publications associées')}</dt><dd>{articles.length.toLocaleString(locale)}</dd></div><div><dt>{pick('With GIDS evidence summaries', '附证据摘要', 'Avec synthèse GIDS')}</dt><dd>{summaryCount.toLocaleString(locale)}</dd></div><div><dt>{pick('Bibliographic records', '书目记录', 'Fiches bibliographiques')}</dt><dd>{(articles.length - summaryCount).toLocaleString(locale)}</dd></div><div><dt>{pick('Countries and regions', '关联国家和地区', 'Pays et régions')}</dt><dd>{countries.size.toLocaleString(locale)}</dd></div></dl>
      <p class="literature-catalogue-note">{pick('Disease links reflect catalogue classification. Bibliographic records link directly to their source and do not imply a GIDS evidence review.', '疾病关联依据文献目录分类。仅有书目信息的记录直接链接原始来源，不表示 GIDS 已完成证据解读。', 'Les associations proviennent de la classification du catalogue. Les fiches bibliographiques renvoient à la source sans impliquer une analyse GIDS.')}{generatedAt && <> {pick('Catalogue updated', '目录更新于', 'Catalogue mis à jour le')} {String(generatedAt).slice(0, 10)}</>}</p>
    </header>
    <DiseaseLiteratureExplorer client:load diseaseId={facet.disease_id} initialArticles={articles.slice(0, 24)} total={articles.length} initialTrend={literatureTrend(articles)} facets={facets} locale={locale} />
    <section class="literature-strategy" id="literature-strategy" aria-labelledby="literature-strategy-title">
      <p class="academic-kicker">{pick('Continue the search', '继续检索', 'Poursuivre la recherche')}</p><h2 id="literature-strategy-title">{pick('Search databases with a built-in strategy', '数据库检索与内置检索式', 'Bases de données et requêtes intégrées')}</h2>
      <p>{pick('Start with the disease name and selected synonyms. PubMed searches titles and abstracts; Europe PMC uses TITLE_ABS. These editable starting strategies do not cover every synonym and are not a systematic-review search. The filters above apply only to GIDS records.', '以疾病英文名称和常用同义词组合检索。PubMed 限定标题与摘要，Europe PMC 使用 TITLE_ABS 字段；可在目标数据库继续调整检索式。内置策略是检索起点，不保证穷尽同义词，也不能替代系统综述的完整检索。上方筛选仅作用于本站文献。', 'Ces requêtes combinent le nom de la maladie et des synonymes sélectionnés dans les titres et résumés. Adaptez-les dans la base cible ; elles ne remplacent pas une stratégie exhaustive de revue systématique. Les filtres ci-dessus s’appliquent uniquement au catalogue GIDS.')}</p>
      <div class="literature-database-links"><a href={strategy.pubmedUrl} target="_blank" rel="noopener noreferrer">PubMed ↗</a><a href={strategy.europepmcUrl} target="_blank" rel="noopener noreferrer">Europe PMC ↗</a><a href={strategy.scholarUrl} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></div>
      <details><summary>{pick('View and copy search strategies', '查看与复制检索式', 'Voir et copier les requêtes')}</summary><p>{pick('Included terms', '当前关键词', 'Termes inclus')}: {strategy.terms.join(' · ')}</p>{[{ name: 'PubMed', query: strategy.pubmed }, { name: 'Europe PMC', query: strategy.europepmc }, { name: 'Google Scholar', query: strategy.scholar }].map(row => <div class="literature-query-block"><label for={`strategy-${row.name.replaceAll(' ', '-')}`}>{row.name}</label><textarea id={`strategy-${row.name.replaceAll(' ', '-')}`} readonly rows="3">{row.query}</textarea><button type="button" data-copy-literature-query data-query={row.query}>{pick('Copy strategy', '复制检索式', 'Copier la requête')}</button></div>)}<p class="literature-strategy-help"><a href="https://pubmed.ncbi.nlm.nih.gov/help/#using-search-field-tags" target="_blank" rel="noopener noreferrer">{pick('PubMed search field documentation', 'PubMed 字段检索说明', 'Documentation des champs PubMed')} ↗</a> · <a href="https://europepmc.org/searchsyntax" target="_blank" rel="noopener noreferrer">{pick('Europe PMC query syntax', 'Europe PMC 检索语法', 'Syntaxe Europe PMC')} ↗</a></p></details>
      <p id="literature-copy-status" role="status" aria-live="polite"></p>
    </section>
  </div>
</ReportLayout>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-literature-query]')) button.addEventListener('click', async () => {
    const status = document.querySelector('#literature-copy-status');
    const zh = document.documentElement.lang.startsWith('zh');
    const fr = document.documentElement.lang.startsWith('fr');
    try { await navigator.clipboard.writeText(button.dataset.query ?? ''); if (status) status.textContent = zh ? '检索式已复制。' : fr ? 'Requête copiée.' : 'Search strategy copied.'; }
    catch { if (status) status.textContent = zh ? '可选中上方检索式手动复制。' : fr ? 'Sélectionnez la requête ci-dessus pour la copier.' : 'Select the query above to copy it manually.'; }
  });
</script>
<style>
  .literature-hero h1 { margin-top: .5rem; color: rgb(var(--text-strong)); font: 600 clamp(2rem, 4vw, 3rem)/1.2 'IBM Plex Sans', sans-serif; }
  .literature-lead { margin-top: 1.2rem; max-width: 58rem; color: rgb(var(--text-muted)); font-size: 1rem; line-height: 1.8; }
  .literature-hero-links, .literature-database-links { display: flex; flex-wrap: wrap; gap: .65rem 1.5rem; margin-top: 1rem; }
  .literature-hero-links a, .literature-database-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: .85rem; font-weight: 600; color: rgb(var(--color-teal)); }
  .literature-hero-metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .literature-hero-metrics > div { padding: 1rem; border: 1px solid rgb(var(--border)); }
  .literature-hero-metrics dt { color: rgb(var(--text-muted)); font-size: .75rem; }
  .literature-hero-metrics dd { margin-top: .4rem; color: rgb(var(--text-strong)); font-size: 1.5rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .literature-catalogue-note { margin-top: 1rem; color: rgb(var(--text-muted)); font-size: .76rem; line-height: 1.7; }
  .literature-strategy { padding: clamp(1rem, 3vw, 2rem); margin-top: 1.5rem; border: 1px solid rgb(var(--border)); background: rgb(var(--surface)); }
  .literature-strategy h2 { margin: .4rem 0 1rem; color: rgb(var(--text-strong)); font-size: 1.5rem; font-weight: 600; }
  .literature-strategy p { max-width: 65rem; color: rgb(var(--text-muted)); font-size: .82rem; line-height: 1.8; }
  .literature-strategy details { margin-top: 1rem; }
  .literature-strategy summary { padding: .5rem 0; cursor: pointer; color: rgb(var(--text)); font-size: .85rem; }
  .literature-query-block { margin: .8rem 0; }
  .literature-query-block label { display: block; font-size: .8rem; font-weight: 600; }
  .literature-query-block textarea { display: block; width: 100%; margin-top: .5rem; padding: .7rem; resize: vertical; min-height: 5rem; border: 1px solid rgb(var(--border)); background: rgb(var(--surface-raised)); color: rgb(var(--text)); font: .78rem/1.6 ui-monospace, monospace; }
  .literature-query-block button { min-height: 44px; padding: .5rem .7rem; color: rgb(var(--color-teal)); font-size: .8rem; text-decoration: underline; }
  .literature-strategy-help a { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) { .literature-hero-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; } }
</style>
