---
import ReportLayout from '../../../layouts/ReportLayout.astro';
import researchData from '../../../data/research/index.json';
import {
  integrityAlertLabel,
  normalizeIntegrityAlerts,
} from '../../../lib/research-integrity';
import { buildAlternatePaths } from '../../../lib/seo';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' };
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;

const alerts = normalizeIntegrityAlerts((researchData as any).integrity_alerts);
const counts = {
  retraction: alerts.filter(alert => alert.event_type === 'retraction').length,
  expression_of_concern: alerts.filter(alert => alert.event_type === 'expression_of_concern').length,
  correction: alerts.filter(alert => alert.event_type === 'correction').length,
};
const dateLabels = (value?: string) => {
  if (!value) return { en: 'Date unavailable', zh: '日期暂缺' };
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return { en: value, zh: value };
  return {
    en: parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }),
    zh: parsed.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }),
  };
};
const structuredData = {
  '@type': 'CollectionPage',
  name: pick('Research integrity alerts', '研究完整性通知'),
  description: pick('Public retraction, expression-of-concern, and correction history for Research Radar records.', '研究雷达文献的公开撤稿、关注声明和更正历史。'),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: alerts.length,
    itemListElement: alerts.map((alert, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${integrityAlertLabel(alert.event_type, locale)}: ${alert.article_title}`,
      url: alert.source_url,
    })),
  },
};
---

<ReportLayout
  title={pick('Research integrity alerts', '研究完整性通知')}
  description={pick('Public retraction, expression-of-concern, and correction history for Research Radar records.', '研究雷达文献的公开撤稿、关注声明和更正历史。')}
  initialLanguage={locale}
  seo={{
    title: pick('Research integrity alerts | Research Radar | GIDS', '研究完整性通知 | 研究雷达 | GIDS'),
    description: pick('Public retraction, expression-of-concern, and correction history for Research Radar records.', '研究雷达文献的公开撤稿、关注声明和更正历史。'),
    locale,
    canonicalPath: `${prefix}/research/integrity/`,
    alternatePaths: buildAlternatePaths(`${prefix}/research/integrity/`, locale),
    pageType: 'WebPage',
  }}
  structuredData={structuredData}
  breadcrumbs={[
    { label: pick('Research Radar', '研究雷达'), href: `${prefix}/research/` },
    { label: pick('Integrity alerts', '完整性通知') },
  ]}
>
  <div class="integrity-page">
    <header class="academic-hero integrity-hero">
      <div class="integrity-topline">
        <p class="academic-kicker">{pick('Publication record', '发表记录')}</p>
        <a href={`${prefix}/research/`}>{pick('Research home', '研究首页')}</a>
      </div>
      <h1>{pick('Research integrity alerts', '研究完整性通知')}</h1>
      <p class="integrity-lede">{pick('A public history of retractions, expressions of concern, and corrections affecting records that have appeared in Research Radar.', '公开记录曾出现在研究雷达中的文献所涉及的撤稿、关注声明和更正历史。')}</p>
      <dl class="integrity-metrics">
        <div><dt>{pick('All alerts', '全部通知')}</dt><dd>{alerts.length}</dd></div>
        <div><dt>{pick('Retractions', '撤稿')}</dt><dd>{counts.retraction}</dd></div>
        <div><dt>{pick('Expressions of concern', '关注声明')}</dt><dd>{counts.expression_of_concern}</dd></div>
        <div><dt>{pick('Corrections', '更正')}</dt><dd>{counts.correction}</dd></div>
      </dl>
    </header>

    <section class="integrity-explainer" aria-labelledby="integrity-explainer-title">
      <div>
        <p class="academic-kicker">{pick('How to read this page', '如何阅读本页')}</p>
        <h2 id="integrity-explainer-title">{pick('Status notices remain visible after catalogue removal', '文献移出目录后，状态通知仍会保留')}</h2>
      </div>
      <p>{pick('Retracted records and records under an expression of concern are removed from the public research catalogue, while this metadata-only history remains. Corrected records may remain public and link to their event history. Always verify the linked source record.', '撤稿文献和收到关注声明的文献会从公开研究目录中移除，但本页会保留仅含元数据的历史记录。已更正文献可能继续公开，并链接其事件历史。请始终核对所链接的来源记录。')}</p>
    </section>

    <section class="integrity-register" aria-labelledby="integrity-register-title">
      <div class="integrity-heading">
        <div>
          <p class="academic-kicker">{pick('Status history', '状态历史')}</p>
          <h2 id="integrity-register-title">{pick('Recorded integrity events', '已记录的完整性事件')}</h2>
        </div>
        <span>{String(alerts.length).padStart(2, '0')}</span>
      </div>

      {alerts.length === 0 ? (
        <div class="integrity-empty">
          <h3>{pick('No public integrity alerts', '暂无公开完整性通知')}</h3>
          <p>{pick('The alert register is active. Retractions, expressions of concern, and corrections will appear here after the publication-history gate is satisfied.', '通知登记页已经启用。通过发表历史门控后，撤稿、关注声明和更正将在此显示。')}</p>
        </div>
      ) : (
        <ol class="integrity-list">
          {alerts.map(alert => {
            const labelEn = integrityAlertLabel(alert.event_type);
            const labelZh = integrityAlertLabel(alert.event_type, 'zh');
            const eventDate = dateLabels(alert.effective_at ?? alert.recorded_at);
            return (
              <li>
                <article class:list={['integrity-alert', `integrity-${alert.event_type}`]}>
                  <div class="alert-topline">
                    <span class="alert-status">{pick(labelEn, labelZh)}</span>
                    <time datetime={alert.effective_at ?? alert.recorded_at}>{pick(eventDate.en, eventDate.zh)}</time>
                  </div>
                  <h3>{alert.article_title}</h3>
                  <p class="alert-citation">{[alert.journal, alert.doi ? `DOI ${alert.doi}` : null].filter(Boolean).join(' · ') || alert.article_id}</p>
                  <dl>
                    <div><dt>{pick('Current status', '当前状态')}</dt><dd>{pick(labelEn, labelZh)}</dd></div>
                    <div><dt>{pick('Recorded source', '记录来源')}</dt><dd>{alert.source}</dd></div>
                  </dl>
                  <div class="alert-actions">
                    {alert.source_url && <a class="source-link" href={alert.source_url} target="_blank" rel="noopener noreferrer">{pick('Verify source record ↗', '核对来源记录 ↗')}</a>}
                    {alert.article_url && <a href={zh && alert.article_url.startsWith('/') ? `${prefix}${alert.article_url}` : alert.article_url}>{pick('View corrected public record →', '查看已更正公开记录 →')}</a>}
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      )}
    </section>
  </div>
</ReportLayout>

<style>
  .integrity-page { width: min(74rem, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 4rem; }
  .integrity-hero { padding: clamp(1.5rem, 4vw, 3rem); }
  .integrity-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .integrity-topline a, .alert-actions a { color: rgb(var(--color-brand)); font-size: .72rem; font-weight: 700; }
  .integrity-hero h1 { max-width: 50rem; margin-top: 1rem; color: rgb(var(--text-strong)); font: 600 clamp(2rem, 5vw, 4rem)/1.02 'IBM Plex Sans', sans-serif; letter-spacing: -.035em; }
  .integrity-lede { max-width: 54rem; margin-top: 1rem; color: rgb(var(--text-muted)); font-size: .95rem; line-height: 1.7; }
  .integrity-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid rgb(var(--border) / .72); }
  .integrity-metrics dt, .integrity-alert dt { color: rgb(var(--text-faint)); font-size: .63rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .integrity-metrics dd { margin-top: .25rem; color: rgb(var(--text-strong)); font: 600 1.65rem/1 ui-monospace, monospace; }
  .integrity-explainer { display: grid; grid-template-columns: minmax(15rem, .6fr) minmax(0, 1fr); gap: 1.5rem; margin-top: 1.5rem; padding: 1.25rem; border: 1px solid rgb(var(--color-accent) / .35); border-left: 3px solid rgb(var(--color-accent)); background: rgb(var(--color-accent) / .045); }
  .integrity-explainer h2 { margin-top: .35rem; color: rgb(var(--text-strong)); font: 600 1.2rem/1.25 'IBM Plex Sans', sans-serif; }
  .integrity-explainer > p { color: rgb(var(--text-muted)); font-size: .78rem; line-height: 1.7; }
  .integrity-register { margin-top: 1.5rem; border: 1px solid rgb(var(--border) / .72); background: rgb(var(--surface)); }
  .integrity-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 1.4rem; border-bottom: 1px solid rgb(var(--border) / .72); }
  .integrity-heading h2 { margin-top: .3rem; color: rgb(var(--text-strong)); font: 600 1.55rem/1.15 'IBM Plex Sans', sans-serif; }
  .integrity-heading > span { color: rgb(var(--color-accent)); font: 600 .85rem/1 ui-monospace, monospace; }
  .integrity-list { list-style: none; margin: 0; padding: 0 1.4rem; }
  .integrity-list li + li { border-top: 1px solid rgb(var(--border) / .62); }
  .integrity-alert { padding: 1.4rem 0; }
  .alert-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .alert-status { border: 1px solid rgb(var(--border)); padding: .24rem .52rem; color: rgb(var(--text)); font-size: .65rem; font-weight: 750; letter-spacing: .045em; text-transform: uppercase; }
  .integrity-retraction .alert-status { border-color: rgb(185 28 28 / .45); background: rgb(185 28 28 / .08); color: rgb(185 28 28); }
  .integrity-expression_of_concern .alert-status { border-color: rgb(var(--color-accent) / .45); background: rgb(var(--color-accent) / .08); color: rgb(var(--color-accent)); }
  .integrity-correction .alert-status { border-color: rgb(var(--color-teal) / .5); background: rgb(var(--color-teal) / .08); color: rgb(var(--color-teal)); }
  .alert-topline time { color: rgb(var(--text-faint)); font: 500 .66rem/1 ui-monospace, monospace; }
  .integrity-alert h3 { max-width: 52rem; margin-top: .8rem; color: rgb(var(--text-strong)); font: 600 1.3rem/1.25 'IBM Plex Sans', sans-serif; }
  .alert-citation { margin-top: .45rem; color: rgb(var(--text-muted)); font-size: .72rem; }
  .integrity-alert dl { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1rem; }
  .integrity-alert dd { margin-top: .2rem; color: rgb(var(--text)); font-size: .72rem; }
  .alert-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
  .alert-actions a:hover, .integrity-topline a:hover { text-decoration: underline; }
  .integrity-empty { padding: 3rem 1.4rem; text-align: center; }
  .integrity-empty h3 { color: rgb(var(--text-strong)); font: 600 1.35rem/1.2 'IBM Plex Sans', sans-serif; }
  .integrity-empty p { max-width: 42rem; margin: .65rem auto 0; color: rgb(var(--text-muted)); font-size: .78rem; line-height: 1.65; }
  @media (max-width: 700px) {
    .integrity-page { width: min(100% - 1rem, 74rem); }
    .integrity-metrics { grid-template-columns: repeat(2, 1fr); }
    .integrity-explainer { grid-template-columns: 1fr; gap: .75rem; }
  }
</style>
