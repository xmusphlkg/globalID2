---
import ReportLayout from '../../../layouts/ReportLayout.astro';
import researchData from '../../../data/research/index.json';
import {
  integrityAlertLabel,
  normalizeIntegrityAlerts,
} from '../../../lib/research-integrity';

const alerts = normalizeIntegrityAlerts((researchData as any).integrity_alerts);
const counts = {
  retraction: alerts.filter(alert => alert.event_type === 'retraction').length,
  expression_of_concern: alerts.filter(alert => alert.event_type === 'expression_of_concern').length,
  correction: alerts.filter(alert => alert.event_type === 'correction').length,
};
const dateLabels = (value?: string) => {
  if (!value) return { en: 'Date unavailable', zh: '日期暂缺' };
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return { en: value, zh: value };
  return {
    en: parsed.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }),
    zh: parsed.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }),
  };
};
const structuredData = {
  '@type': 'CollectionPage',
  name: 'Research integrity alerts',
  description: 'Public retraction, expression-of-concern, and correction history for Research Radar records.',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: alerts.length,
    itemListElement: alerts.map((alert, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: `${integrityAlertLabel(alert.event_type)}: ${alert.article_title}`,
      url: alert.source_url,
    })),
  },
};
---

<ReportLayout
  title="Research integrity alerts"
  description="Public retraction, expression-of-concern, and correction history for Research Radar records."
  seo={{
    title: 'Research integrity alerts | Research Radar | GIDS',
    description: 'Public retraction, expression-of-concern, and correction history for Research Radar records.',
    locale: 'en',
    canonicalPath: '/research/integrity/',
    alternatePaths: { en: '/research/integrity/' },
    pageType: 'WebPage',
  }}
  structuredData={structuredData}
  breadcrumbs={[
    { label: 'Research Radar', labelZh: '研究雷达', href: '/research/' },
    { label: 'Integrity alerts', labelZh: '完整性通知' },
  ]}
>
  <main class="integrity-page">
    <header class="academic-hero integrity-hero">
      <div class="integrity-topline">
        <p class="academic-kicker" data-lang-en="Publication record" data-lang-zh="发表记录">Publication record</p>
        <a href="/research/" data-lang-en="Research home" data-lang-zh="研究首页">Research home</a>
      </div>
      <h1 data-lang-en="Research integrity alerts" data-lang-zh="研究完整性通知">Research integrity alerts</h1>
      <p class="integrity-lede" data-lang-en="A public history of retractions, expressions of concern, and corrections affecting records that have appeared in Research Radar." data-lang-zh="公开记录曾出现在研究雷达中的文献所涉及的撤稿、关注声明和更正历史。">A public history of retractions, expressions of concern, and corrections affecting records that have appeared in Research Radar.</p>
      <dl class="integrity-metrics">
        <div><dt data-lang-en="All alerts" data-lang-zh="全部通知">All alerts</dt><dd>{alerts.length}</dd></div>
        <div><dt data-lang-en="Retractions" data-lang-zh="撤稿">Retractions</dt><dd>{counts.retraction}</dd></div>
        <div><dt data-lang-en="Expressions of concern" data-lang-zh="关注声明">Expressions of concern</dt><dd>{counts.expression_of_concern}</dd></div>
        <div><dt data-lang-en="Corrections" data-lang-zh="更正">Corrections</dt><dd>{counts.correction}</dd></div>
      </dl>
    </header>

    <section class="integrity-explainer" aria-labelledby="integrity-explainer-title">
      <div>
        <p class="academic-kicker" data-lang-en="How to read this page" data-lang-zh="如何阅读本页">How to read this page</p>
        <h2 id="integrity-explainer-title" data-lang-en="Status notices remain visible after catalogue removal" data-lang-zh="文献移出目录后，状态通知仍会保留">Status notices remain visible after catalogue removal</h2>
      </div>
      <p data-lang-en="Retracted records and records under an expression of concern are removed from the public research catalogue, while this metadata-only history remains. Corrected records may remain public and link to their event history. Always verify the linked source record." data-lang-zh="撤稿文献和收到关注声明的文献会从公开研究目录中移除，但本页会保留仅含元数据的历史记录。已更正文献可能继续公开，并链接其事件历史。请始终核对所链接的来源记录。">Retracted records and records under an expression of concern are removed from the public research catalogue, while this metadata-only history remains. Corrected records may remain public and link to their event history. Always verify the linked source record.</p>
    </section>

    <section class="integrity-register" aria-labelledby="integrity-register-title">
      <div class="integrity-heading">
        <div>
          <p class="academic-kicker" data-lang-en="Status history" data-lang-zh="状态历史">Status history</p>
          <h2 id="integrity-register-title" data-lang-en="Recorded integrity events" data-lang-zh="已记录的完整性事件">Recorded integrity events</h2>
        </div>
        <span>{String(alerts.length).padStart(2, '0')}</span>
      </div>

      {alerts.length === 0 ? (
        <div class="integrity-empty">
          <h3 data-lang-en="No public integrity alerts" data-lang-zh="暂无公开完整性通知">No public integrity alerts</h3>
          <p data-lang-en="The alert register is active. Retractions, expressions of concern, and corrections will appear here after the publication-history gate is satisfied." data-lang-zh="通知登记页已经启用。通过发表历史门控后，撤稿、关注声明和更正将在此显示。">The alert register is active. Retractions, expressions of concern, and corrections will appear here after the publication-history gate is satisfied.</p>
        </div>
      ) : (
        <ol class="integrity-list">
          {alerts.map(alert => {
            const labelEn = integrityAlertLabel(alert.event_type);
            const labelZh = integrityAlertLabel(alert.event_type, 'zh');
            const eventDate = dateLabels(alert.effective_at ?? alert.recorded_at);
            return (
              <li>
                <article class:list={['integrity-alert', `integrity-${alert.event_type}`]}>
                  <div class="alert-topline">
                    <span class="alert-status" data-lang-en={labelEn} data-lang-zh={labelZh}>{labelEn}</span>
                    <time datetime={alert.effective_at ?? alert.recorded_at} data-lang-en={eventDate.en} data-lang-zh={eventDate.zh}>{eventDate.en}</time>
                  </div>
                  <h3>{alert.article_title}</h3>
                  <p class="alert-citation">{[alert.journal, alert.doi ? `DOI ${alert.doi}` : null].filter(Boolean).join(' · ') || alert.article_id}</p>
                  <dl>
                    <div><dt data-lang-en="Current status" data-lang-zh="当前状态">Current status</dt><dd data-lang-en={labelEn} data-lang-zh={labelZh}>{labelEn}</dd></div>
                    <div><dt data-lang-en="Recorded source" data-lang-zh="记录来源">Recorded source</dt><dd>{alert.source}</dd></div>
                  </dl>
                  <div class="alert-actions">
                    {alert.source_url && <a class="source-link" href={alert.source_url} target="_blank" rel="noopener noreferrer" data-lang-en="Verify source record ↗" data-lang-zh="核对来源记录 ↗">Verify source record ↗</a>}
                    {alert.article_url && <a href={alert.article_url} data-lang-en="View corrected public record →" data-lang-zh="查看已更正公开记录 →">View corrected public record →</a>}
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      )}
    </section>
  </main>
</ReportLayout>

<style>
  .integrity-page { width: min(74rem, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 4rem; }
  .integrity-hero { padding: clamp(1.5rem, 4vw, 3rem); }
  .integrity-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .integrity-topline a, .alert-actions a { color: rgb(var(--color-brand)); font-size: .72rem; font-weight: 700; }
  .integrity-hero h1 { max-width: 50rem; margin-top: 1rem; color: rgb(var(--text-strong)); font: 600 clamp(2rem, 5vw, 4rem)/1.02 'Source Serif 4', serif; letter-spacing: -.035em; }
  .integrity-lede { max-width: 54rem; margin-top: 1rem; color: rgb(var(--text-muted)); font-size: .95rem; line-height: 1.7; }
  .integrity-metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; padding-top: 1.25rem; border-top: 1px solid rgb(var(--border) / .72); }
  .integrity-metrics dt, .integrity-alert dt { color: rgb(var(--text-faint)); font-size: .63rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .integrity-metrics dd { margin-top: .25rem; color: rgb(var(--text-strong)); font: 600 1.65rem/1 'JetBrains Mono', monospace; }
  .integrity-explainer { display: grid; grid-template-columns: minmax(15rem, .6fr) minmax(0, 1fr); gap: 1.5rem; margin-top: 1.5rem; padding: 1.25rem; border: 1px solid rgb(var(--color-accent) / .35); border-left: 3px solid rgb(var(--color-accent)); background: rgb(var(--color-accent) / .045); }
  .integrity-explainer h2 { margin-top: .35rem; color: rgb(var(--text-strong)); font: 600 1.2rem/1.25 'Source Serif 4', serif; }
  .integrity-explainer > p { color: rgb(var(--text-muted)); font-size: .78rem; line-height: 1.7; }
  .integrity-register { margin-top: 1.5rem; border: 1px solid rgb(var(--border) / .72); background: rgb(var(--surface)); }
  .integrity-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding: 1.4rem; border-bottom: 1px solid rgb(var(--border) / .72); }
  .integrity-heading h2 { margin-top: .3rem; color: rgb(var(--text-strong)); font: 600 1.55rem/1.15 'Source Serif 4', serif; }
  .integrity-heading > span { color: rgb(var(--color-accent)); font: 600 .85rem/1 'JetBrains Mono', monospace; }
  .integrity-list { list-style: none; margin: 0; padding: 0 1.4rem; }
  .integrity-list li + li { border-top: 1px solid rgb(var(--border) / .62); }
  .integrity-alert { padding: 1.4rem 0; }
  .alert-topline { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .alert-status { border: 1px solid rgb(var(--border)); padding: .24rem .52rem; color: rgb(var(--text)); font-size: .65rem; font-weight: 750; letter-spacing: .045em; text-transform: uppercase; }
  .integrity-retraction .alert-status { border-color: rgb(185 28 28 / .45); background: rgb(185 28 28 / .08); color: rgb(185 28 28); }
  .integrity-expression_of_concern .alert-status { border-color: rgb(var(--color-accent) / .45); background: rgb(var(--color-accent) / .08); color: rgb(var(--color-accent)); }
  .integrity-correction .alert-status { border-color: rgb(var(--color-teal) / .5); background: rgb(var(--color-teal) / .08); color: rgb(var(--color-teal)); }
  .alert-topline time { color: rgb(var(--text-faint)); font: 500 .66rem/1 'JetBrains Mono', monospace; }
  .integrity-alert h3 { max-width: 52rem; margin-top: .8rem; color: rgb(var(--text-strong)); font: 600 1.3rem/1.25 'Source Serif 4', serif; }
  .alert-citation { margin-top: .45rem; color: rgb(var(--text-muted)); font-size: .72rem; }
  .integrity-alert dl { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1rem; }
  .integrity-alert dd { margin-top: .2rem; color: rgb(var(--text)); font-size: .72rem; }
  .alert-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1rem; }
  .alert-actions a:hover, .integrity-topline a:hover { text-decoration: underline; }
  .integrity-empty { padding: 3rem 1.4rem; text-align: center; }
  .integrity-empty h3 { color: rgb(var(--text-strong)); font: 600 1.35rem/1.2 'Source Serif 4', serif; }
  .integrity-empty p { max-width: 42rem; margin: .65rem auto 0; color: rgb(var(--text-muted)); font-size: .78rem; line-height: 1.65; }
  @media (max-width: 700px) {
    .integrity-page { width: min(100% - 1rem, 74rem); }
    .integrity-metrics { grid-template-columns: repeat(2, 1fr); }
    .integrity-explainer { grid-template-columns: 1fr; gap: .75rem; }
  }
</style>
