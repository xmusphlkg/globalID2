---
import ReportLayout from '../../layouts/ReportLayout.astro';
import ResearchAskSurveillance from '../../components/research/ResearchAskSurveillance';
import { buildAlternatePaths } from '../../lib/seo';

const { locale = 'en' } = Astro.props as { locale?: 'en' | 'zh' };
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;
---

<ReportLayout
  title={pick('Ask GIDS Research', '问研究雷达')}
  description={pick('Search published Research Radar evidence and its public surveillance links with source-level citations.', '检索研究雷达已发表证据及其公开监测关联，并核对来源级引用。')}
  initialLanguage={locale}
  seo={{
    title: pick('Ask GIDS Research | GIDS', '问研究雷达 | GIDS'),
    description: pick('Search published Research Radar evidence and its public surveillance links with source-level citations.', '检索研究雷达已发表证据及其公开监测关联，并核对来源级引用。'),
    locale,
    canonicalPath: `${prefix}/research/ask/`,
    alternatePaths: buildAlternatePaths(`${prefix}/research/ask/`, locale),
    pageType: 'WebPage',
  }}
  breadcrumbs={[
    { label: pick('Research Radar', '研究雷达'), href: `${prefix}/research/` },
    { label: pick('Ask GIDS Research', '问研究雷达') },
  ]}
>
  <div class="ask-page">
    <header class="academic-hero ask-hero">
      <div class="ask-hero-layout">
        <div class="ask-hero-copy">
          <p class="academic-kicker">{pick('Evidence-grounded retrieval', '基于证据的检索')}</p>
          <div class="ask-title-row">
            <h1>{pick('Ask GIDS Research', '问研究雷达')}</h1>
            <span class="ask-title-index">01 / 03</span>
          </div>
          <p class="ask-lede">{pick('Ask about a disease, country, study design, or public-health topic. Results come only from published Research Radar records and their verified public surveillance links.', '可询问疾病、国家、研究设计或公共卫生主题。结果仅来自研究雷达已发布记录及其已核验的公开监测关联。')}</p>
        </div>
        <aside class="ask-method-card" aria-label={pick('How Ask GIDS works', 'Ask GIDS 如何工作')}>
          <p class="ask-method-kicker">{pick('How it works', '工作方式')}</p>
          <ol>
            <li><span>01</span><strong>{pick('Parse the question', '拆解问题')}</strong><small>{pick('Disease, place, topic, and study design', '疾病、地区、主题与研究设计')}</small></li>
            <li><span>02</span><strong>{pick('Rank published evidence', '排序已发布证据')}</strong><small>{pick('Explainable catalogue matching', '可解释的目录匹配')}</small></li>
            <li><span>03</span><strong>{pick('Add surveillance context', '补充监测背景')}</strong><small>{pick('When a public time series is available', '有公开时间序列时显示')}</small></li>
          </ol>
        </aside>
      </div>
      <div class="ask-query-panel">
        <form id="research-question-form" class="ask-form" role="search" data-research-locale={locale}>
          <label for="research-question">{pick('Research question', '研究问题')}</label>
          <div class="ask-input-row">
            <input id="research-question" class="site-control-input" type="search" autocomplete="off" required minlength="2" maxlength="240" placeholder={pick('What does recent evidence say about pertussis resurgence?', '近期证据如何解释百日咳回升？')} />
            <button type="submit"><span>{pick('Find evidence', '查找证据')}</span><span aria-hidden="true">→</span></button>
          </div>
        </form>
        <div class="ask-examples" aria-label={pick('Example questions', '问题示例')}>
          <span>{pick('Try a focused query', '试试这些问题')}</span>
          <button type="button" data-question={pick('pertussis resurgence and vaccination', '百日咳回升与疫苗接种')}>{pick('Pertussis resurgence', '百日咳回升')}</button>
          <button type="button" data-question={pick('dengue surveillance in Brazil', '巴西登革热监测')}>{pick('Dengue in Brazil', '巴西登革热')}</button>
          <button type="button" data-question={pick('antimicrobial resistance systematic reviews', '抗菌药物耐药系统综述')}>{pick('AMR reviews', '耐药性综述')}</button>
        </div>
        <p class="ask-privacy"><span class="ask-privacy-dot" aria-hidden="true"></span>{pick('Processed in this browser · not sent to a model · not stored by this page', '仅在当前浏览器处理 · 不发送给模型 · 本页面不保存')}</p>
      </div>
    </header>

    <section id="ask-status" class="card ask-status" role="status" aria-live="polite" hidden></section>
    <section id="ask-answer" class="ask-answer" aria-live="polite" hidden>
      <article class="card answer-summary">
        <div class="answer-heading"><div><p class="academic-kicker">{pick('Catalogue answer', '目录回答')}</p><h2>{pick('What the indexed evidence shows', '索引证据显示什么')}</h2></div><a href={`${prefix}/research/`}>{pick('Browse Research Radar', '浏览研究雷达')} <span aria-hidden="true">→</span></a></div>
        <p id="answer-query-caption" class="answer-query-caption"></p>
        <p id="answer-summary-text"></p>
        <div class="answer-metrics" aria-label={pick('Answer counts', '回答统计')}>
          <div><strong id="answer-exact-count">—</strong><span>{pick('Exact matches', '精确匹配')}</span></div>
          <div><strong id="answer-background-count">—</strong><span>{pick('Background matches', '背景匹配')}</span></div>
          <div><strong id="answer-surveillance-count">—</strong><span>{pick('Public signals', '公开信号')}</span></div>
        </div>
        <div id="answer-themes" class="answer-themes"></div>
        <p id="answer-limitations" class="answer-limitations"></p>
      </article>

      <article id="answer-surveillance-card" class="card answer-section ask-surveillance-section" hidden>
        <div class="answer-section-heading">
          <div><p class="academic-kicker">{pick('Surveillance context', '监测背景')}</p><h2>{pick('Epidemiological curve', '流行病学曲线')}</h2></div>
          <span class="answer-section-badge">{pick('GIDS data', 'GIDS 数据')}</span>
        </div>
        <p id="answer-surveillance-intro" class="answer-section-intro"></p>
        <ResearchAskSurveillance client:load initialLanguage={locale} />
      </article>

      <article id="answer-signals-card" class="card answer-section" hidden>
        <div class="answer-section-heading"><div><p class="academic-kicker">{pick('Current GIDS context', '当前 GIDS 背景')}</p><h2>{pick('Linked public surveillance signals', '已关联的公开监测信号')}</h2></div><span class="answer-section-badge">{pick('Linked evidence', '关联证据')}</span></div>
        <div id="answer-signals" class="signal-list"></div>
      </article>

      <article class="card answer-section">
        <div class="answer-section-heading"><div><p class="academic-kicker">{pick('Cited evidence', '引用证据')}</p><h2>{pick('Relevant Research Radar records', '相关研究雷达记录')}</h2></div><span class="answer-section-badge">{pick('Source-level links', '来源级链接')}</span></div>
        <div id="answer-evidence" class="evidence-list"></div>
      </article>
    </section>
  </div>
</ReportLayout>

<script>
  import { answerResearchQuestion } from '../../lib/research-ask';

  const form = document.querySelector<HTMLFormElement>('#research-question-form');
  const input = document.querySelector<HTMLInputElement>('#research-question');
  const status = document.querySelector<HTMLElement>('#ask-status');
  const answer = document.querySelector<HTMLElement>('#ask-answer');
  const queryCaption = document.querySelector<HTMLElement>('#answer-query-caption');
  const summary = document.querySelector<HTMLElement>('#answer-summary-text');
  const exactCount = document.querySelector<HTMLElement>('#answer-exact-count');
  const backgroundCount = document.querySelector<HTMLElement>('#answer-background-count');
  const surveillanceCount = document.querySelector<HTMLElement>('#answer-surveillance-count');
  const themes = document.querySelector<HTMLElement>('#answer-themes');
  const limitations = document.querySelector<HTMLElement>('#answer-limitations');
  const surveillanceCard = document.querySelector<HTMLElement>('#answer-surveillance-card');
  const surveillanceIntro = document.querySelector<HTMLElement>('#answer-surveillance-intro');
  const signalsCard = document.querySelector<HTMLElement>('#answer-signals-card');
  const signals = document.querySelector<HTMLElement>('#answer-signals');
  const evidence = document.querySelector<HTMLElement>('#answer-evidence');
  let cataloguePromise: Promise<any[]> | null = null;
  const isZh = () => form?.dataset.researchLocale === 'zh';
  const routePrefix = isZh() ? '/zh' : '';
  const SURVEILLANCE_EVENT = 'gids:research-ask-surveillance';
  type SurveillanceDetail = {
    diseaseId: string;
    diseaseSlug?: string | null;
    diseaseNameEn?: string | null;
    diseaseNameZh?: string | null;
    countryCodes: string[];
    countryNameEn?: string | null;
    countryNameZh?: string | null;
  };
  const askWindow = window as Window & { __gidsResearchAskSurveillance?: SurveillanceDetail | null };
  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) => {
    const element = document.createElement(tag);
    if (className) element.className = className;
    return element;
  };
  const formatDate = (value: string | null | undefined) => {
    if (!value) return isZh() ? '日期暂缺' : 'Date unavailable';
    return new Intl.DateTimeFormat(isZh() ? 'zh-CN' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }).format(new Date(value));
  };
  const setStatus = (message: string, kind = 'pending') => {
    if (!status) return;
    status.hidden = false;
    status.dataset.kind = kind;
    status.textContent = message;
  };
  const loadCatalogue = () => {
    cataloguePromise ??= fetch('/research/catalogue.json', { headers: { accept: 'application/json' } })
      .then((response) => {
        if (!response.ok) throw new Error(`catalogue_${response.status}`);
        return response.json();
      })
      .then((payload) => Array.isArray(payload?.articles) ? payload.articles : []);
    return cataloguePromise;
  };

  const normalizedFacet = (value: unknown) => String(value ?? '')
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, ' ')
    .trim();
  const requestedFacetTerms = (result: ReturnType<typeof answerResearchQuestion>, kind: string) => [...new Set(
    result.evidence.flatMap((item) => item.matchReasons
      .filter((reason) => reason.kind === kind)
      .flatMap((reason) => [reason.queryTerm, reason.matchedAlias])
      .map(normalizedFacet)
      .filter(Boolean))
  )];
  const matchesFacet = (item: any, terms: string[]) => {
    if (!terms.length) return false;
    const candidates = [item.disease_id, item.slug, item.code, item.name_en, item.name_zh]
      .map(normalizedFacet)
      .filter(Boolean);
    return terms.some((term) => candidates.some((candidate) => (
      candidate === term
      || (candidate.length > 3 && (candidate.includes(term) || term.includes(candidate)))
    )));
  };
  const buildSurveillanceDetail = (result: ReturnType<typeof answerResearchQuestion>): SurveillanceDetail | null => {
    const diseaseTerms = requestedFacetTerms(result, 'disease');
    if (!diseaseTerms.length) return null;
    const diseaseCandidates = result.evidence.flatMap((item) => item.article.diseases ?? [])
      .filter((item: any) => Number(item.confidence ?? 1) >= 0.66 && item.disease_id)
      .filter((item: any) => matchesFacet(item, diseaseTerms));
    const disease = new Map(diseaseCandidates.map((item: any) => [String(item.disease_id), item])).values().next().value as any;
    if (!disease) return null;

    const countryTerms = requestedFacetTerms(result, 'country');
    const countryCandidates = countryTerms.length
      ? result.evidence.flatMap((item) => item.article.countries ?? [])
        .filter((item: any) => Number(item.confidence ?? 1) >= 0.66 && item.code)
        .filter((item: any) => matchesFacet(item, countryTerms))
      : [];
    const countries = [...new Map(countryCandidates.map((item: any) => [String(item.code).toUpperCase(), item])).values()] as any[];
    return {
      diseaseId: String(disease.disease_id),
      diseaseSlug: disease.slug ?? null,
      diseaseNameEn: disease.name_en ?? null,
      diseaseNameZh: disease.name_zh ?? null,
      countryCodes: countries.map((item) => String(item.code).toUpperCase()),
      countryNameEn: countries.length === 1 ? countries[0].name_en ?? null : null,
      countryNameZh: countries.length === 1 ? countries[0].name_zh ?? null : null,
    };
  };

  const render = (result: ReturnType<typeof answerResearchQuestion>) => {
    if (!answer || !queryCaption || !summary || !exactCount || !backgroundCount || !surveillanceCount || !themes || !limitations || !surveillanceCard || !surveillanceIntro || !signals || !signalsCard || !evidence || !status) return;
    status.hidden = true;
    answer.hidden = false;
    queryCaption.textContent = `${isZh() ? '当前问题' : 'Current question'} · ${result.query}`;
    summary.textContent = isZh() ? result.summaryZh : result.summaryEn;
    exactCount.textContent = String(result.exactEvidence.length);
    backgroundCount.textContent = String(result.backgroundEvidence.length);
    surveillanceCount.textContent = String(result.signals.length);
    limitations.textContent = isZh() ? result.limitationsZh : result.limitationsEn;
    themes.replaceChildren(...result.themes.map((item) => {
      const chip = make('span');
      chip.textContent = `${item.name} · ${item.count}`;
      return chip;
    }));

    signalsCard.hidden = result.signals.length === 0;
    signals.replaceChildren(...result.signals.map((signal) => {
      const link = make('a');
      const signalPath = signal.situation_url || '/situation/';
      link.href = routePrefix && signalPath.startsWith('/') ? `${routePrefix}${signalPath}` : signalPath;
      const title = make('strong');
      title.textContent = isZh() ? (signal.disease_name_zh || signal.disease_name_en || signal.title || '监测信号') : (signal.disease_name_en || signal.title || 'Surveillance signal');
      const detail = make('span');
      const geographies = (signal.geographies ?? []).map((item: any) => item.name_en || item.name || item.code).filter(Boolean).join(', ');
      detail.textContent = [geographies, signal.relation_level === 'exact_disease_geography' ? (isZh() ? '疾病与地区精确关联' : 'Exact disease–geography link') : (isZh() ? '疾病背景关联' : 'Disease-context link'), signal.data_through ? formatDate(signal.data_through) : ''].filter(Boolean).join(' · ');
      link.append(title, detail);
      return link;
    }));

    const surveillanceDetail = buildSurveillanceDetail(result);
    surveillanceCard.hidden = !surveillanceDetail;
    if (surveillanceDetail) {
      const diseaseLabel = isZh()
        ? surveillanceDetail.diseaseNameZh || surveillanceDetail.diseaseNameEn || surveillanceDetail.diseaseId
        : surveillanceDetail.diseaseNameEn || surveillanceDetail.diseaseId;
      const countryLabel = surveillanceDetail.countryCodes.length === 1
        ? (isZh()
            ? surveillanceDetail.countryNameZh || surveillanceDetail.countryNameEn || surveillanceDetail.countryCodes[0]
            : surveillanceDetail.countryNameEn || surveillanceDetail.countryCodes[0])
        : surveillanceDetail.countryCodes.length > 1
          ? (isZh() ? `${surveillanceDetail.countryCodes.length} 个相关国家/地区` : `${surveillanceDetail.countryCodes.length} related locations`)
          : (isZh() ? '报告国家/地区' : 'reporting locations');
      surveillanceIntro.textContent = isZh()
        ? `已根据问题匹配 ${diseaseLabel} × ${countryLabel} 的公开报告病例序列。`
        : `A public reported-case series was matched for ${diseaseLabel} × ${countryLabel}.`;
    }
    askWindow.__gidsResearchAskSurveillance = surveillanceDetail;
    window.dispatchEvent(new CustomEvent(SURVEILLANCE_EVENT, { detail: surveillanceDetail }));

    if (!result.evidence.length) {
      const empty = make('p', 'evidence-empty');
      empty.textContent = isZh() ? '请换一个更具体的疾病、地区或主题后重试。' : 'Try a more specific disease, geography, or topic.';
      evidence.replaceChildren(empty);
      return;
    }
    evidence.replaceChildren(...result.evidence.map((item, index) => {
      const article = item.article;
      const row = make('section', 'evidence-row');
      const number = make('span', 'evidence-number');
      number.textContent = String(index + 1).padStart(2, '0');
      const body = make('div');
      const rowHeader = make('div', 'evidence-row-header');
      const heading = make('h3');
      const internal = make('a');
      internal.href = `${routePrefix}/research/articles/${article.slug}/`;
      internal.textContent = article.title || (isZh() ? '未命名研究' : 'Untitled research');
      heading.append(internal);
      const level = make('span', `evidence-level evidence-level-${item.evidenceLevel}`);
      level.textContent = item.evidenceLevel === 'exact'
        ? (isZh() ? '精确匹配' : 'Exact match')
        : (isZh() ? '背景匹配' : 'Background');
      rowHeader.append(level);
      const meta = make('p', 'evidence-meta');
      meta.textContent = [article.journal, article.study_type, (article.countries ?? []).map((country: any) => country.name_en || country.code).join(', '), formatDate(article.published_at)].filter(Boolean).join(' · ');
      const matched = make('p', 'evidence-match');
      matched.textContent = `${isZh() ? '匹配' : 'Matched'}: ${item.matchedTerms.join(isZh() ? '、' : ', ')}`;
      const finding = make('p', 'evidence-finding');
      finding.textContent = (isZh() ? item.findingZh : item.findingEn) || (isZh() ? '该记录尚无已发布的结构化结果摘要；请查看原文。' : 'No published structured finding is available for this record; consult the source.');
      const citations = make('div', 'evidence-citations');
      const radar = make('a');
      radar.href = `${routePrefix}/research/articles/${article.slug}/`;
      radar.textContent = isZh() ? '证据摘要' : 'Evidence summary';
      citations.append(radar);
      if (article.doi) {
        const doi = make('a');
        doi.href = `https://doi.org/${article.doi}`;
        doi.target = '_blank';
        doi.rel = 'noopener noreferrer';
        doi.textContent = `DOI ${article.doi} ↗`;
        citations.append(doi);
      }
      if (article.pmid) {
        const pmid = make('a');
        pmid.href = `https://pubmed.ncbi.nlm.nih.gov/${article.pmid}/`;
        pmid.target = '_blank';
        pmid.rel = 'noopener noreferrer';
        pmid.textContent = `PMID ${article.pmid} ↗`;
        citations.append(pmid);
      }
      if (article.open_access_url) {
        const oa = make('a');
        oa.href = article.open_access_url;
        oa.target = '_blank';
        oa.rel = 'noopener noreferrer';
        oa.textContent = isZh() ? '开放获取 ↗' : 'Open access ↗';
        citations.append(oa);
      }
      body.append(rowHeader, heading, meta, matched, finding, citations);
      row.append(number, body);
      row.dataset.evidenceLevel = item.evidenceLevel;
      return row;
    }));
  };

  const ask = async (question: string) => {
    const query = question.trim();
    if (query.length < 2) return;
    setStatus(isZh() ? '正在检索已发布目录…' : 'Searching the published catalogue…');
    answer?.setAttribute('hidden', '');
    try {
      const articles = await loadCatalogue();
      render(answerResearchQuestion(query, articles, { limit: 12 }));
      const url = new URL(location.href);
      url.searchParams.set('q', query);
      history.replaceState(null, '', url);
    } catch {
      setStatus(isZh() ? '暂时无法读取研究目录，请稍后重试。' : 'The research catalogue could not be loaded. Please try again shortly.', 'error');
    }
  };

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    void ask(input?.value ?? '');
  });
  document.querySelectorAll<HTMLButtonElement>('[data-question]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!input) return;
      input.value = button.dataset.question || '';
      void ask(input.value);
    });
  });
  const preset = new URLSearchParams(location.search).get('q');
  if (preset && input) {
    input.value = preset.slice(0, 240);
    void ask(input.value);
  }
</script>

<style is:global>
  .ask-page { width: min(78rem, calc(100% - 2rem)); margin: 0 auto; padding: clamp(1.25rem, 4vw, 2.75rem) 0 4rem; }
  .ask-hero { padding: clamp(1.25rem, 4vw, 2.75rem); background: linear-gradient(135deg, rgb(var(--surface)), rgb(var(--surface-raised) / .46)); }
  .ask-hero-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(16rem, 21rem); gap: clamp(1.5rem, 5vw, 4.5rem); align-items: stretch; }
  .ask-hero-copy { min-width: 0; }
  .ask-title-row { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-top: .7rem; }
  .ask-hero h1 { max-width: 62rem; color: rgb(var(--text-strong)); font: 600 clamp(2.35rem, 6vw, 4.7rem)/.98 'IBM Plex Sans', sans-serif; letter-spacing: -.05em; }
  .ask-title-index { flex: 0 0 auto; padding-bottom: .25rem; color: rgb(var(--text-faint)); font: 600 .62rem/1 ui-monospace, monospace; letter-spacing: .12em; }
  .ask-lede { max-width: 52rem; margin-top: 1rem; color: rgb(var(--text-muted)); font-size: clamp(.92rem, 1.8vw, 1.08rem); line-height: 1.72; }
  .ask-method-card { border-left: 1px solid rgb(var(--border-soft) / .72); padding: .1rem 0 .1rem 1.35rem; }
  .ask-method-kicker { color: rgb(var(--text-faint)); font-size: .64rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .ask-method-card ol { display: grid; gap: 1rem; margin-top: 1.1rem; list-style: none; }
  .ask-method-card li { display: grid; grid-template-columns: 1.8rem minmax(0, 1fr); column-gap: .55rem; }
  .ask-method-card li > span { grid-row: span 2; color: rgb(var(--color-teal)); font: 600 .65rem/1.35 ui-monospace, monospace; }
  .ask-method-card strong { color: rgb(var(--text-strong)); font-size: .76rem; line-height: 1.35; }
  .ask-method-card small { margin-top: .18rem; color: rgb(var(--text-faint)); font-size: .65rem; line-height: 1.45; }
  .ask-query-panel { margin-top: clamp(1.75rem, 4vw, 2.75rem); border-top: 1px solid rgb(var(--border) / .75); padding-top: 1.25rem; }
  .ask-form { margin-top: 0; }
  .ask-form > label { display: block; margin-bottom: .55rem; color: rgb(var(--text-strong)); font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ask-input-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
  .ask-input-row input { min-height: 3.35rem; border-right: 0; padding: 0 1rem; font-size: .94rem; }
  .ask-input-row button { display: inline-flex; min-width: 10.5rem; min-height: 3.35rem; align-items: center; justify-content: space-between; gap: 1rem; border: 1px solid rgb(var(--color-brand)); background: rgb(var(--color-brand)); padding: 0 1rem 0 1.1rem; color: white; font-size: .75rem; font-weight: 700; letter-spacing: .02em; transition: background-color .18s ease, border-color .18s ease; }
