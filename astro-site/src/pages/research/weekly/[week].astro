---
import { existsSync, readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { resolve } from 'node:path';
import ResearchCollectionPage from '../../../components/research/ResearchCollectionPage.astro';
import ResearchEvidenceContext from '../../../components/research/ResearchEvidenceContext.astro';
import researchData from '../../../data/research/routes.json';
import { shouldBuildPage } from '../../../lib/page-build-plan';
import { localizedDiseaseName } from '../../../utils/diseaseNames';
import { localizedRegionName, localizedResearchTopic } from '../../../utils/i18n';
import { absoluteSiteUrl, siteHref } from '../../../lib/papers';
import { clampSeoTitleWithSuffix } from '../../../lib/seo';

export function getStaticPaths() {
  return ((researchData as any).facets?.weeks ?? []).filter((facet: any) => shouldBuildPage(`research:weekly:${facet.week}`)).map((facet: any) => ({ params: { week: facet.week }, props: { facet, week: facet.week, locale: 'en' } }));
}

interface Props { facet?: any; week?: string; locale?: 'en' | 'zh' | 'fr' }
const { locale = 'en' } = Astro.props as Props;
const week = (Astro.props as Props).week ?? '';
const facet = (Astro.props as Props).facet ?? ((researchData as any).facets?.weeks ?? []).find((item: any) => item.week === week);
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const localeHref = (href: string) => (zh || fr) && href.startsWith('/') ? `${prefix}${href}` : href;
const file = resolve(process.env.GIDS_SITE_DATA_ROOT || './src/data', `research/weekly/${facet.week}.json`);
const payloadBytes = existsSync(file) ? readFileSync(file) : null;
const payload = payloadBytes ? JSON.parse(payloadBytes.toString('utf-8')) : { articles: [], top_topics: [] };
// Records which exact public brief data produced this locale's built page.
// The subscription dispatcher checks both en and zh pages against it before
// sending any content; source exports can change independently after build.
const payloadSha256 = payloadBytes ? createHash('sha256').update(payloadBytes).digest('hex') : '';
const briefArticles = payload.articles ?? [];
const leadingTopics = (payload.top_topics ?? []).slice(0, 3);
const topicsEn = leadingTopics.join(', ');
const topicsZh = leadingTopics.map((topic: string) => localizedResearchTopic('zh', topic)).join('、');
const topicsFr = leadingTopics.map((topic: string) => localizedResearchTopic('fr', topic)).join(', ');
const diseaseCounts = new Map<string, { en: string; zh: string; fr: string; count: number }>();
for (const article of briefArticles) for (const disease of article.diseases ?? []) {
  const key = String(disease.disease_id ?? disease.name_en ?? '').toLowerCase();
  if (!key) continue;
  const previous = diseaseCounts.get(key);
  diseaseCounts.set(key, { en: disease.name_en ?? key, zh: disease.name_zh ?? disease.name_en ?? key, fr: disease.name_fr ?? disease.name_en ?? key, count: (previous?.count ?? 0) + 1 });
}
const leadingDiseases = [...diseaseCounts.values()].sort((a, b) => b.count - a.count || a.en.localeCompare(b.en)).slice(0, 2);
const diseasesEn = leadingDiseases.map(disease => disease.en).join(', ');
const diseasesZh = leadingDiseases.map(disease => disease.zh).join('、');
const diseasesFr = leadingDiseases.map(disease => disease.fr).join(', ');
const description = `Weekly infectious disease research brief ${facet.week}: ${briefArticles.length} papers${topicsEn ? ` on ${topicsEn}` : ''}, with evidence summaries and surveillance context.`;
const descriptionZh = `传染病研究周报 ${facet.week}：汇集 ${briefArticles.length} 篇研究文献${topicsZh ? `，涵盖${topicsZh}` : ''}，提供有引用的证据摘要、研究局限及相关疫情监测背景。`;
const descriptionFr = `Brief de recherche infectieuse ${facet.week} : ${briefArticles.length} publications${topicsFr ? ` sur ${topicsFr}` : ''}, synthèses et contexte de surveillance.`;
const introductionEn = `This weekly infectious disease research brief brings together ${briefArticles.length} publications dated ${payload.start_date ?? facet.start_date} through ${payload.end_date ?? facet.end_date}.${topicsEn ? ` Leading catalogue topics include ${topicsEn}.` : ''} Follow the cited findings to individual evidence summaries and compare the available surveillance context and evidence gaps below.`;
const introductionZh = `本期传染病研究周报汇集 ${payload.start_date ?? facet.start_date} 至 ${payload.end_date ?? facet.end_date} 发表的 ${briefArticles.length} 篇文献。${topicsZh ? `主要收录主题包括${topicsZh}。` : ''}可从有引用的发现进入单篇证据摘要，并结合下方已提供的监测背景及证据缺口阅读。`;
const introductionFr = `Ce brief hebdomadaire réunit ${briefArticles.length} publications datées du ${payload.start_date ?? facet.start_date} au ${payload.end_date ?? facet.end_date}.${topicsFr ? ` Les principaux thèmes du catalogue comprennent ${topicsFr}.` : ''} Consultez les résultats cités, les synthèses individuelles et le contexte de surveillance disponible ci-dessous.`;
const briefTitle = `Infectious Disease Research Week ${facet.week}: ${diseasesEn || topicsEn || 'Key papers'}`;
const briefTitleZh = `传染病研究周报 ${facet.week}${diseasesZh ? `：${diseasesZh}` : topicsZh ? `：${topicsZh}` : ''}`;
const briefTitleFr = `Semaine de recherche infectieuse ${facet.week}${diseasesFr ? ` : ${diseasesFr}` : topicsFr ? ` : ${topicsFr}` : ''}`;
const seoBriefTitle = locale === 'zh'
  ? clampSeoTitleWithSuffix(briefTitleZh, '| 研究雷达 | GIDS')
  : locale === 'fr'
    ? clampSeoTitleWithSuffix(briefTitleFr, '| Radar de recherche | GIDS')
    : clampSeoTitleWithSuffix(briefTitle, '| Research Radar | GIDS');
const sortedWeeks = [...((researchData as any).facets?.weeks ?? [])].sort((a: any, b: any) => a.week.localeCompare(b.week));
const weekIndex = sortedWeeks.findIndex((row: any) => row.week === facet.week);
const previousWeek = weekIndex > 0 ? sortedWeeks[weekIndex - 1] : null;
const nextWeek = weekIndex >= 0 ? sortedWeeks[weekIndex + 1] : null;
const canonicalUrl = absoluteSiteUrl(`${prefix}/research/weekly/${facet.week}/`, Astro.site ?? Astro.url.origin).toString();
const structuredBrief = {
  '@type': 'Report',
  '@id': `${canonicalUrl}#brief`,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  headline: zh ? briefTitleZh : fr ? briefTitleFr : briefTitle,
  abstract: zh ? introductionZh : fr ? introductionFr : introductionEn,
  inLanguage: zh ? 'zh-CN' : fr ? 'fr-FR' : 'en',
  author: { '@type': 'Organization', name: 'GIDS Research Radar', url: absoluteSiteUrl(`${prefix}/research/`, Astro.site ?? Astro.url.origin).toString() },
  // These are the papers' coverage dates, not the brief's publication date.
  temporalCoverage: `${payload.start_date ?? facet.start_date}/${payload.end_date ?? facet.end_date}`,
  citation: (payload.cited_findings ?? []).map((finding: any) => finding.source_url).filter(Boolean),
};
const citedFindings = payload.cited_findings ?? [];
const monitoringContext = payload.monitoring_context ?? [];
const evidenceGaps = payload.evidence_gaps ?? [];
const reviewer = payload.brief_status === 'editorially_reviewed' && payload.byline?.reviewer
  ? payload.byline.reviewer
  : null;
const aiReview = payload.brief_status === 'ai_reviewed' && payload.byline?.ai_review
  ? payload.byline.ai_review
  : null;
const reviewedDate = reviewer?.reviewed_at ? String(reviewer.reviewed_at).slice(0, 10) : '';
const reviewedByEn = reviewer ? `Editorially reviewed by ${reviewer.name} · ${reviewer.role}` : '';
const reviewedByZh = reviewer ? `编辑审核：${reviewer.name} · ${reviewer.role}` : '';
const reviewedByFr = reviewer ? `Relecture éditoriale : ${reviewer.name} · ${reviewer.role}` : '';
const reviewedAtEn = reviewer ? `Reviewed ${reviewedDate}` : '';
const reviewedAtZh = reviewer ? `审核于 ${reviewedDate}` : '';
const reviewedAtFr = reviewer ? `Relu le ${reviewedDate}` : '';
const relationFr = (value: string | null | undefined) => ({
  exact_disease_geography: 'maladie et région correspondantes',
  exact_disease: 'maladie correspondante',
  disease_context: 'contexte de la maladie',
  context: 'contexte',
}[String(value ?? 'context')] ?? 'contexte');
const frenchDisease = (item: any) => localizedDiseaseName({
  disease_id: item.disease_id,
  slug: item.d_slug ?? item.disease_slug,
  name_en: item.disease_name_en,
  name_fr: item.disease_name_fr,
}, 'fr');
const frenchGeography = (item: any) => localizedRegionName('fr', item.code, { en: item.name_en, fr: item.name_fr });
---

<ResearchCollectionPage
  eyebrow="Weekly evidence brief"
  eyebrowZh="每周证据简报"
  eyebrowFr="Brief hebdomadaire des preuves"
  title={briefTitle}
  titleZh={briefTitleZh}
  titleFr={briefTitleFr}
  seoTitle={seoBriefTitle}
  description={description}
  descriptionZh={descriptionZh}
  descriptionFr={descriptionFr}
  canonicalPath={`/research/weekly/${facet.week}/`}
  articles={payload.articles ?? []}
  contextLabel="Papers this week"
  contextLabelZh="本周论文"
  contextLabelFr="Articles de la semaine"
  feedLabel="RSS feed"
  feedLabelZh="RSS 订阅"
  feedLabelFr="Flux RSS"
  clientCollectionScope="week"
  clientCollectionValue={facet.week}
  locale={locale}
  additionalStructuredData={[structuredBrief]}
>
  <section slot="context" class="card weekly-context" data-research-brief-sha256={payloadSha256}>
    <p class="academic-kicker">{zh ? '本周概览' : fr ? 'Aperçu de la semaine' : 'Week at a glance'}</p>
    <p class="weekly-introduction">{zh ? introductionZh : fr ? introductionFr : introductionEn}</p>
    {(previousWeek || nextWeek) && <nav class="weekly-navigation" aria-label={zh ? '研究周报导航' : fr ? 'Navigation des briefs' : 'Research brief navigation'}>
      {previousWeek && <a rel="prev" href={siteHref(localeHref(previousWeek.url))}>← {zh ? '上一期' : fr ? 'Brief précédent' : 'Previous brief'} {previousWeek.week}</a>}
      {nextWeek && <a rel="next" href={siteHref(localeHref(nextWeek.url))}>{zh ? '下一期' : fr ? 'Brief suivant' : 'Next brief'} {nextWeek.week} →</a>}
    </nav>}
    <div class="weekly-grid"><div><strong>{payload.disease_count ?? 0}</strong><span>{zh ? '种疾病' : fr ? 'maladies' : 'diseases'}</span></div><div><strong>{payload.country_count ?? 0}</strong><span>{zh ? '个地理区域' : fr ? 'zones géographiques' : 'geographic areas'}</span></div><div class="weekly-topics"><span>{zh ? '主要主题' : fr ? 'Thèmes principaux' : 'Leading topics'}</span><p>{(payload.top_topics ?? []).map((topic: string) => localizedResearchTopic(locale, topic)).join(' · ') || '—'}</p></div></div>
    <p class="weekly-note">{zh ? '本简报汇总发表元数据和分类关系，不是风险评估，也不代表疾病发病情况发生变化。' : fr ? 'Ce brief résume les métadonnées de publication et les liens de classification. Il ne constitue pas une évaluation du risque ni une affirmation sur l’incidence des maladies.' : 'This brief summarizes publication metadata and classifier links. It is not a risk assessment or a claim about changes in disease incidence.'}</p>
    <div class="weekly-byline">
      <span>{zh ? payload.byline?.name_zh ?? 'GIDS Research Radar 自动编译器' : fr ? 'Compilateur automatisé du Radar de recherche GIDS' : payload.byline?.name_en ?? 'GIDS Research Radar automated compiler'}</span>
      {reviewer ? (
        <div class="weekly-review" data-review-status="editorially-reviewed">
          <strong>{zh ? reviewedByZh : fr ? reviewedByFr : reviewedByEn}</strong>
          {reviewer.institution && <span>{reviewer.institution}</span>}
          <time datetime={reviewer.reviewed_at}>{zh ? reviewedAtZh : fr ? reviewedAtFr : reviewedAtEn}</time>
          {reviewer.note_en && reviewer.note_zh && <p>{zh ? reviewer.note_zh : fr ? (reviewer.note_fr || 'Note éditoriale française en attente.') : reviewer.note_en}</p>}
        </div>
      ) : aiReview ? (
        <div class="weekly-review" data-review-status="ai-reviewed">
          <strong>{zh ? 'AI 证据边界审核通过 · 非编辑签审' : fr ? 'Contrôle IA des limites de preuve réussi · sans validation éditoriale' : 'AI evidence-bound review passed · not editorial review'}</strong>
          <span>{aiReview.provider} · {aiReview.model}</span>
          <time datetime={aiReview.reviewed_at}>{String(aiReview.reviewed_at).slice(0, 10)}</time>
        </div>
      ) : (
        <strong data-review-status="not-editorially-reviewed">{zh ? '自动编译 · 未经编辑审核' : fr ? 'Compilation automatique · sans relecture éditoriale' : 'Automatically compiled · not editorially reviewed'}</strong>
      )}
    </div>
  </section>

  {citedFindings.length > 0 && (
    <section slot="context" class="card weekly-evidence-section">
      <p class="academic-kicker">{zh ? '有引用的证据' : fr ? 'Preuves citées' : 'Cited evidence'}</p>
      <h2>{zh ? '本周来源层面发现' : fr ? 'Résultats au niveau des sources cette semaine' : 'Source-level findings this week'}</h2>
      <ol>{citedFindings.map((finding: any) => <li><a href={siteHref(finding.source_url)}><strong>{finding.title}</strong><p>{zh ? finding.finding_zh ?? finding.finding_en : fr ? (finding.finding_fr || 'Synthèse française en cours d’enrichissement par le Centre de modèles.') : finding.finding_en}</p><span>{finding.doi ? `DOI ${finding.doi}` : (zh ? 'GIDS 证据记录' : fr ? 'Référence GIDS' : 'GIDS evidence record')} →</span></a></li>)}</ol>
    </section>
  )}

  {(monitoringContext.length > 0 || evidenceGaps.length > 0) && (
    <section slot="context" class="card weekly-evidence-section">
      <p class="academic-kicker">{zh ? '监测背景' : fr ? 'Contexte de surveillance' : 'Monitoring context'}</p>
      <h2>{zh ? '信号与目录覆盖' : fr ? 'Signaux et couverture du catalogue' : 'Signals and catalogue coverage'}</h2>
      {monitoringContext.length > 0 && <div class="weekly-monitoring-list">{monitoringContext.map((signal: any) => <a href={localeHref(signal.situation_url ?? '/situation/')}><strong>{zh ? signal.disease_name_zh ?? signal.title ?? signal.disease_name_en : fr ? frenchDisease(signal) : signal.title ?? signal.disease_name_en}</strong><span>{(signal.geographies ?? []).map((item: any) => zh ? item.name_zh ?? item.name_en : fr ? frenchGeography(item) : item.name_en).join(' · ') || (zh ? '地理范围暂缺' : fr ? 'Géographie indisponible' : 'Geography unavailable')} · {signal.data_through ?? '—'}</span><em>{fr ? relationFr(signal.relation_level) : String(signal.relation_level ?? 'context').replaceAll('_', ' ')}</em></a>)}</div>}
      {evidenceGaps.length > 0 && <div class="weekly-gap-list"><h3>{zh ? '公开目录证据缺口' : fr ? 'Lacunes du catalogue public' : 'Open catalogue evidence gaps'}</h3>{evidenceGaps.map((gap: any) => <article><strong>{zh ? gap.disease_name_zh ?? gap.disease_name_en : fr ? frenchDisease(gap) : gap.disease_name_en}</strong><p>{zh ? gap.note_zh ?? gap.note_en : fr ? (gap.note_fr || 'Description française de cette lacune en attente.') : gap.note_en}</p></article>)}</div>}
      <p class="weekly-note">{zh ? payload.methodology?.zh ?? payload.methodology?.en : fr ? (payload.methodology?.fr || 'Méthode : sélection de références publiées, classification vérifiable et liens vers les sources primaires.') : payload.methodology?.en}</p>
    </section>
  )}
  <ResearchEvidenceContext slot="context" articles={briefArticles} locale={locale} currentPath={`/research/weekly/${facet.week}/`} />
</ResearchCollectionPage>

<style>
  .weekly-context { margin-top: 1.5rem; padding: clamp(1.25rem, 3vw, 2rem); }
  .weekly-introduction { max-width: 65rem; margin-top: .8rem; color: rgb(var(--text-muted)); font-size: .9rem; line-height: 1.8; }
  .weekly-navigation { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1.5rem; margin-top: .8rem; }
  .weekly-navigation a { display: inline-flex; align-items: center; min-height: 44px; color: rgb(var(--color-teal)); font-size: .8rem; }
  .weekly-grid { display: grid; grid-template-columns: 8rem 8rem minmax(0, 1fr); gap: 1rem; margin-top: 1rem; }
  .weekly-grid > div { border-left: 1px solid rgb(var(--border)); padding-left: 1rem; }
  .weekly-grid > div:first-child { padding-left: 0; border-left: 0; }
  .weekly-grid strong { display: block; color: rgb(var(--text-strong)); font: 600 1.75rem/1 'IBM Plex Sans', sans-serif; }
  .weekly-grid span { display: block; margin-top: .35rem; color: rgb(var(--text-faint)); font-size: .65rem; }
  .weekly-topics p { margin-top: .4rem; color: rgb(var(--text)); font-size: .78rem; line-height: 1.5; }
  .weekly-note { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgb(var(--border) / .64); color: rgb(var(--text-faint)); font-size: .68rem; line-height: 1.55; }
  .weekly-byline { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1rem; margin-top: .8rem; color: rgb(var(--text-faint)); font-size: .65rem; }
  .weekly-byline strong { color: rgb(var(--color-accent)); }
  .weekly-review { display: grid; justify-items: end; gap: .2rem; text-align: right; }
  .weekly-review span, .weekly-review time { color: rgb(var(--text-faint)); }
  .weekly-review p { max-width: 46rem; color: rgb(var(--text-muted)); line-height: 1.5; }
  .weekly-evidence-section { margin-top: 1rem; padding: clamp(1.25rem, 3vw, 2rem); }
  .weekly-evidence-section h2 { margin-top: .35rem; color: rgb(var(--text-strong)); font: 600 1.45rem/1.15 'IBM Plex Sans', sans-serif; }
  .weekly-evidence-section ol, .weekly-monitoring-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .65rem; margin-top: 1rem; }
  .weekly-evidence-section li, .weekly-monitoring-list a, .weekly-gap-list article { border: 1px solid rgb(var(--border) / .68); background: rgb(var(--surface-raised) / .3); padding: .9rem; }
  .weekly-evidence-section li strong, .weekly-monitoring-list strong, .weekly-gap-list strong { display: block; color: rgb(var(--text-strong)); font: 600 .95rem/1.3 'IBM Plex Sans', sans-serif; }
  .weekly-evidence-section li p, .weekly-gap-list p { margin-top: .5rem; color: rgb(var(--text-muted)); font-size: .74rem; line-height: 1.6; }
  .weekly-evidence-section li span, .weekly-monitoring-list span, .weekly-monitoring-list em { display: block; margin-top: .45rem; color: rgb(var(--text-faint)); font-size: .62rem; font-style: normal; }
  .weekly-monitoring-list em { color: rgb(var(--color-accent)); text-transform: capitalize; }
  .weekly-gap-list { margin-top: 1.2rem; }
  .weekly-gap-list h3 { color: rgb(var(--text-strong)); font-size: .8rem; }
  .weekly-gap-list article { margin-top: .55rem; }
  @media (max-width: 620px) { .weekly-grid { grid-template-columns: 1fr 1fr; } .weekly-grid .weekly-topics { grid-column: 1 / -1; padding-top: 1rem; padding-left: 0; border-top: 1px solid rgb(var(--border)); border-left: 0; } }
  @media (max-width: 620px) { .weekly-review { justify-items: start; text-align: left; } }
  @media (max-width: 620px) { .weekly-evidence-section ol, .weekly-monitoring-list { grid-template-columns: 1fr; } }
</style>
