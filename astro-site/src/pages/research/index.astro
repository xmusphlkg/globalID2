---
import ReportLayout from '../../layouts/ReportLayout.astro';
import ResearchArticleCard from '../../components/research/ResearchArticleCard.astro';
import ResearchHotspotCharts from '../../components/research/ResearchHotspotCharts';
import researchData from '../../data/research/index.json';
import researchHotspotsData from '../../data/research/hotspots.json';
import { buildResearchFeedDefinitions, filterResearchFeedArticles, type ResearchFeedScope } from '../../lib/research-feed';

const data: any = researchData;
const articles = (data.articles ?? []).filter((article: any) => (
  article.peer_review_status === 'peer_reviewed'
  || article.source_kind === 'historical_seed'
  || article.historical_baseline === true
));
const preprints = filterResearchFeedArticles(data, 'peer-review', 'preprint');
const integrityAlerts = data.integrity_alerts ?? [];
const metrics = data.metrics ?? {};
const facets = data.facets ?? { diseases: [], countries: [], topics: [], weeks: [] };
const topDiseaseHubs = (facets.diseases ?? []).slice(0, 5);
const topTopicHubs = (facets.topics ?? []).slice(0, 5);
const latestBrief = (facets.weeks ?? [])[0];
const featuredArticles = (data.featured ?? []).slice(0, 3);
const reviewsAndGuidelines = (data.reviews_and_guidelines ?? []).slice(0, 3);
const emergingTopics = (data.emerging_topics ?? []).slice(0, 6);
const surveillanceEvidence = data.surveillance_evidence ?? {};
const surveillanceSignals = surveillanceEvidence.available === true && surveillanceEvidence.visibility === 'public'
  ? (surveillanceEvidence.signals ?? []).filter((signal: any) => signal.visibility === 'public').slice(0, 3)
  : [];
const historicalBaselineAll = data.historical_baseline ?? articles.filter((article: any) => article.source_kind === 'historical_seed' || article.historical_baseline);
const historicalBaseline = historicalBaselineAll.slice(0, 8);
const initialVisibleArticles = 24;
const initialResultCount = articles.length > initialVisibleArticles
  ? `${initialVisibleArticles} of ${articles.length} publications shown`
  : `${articles.length} ${articles.length === 1 ? 'publication' : 'publications'}`;
const diseases = [...new Map(articles.flatMap((article: any) => article.diseases ?? []).map((item: any) => [item.disease_id, item])).values()] as any[];
const countries = [...new Map(articles.flatMap((article: any) => article.countries ?? []).map((item: any) => [item.code, item])).values()] as any[];
const studyTypes = [...new Set(articles.map((article: any) => article.study_type).filter(Boolean))] as string[];
const topics = [...new Set(articles.flatMap((article: any) => (article.topics ?? []).map((item: any) => item.name)).filter(Boolean))].sort() as string[];
const pathogenTypes = [...new Map(articles.flatMap((article: any) => article.pathogen_types ?? []).map((item: any) => [item.id, item])).values()] as any[];
const populations = [...new Map(articles.flatMap((article: any) => article.populations ?? []).map((item: any) => [item.id, item])).values()] as any[];
const journals = [...new Set(articles.map((article: any) => article.journal).filter(Boolean))].sort() as string[];
const publishers = [...new Set(articles.map((article: any) => article.publisher).filter(Boolean))].sort() as string[];
const researchFeeds = buildResearchFeedDefinitions(data);
type FeedGroup = {
  scopes: ResearchFeedScope[];
  title: string;
  titleZh: string;
  feeds: typeof researchFeeds;
  open?: boolean;
};
const feedGroupSpecs: Array<Omit<FeedGroup, 'feeds'>> = [
  { scopes: ['diseases'], title: 'By disease', titleZh: '按疾病' },
  { scopes: ['countries'], title: 'By country or region', titleZh: '按国家或地区' },
  { scopes: ['topics'], title: 'By public-health topic', titleZh: '按公共卫生主题' },
  { scopes: ['study-types'], title: 'By study type', titleZh: '按研究类型' },
  { scopes: ['collections', 'peer-review'], title: 'Reviews, guidelines & publication status', titleZh: '综述、指南与发表状态', open: true },
];
const feedGroups: FeedGroup[] = feedGroupSpecs.map(group => ({
  ...group,
  feeds: researchFeeds.filter(feed => group.scopes.includes(feed.scope)),
}));
const hotspots = data.visualizations?.hotspots ?? researchHotspotsData ?? {};
const hasHotspotVisualizations = Boolean(
  (hotspots.streamgraph?.series ?? []).length
  || (hotspots.heatmap?.rows ?? []).length
  || (hotspots.burst_timeline?.bursts ?? []).length
  || (hotspots.alluvial?.nodes ?? []).length
);
const lastUpdatedEn = data.last_updated
  ? new Date(data.last_updated).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : 'Awaiting first synchronization';
const lastUpdatedZh = data.last_updated
  ? new Date(data.last_updated).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '等待首次同步';
const itemList = {
  '@type': 'CollectionPage',
  name: 'GIDS Research Radar',
  description: 'New infectious disease research connected to disease and country surveillance context.',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: articles.length,
    itemListElement: articles.slice(0, 100).map((article: any, index: number) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/research/articles/${article.slug}/`, Astro.site ?? Astro.url.origin).toString(),
      name: article.title,
    })),
  },
};
---

<ReportLayout
  title="Research Radar"
  description="Track newly published infectious disease research across journals, diseases, countries, and public-health topics."
  seo={{
    title: 'Research Radar | GIDS',
    description: 'Track newly published infectious disease research across journals, diseases, countries, and public-health topics.',
    locale: 'en',
    canonicalPath: '/research/',
    alternatePaths: { en: '/research/' },
    pageType: 'WebPage',
  }}
  structuredData={itemList}
  breadcrumbs={[{ label: 'Research Radar', labelZh: '研究雷达' }]}
>
  <div class="research-page">
    <section class="academic-hero research-hero">
      <div class="research-hero-grid">
        <div class="research-hero-copy">
          <p class="academic-kicker" data-lang-en="Literature intelligence" data-lang-zh="文献情报">Literature intelligence</p>
          <h1 class="academic-title" data-lang-en="Research Radar" data-lang-zh="研究雷达">Research Radar</h1>
          <p class="academic-lead research-lede" data-lang-en="Find high-signal infectious disease research, organized for quick review across diseases, regions, and public-health topics." data-lang-zh="快速发现高价值的传染病研究，并按疾病、地区和公共卫生主题浏览。">
            Find high-signal infectious disease research, organized for quick review across diseases, regions, and public-health topics.
          </p>
          <div class="research-hero-actions">
            <a class="research-primary-link" href="#latest-publications" data-lang-en="Browse latest publications" data-lang-zh="浏览最新文献">Browse latest publications</a>
            <a class="research-secondary-link" href="/research/preprints/" data-lang-en={`Browse published preprints (${preprints.length}) →`} data-lang-zh={`浏览已公开预印本（${preprints.length}）→`}>Browse published preprints ({preprints.length}) →</a>
            <a class="research-secondary-link" href="/research/integrity/" data-lang-en={`Research integrity alerts (${integrityAlerts.length}) →`} data-lang-zh={`研究完整性通知（${integrityAlerts.length}）→`}>Research integrity alerts ({integrityAlerts.length}) →</a>
            <a class="research-secondary-link" href="/research/ask/" data-lang-en="Ask GIDS with cited evidence →" data-lang-zh="使用有引用证据的 Ask GIDS →">Ask GIDS with cited evidence →</a>
            <a class="research-secondary-link" href="/research/graph/" data-lang-en="Explore the evidence graph →" data-lang-zh="探索证据图谱 →">Explore the evidence graph →</a>
            {historicalBaseline.length > 0 && <a class="research-secondary-link" href="#historical-baseline" data-lang-en="Browse historical baseline →" data-lang-zh="浏览历史基线 →">Browse historical baseline →</a>}
            {latestBrief && <a class="research-secondary-link" href={latestBrief.url} data-lang-en="Read the latest weekly brief →" data-lang-zh="阅读最新每周简报 →">Read the latest weekly brief →</a>}
          </div>
          <div class="research-provenance">
            <span class="research-updated"><i class="research-pulse" aria-hidden="true"></i><span data-lang-en={`Updated ${lastUpdatedEn}`} data-lang-zh={`更新于 ${lastUpdatedZh}`}>Updated {lastUpdatedEn}</span></span>
            <span data-lang-en="Sources: Crossref · Europe PMC · OpenAlex · Unpaywall · historical seed" data-lang-zh="来源：Crossref · Europe PMC · OpenAlex · Unpaywall · 历史种子">Sources: Crossref · Europe PMC · OpenAlex · Unpaywall · historical seed</span>
          </div>
        </div>
        <aside class="research-week" aria-label="Research Radar at a glance">
          <p class="academic-kicker" data-lang-en="At a glance" data-lang-zh="快速概览">At a glance</p>
          <dl>
            <div><dt data-lang-en="Public catalogue" data-lang-zh="公开目录">Public catalogue</dt><dd>{metrics.total_public_articles ?? articles.length}</dd></div>
            <div><dt data-lang-en="Historical baseline" data-lang-zh="历史基线">Historical baseline</dt><dd>{metrics.historical_baseline_articles ?? historicalBaselineAll.length}</dd></div>
            <div><dt data-lang-en="Papers · 7 days" data-lang-zh="近 7 天论文">Papers · 7 days</dt><dd>{metrics.papers_last_7_days ?? 0}</dd></div>
            <div><dt data-lang-en="Diseases · 7 days" data-lang-zh="近 7 天疾病">Diseases · 7 days</dt><dd>{metrics.diseases_last_7_days ?? 0}</dd></div>
            <div><dt data-lang-en="Countries · 7 days" data-lang-zh="近 7 天国家">Countries · 7 days</dt><dd>{metrics.countries_last_7_days ?? 0}</dd></div>
            <div><dt data-lang-en="Reviews & guidelines · 7 days" data-lang-zh="近 7 天综述与指南">Reviews & guidelines · 7 days</dt><dd>{metrics.reviews_and_guidelines_last_7_days ?? 0}</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    {(topDiseaseHubs.length > 0 || topTopicHubs.length > 0) && (
      <nav class="card research-directory" aria-label="Research collections">
        <div class="directory-heading">
          <div><p class="academic-kicker" data-lang-en="Explore" data-lang-zh="探索">Explore</p><h2 data-lang-en="Browse research collections" data-lang-zh="浏览研究集合">Browse research collections</h2></div>
          <a href="#research-feeds" data-lang-en="RSS feeds & subscriptions →" data-lang-zh="RSS 订阅与筛选 →">RSS feeds & subscriptions →</a>
        </div>
        <div class="directory-rows">
          <section>
            <h3 data-lang-en="Diseases" data-lang-zh="疾病">Diseases</h3>
            <ul>{topDiseaseHubs.map((facet: any) => <li><a href={facet.url}><span data-lang-en={facet.name_en} data-lang-zh={facet.name_zh ?? facet.name_en}>{facet.name_en}</span><strong>{facet.count}</strong></a></li>)}</ul>
          </section>
          <section>
            <h3 data-lang-en="Topics" data-lang-zh="主题">Topics</h3>
            <ul>{topTopicHubs.map((facet: any) => <li><a href={facet.url}><span>{facet.name}</span><strong>{facet.count}</strong></a></li>)}</ul>
          </section>
          <section>
            <h3 data-lang-en="Status" data-lang-zh="发表状态">Status</h3>
            <ul><li><a href="/research/preprints/"><span data-lang-en="Published preprints" data-lang-zh="已公开预印本">Published preprints</span><strong>{preprints.length}</strong></a></li><li><a href="/research/integrity/"><span data-lang-en="Integrity alerts" data-lang-zh="完整性通知">Integrity alerts</span><strong>{integrityAlerts.length}</strong></a></li></ul>
          </section>
          <section>
            <h3 data-lang-en="Tools" data-lang-zh="工具">Tools</h3>
            <ul><li><a href="/research/ask/"><span>Ask GIDS</span><strong>→</strong></a></li><li><a href="/research/graph/"><span data-lang-en="Evidence graph" data-lang-zh="证据图谱">Evidence graph</span><strong>→</strong></a></li></ul>
          </section>
        </div>
      </nav>
    )}

    <section id="research-feeds" class="card research-feeds" aria-labelledby="research-feeds-title">
      <div class="feed-heading">
        <div>
          <p class="academic-kicker" data-lang-en="Stay current" data-lang-zh="持续追踪">Stay current</p>
          <h2 id="research-feeds-title" data-lang-en="Subscribe to a focused Research Radar feed" data-lang-zh="订阅筛选后的研究雷达">Subscribe to a focused Research Radar feed</h2>
          <p data-lang-en="Choose a stable RSS address for all research, or narrow it by disease, country, topic, study type, reviews and guidelines, or peer-review status. A count of 0 means no matching public records are available yet; the feed remains active for future releases." data-lang-zh="可订阅全部研究，或按疾病、国家、主题、研究类型、综述与指南以及同行评议状态选择稳定的 RSS 地址。数量为 0 表示目前没有匹配的公开记录；该 feed 仍然有效，可用于接收未来发布。">Choose a stable RSS address for all research, or narrow it by disease, country, topic, study type, reviews and guidelines, or peer-review status. A count of 0 means no matching public records are available yet; the feed remains active for future releases.</p>
        </div>
        <a class="feed-all-link" href="/research/rss.xml" type="application/rss+xml">
          <span data-lang-en="Subscribe to all research" data-lang-zh="订阅全部研究">Subscribe to all research</span>
          <strong>{articles.length}</strong>
        </a>
      </div>
      <div class="feed-groups">
        {feedGroups.filter(group => group.feeds.length > 0).map(group => (
          <details open={group.open}>
            <summary><span data-lang-en={group.title} data-lang-zh={group.titleZh}>{group.title}</span><strong>{group.feeds.length}</strong></summary>
            <ul>
              {group.feeds.map(feed => (
                <li>
                  <a href={feed.path} type="application/rss+xml">
                    <span data-lang-en={feed.label} data-lang-zh={feed.labelZh ?? feed.label}>{feed.label}</span>
                    <strong>{feed.count}</strong>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </section>

    {featuredArticles.length > 0 && (
      <section id="featured-research" class="card research-section featured-section">
        <div class="research-heading"><div><p class="academic-kicker" data-lang-en="Editor's selection" data-lang-zh="编辑精选">Editor's selection</p><h2 class="section-heading" data-lang-en="Featured research" data-lang-zh="重点研究">Featured research</h2></div></div>
        <div class="featured-list">{featuredArticles.map((article: any) => <ResearchArticleCard article={article} featured />)}</div>
      </section>
    )}

    {surveillanceSignals.length > 0 && (
      <section id="surveillance-linked-research" class="card research-section surveillance-research-section" aria-labelledby="surveillance-research-title">
        <div class="research-heading research-heading-split">
          <div>
            <p class="academic-kicker" data-lang-en="Monitoring context" data-lang-zh="监测背景">Monitoring context</p>
            <h2 id="surveillance-research-title" class="section-heading" data-lang-en="Surveillance-linked Research" data-lang-zh="监测关联研究">Surveillance-linked Research</h2>
          </div>
          <a href="/situation/" data-lang-en="Open Situation Room →" data-lang-zh="打开全球态势室 →">Open Situation Room →</a>
        </div>
        <p class="research-section-intro" data-lang-en="Published literature is linked to public monitoring context with exact and disease-only relationships clearly separated. These links provide background and do not validate or explain a signal." data-lang-zh="已发表文献与公开监测背景建立关联，并明确区分精确关系和仅疾病关系。这些链接仅提供背景，不验证或解释监测信号。">Published literature is linked to public monitoring context with exact and disease-only relationships clearly separated. These links provide background and do not validate or explain a signal.</p>
        <div class="surveillance-research-grid">
          {surveillanceSignals.map((signal: any) => {
            const exact = signal.exact_articles ?? [];
            const linkedArticles = (exact.length > 0 ? exact : signal.context_articles ?? []).slice(0, 3);
            const isExact = exact.length > 0;
            const geography = (signal.geographies ?? []).map((item: any) => item.name_en).join(' · ') || 'Geography unavailable';
            return <article class="surveillance-research-card">
              <div class="surveillance-research-status">
                <span data-lang-en={isExact ? 'Exact disease + geography' : 'Disease context only'} data-lang-zh={isExact ? '疾病 + 地区精确关联' : '仅疾病背景'}>{isExact ? 'Exact disease + geography' : 'Disease context only'}</span>
                <time datetime={signal.data_through}>{signal.data_through ?? '—'}</time>
              </div>
              <h3><a href={signal.situation_url ?? '/situation/'}>{signal.title}</a></h3>
              <p class="surveillance-research-meta"><span data-lang-en={signal.disease_name_en} data-lang-zh={signal.disease_name_zh ?? signal.disease_name_en}>{signal.disease_name_en}</span> · {geography}</p>
              {linkedArticles.length > 0
                ? <ol>{linkedArticles.map((article: any) => <li><a href={`/research/articles/${article.slug}/`}><strong>{article.title}</strong><span>{article.journal ?? 'Journal unavailable'} · {article.study_type ?? 'Journal article'}</span></a></li>)}</ol>
                : <p class="surveillance-research-empty" data-lang-en="No public Research Radar article currently meets this relationship threshold." data-lang-zh="目前没有公开的 Research Radar 文献达到此关联阈值。">No public Research Radar article currently meets this relationship threshold.</p>}
            </article>;
          })}
        </div>
        {surveillanceEvidence.methodology?.en && <p class="research-method-note" data-lang-en={surveillanceEvidence.methodology.en} data-lang-zh={surveillanceEvidence.methodology.zh ?? surveillanceEvidence.methodology.en}>{surveillanceEvidence.methodology.en}</p>}
      </section>
    )}

    {reviewsAndGuidelines.length > 0 && (
      <section id="new-reviews-guidelines" class="card research-section curated-research-section" aria-labelledby="reviews-guidelines-title">
        <div class="research-heading research-heading-split">
          <div><p class="academic-kicker" data-lang-en="Evidence synthesis" data-lang-zh="证据综合">Evidence synthesis</p><h2 id="reviews-guidelines-title" class="section-heading" data-lang-en="New Reviews & Guidelines" data-lang-zh="最新综述与指南">New Reviews & Guidelines</h2></div>
          <a href="/research/rss/collections/reviews-and-guidelines.xml" type="application/rss+xml" data-lang-en="Subscribe to this collection →" data-lang-zh="订阅此集合 →">Subscribe to this collection →</a>
        </div>
        <div class="curated-research-grid">{reviewsAndGuidelines.map((article: any) => <ResearchArticleCard article={article} stream />)}</div>
      </section>
    )}

    {emergingTopics.length > 0 && (
      <section id="emerging-topics" class="card research-section emerging-topics-section" aria-labelledby="emerging-topics-title">
        <div class="research-heading">
          <div><p class="academic-kicker" data-lang-en="Literature momentum" data-lang-zh="文献动向">Literature momentum</p><h2 id="emerging-topics-title" class="section-heading" data-lang-en="Emerging Topics" data-lang-zh="新兴主题">Emerging Topics</h2></div>
        </div>
        <p class="research-section-intro" data-lang-en="Topics with rising publication attention over the latest 28-day window. Increased attention does not mean increased disease risk." data-lang-zh="最近 28 天文献关注度上升的主题。关注度增加并不代表疾病风险上升。">Topics with rising publication attention over the latest 28-day window. Increased attention does not mean increased disease risk.</p>
        <div class="emerging-topic-grid">
          {emergingTopics.map((topic: any) => {
            const slug = String(topic.name ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
            const shareChange = Math.round(Number(topic.share_delta ?? 0) * 100);
            return <a class="emerging-topic-card" href={`/research/topics/${slug}/`}>
              <span data-lang-en="28-day attention" data-lang-zh="28 天关注度">28-day attention</span>
              <strong>{topic.name}</strong>
              <dl>
                <div><dt data-lang-en="Papers" data-lang-zh="论文">Papers</dt><dd>{topic.count_28_days ?? 0}</dd></div>
                <div><dt data-lang-en="Change" data-lang-zh="变化">Change</dt><dd>{Number(topic.growth ?? 0) > 0 ? '+' : ''}{topic.growth ?? 0}</dd></div>
                <div><dt data-lang-en="Share" data-lang-zh="占比变化">Share</dt><dd>{shareChange > 0 ? '+' : ''}{shareChange} pp</dd></div>
              </dl>
            </a>;
          })}
        </div>
      </section>
    )}

    {historicalBaseline.length > 0 && (
      <section id="historical-baseline" class="card research-section historical-section">
        <div class="research-heading">
          <div>
            <p class="academic-kicker" data-lang-en="Historical database" data-lang-zh="历史数据库">Historical database</p>
            <h2 class="section-heading" data-lang-en="Baseline literature across earlier eras" data-lang-zh="跨年代基线文献">Baseline literature across earlier eras</h2>
          </div>
        </div>
        <p class="historical-intro" data-lang-en="Curated historical records supplement the recent literature stream and are labelled separately from newly indexed papers." data-lang-zh="精选历史记录用于补充近期文献流，并与新近索引论文分开标注。">Curated historical records supplement the recent literature stream and are labelled separately from newly indexed papers.</p>
        <div class="historical-list">{historicalBaseline.map((article: any) => <ResearchArticleCard article={article} compact />)}</div>
      </section>
    )}

    {hasHotspotVisualizations && (
      <section id="research-trends" class="card research-section research-trends-section">
        <div class="research-heading">
          <div>
            <p class="academic-kicker" data-lang-en="Research trends" data-lang-zh="研究趋势">Research trends</p>
            <h2 class="section-heading" data-lang-en="How literature attention is changing" data-lang-zh="文献关注如何变化">How literature attention is changing</h2>
          </div>
        </div>
        <ResearchHotspotCharts client:visible hotspots={hotspots} />
      </section>
    )}

    <section id="latest-publications" class="card research-section latest-section">
      <div class="research-heading"><div><p class="academic-kicker" data-lang-en="Evidence library" data-lang-zh="证据库">Evidence library</p><h2 class="section-heading" data-lang-en="Latest publications" data-lang-zh="最新发表">Latest publications</h2></div></div>
      <form class="research-filters" role="search" aria-label="Filter research articles" data-research-filters>
        <label class="search-field"><span class="sr-only">Search</span><input class="site-control-input" id="research-search" type="search" data-lang-en-placeholder="Search title, disease, journal, or topic" data-lang-zh-placeholder="搜索标题、疾病、期刊或主题" placeholder="Search title, disease, journal, or topic" /></label>
        <label><span data-lang-en="Disease" data-lang-zh="疾病">Disease</span><select class="site-control-input" id="research-disease"><option value="" data-lang-en="All diseases" data-lang-zh="全部疾病">All diseases</option>{diseases.map((item: any) => <option value={item.disease_id.toLowerCase()}>{item.name_en}</option>)}</select></label>
        <label><span data-lang-en="Country" data-lang-zh="国家">Country</span><select class="site-control-input" id="research-country"><option value="" data-lang-en="All countries" data-lang-zh="全部国家">All countries</option>{countries.map((item: any) => <option value={item.code.toLowerCase()}>{item.name_en}</option>)}</select></label>
        <label><span data-lang-en="Study type" data-lang-zh="研究类型">Study type</span><select class="site-control-input" id="research-study"><option value="" data-lang-en="All study types" data-lang-zh="全部研究类型">All study types</option>{studyTypes.map((item) => <option value={item.toLowerCase()}>{item}</option>)}</select></label>
        <label><span data-lang-en="Topic" data-lang-zh="主题">Topic</span><select class="site-control-input" id="research-topic"><option value="" data-lang-en="All topics" data-lang-zh="全部主题">All topics</option>{topics.map((item) => <option value={String(item).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}>{item}</option>)}</select></label>
        <label><span data-lang-en="Pathogen type" data-lang-zh="病原体类型">Pathogen type</span><select class="site-control-input" id="research-pathogen-type"><option value="" data-lang-en="All pathogen types" data-lang-zh="全部病原体类型">All pathogen types</option>{pathogenTypes.map((item: any) => <option value={item.id}>{item.name}</option>)}</select></label>
        <label><span data-lang-en="Population" data-lang-zh="研究人群">Population</span><select class="site-control-input" id="research-population"><option value="" data-lang-en="All populations" data-lang-zh="全部研究人群">All populations</option>{populations.map((item: any) => <option value={item.id}>{item.name}</option>)}</select></label>
        <label><span data-lang-en="Journal" data-lang-zh="期刊">Journal</span><select class="site-control-input" id="research-journal"><option value="" data-lang-en="All journals" data-lang-zh="全部期刊">All journals</option>{journals.map((item) => <option value={String(item).toLowerCase()}>{item}</option>)}</select></label>
        <label><span data-lang-en="Publisher" data-lang-zh="出版商">Publisher</span><select class="site-control-input" id="research-publisher"><option value="" data-lang-en="All publishers" data-lang-zh="全部出版商">All publishers</option>{publishers.map((item) => <option value={String(item).toLowerCase()}>{item}</option>)}</select></label>
        <label><span data-lang-en="Published from" data-lang-zh="起始日期">Published from</span><input class="site-control-input research-date" id="research-from" type="date" /></label>
        <label><span data-lang-en="Published to" data-lang-zh="结束日期">Published to</span><input class="site-control-input research-date" id="research-to" type="date" /></label>
        <label><span data-lang-en="Collection" data-lang-zh="文献集合">Collection</span><select class="site-control-input" id="research-publication-collection"><option value="peer_reviewed" data-lang-en="Peer reviewed" data-lang-zh="同行评议">Peer reviewed</option><option value="preprint" data-lang-en="Approved preprints" data-lang-zh="已审核预印本">Approved preprints</option></select></label>
        <label class="oa-filter"><input id="research-oa" type="checkbox" /><span data-lang-en="Open access only" data-lang-zh="仅开放获取">Open access only</span></label>
      </form>
      <p id="research-result-count" class="result-count" data-total={articles.length} aria-live="polite">{initialResultCount}</p>
      <div id="research-list" class="research-list" data-initial-visible={initialVisibleArticles} data-total={articles.length}>{articles.slice(0, initialVisibleArticles).map((article: any, index: number) => <ResearchArticleCard article={article} stream index={index} initialVisible={initialVisibleArticles} />)}</div>
      {articles.length > initialVisibleArticles && <button id="research-load-more" class="research-load-more" type="button" aria-controls="research-list" data-load-more-research data-lang-en="Load more publications" data-lang-zh="加载更多论文">Load more publications</button>}
      <div id="research-empty" class:list={['research-empty', articles.length > 0 && 'hidden']}>
        <div class="empty-orbit" aria-hidden="true"></div>
        <h3 data-lang-en={articles.length ? 'No matching research' : 'Research Radar is ready'} data-lang-zh={articles.length ? '没有匹配的研究' : '研究雷达已就绪'}>{articles.length ? 'No matching research' : 'Research Radar is ready'}</h3>
        <p data-lang-en={articles.length ? 'Try broadening one or more filters.' : 'The catalogue will populate after the first scheduled or manual literature synchronization.'} data-lang-zh={articles.length ? '请尝试放宽一个或多个筛选条件。' : '首次计划或手动文献同步完成后，目录将在此显示。'}>{articles.length ? 'Try broadening one or more filters.' : 'The catalogue will populate after the first scheduled or manual literature synchronization.'}</p>
      </div>
    </section>

  </div>

  <script>
    const search = document.querySelector<HTMLInputElement>('#research-search');
    const disease = document.querySelector<HTMLSelectElement>('#research-disease');
    const country = document.querySelector<HTMLSelectElement>('#research-country');
    const study = document.querySelector<HTMLSelectElement>('#research-study');
    const topic = document.querySelector<HTMLSelectElement>('#research-topic');
    const pathogenType = document.querySelector<HTMLSelectElement>('#research-pathogen-type');
    const population = document.querySelector<HTMLSelectElement>('#research-population');
    const journalFilter = document.querySelector<HTMLSelectElement>('#research-journal');
    const publisherFilter = document.querySelector<HTMLSelectElement>('#research-publisher');
    const publishedFrom = document.querySelector<HTMLInputElement>('#research-from');
    const publishedTo = document.querySelector<HTMLInputElement>('#research-to');
    const publicationCollection = document.querySelector<HTMLSelectElement>('#research-publication-collection');
    const oa = document.querySelector<HTMLInputElement>('#research-oa');
    const form = document.querySelector<HTMLFormElement>('[data-research-filters]');
    const list = document.querySelector<HTMLElement>('#research-list');
    const count = document.querySelector<HTMLElement>('#research-result-count');
    const empty = document.querySelector<HTMLElement>('#research-empty');
    const loadMore = document.querySelector<HTMLButtonElement>('#research-load-more');
    const initialVisible = Number(list?.dataset.initialVisible ?? 60);
    const totalArticles = Number(list?.dataset.total ?? 0);
    let visibleLimit = initialVisible;
    let cataloguePromise: Promise<any[]> | null = null;
    const preset = new URLSearchParams(location.search).get('disease')?.toLowerCase();
    if (preset && disease && [...disease.options].some(option => option.value === preset)) disease.value = preset;
    const hasToken = (value: string | undefined, token: string) => (value ?? '').split(/\s+/).includes(token);
    const slugifyTopic = (value: string | undefined) => (value ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const currentLang = () => document.documentElement.getAttribute('data-lang') === 'zh' ? 'zh' : 'en';
    const setLangText = (element: HTMLElement, en: string, zh?: string | null) => {
      element.dataset.langEn = en;
      element.dataset.langZh = zh || en;
      element.textContent = currentLang() === 'zh' ? (zh || en) : en;
    };
    const text = (value: unknown) => String(value ?? '');
    const formatDate = (value: string | undefined, lang: 'en' | 'zh') => {
      if (!value) return lang === 'zh' ? '日期暂缺' : 'Date unavailable';
      return new Intl.DateTimeFormat(lang === 'zh' ? 'zh-CN' : 'en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(value));
    };
    const formatArticleDate = (article: any, lang: 'en' | 'zh') => {
      const label = lang === 'zh' ? article.publication_date_label_zh : article.publication_date_label_en;
      return label || formatDate(article.published_at, lang);
    };
    const articleTokens = (article: any) => ({
      diseaseText: (article.diseases ?? []).map((item: any) => `${item.disease_id} ${item.name_en} ${item.name_zh ?? ''}`).join(' ').toLowerCase(),
      diseaseIds: (article.diseases ?? []).map((item: any) => String(item.disease_id ?? '').toLowerCase()).filter(Boolean).join(' '),
      countryText: (article.countries ?? []).map((item: any) => `${item.code} ${item.name_en}`).join(' ').toLowerCase(),
      countryCodes: (article.countries ?? []).map((item: any) => String(item.code ?? '').toLowerCase()).filter(Boolean).join(' '),
      topicText: (article.topics ?? []).map((item: any) => item.name).join(' ').toLowerCase(),
      topicSlugs: (article.topics ?? []).map((item: any) => slugifyTopic(item.name)).filter(Boolean).join(' '),
      pathogenTypeIds: (article.pathogen_types ?? []).map((item: any) => String(item.id ?? '').toLowerCase()).filter(Boolean).join(' '),
      pathogenText: (article.pathogens ?? []).map((item: any) => item.name).join(' ').toLowerCase(),
      populationIds: (article.populations ?? []).map((item: any) => String(item.id ?? '').toLowerCase()).filter(Boolean).join(' '),
      populationText: (article.populations ?? []).map((item: any) => item.name).join(' ').toLowerCase(),
    });
    const articleSearchText = (article: any, tokens = articleTokens(article)) => `${article.title} ${article.journal ?? ''} ${tokens.diseaseText} ${tokens.countryText} ${tokens.topicText} ${tokens.pathogenText} ${tokens.populationText}`.toLowerCase();
    const loadCatalogue = () => {
      if (!cataloguePromise) {
        cataloguePromise = fetch('/research/catalogue.json')
          .then(response => {
            if (!response.ok) throw new Error(`Research catalogue request failed: ${response.status}`);
            return response.json();
          })
          .then(payload => Array.isArray(payload?.articles) ? payload.articles : []);
      }
      return cataloguePromise;
    };
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string) => {
      const element = document.createElement(tag);
      if (className) element.className = className;
      return element;
    };
    const makeBadge = (en: string, zh: string | null | undefined, extraClass = '') => {
      const badge = make('span', `research-badge ${extraClass}`.trim());
      setLangText(badge, en, zh);
      return badge;
    };
    const makeTopicBadge = (name: string) => {
      const badge = make('a', 'research-badge research-badge-topic');
      badge.href = `/research/topics/${slugifyTopic(name)}/`;
      badge.textContent = name;
      return badge;
    };
    const renderArticleCard = (article: any) => {
      const tokens = articleTokens(article);
      const card = make('article', 'research-card research-card-stream');
      card.dataset.researchCard = '';
      card.dataset.search = articleSearchText(article, tokens);
      card.dataset.disease = tokens.diseaseText;
      card.dataset.diseaseIds = tokens.diseaseIds;
      card.dataset.country = tokens.countryText;
      card.dataset.countryCodes = tokens.countryCodes;
      card.dataset.topic = tokens.topicText;
      card.dataset.topicSlugs = tokens.topicSlugs;
      card.dataset.pathogenTypes = tokens.pathogenTypeIds;
      card.dataset.populations = tokens.populationIds;
      card.dataset.study = String(article.study_type ?? '').toLowerCase();
      card.dataset.journal = String(article.journal ?? '').toLowerCase();
      card.dataset.publisher = String(article.publisher ?? '').toLowerCase();
      card.dataset.publishedAt = String(article.published_at ?? '');
      card.dataset.peerReviewStatus = String(article.peer_review_status ?? '');
      card.dataset.openAccess = article.open_access_status === 'open' ? 'true' : 'false';

      const topline = make('div', 'research-card-topline');
      const badges = make('div', 'research-card-badges');
      badges.appendChild(makeBadge(article.peer_review_status === 'peer_reviewed' ? 'Peer reviewed' : 'Preprint', article.peer_review_status === 'peer_reviewed' ? '同行评议' : '预印本', 'research-badge-peer'));
      if (article.source_kind === 'historical_seed' || article.historical_baseline) badges.appendChild(makeBadge('Historical baseline', '历史基线', 'research-badge-history'));
      if (article.open_access_status === 'open') badges.appendChild(makeBadge('Open access', '开放获取', 'research-badge-oa'));
      (article.diseases ?? []).slice(0, 2).forEach((item: any) => badges.appendChild(makeBadge(text(item.name_en), item.name_zh ?? item.name_en)));
      (article.topics ?? []).slice(0, 3).forEach((item: any) => badges.appendChild(makeTopicBadge(text(item.name))));
      topline.appendChild(badges);
      if (article.doi) {
        const doi = document.createElement('a');
        doi.className = 'research-card-doi';
        doi.href = `https://doi.org/${article.doi}`;
        doi.target = '_blank';
        doi.rel = 'noopener noreferrer';
        doi.textContent = `DOI ${article.doi} ↗`;
        topline.appendChild(doi);
      }
      card.appendChild(topline);

      const title = make('h3', 'research-card-title');
      const titleLink = document.createElement('a');
      titleLink.href = `/research/articles/${article.slug}/`;
      titleLink.textContent = text(article.title);
      title.appendChild(titleLink);
      card.appendChild(title);

      const authorNames = (article.authors ?? []).filter(Boolean).map(text);
      if (authorNames.length) {
        const authors = make('p', 'research-card-authors');
        const preview = authorNames.slice(0, 3);
        const en = authorNames.length > 3 ? `${preview.join(', ')} +${authorNames.length - preview.length} more` : preview.join(', ');
        const zh = authorNames.length > 3 ? `${preview.join('、')} 等 ${authorNames.length} 位作者` : preview.join('、');
        setLangText(authors, en, zh);
        card.appendChild(authors);
      }

      const source = make('p', 'research-card-source');
      const journal = document.createElement('span');
      journal.textContent = text(article.journal || 'Journal unavailable');
      source.appendChild(journal);
      const separator = document.createElement('span');
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = '·';
      source.appendChild(separator);
      const time = document.createElement('time');
      if (article.published_at) time.dateTime = article.published_at;
      setLangText(time, formatArticleDate(article, 'en'), formatArticleDate(article, 'zh'));
      source.appendChild(time);
      card.appendChild(source);

      const openAccessUrl = article.open_access_status === 'open'
        ? article.open_access_url || article.source_urls?.publisher
        : '';
      const surveillance = (article.related_surveillance ?? [])[0];
      const fallbackDisease = (article.diseases ?? [])[0];
      const surveillanceUrl = surveillance?.url || (fallbackDisease?.slug ? `/diseases/${fallbackDisease.slug}/` : '');
      if (openAccessUrl || surveillanceUrl) {
        const actions = make('div', 'research-card-actions');
        if (openAccessUrl) {
          const open = make('a', 'research-card-action research-card-action-oa');
          open.href = openAccessUrl;
          open.target = '_blank';
          open.rel = 'noopener noreferrer';
          setLangText(open, 'Open article ↗', '打开全文 ↗');
          actions.appendChild(open);
        }
        if (surveillanceUrl) {
          const related = make('a', 'research-card-action');
          related.href = surveillanceUrl;
          const labelEn = `${surveillance?.disease_name_en || fallbackDisease?.name_en || 'Related'} surveillance →`;
          const labelZh = `${surveillance?.disease_name_zh || surveillance?.disease_name_en || fallbackDisease?.name_zh || fallbackDisease?.name_en || '相关'}监测 →`;
          setLangText(related, labelEn, labelZh);
          actions.appendChild(related);
        }
        card.appendChild(actions);
      }

      const facts = make('dl', 'research-card-facts');
      const studyFact = document.createElement('div');
      const studyDt = document.createElement('dt');
      setLangText(studyDt, 'Type', '类型');
      const studyDd = document.createElement('dd');
      studyDd.textContent = text(article.study_type || 'Journal article');
      studyFact.append(studyDt, studyDd);
      const geographyFact = document.createElement('div');
      const geographyDt = document.createElement('dt');
      setLangText(geographyDt, 'Scope', '范围');
      const geographyDd = document.createElement('dd');
      geographyDd.textContent = (article.countries ?? []).length > 0
        ? (article.countries ?? []).slice(0, 3).map((item: any) => item.name_en).join(', ')
        : 'Not classified';
      geographyFact.append(geographyDt, geographyDd);
      facts.append(studyFact, geographyFact);
      card.appendChild(facts);

      const context = make('p', 'research-context');
      const contextLabel = document.createElement('strong');
      setLangText(contextLabel, 'Why it matters now', '为何现在值得关注');
      const contextCopy = document.createElement('span');
      setLangText(contextCopy, text(article.why_it_matters_en), article.why_it_matters_zh);
      context.append(contextLabel, contextCopy);
      card.appendChild(context);

      return card;
    };
    const filtersAreActive = () => Boolean(
      (search?.value.trim() ?? '')
      || disease?.value
      || country?.value
      || study?.value
      || topic?.value
      || pathogenType?.value
      || population?.value
      || journalFilter?.value
      || publisherFilter?.value
      || publishedFrom?.value
      || publishedTo?.value
      || oa?.checked
    );
    const matchesFilters = (article: any) => {
      const query = search?.value.trim().toLowerCase() ?? '';
      const tokens = articleTokens(article);
      return (!query || articleSearchText(article, tokens).includes(query))
        && (!disease?.value || hasToken(tokens.diseaseIds, disease.value))
        && (!country?.value || hasToken(tokens.countryCodes, country.value))
        && (!study?.value || String(article.study_type ?? '').toLowerCase() === study.value)
        && (!topic?.value || hasToken(tokens.topicSlugs, topic.value))
        && (!pathogenType?.value || hasToken(tokens.pathogenTypeIds, pathogenType.value))
        && (!population?.value || hasToken(tokens.populationIds, population.value))
        && (!journalFilter?.value || String(article.journal ?? '').toLowerCase() === journalFilter.value)
        && (!publisherFilter?.value || String(article.publisher ?? '').toLowerCase() === publisherFilter.value)
        && (!publishedFrom?.value || String(article.published_at ?? '').slice(0, 10) >= publishedFrom.value)
        && (!publishedTo?.value || String(article.published_at ?? '').slice(0, 10) <= publishedTo.value)
        && (!oa?.checked || article.open_access_status === 'open');
    };
    const renderArticles = (articles: any[]) => {
      if (!list) return;
      const visible = articles.slice(0, visibleLimit);
      list.replaceChildren(...visible.map(renderArticleCard));
      if (count) count.textContent = articles.length === visible.length
        ? `${articles.length} ${articles.length === 1 ? 'publication' : 'publications'}`
        : `${visible.length} of ${articles.length} publications shown`;
      empty?.classList.toggle('hidden', articles.length > 0);
      if (loadMore) loadMore.hidden = articles.length <= visibleLimit;
      document.dispatchEvent(new CustomEvent('globalid:language-change', { detail: { lang: currentLang() } }));
    };
    const applyFilters = async (requireCatalogue = filtersAreActive() || visibleLimit > initialVisible) => {
      if (!requireCatalogue) {
        if (count) count.textContent = totalArticles > initialVisible
          ? `${initialVisible} of ${totalArticles} publications shown`
          : `${totalArticles} ${totalArticles === 1 ? 'publication' : 'publications'}`;
        if (loadMore) loadMore.hidden = totalArticles <= initialVisible;
        empty?.classList.toggle('hidden', totalArticles > 0);
        return;
      }
      try {
        const articles = await loadCatalogue();
        renderArticles(articles.filter(matchesFilters));
      } catch (error) {
        console.error(error);
        if (loadMore) loadMore.hidden = true;
      }
    };
    form?.addEventListener('submit', event => event.preventDefault());
    publicationCollection?.addEventListener('change', () => {
      if (publicationCollection.value === 'preprint') location.href = '/research/preprints/';
    });
    [search, disease, country, study, topic, pathogenType, population, journalFilter, publisherFilter, publishedFrom, publishedTo, oa].forEach(control => control?.addEventListener(control instanceof HTMLInputElement && control.type === 'search' ? 'input' : 'change', () => {
      visibleLimit = initialVisible;
      void applyFilters(true);
    }));
    loadMore?.addEventListener('click', () => {
      visibleLimit += initialVisible;
      void applyFilters(true);
    });
    void applyFilters(filtersAreActive());
  </script>
</ReportLayout>

<style>
  .research-page { width: min(88rem, calc(100% - 1.5rem)); margin: 0 auto; padding: 1.5rem 0 1rem; }
  .research-hero { position: relative; isolation: isolate; overflow: hidden; padding: 0; }
  .research-hero::before { content: ''; position: absolute; z-index: -1; inset: 0 0 0 auto; width: min(38rem, 48vw); background: radial-gradient(circle at 70% 32%, rgb(var(--color-teal) / .12) 0 1px, transparent 2px 100%), radial-gradient(circle at 70% 32%, transparent 0 24%, rgb(var(--color-brand) / .07) 24.2% 24.6%, transparent 24.8%); background-size: 20px 20px, 100% 100%; mask-image: linear-gradient(90deg, transparent, #000 38%); opacity: .65; pointer-events: none; }
  .research-hero-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(19rem, .6fr); gap: clamp(1.75rem, 4vw, 3.5rem); align-items: center; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .research-hero .academic-title { margin-top: .38rem; font-size: clamp(2.7rem, 4.7vw, 4rem); line-height: 1; }
  .research-lede { max-width: 48rem; margin-top: .8rem; font-size: clamp(.95rem, 1.25vw, 1.06rem); }
  .research-hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1rem; margin-top: 1.25rem; }
  .research-primary-link { display: inline-flex; min-height: 2.5rem; align-items: center; justify-content: center; background: rgb(var(--color-brand)); padding: 0 .95rem; color: #fff; font-size: .73rem; font-weight: 700; }
  .research-primary-link:hover { background: rgb(var(--color-brand) / .86); color: #fff; }
  .research-secondary-link { color: rgb(var(--color-brand)); font-size: .72rem; font-weight: 650; }
  .research-provenance { display: flex; flex-wrap: wrap; gap: .55rem 1.25rem; margin-top: 1rem; color: rgb(var(--text-faint)); font: 500 .64rem/1.4 'JetBrains Mono', monospace; }
  .research-updated { display: inline-flex; align-items: center; gap: .5rem; }
  .research-pulse { display: inline-block; width: .4rem; height: .4rem; border-radius: 50%; background: rgb(var(--color-teal)); box-shadow: 0 0 0 .22rem rgb(var(--color-teal) / .1); }
  .research-week { padding: 1rem 1.05rem; border: 1px solid rgb(var(--border) / .72); background: rgb(var(--surface) / .7); backdrop-filter: blur(4px); }
  .research-week dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: .7rem; }
  .research-week dl div { min-width: 0; padding: .1rem .7rem; border-left: 1px solid rgb(var(--border) / .7); }
  .research-week dl div:nth-child(odd) { padding-left: 0; border-left: 0; }
  .research-week dl div:nth-child(n+3) { margin-top: .65rem; padding-top: .65rem; border-top: 1px solid rgb(var(--border) / .7); }
  .research-week dt { min-height: 2.4em; color: rgb(var(--text-faint)); font-size: .57rem; font-weight: 700; line-height: 1.2; letter-spacing: .06em; text-transform: uppercase; }
  .research-week dd { margin-top: .45rem; color: rgb(var(--text-strong)); font: 600 1.55rem/1 'Source Serif 4', serif; }
  .research-section { margin-top: 1.15rem; padding: clamp(1.05rem, 2vw, 1.5rem); }
  .research-directory { margin-top: 1.15rem; padding: 1.05rem clamp(1.05rem, 2vw, 1.5rem); }
  .directory-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; padding-bottom: .8rem; border-bottom: 1px solid rgb(var(--border) / .68); }
  .directory-heading h2 { margin-top: .24rem; color: rgb(var(--text-strong)); font: 600 clamp(1.25rem, 2.3vw, 1.65rem)/1.1 'Source Serif 4', serif; }
  .directory-heading > a { flex: none; color: rgb(var(--color-brand)); font-size: .69rem; font-weight: 650; }
  .directory-rows { display: grid; gap: .58rem; margin-top: .8rem; }
  .directory-rows section { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: .75rem; align-items: center; }
  .directory-rows h3 { color: rgb(var(--text-faint)); font-size: .61rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .directory-rows ul { display: flex; flex-wrap: wrap; gap: .38rem; }
