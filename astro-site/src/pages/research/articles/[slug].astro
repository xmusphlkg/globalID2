---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import ReportLayout from '../../../layouts/ReportLayout.astro';
import researchData from '../../../data/research/index.json';
import { integrityAlertLabel, normalizeIntegrityAlerts } from '../../../lib/research-integrity';

export function getStaticPaths() {
  const data: any = researchData;
  return [...(data.articles ?? []), ...(data.preprints ?? [])]
    .map((article: any) => ({ params: { slug: article.slug } }));
}

const { slug } = Astro.params;
const file = resolve(`./src/data/research/articles/${slug}.json`);
const article: any = existsSync(file)
  ? JSON.parse(readFileSync(file, 'utf-8'))
  : [...((researchData as any).articles ?? []), ...((researchData as any).preprints ?? [])]
    .find((item: any) => item.slug === slug);
if (!article) return Astro.redirect('/research/');
const isPreprint = article.peer_review_status === 'preprint';
const versionRelation = (article.version_relations ?? []).find((relation: any) => (
  isPreprint
    ? relation.preprint_doi === article.doi && relation.peer_reviewed_doi
    : relation.peer_reviewed_doi === article.doi && relation.preprint_doi
));
const versionTargetUrl = versionRelation
  ? (isPreprint
      ? versionRelation.peer_reviewed_url ?? `https://doi.org/${versionRelation.peer_reviewed_doi}`
      : versionRelation.preprint_url ?? `https://doi.org/${versionRelation.preprint_doi}`)
  : null;
const integrityEvents = normalizeIntegrityAlerts(article.integrity_events);
const showCorrectionHistory = article.integrity_status === 'corrected'
  && article.indexable === true
  && integrityEvents.length > 0;
const summaryEn = article.summary?.en ?? {};
const summaryZh = article.summary?.zh ?? {};
const evidenceSections = [
  ['Research question', '研究问题', 'research_question'],
  ['Study design', '研究设计', 'study_design'],
  ['Population and setting', '人群与场景', 'population_setting'],
  ['Main findings', '主要发现', 'main_findings'],
  ['Public-health relevance', '公共卫生意义', 'public_health_relevance'],
  ['Important limitations', '重要局限', 'limitations'],
  ['GIDS interpretation', 'GIDS 解读', 'gids_interpretation'],
] as const;
const publicationDateEn = article.publication_date_label_en ?? (article.published_at
  ? new Date(article.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : 'Date unavailable');
const publicationDateZh = article.publication_date_label_zh ?? (article.published_at
  ? new Date(article.published_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '日期暂缺');
const authorLine = (article.authors ?? []).join(', ');
const originalUrl = article.source_urls?.doi ?? article.source_urls?.publisher;
const isHistoricalBaseline = article.source_kind === 'historical_seed' || article.historical_baseline;
const structuredArticle = {
  '@type': 'ScholarlyArticle',
  headline: article.title,
  datePublished: article.published_at,
  dateModified: article.updated_at,
  author: (article.authors ?? []).map((name: string) => ({ '@type': 'Person', name })),
  isPartOf: article.journal ? { '@type': 'Periodical', name: article.journal } : undefined,
  identifier: article.doi ? `https://doi.org/${article.doi}` : article.pmid ? `PMID:${article.pmid}` : article.article_id,
  sameAs: originalUrl,
  about: (article.diseases ?? []).map((disease: any) => ({ '@type': 'MedicalCondition', name: disease.name_en })),
};
const graph = article.knowledge_graph ?? { stats: {}, edges: [] };
const summaryProvenance = summaryEn.provenance ?? summaryZh.provenance ?? null;
const provenanceDisclosureEn = summaryProvenance?.editorially_approved
  ? 'This bilingual evidence summary was AI-assisted and subsequently editorially approved.'
  : 'This bilingual evidence summary was generated with AI and passed an automated quality gate; it has not been editorially approved.';
const provenanceDisclosureZh = summaryProvenance?.editorially_approved
  ? '本双语证据摘要由 AI 辅助生成，随后已通过编辑审核。'
  : '本双语证据摘要由 AI 生成并通过自动质量门控；尚未经过编辑审核。';
const relatedSurveillance = article.related_surveillance ?? [];
const relatedSignals = (article.related_signals ?? []).filter((signal: any) => signal.visibility === 'public' || import.meta.env.DEV);
const relatedArticles = article.related_articles ?? [];
const isIndexableEvidencePage = article.indexable !== false
  && Boolean(article.summary?.en)
  && Boolean(article.summary?.zh);
---

<ReportLayout
  title={article.title}
  description={article.why_it_matters_en}
  seo={{
    title: `${article.title} | GIDS`,
    description: article.why_it_matters_en,
    locale: 'en',
    canonicalPath: `/research/articles/${article.slug}/`,
    alternatePaths: { en: `/research/articles/${article.slug}/` },
    pageType: 'MedicalWebPage',
    image: `/research/cards/${article.slug}.png`,
    noindex: !isIndexableEvidencePage,
    datePublished: article.published_at,
    dateModified: article.updated_at,
  }}
  structuredData={structuredArticle}
  breadcrumbs={[
    { label: 'Research Radar', labelZh: '研究雷达', href: '/research/' },
    ...(isPreprint ? [{ label: 'Preprints', labelZh: '预印本', href: '/research/preprints/' }] : []),
    { label: 'Evidence summary', labelZh: '证据摘要' },
  ]}
>
  <article class="evidence-page">
    <header class="academic-hero evidence-header">
      <div class="evidence-badges">
        <span data-lang-en={article.peer_review_status === 'peer_reviewed' ? 'Peer reviewed' : 'Preprint'} data-lang-zh={article.peer_review_status === 'peer_reviewed' ? '同行评议' : '预印本'}>{article.peer_review_status === 'peer_reviewed' ? 'Peer reviewed' : 'Preprint'}</span>
        {isPreprint && versionRelation && <span class="version-available" data-lang-en="Peer-reviewed version available" data-lang-zh="已有同行评议版本">Peer-reviewed version available</span>}
        {showCorrectionHistory && <span class="integrity-corrected" data-lang-en="Correction recorded" data-lang-zh="已记录更正">Correction recorded</span>}
        {isHistoricalBaseline && <span class="history" data-lang-en="Historical baseline" data-lang-zh="历史基线">Historical baseline</span>}
        {article.open_access_status === 'open' && <span class="oa" data-lang-en="Open access" data-lang-zh="开放获取">Open access</span>}
        {(article.diseases ?? []).map((disease: any) => <span data-lang-en={disease.name_en} data-lang-zh={disease.name_zh ?? disease.name_en}>{disease.name_en}</span>)}
      </div>
      <h1>{article.title}</h1>
      <p class="evidence-citation"><span>{article.journal ?? 'Journal unavailable'}</span><span>·</span><time datetime={article.published_at} data-lang-en={publicationDateEn} data-lang-zh={publicationDateZh}>{publicationDateEn}</time></p>
      {authorLine && <p class="evidence-authors">{authorLine}</p>}
      <dl class="evidence-register">
        <div><dt>DOI</dt><dd>{article.doi ?? '—'}</dd></div>
        <div><dt>PMID</dt><dd>{article.pmid ?? '—'}</dd></div>
        <div><dt>PMCID</dt><dd>{article.pmcid ?? '—'}</dd></div>
        <div><dt>OpenAlex</dt><dd>{article.openalex_id ?? '—'}</dd></div>
        <div><dt data-lang-en="Study type" data-lang-zh="研究类型">Study type</dt><dd>{article.study_type ?? 'Journal article'}</dd></div>
        <div><dt data-lang-en="Publisher" data-lang-zh="出版商">Publisher</dt><dd data-lang-en={article.publisher ?? 'Publisher unavailable'} data-lang-zh={article.publisher ?? '出版商暂缺'}>{article.publisher ?? 'Publisher unavailable'}</dd></div>
        <div><dt data-lang-en="Article type" data-lang-zh="文章类型">Article type</dt><dd>{article.article_type ?? 'journal-article'}</dd></div>
        <div><dt data-lang-en="Integrity" data-lang-zh="完整性状态">Integrity</dt><dd data-lang-en={article.integrity_status === 'corrected' ? 'Corrected' : article.integrity_status} data-lang-zh={article.integrity_status === 'corrected' ? '已更正' : article.integrity_status}>{article.integrity_status === 'corrected' ? 'Corrected' : article.integrity_status}</dd></div>
      </dl>
    </header>

    {showCorrectionHistory && (
      <section class="integrity-correction-notice" aria-labelledby="correction-notice-title">
        <div>
          <p class="evidence-kicker" data-lang-en="Integrity update" data-lang-zh="完整性更新">Integrity update</p>
          <h2 id="correction-notice-title" data-lang-en="This public record has a correction history" data-lang-zh="此公开记录存在更正历史">This public record has a correction history</h2>
        </div>
        <p data-lang-en="Review the dated events and verify the linked source record before using the findings." data-lang-zh="使用研究结论前，请查看带日期的事件并核对所链接的来源记录。">Review the dated events and verify the linked source record before using the findings.</p>
        <a href="/research/integrity/" data-lang-en="All integrity alerts →" data-lang-zh="查看全部完整性通知 →">All integrity alerts →</a>
      </section>
    )}

    {versionRelation && versionTargetUrl && (
      <section class="version-link-notice" aria-labelledby="version-link-title">
        <div>
          <p class="evidence-kicker" data-lang-en="Publication version" data-lang-zh="发表版本">Publication version</p>
          <h2 id="version-link-title" data-lang-en={isPreprint ? 'A peer-reviewed version is available' : 'This article has a linked preprint'} data-lang-zh={isPreprint ? '已有同行评议版本' : '本文关联一个预印本版本'}>{isPreprint ? 'A peer-reviewed version is available' : 'This article has a linked preprint'}</h2>
        </div>
        <p data-lang-en="The relationship comes from Crossref version metadata. Compare both records because findings and wording may have changed between versions." data-lang-zh="该关系来自 Crossref 版本元数据。不同版本之间的结果与表述可能变化，请对照核验。">The relationship comes from Crossref version metadata. Compare both records because findings and wording may have changed between versions.</p>
        <a href={versionTargetUrl} target={versionTargetUrl.startsWith('http') ? '_blank' : undefined} rel={versionTargetUrl.startsWith('http') ? 'noopener noreferrer' : undefined} data-lang-en={isPreprint ? 'Open peer-reviewed version →' : 'Open linked preprint →'} data-lang-zh={isPreprint ? '查看同行评议版本 →' : '查看关联预印本 →'}>{isPreprint ? 'Open peer-reviewed version →' : 'Open linked preprint →'}</a>
      </section>
    )}

    <div class="evidence-layout">
      <main>
        <section class="evidence-context">
          <p class="evidence-kicker" data-lang-en="Why this research matters now" data-lang-zh="为何这项研究现在值得关注">Why this research matters now</p>
          <p data-lang-en={article.why_it_matters_en} data-lang-zh={article.why_it_matters_zh}>{article.why_it_matters_en}</p>
        </section>
        {showCorrectionHistory && (
          <section class="evidence-surveillance article-integrity-history" aria-labelledby="article-integrity-title">
            <div class="section-title"><span>!</span><h2 id="article-integrity-title" data-lang-en="Correction event history" data-lang-zh="更正事件历史">Correction event history</h2></div>
            <ol>
              {integrityEvents.map(event => {
                const labelEn = integrityAlertLabel(event.event_type);
                const labelZh = integrityAlertLabel(event.event_type, 'zh');
                const dateValue = event.effective_at ?? event.recorded_at;
                const parsedDate = dateValue ? new Date(dateValue) : null;
                const dateEn = parsedDate && !Number.isNaN(parsedDate.getTime())
                  ? parsedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
                  : 'Date unavailable';
                const dateZh = parsedDate && !Number.isNaN(parsedDate.getTime())
                  ? parsedDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
                  : '日期暂缺';
                return <li>
                  <div><strong data-lang-en={labelEn} data-lang-zh={labelZh}>{labelEn}</strong><time datetime={dateValue} data-lang-en={dateEn} data-lang-zh={dateZh}>{dateEn}</time></div>
                  <span>{event.source}</span>
                  {event.source_url && <a href={event.source_url} target="_blank" rel="noopener noreferrer" data-lang-en="Verify source record ↗" data-lang-zh="核对来源记录 ↗">Verify source record ↗</a>}
                </li>;
              })}
            </ol>
          </section>
        )}
        <section class="evidence-sections">
          <div class="section-title"><span>01</span><h2 data-lang-en="Structured evidence summary" data-lang-zh="结构化证据摘要">Structured evidence summary</h2></div>
          {evidenceSections.map(([labelEn, labelZh, key]) => {
            const valueEn = summaryEn[key];
            const valueZh = summaryZh[key];
            const fallbackEn = key === 'limitations'
              ? 'Limitations could not be fully assessed from the available metadata.'
              : 'This field has not yet received a quality-gated evidence summary. Consult the original article.';
            const fallbackZh = key === 'limitations'
              ? '根据现有元数据，尚无法充分评估研究局限。'
              : '该字段尚无通过质量门控的证据摘要，请查阅原始文献。';
            return <div class:list={['evidence-section', !valueEn && !valueZh && 'evidence-section-pending']}><h3 data-lang-en={labelEn} data-lang-zh={labelZh}>{labelEn}</h3><p data-lang-en={valueEn ?? fallbackEn} data-lang-zh={valueZh ?? fallbackZh}>{valueEn ?? fallbackEn}</p></div>;
          })}
        </section>

        {(article.diseases ?? []).length > 0 && (
          <section class="evidence-surveillance">
            <div class="section-title"><span>02</span><h2 data-lang-en="Related GIDS surveillance" data-lang-zh="相关 GIDS 监测">Related GIDS surveillance</h2></div>
            {relatedSignals.length > 0 && <div class="related-signal-context">
              <p class="evidence-kicker" data-lang-en="Active Situation Room context" data-lang-zh="当前全球态势室背景">Active Situation Room context</p>
              <div class="related-signal-list">{relatedSignals.map((signal: any) => {
                const places = (signal.geographies ?? []).map((item: any) => item.name_en).join(' · ') || 'Geography unavailable';
                const relationEn = signal.relation_level === 'exact_disease_geography' ? 'Exact disease + geography match' : 'Disease context only';
                const relationZh = signal.relation_level === 'exact_disease_geography' ? '疾病 + 地区精确匹配' : '仅疾病背景';
                return <a href={signal.situation_url}>
                  <div><span data-lang-en={signal.disease_name_en} data-lang-zh={signal.disease_name_zh ?? signal.disease_name_en}>{signal.disease_name_en}</span><small>{places} · {signal.data_through ?? '—'}</small></div>
                  {signal.window?.change_pct != null && <strong>{signal.window.change_pct > 0 ? '+' : ''}{signal.window.change_pct}%</strong>}
                  <em data-lang-en={relationEn} data-lang-zh={relationZh}>{relationEn}</em>
                </a>;
              })}</div>
              <p class="signal-context-note" data-lang-en="A disease-only match provides background reading; it is not evidence about the signal geography or cause." data-lang-zh="仅疾病匹配只提供背景阅读，并不是关于信号地区或成因的证据。">A disease-only match provides background reading; it is not evidence about the signal geography or cause.</p>
            </div>}
            <div class="surveillance-links">
              {relatedSurveillance.length > 0
                ? relatedSurveillance.map((link: any) => <a href={link.url}><span data-lang-en={`${link.disease_name_en} · ${link.country_name_en}`} data-lang-zh={`${link.disease_name_zh ?? link.disease_name_en} · ${link.country_name_en}`}>{link.disease_name_en} · {link.country_name_en}</span><small data-lang-en="High-confidence geography · GIDS series available" data-lang-zh="高置信度地理关联 · GIDS 有监测序列">High-confidence geography · GIDS series available</small><i>→</i></a>)
                : article.diseases.map((disease: any) => <a href={`/diseases/${disease.slug}/`}><span data-lang-en={disease.name_en} data-lang-zh={disease.name_zh ?? disease.name_en}>{disease.name_en}</span><small data-lang-en="View available GIDS surveillance" data-lang-zh="查看可用的 GIDS 监测">View available GIDS surveillance</small><i>→</i></a>)}
            </div>
            <p class="evidence-disclaimer" data-lang-en="Literature context does not validate, explain, or change a surveillance signal. Exact and contextual relationships are shown separately." data-lang-zh="文献背景不会验证、解释或改变监测信号；精确关系与背景关系会分开展示。">Literature context does not validate, explain, or change a surveillance signal. Exact and contextual relationships are shown separately.</p>
          </section>
        )}
        <section class="evidence-surveillance evidence-graph">
          <div class="section-title"><span>03</span><h2 data-lang-en="Evidence relationships" data-lang-zh="证据关系">Evidence relationships</h2></div>
          <p data-lang-en={`This article has ${graph.stats?.edges ?? 0} auditable classifier relationships to diseases, places, topics, and study design.`} data-lang-zh={`本文与疾病、地区、主题及研究设计之间有 ${graph.stats?.edges ?? 0} 条可审计分类关系。`}>This article has {graph.stats?.edges ?? 0} auditable classifier relationships to diseases, places, topics, and study design.</p>
          <div class="relationship-list">{(graph.edges ?? []).map((edge: any) => <span>{String(edge.relation).replaceAll('_', ' ').toLowerCase()}</span>)}</div>
        </section>
        {relatedArticles.length > 0 && (
          <section class="evidence-surveillance related-research" aria-labelledby="related-research-title">
            <div class="section-title"><span>04</span><h2 id="related-research-title" data-lang-en="Related research" data-lang-zh="相关文章">Related research</h2></div>
            <p class="related-research-method" data-lang-en="Ranked deterministically by shared disease, geography, topic, study design, and publication proximity. This is a discovery aid, not a quality judgment." data-lang-zh="根据相同疾病、地区、主题、研究设计和发表时间邻近性进行确定性排序。该功能仅用于文献发现，不代表质量判断。">Ranked deterministically by shared disease, geography, topic, study design, and publication proximity. This is a discovery aid, not a quality judgment.</p>
            <ol>
              {relatedArticles.map((related: any) => (
                <li>
                  <a href={`/research/articles/${related.slug}/`}><strong>{related.title}</strong><span>{related.journal ?? 'Journal unavailable'} · {related.study_type ?? 'Journal article'}</span></a>
                  <p data-lang-en={(related.reasons_en ?? []).join(' · ')} data-lang-zh={(related.reasons_zh ?? related.reasons_en ?? []).join(' · ')}>{(related.reasons_en ?? []).join(' · ')}</p>
                </li>
              ))}
            </ol>
          </section>
        )}
      </main>

      <aside>
        <div class="evidence-aside-block"><p class="evidence-kicker" data-lang-en="Topics" data-lang-zh="主题">Topics</p><div class="topic-tags">{(article.topics ?? []).map((topic: any) => <a href={`/research/topics/${String(topic.name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}/`}>{topic.name}</a>)}</div></div>
        {(article.pathogens ?? []).length > 0 && <div class="evidence-aside-block"><p class="evidence-kicker" data-lang-en="Pathogens" data-lang-zh="病原体">Pathogens</p><ul>{article.pathogens.map((pathogen: any) => <li>{pathogen.name}</li>)}</ul></div>}
        {(article.populations ?? []).length > 0 && <div class="evidence-aside-block"><p class="evidence-kicker" data-lang-en="Populations" data-lang-zh="研究人群">Populations</p><ul>{article.populations.map((population: any) => <li>{population.name}</li>)}</ul></div>}
        {(article.countries ?? []).length > 0 && <div class="evidence-aside-block"><p class="evidence-kicker" data-lang-en="Geographic scope" data-lang-zh="地理范围">Geographic scope</p><ul>{article.countries.map((country: any) => <li><a href={`/research/countries/${country.code.toLowerCase()}/`}>{country.name_en} <span>→</span></a></li>)}</ul></div>}
        <div class="evidence-aside-block"><p class="evidence-kicker" data-lang-en="Original sources" data-lang-zh="原始来源">Original sources</p><div class="source-links">{article.doi && <a href={`https://doi.org/${article.doi}`} target="_blank" rel="noopener noreferrer">DOI record ↗</a>}{article.source_urls?.pubmed && <a href={article.source_urls.pubmed} target="_blank" rel="noopener noreferrer">PubMed ↗</a>}{article.open_access_url && <a href={article.open_access_url} target="_blank" rel="noopener noreferrer">Open access ↗</a>}</div></div>
        <div class="evidence-aside-block evidence-score"><p class="evidence-kicker">GIDS Discovery Score</p><strong>{Math.round((article.discovery_score ?? 0) * 100)}</strong><p data-lang-en="A transparent discovery ranking, not a scientific quality or credibility score." data-lang-zh="这是透明的发现排序，并非科学质量或可信度评分。">A transparent discovery ranking, not a scientific quality or credibility score.</p></div>
        {summaryProvenance && <div class="evidence-aside-block evidence-provenance"><p class="evidence-kicker" data-lang-en="AI-assisted summary provenance" data-lang-zh="AI 辅助摘要来源">AI-assisted summary provenance</p><p data-lang-en={provenanceDisclosureEn} data-lang-zh={provenanceDisclosureZh}>{provenanceDisclosureEn}</p><dl><div><dt data-lang-en="Generator" data-lang-zh="生成器">Generator</dt><dd>{summaryProvenance.generated_by ?? 'AI evidence pipeline'}</dd></div>{(summaryProvenance.provider || summaryProvenance.model) && <div><dt data-lang-en="Provider / model" data-lang-zh="提供商 / 模型">Provider / model</dt><dd>{[summaryProvenance.provider, summaryProvenance.model].filter(Boolean).join(' · ')}</dd></div>}{summaryProvenance.quality_score != null && <div><dt data-lang-en="Quality score" data-lang-zh="质量分">Quality score</dt><dd>{Math.round(summaryProvenance.quality_score * 100)} / 100</dd></div>}{summaryProvenance.publication_gate && <div><dt data-lang-en="Publication gate" data-lang-zh="发布门控">Publication gate</dt><dd>{summaryProvenance.publication_gate}</dd></div>}{summaryProvenance.automation_policy_version && <div><dt data-lang-en="Policy" data-lang-zh="策略">Policy</dt><dd>{summaryProvenance.automation_policy_version}</dd></div>}</dl></div>}
      </aside>
    </div>
  </article>
</ReportLayout>

<style>
  .evidence-page { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 3rem; }
  .evidence-header { padding: clamp(1.5rem, 4vw, 3rem); }
  .evidence-badges { display: flex; flex-wrap: wrap; gap: .4rem; }
  .evidence-badges span { border: 1px solid rgb(var(--border)); padding: .2rem .5rem; color: rgb(var(--text-muted)); font-size: .67rem; font-weight: 650; }
  .evidence-badges .history { border-color: rgb(var(--color-accent) / .58); color: rgb(var(--color-accent)); background: rgb(var(--color-accent) / .08); }
  .evidence-badges .oa { border-color: rgb(var(--color-teal) / .55); color: rgb(var(--color-teal)); }
  .evidence-badges .integrity-corrected { border-color: rgb(var(--color-teal) / .58); color: rgb(var(--color-teal)); background: rgb(var(--color-teal) / .08); }
  .evidence-badges .version-available { border-color: rgb(var(--color-brand) / .58); color: rgb(var(--color-brand)); background: rgb(var(--color-brand) / .08); }
  .evidence-header h1 { max-width: 55rem; margin-top: 1.2rem; font: 600 clamp(2rem, 5vw, 3.9rem)/1.04 'Source Serif 4', serif; letter-spacing: -.035em; color: rgb(var(--text-strong)); }
  .evidence-citation { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.15rem; color: rgb(var(--text-muted)); font-size: .85rem; }
  .evidence-authors { max-width: 52rem; margin-top: .8rem; color: rgb(var(--text-faint)); font-size: .76rem; line-height: 1.6; }
