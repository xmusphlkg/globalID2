---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import ReportLayout from '../../../layouts/ReportLayout.astro';
import researchData from '../../../data/research/index.json';
import { integrityAlertLabel, normalizeIntegrityAlerts } from '../../../lib/research-integrity';
import { buildAlternatePaths, clampSeoDescription, clampSeoTitle } from '../../../lib/seo';

export function getStaticPaths() {
  const data: any = researchData;
  return [...(data.articles ?? []), ...(data.preprints ?? [])]
    .map((article: any) => ({ params: { slug: article.slug }, props: { articleSlug: article.slug, locale: 'en' } }));
}

interface Props { articleSlug?: string; locale?: 'en' | 'zh' }
const { articleSlug = '', locale = 'en' } = Astro.props as Props;
const slug = articleSlug;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const localeHref = (href: string) => zh && href.startsWith('/') ? `${prefix}${href}` : href;
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;
const file = resolve(`./src/data/research/articles/${slug}.json`);
const article: any = existsSync(file)
  ? JSON.parse(readFileSync(file, 'utf-8'))
  : [...((researchData as any).articles ?? []), ...((researchData as any).preprints ?? [])]
    .find((item: any) => item.slug === slug);
if (!article) return Astro.redirect(localeHref('/research/'));
const isPreprint = article.peer_review_status === 'preprint';
const versionRelation = (article.version_relations ?? []).find((relation: any) => (
  isPreprint
    ? relation.preprint_doi === article.doi && relation.peer_reviewed_doi
    : relation.peer_reviewed_doi === article.doi && relation.preprint_doi
));
const versionTargetUrl = versionRelation
  ? (isPreprint
      ? versionRelation.peer_reviewed_url ?? `https://doi.org/${versionRelation.peer_reviewed_doi}`
      : versionRelation.preprint_url ?? `https://doi.org/${versionRelation.preprint_doi}`)
  : null;
const integrityEvents = normalizeIntegrityAlerts(article.integrity_events);
const showCorrectionHistory = article.integrity_status === 'corrected'
  && article.indexable === true
  && integrityEvents.length > 0;
const summaryEn = article.summary?.en ?? {};
const summaryZh = article.summary?.zh ?? {};
const evidenceSections = [
  ['Research question', '研究问题', 'research_question'],
  ['Study design', '研究设计', 'study_design'],
  ['Population and setting', '人群与场景', 'population_setting'],
  ['Main findings', '主要发现', 'main_findings'],
  ['Public-health relevance', '公共卫生意义', 'public_health_relevance'],
  ['Important limitations', '重要局限', 'limitations'],
  ['GIDS interpretation', 'GIDS 解读', 'gids_interpretation'],
] as const;
const publicationDateEn = article.publication_date_label_en ?? (article.published_at
  ? new Date(article.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : 'Date unavailable');
const publicationDateZh = article.publication_date_label_zh ?? (article.published_at
  ? new Date(article.published_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : '日期暂缺');
const authorLine = (article.authors ?? []).join(', ');
const originalUrl = article.source_urls?.doi ?? article.source_urls?.publisher;
const isHistoricalBaseline = article.source_kind === 'historical_seed' || article.historical_baseline;
const structuredArticle = {
  '@type': 'ScholarlyArticle',
  headline: article.title,
  datePublished: article.published_at,
  dateModified: article.updated_at,
  author: (article.authors ?? []).map((name: string) => ({ '@type': 'Person', name })),
  isPartOf: article.journal ? { '@type': 'Periodical', name: article.journal } : undefined,
  identifier: article.doi ? `https://doi.org/${article.doi}` : article.pmid ? `PMID:${article.pmid}` : article.article_id,
  sameAs: originalUrl,
  about: (article.diseases ?? []).map((disease: any) => ({ '@type': 'MedicalCondition', name: disease.name_en })),
  inLanguage: zh ? 'zh-CN' : 'en',
};
const graph = article.knowledge_graph ?? { stats: {}, edges: [] };
const summaryProvenance = summaryEn.provenance ?? summaryZh.provenance ?? null;
const provenanceDisclosureEn = summaryProvenance?.editorially_approved
  ? 'This bilingual evidence summary was AI-assisted and subsequently editorially approved.'
  : 'This bilingual evidence summary was generated with AI and passed an automated quality gate; it has not been editorially approved.';
const provenanceDisclosureZh = summaryProvenance?.editorially_approved
  ? '本双语证据摘要由 AI 辅助生成，随后已通过编辑审核。'
  : '本双语证据摘要由 AI 生成并通过自动质量门控；尚未经过编辑审核。';
const relatedSurveillance = article.related_surveillance ?? [];
const relatedSignals = (article.related_signals ?? []).filter((signal: any) => signal.visibility === 'public' || import.meta.env.DEV);
const relatedArticles = article.related_articles ?? [];
const isIndexableEvidencePage = article.indexable !== false
  && Boolean(article.summary?.en)
  && Boolean(article.summary?.zh);
const canonicalPath = localeHref(`/research/articles/${article.slug}/`);
const whyItMatters = pick(article.why_it_matters_en, article.why_it_matters_zh ?? article.why_it_matters_en);
const descriptionContext = zh
  ? '本页提供研究设计、主要发现、重要局限、来源标识及相关监测背景。'
  : 'Review the study design, main findings, important limitations, source identifiers, and related surveillance context.';
const pageDescription = clampSeoDescription(`${whyItMatters} ${descriptionContext}`);
const titleSuffix = zh ? ' | GIDS 中文证据摘要' : ' | GIDS';
const doiSuffix = article.doi ? String(article.doi).split('/').filter(Boolean).at(-1) : '';
const shortIdentifier = doiSuffix && [...doiSuffix].length <= 18
  ? doiSuffix
  : (article.pmid ? `PMID ${article.pmid}` : String(article.slug).slice(-8));
const titleDisambiguator = ` · ${shortIdentifier}`;
const pageSeoTitle = `${clampSeoTitle(article.title, 70 - titleSuffix.length - titleDisambiguator.length)}${titleDisambiguator}${titleSuffix}`;
---

<ReportLayout
  title={article.title}
  description={pageDescription}
  initialLanguage={locale}
  seo={{
    title: pageSeoTitle,
    description: pageDescription,
    locale,
    canonicalPath,
    alternatePaths: buildAlternatePaths(canonicalPath, locale),
    pageType: 'MedicalWebPage',
    image: `/research/cards/${article.slug}.png`,
    noindex: !isIndexableEvidencePage,
    datePublished: article.published_at,
    dateModified: article.updated_at,
  }}
  structuredData={structuredArticle}
  breadcrumbs={[
    { label: 'Research Radar', labelZh: '研究雷达', href: localeHref('/research/') },
    ...(isPreprint ? [{ label: 'Preprints', labelZh: '预印本', href: localeHref('/research/preprints/') }] : []),
    { label: 'Evidence summary', labelZh: '证据摘要' },
  ]}
>
  <article class="evidence-page">
    <header class="academic-hero evidence-header">
      <div class="evidence-badges">
        <span>{article.peer_review_status === 'peer_reviewed' ? pick('Peer reviewed', '同行评议') : pick('Preprint', '预印本')}</span>
        {isPreprint && versionRelation && <span class="version-available">{pick('Peer-reviewed version available', '已有同行评议版本')}</span>}
        {showCorrectionHistory && <span class="integrity-corrected">{pick('Correction recorded', '已记录更正')}</span>}
        {isHistoricalBaseline && <span class="history">{pick('Historical baseline', '历史基线')}</span>}
        {article.open_access_status === 'open' && <span class="oa">{pick('Open access', '开放获取')}</span>}
        {(article.diseases ?? []).map((disease: any) => <span>{pick(disease.name_en, disease.name_zh ?? disease.name_en)}</span>)}
      </div>
      <h1>{article.title}</h1>
      <p class="evidence-citation"><span>{article.journal ?? pick('Journal unavailable', '期刊信息暂缺')}</span><span>·</span><time datetime={article.published_at}>{pick(publicationDateEn, publicationDateZh)}</time></p>
      {authorLine && <p class="evidence-authors">{authorLine}</p>}
      <dl class="evidence-register">
        <div><dt>DOI</dt><dd>{article.doi ?? '—'}</dd></div>
        <div><dt>PMID</dt><dd>{article.pmid ?? '—'}</dd></div>
        <div><dt>PMCID</dt><dd>{article.pmcid ?? '—'}</dd></div>
        <div><dt>OpenAlex</dt><dd>{article.openalex_id ?? '—'}</dd></div>
        <div><dt>{pick('Study type', '研究类型')}</dt><dd>{article.study_type ?? pick('Journal article', '期刊论文')}</dd></div>
        <div><dt>{pick('Publisher', '出版商')}</dt><dd>{article.publisher ?? pick('Publisher unavailable', '出版商暂缺')}</dd></div>
        <div><dt>{pick('Article type', '文章类型')}</dt><dd>{article.article_type ?? 'journal-article'}</dd></div>
        <div><dt>{pick('Integrity', '完整性状态')}</dt><dd>{article.integrity_status === 'corrected' ? pick('Corrected', '已更正') : article.integrity_status}</dd></div>
      </dl>
    </header>

    {showCorrectionHistory && (
      <section class="integrity-correction-notice" aria-labelledby="correction-notice-title">
        <div>
          <p class="evidence-kicker">{pick('Integrity update', '完整性更新')}</p>
          <h2 id="correction-notice-title">{pick('This public record has a correction history', '此公开记录存在更正历史')}</h2>
        </div>
        <p>{pick('Review the dated events and verify the linked source record before using the findings.', '使用研究结论前，请查看带日期的事件并核对所链接的来源记录。')}</p>
        <a href={localeHref('/research/integrity/')}>{pick('All integrity alerts →', '查看全部完整性通知 →')}</a>
      </section>
    )}

    {versionRelation && versionTargetUrl && (
      <section class="version-link-notice" aria-labelledby="version-link-title">
        <div>
          <p class="evidence-kicker">{pick('Publication version', '发表版本')}</p>
          <h2 id="version-link-title">{isPreprint ? pick('A peer-reviewed version is available', '已有同行评议版本') : pick('This article has a linked preprint', '本文关联一个预印本版本')}</h2>
        </div>
        <p>{pick('The relationship comes from Crossref version metadata. Compare both records because findings and wording may have changed between versions.', '该关系来自 Crossref 版本元数据。不同版本之间的结果与表述可能变化，请对照核验。')}</p>
        <a href={versionTargetUrl} target={versionTargetUrl.startsWith('http') ? '_blank' : undefined} rel={versionTargetUrl.startsWith('http') ? 'noopener noreferrer' : undefined}>{isPreprint ? pick('Open peer-reviewed version →', '查看同行评议版本 →') : pick('Open linked preprint →', '查看关联预印本 →')}</a>
      </section>
    )}

    <div class="evidence-layout">
      <div>
        <section class="evidence-context">
          <p class="evidence-kicker">{pick('Why this research matters now', '为何这项研究现在值得关注')}</p>
          <p>{pick(article.why_it_matters_en, article.why_it_matters_zh ?? article.why_it_matters_en)}</p>
        </section>
        {showCorrectionHistory && (
          <section class="evidence-surveillance article-integrity-history" aria-labelledby="article-integrity-title">
            <div class="section-title"><span>!</span><h2 id="article-integrity-title">{pick('Correction event history', '更正事件历史')}</h2></div>
            <ol>
              {integrityEvents.map(event => {
                const labelEn = integrityAlertLabel(event.event_type);
                const labelZh = integrityAlertLabel(event.event_type, 'zh');
                const dateValue = event.effective_at ?? event.recorded_at;
                const parsedDate = dateValue ? new Date(dateValue) : null;
                const dateEn = parsedDate && !Number.isNaN(parsedDate.getTime())
                  ? parsedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
                  : 'Date unavailable';
                const dateZh = parsedDate && !Number.isNaN(parsedDate.getTime())
                  ? parsedDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
                  : '日期暂缺';
                return <li>
                  <div><strong>{pick(labelEn, labelZh)}</strong><time datetime={dateValue}>{pick(dateEn, dateZh)}</time></div>
                  <span>{event.source}</span>
                  {event.source_url && <a href={event.source_url} target="_blank" rel="noopener noreferrer">{pick('Verify source record ↗', '核对来源记录 ↗')}</a>}
                </li>;
              })}
            </ol>
          </section>
        )}
        <section class="evidence-sections">
          <div class="section-title"><span>01</span><h2>{pick('Structured evidence summary', '结构化证据摘要')}</h2></div>
          {evidenceSections.map(([labelEn, labelZh, key]) => {
            const valueEn = summaryEn[key];
            const valueZh = summaryZh[key];
            const fallbackEn = key === 'limitations'
              ? 'Limitations could not be fully assessed from the available metadata.'
              : 'This field has not yet received a quality-gated evidence summary. Consult the original article.';
            const fallbackZh = key === 'limitations'
              ? '根据现有元数据，尚无法充分评估研究局限。'
              : '该字段尚无通过质量门控的证据摘要，请查阅原始文献。';
            return <div class:list={['evidence-section', !valueEn && !valueZh && 'evidence-section-pending']}><h3>{pick(labelEn, labelZh)}</h3><p>{pick(valueEn ?? fallbackEn, valueZh ?? fallbackZh)}</p></div>;
          })}
        </section>

        {(article.diseases ?? []).length > 0 && (
          <section class="evidence-surveillance">
            <div class="section-title"><span>02</span><h2>{pick('Related GIDS surveillance', '相关 GIDS 监测')}</h2></div>
            {relatedSignals.length > 0 && <div class="related-signal-context">
              <p class="evidence-kicker">{pick('Active Situation Room context', '当前全球态势室背景')}</p>
              <div class="related-signal-list">{relatedSignals.map((signal: any) => {
                const places = (signal.geographies ?? []).map((item: any) => pick(item.name_en, item.name_zh ?? item.name_en)).join(' · ') || pick('Geography unavailable', '地理范围暂缺');
                const relationEn = signal.relation_level === 'exact_disease_geography' ? 'Exact disease + geography match' : 'Disease context only';
                const relationZh = signal.relation_level === 'exact_disease_geography' ? '疾病 + 地区精确匹配' : '仅疾病背景';
                return <a href={localeHref(signal.situation_url)}>
                  <div><span>{pick(signal.disease_name_en, signal.disease_name_zh ?? signal.disease_name_en)}</span><small>{places} · {signal.data_through ?? '—'}</small></div>
                  {signal.window?.change_pct != null && <strong>{signal.window.change_pct > 0 ? '+' : ''}{signal.window.change_pct}%</strong>}
                  <em>{pick(relationEn, relationZh)}</em>
                </a>;
              })}</div>
              <p class="signal-context-note">{pick('A disease-only match provides background reading; it is not evidence about the signal geography or cause.', '仅疾病匹配只提供背景阅读，并不是关于信号地区或成因的证据。')}</p>
            </div>}
            <div class="surveillance-links">
              {relatedSurveillance.length > 0
                ? relatedSurveillance.map((link: any) => <a href={localeHref(link.url)}><span>{pick(`${link.disease_name_en} · ${link.country_name_en}`, `${link.disease_name_zh ?? link.disease_name_en} · ${link.country_name_zh ?? link.country_name_en}`)}</span><small>{pick('High-confidence geography · GIDS series available', '高置信度地理关联 · GIDS 有监测序列')}</small><i>→</i></a>)
                : article.diseases.map((disease: any) => <a href={localeHref(`/diseases/${disease.slug}/`)}><span>{pick(disease.name_en, disease.name_zh ?? disease.name_en)}</span><small>{pick('View available GIDS surveillance', '查看可用的 GIDS 监测')}</small><i>→</i></a>)}
            </div>
            <p class="evidence-disclaimer">{pick('Literature context does not validate, explain, or change a surveillance signal. Exact and contextual relationships are shown separately.', '文献背景不会验证、解释或改变监测信号；精确关系与背景关系会分开展示。')}</p>
          </section>
        )}
        <section class="evidence-surveillance evidence-graph">
          <div class="section-title"><span>03</span><h2>{pick('Evidence relationships', '证据关系')}</h2></div>
          <p>{pick(`This article has ${graph.stats?.edges ?? 0} auditable classifier relationships to diseases, places, topics, and study design.`, `本文与疾病、地区、主题及研究设计之间有 ${graph.stats?.edges ?? 0} 条可审计分类关系。`)}</p>
          <div class="relationship-list">{(graph.edges ?? []).map((edge: any) => <span>{String(edge.relation).replaceAll('_', ' ').toLowerCase()}</span>)}</div>
        </section>
        {relatedArticles.length > 0 && (
          <section class="evidence-surveillance related-research" aria-labelledby="related-research-title">
            <div class="section-title"><span>04</span><h2 id="related-research-title">{pick('Related research', '相关文章')}</h2></div>
            <p class="related-research-method">{pick('Ranked deterministically by shared disease, geography, topic, study design, and publication proximity. This is a discovery aid, not a quality judgment.', '根据相同疾病、地区、主题、研究设计和发表时间邻近性进行确定性排序。该功能仅用于文献发现，不代表质量判断。')}</p>
            <ol>
              {relatedArticles.map((related: any) => (
                <li>
                  <a href={localeHref(`/research/articles/${related.slug}/`)}><strong>{related.title}</strong><span>{related.journal ?? pick('Journal unavailable', '期刊信息暂缺')} · {related.study_type ?? pick('Journal article', '期刊论文')}</span></a>
                  <p>{pick((related.reasons_en ?? []).join(' · '), (related.reasons_zh ?? related.reasons_en ?? []).join(' · '))}</p>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>

      <aside>
        <div class="evidence-aside-block"><p class="evidence-kicker">{pick('Topics', '主题')}</p><div class="topic-tags">{(article.topics ?? []).map((topic: any) => <a href={localeHref(`/research/topics/${String(topic.name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}/`)}>{topic.name}</a>)}</div></div>
        {(article.pathogens ?? []).length > 0 && <div class="evidence-aside-block"><p class="evidence-kicker">{pick('Pathogens', '病原体')}</p><ul>{article.pathogens.map((pathogen: any) => <li>{pathogen.name}</li>)}</ul></div>}
        {(article.populations ?? []).length > 0 && <div class="evidence-aside-block"><p class="evidence-kicker">{pick('Populations', '研究人群')}</p><ul>{article.populations.map((population: any) => <li>{population.name}</li>)}</ul></div>}
        {(article.countries ?? []).length > 0 && <div class="evidence-aside-block"><p class="evidence-kicker">{pick('Geographic scope', '地理范围')}</p><ul>{article.countries.map((country: any) => <li><a href={localeHref(`/research/countries/${country.code.toLowerCase()}/`)}>{pick(country.name_en, country.name_zh ?? country.name_en)} <span>→</span></a></li>)}</ul></div>}
        <div class="evidence-aside-block"><p class="evidence-kicker">{pick('Original sources', '原始来源')}</p><div class="source-links">{article.doi && <a href={`https://doi.org/${article.doi}`} target="_blank" rel="noopener noreferrer">{pick('DOI record ↗', 'DOI 记录 ↗')}</a>}{article.source_urls?.pubmed && <a href={article.source_urls.pubmed} target="_blank" rel="noopener noreferrer">PubMed ↗</a>}{article.open_access_url && <a href={article.open_access_url} target="_blank" rel="noopener noreferrer">{pick('Open access ↗', '开放获取 ↗')}</a>}</div></div>
        <div class="evidence-aside-block evidence-score"><p class="evidence-kicker">{pick('GIDS Discovery Score', 'GIDS 发现分数')}</p><strong>{Math.round((article.discovery_score ?? 0) * 100)}</strong><p>{pick('A transparent discovery ranking, not a scientific quality or credibility score.', '这是透明的发现排序，并非科学质量或可信度评分。')}</p></div>
        {summaryProvenance && <div class="evidence-aside-block evidence-provenance"><p class="evidence-kicker">{pick('Summary transparency', '摘要透明度')}</p><p>{pick(provenanceDisclosureEn, provenanceDisclosureZh)}</p>{summaryProvenance.quality_score != null && <p>{pick('Automated quality checks passed before publication.', '发布前已通过自动质量检查。')}</p>}</div>}
      </aside>
    </div>
  </article>
</ReportLayout>

<style>
  .evidence-page { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; padding: 2rem 0 3rem; }
  .evidence-header { padding: clamp(1.5rem, 4vw, 3rem); }
  .evidence-badges { display: flex; flex-wrap: wrap; gap: .4rem; }
  .evidence-badges span { border: 1px solid rgb(var(--border)); padding: .2rem .5rem; color: rgb(var(--text-muted)); font-size: .67rem; font-weight: 650; }
  .evidence-badges .history { border-color: rgb(var(--color-accent) / .58); color: rgb(var(--color-accent)); background: rgb(var(--color-accent) / .08); }
  .evidence-badges .oa { border-color: rgb(var(--color-teal) / .55); color: rgb(var(--color-teal)); }
  .evidence-badges .integrity-corrected { border-color: rgb(var(--color-teal) / .58); color: rgb(var(--color-teal)); background: rgb(var(--color-teal) / .08); }
  .evidence-badges .version-available { border-color: rgb(var(--color-brand) / .58); color: rgb(var(--color-brand)); background: rgb(var(--color-brand) / .08); }
  .evidence-header h1 { max-width: 55rem; margin-top: 1.2rem; font: 600 clamp(2rem, 5vw, 3.9rem)/1.04 'IBM Plex Sans', sans-serif; letter-spacing: -.035em; color: rgb(var(--text-strong)); }
  .evidence-citation { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.15rem; color: rgb(var(--text-muted)); font-size: .85rem; }
  .evidence-authors { max-width: 52rem; margin-top: .8rem; color: rgb(var(--text-faint)); font-size: .76rem; line-height: 1.6; }
  .evidence-register { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: 2rem; padding-top: 1.2rem; border-top: 1px solid rgb(var(--border) / .72); }
  .evidence-register dt, .evidence-kicker { color: rgb(var(--color-accent)); font-size: .64rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  .evidence-register dd { margin-top: .32rem; overflow-wrap: anywhere; color: rgb(var(--text)); font: 500 .72rem/1.4 ui-monospace, monospace; }
  .evidence-layout { display: grid; grid-template-columns: minmax(0, 1fr) 18rem; gap: 1.5rem; margin-top: 1.5rem; }
  .evidence-layout main, .evidence-layout aside { min-width: 0; }
  .evidence-context, .evidence-sections, .evidence-surveillance, .evidence-aside-block { border: 1px solid rgb(var(--border) / .72); background: rgb(var(--surface)); }
  .evidence-context { padding: 1.5rem; border-left: 3px solid rgb(var(--color-accent)); }
  .evidence-context > p:last-child { margin-top: .65rem; color: rgb(var(--text)); font-size: .94rem; line-height: 1.7; }
  .integrity-correction-notice { display: grid; grid-template-columns: minmax(15rem, .65fr) minmax(0, 1fr) auto; gap: 1.25rem; align-items: center; margin-top: 1.5rem; padding: 1.1rem 1.25rem; border: 1px solid rgb(var(--color-teal) / .38); border-left: 3px solid rgb(var(--color-teal)); background: rgb(var(--color-teal) / .045); }
