---
import { existsSync, readdirSync } from 'node:fs';
import { resolve } from 'node:path';
import HomePage from '../index.astro';
import AboutPage from '../about.astro';
import CopyrightPage from '../copyright.astro';
import DownloadsPage from '../downloads/index.astro';
import CountryDetailPage from '../countries/[country]/index.astro';
import DiseaseDetailPage from '../diseases/[disease].astro';
import CountryDiseasePage from '../countries/[country]/diseases/[disease].astro';
import ReportArchivePage from '../countries/[country]/reports/index.astro';
import ReportDetailPage from '../countries/[country]/reports/[id].astro';
import ReportDiseasePage from '../countries/[country]/reports/[id]/[disease].astro';
import ResearchDiseasePage from '../research/diseases/[slug].astro';
import ResearchCountryPage from '../research/countries/[code].astro';
import ResearchTopicPage from '../research/topics/[topic].astro';
import ResearchWeeklyPage from '../research/weekly/[week].astro';
import ResearchPreprintsPage from '../research/preprints/index.astro';
import ResearchArticlePage from '../research/articles/[slug].astro';
import ResearchIndexPage from '../research/index.astro';
import ResearchAskPage from '../research/ask.astro';
import ResearchGraphPage from '../research/graph.astro';
import ResearchIntegrityPage from '../research/integrity/index.astro';
import SituationIndexPage from '../situation/index.astro';
import SituationMethodologyPage from '../situation/methodology.astro';
import SituationWeeklyArchivePage from '../situation/weekly/index.astro';
import SituationMonthlyArchivePage from '../situation/monthly/index.astro';
import SituationWeeklyPeriodPage from '../situation/weekly/[period].astro';
import SituationMonthlyPeriodPage from '../situation/monthly/[period].astro';
import CountriesIndexPage from '../countries/index.astro';
import DiseasesIndexPage from '../diseases/index.astro';
import SubscribePage from '../subscribe.astro';
import ChangelogPage from '../changelog.astro';
import TermsPage from '../terms.astro';
import {
  countryDiseaseCandidates,
  indexableDiseases,
  publishableReports,
  siteMeta,
} from '../../lib/seo-page-data';
import { toSeoSlug } from '../../lib/seo';
import researchRaw from '../../data/research/index.json';

type ZhPage = { path?: string; kind: string; code?: string; slug?: string; id?: string };
// Astro exposes route-only modules with `never` props when their path list is data-derived.
// Runtime props remain supported when the route module is reused by the locale dispatcher.
const CountryDetail = CountryDetailPage as any;
const CountryDiseaseDetail = CountryDiseasePage as any;
const ReportArchive = ReportArchivePage as any;
const ReportDetail = ReportDetailPage as any;
const ReportDiseaseDetail = ReportDiseasePage as any;
const ResearchDisease = ResearchDiseasePage as any;
const ResearchCountry = ResearchCountryPage as any;
const ResearchTopic = ResearchTopicPage as any;
const ResearchWeekly = ResearchWeeklyPage as any;
const ResearchArticle = ResearchArticlePage as any;
const SituationWeeklyPeriod = SituationWeeklyPeriodPage as any;
const SituationMonthlyPeriod = SituationMonthlyPeriodPage as any;

export function getStaticPaths() {
  const publicSnapshotExists = existsSync(resolve('./src/data/situation/v3/latest.json'));
  const situationPaths = publicSnapshotExists
    ? [
        ['weekly', /^\d{4}-W\d{2}\.json$/],
        ['monthly', /^\d{4}-\d{2}\.json$/],
      ].flatMap(([directoryName, pattern]) => {
        const directory = resolve(`./src/data/situation/v3/${directoryName}`);
        return existsSync(directory)
          ? readdirSync(directory)
            .filter(name => (pattern as RegExp).test(name))
            .map(name => ({ path: `situation/${directoryName}/${name.replace(/\.json$/, '')}`, kind: 'situation', slug: name.replace(/\.json$/, '') }))
          : [];
      })
    : [];
  const pages: ZhPage[] = [
    { kind: 'static' },
    ...['about', 'changelog', 'subscribe', 'terms', 'copyright', 'countries', 'diseases', 'downloads'].map(path => ({ path, kind: 'static' })),
    ...indexableDiseases().map(disease => ({ path: `diseases/${toSeoSlug(disease.slug)}`, kind: 'disease', id: String(disease.disease_id) })),
    ...(siteMeta.countries ?? [])
      .filter((country: any) => country.data_available || Number(country.record_count ?? 0) > 0)
      .map((country: any) => ({ path: `countries/${String(country.code).toLowerCase()}`, kind: 'country', code: String(country.code).toLowerCase() })),
    ...publishableReports().flatMap(report => [
      { path: `countries/${report.country}/reports`, kind: 'report-archive', code: report.country },
      { path: `countries/${report.country}/reports/${report.id}`, kind: 'report', code: report.country, id: report.id },
      ...report.diseaseSlugs.map(slug => ({ path: `countries/${report.country}/reports/${report.id}/${toSeoSlug(slug)}`, kind: 'report-disease', code: report.country, id: report.id, slug: toSeoSlug(slug) })),
    ]),
    ...countryDiseaseCandidates().map(item => ({ path: `countries/${item.code}/diseases/${item.slug}`, kind: 'country-disease', code: item.code, slug: item.slug })),
    { path: 'situation', kind: 'situation' },
    ...(publicSnapshotExists ? [
      { path: 'situation/weekly', kind: 'situation', slug: 'weekly' },
      { path: 'situation/monthly', kind: 'situation', slug: 'monthly' },
    ] : []),
    ...(publicSnapshotExists ? [{ path: 'situation/methodology', kind: 'situation-methodology' }] : []),
    ...situationPaths,
    { path: 'research', kind: 'research-index' },
    ...['ask', 'graph', 'integrity', 'preprints'].map(slug => ({ path: `research/${slug}`, kind: 'research-collection', slug })),
    ...[...((researchRaw as any).articles ?? []), ...((researchRaw as any).preprints ?? [])]
      .filter((article: any) => article.indexable !== false && article.slug)
      .map((article: any) => ({ path: `research/articles/${article.slug}`, kind: 'research-article', slug: article.slug })),
    ...((researchRaw as any).facets?.diseases ?? []).filter((item: any) => item.slug).map((item: any) => ({ path: `research/diseases/${item.slug}`, kind: 'research-facet', slug: item.slug })),
    ...((researchRaw as any).facets?.countries ?? []).map((item: any) => item.slug ?? item.code).filter(Boolean).map((slug: string) => ({ path: `research/countries/${String(slug).toLowerCase()}`, kind: 'research-facet', slug: String(slug).toLowerCase() })),
    ...((researchRaw as any).facets?.topics ?? []).filter((item: any) => item.slug).map((item: any) => ({ path: `research/topics/${item.slug}`, kind: 'research-facet', slug: item.slug })),
    ...((researchRaw as any).facets?.weeks ?? []).filter((item: any) => /^\d{4}-W\d{2}$/.test(item.week)).map((item: any) => ({ path: `research/weekly/${item.week}`, kind: 'research-weekly', slug: item.week })),
  ];
  return pages.map(({ path, ...props }) => ({ params: { path }, props }));
}

const page = Astro.props as ZhPage;
const pathParts = String(Astro.params.path ?? '').split('/').filter(Boolean);
---

{page.kind === 'country' ? (
  <CountryDetail countryCode={page.code ?? ''} locale="zh" />
) : page.kind === 'disease' ? (
  <DiseaseDetailPage diseaseSlug={pathParts[1]} diseaseId={page.id ?? ''} locale="zh" />
) : page.kind === 'country-disease' ? (
  <CountryDiseaseDetail countryCode={page.code ?? ''} diseaseSlug={page.slug ?? ''} locale="zh" />
) : page.kind === 'report-archive' ? (
  <ReportArchive countryCode={page.code ?? ''} locale="zh" />
) : page.kind === 'report' ? (
  <ReportDetail countryCode={page.code ?? ''} reportId={page.id ?? ''} locale="zh" />
) : page.kind === 'report-disease' ? (
  <ReportDiseaseDetail countryCode={page.code ?? ''} reportId={page.id ?? ''} diseaseSlug={page.slug ?? ''} locale="zh" />
) : page.kind === 'research-facet' && pathParts[1] === 'diseases' ? (
  <ResearchDisease diseaseSlug={page.slug ?? ''} locale="zh" />
) : page.kind === 'research-facet' && pathParts[1] === 'countries' ? (
  <ResearchCountry code={page.slug ?? ''} locale="zh" />
) : page.kind === 'research-facet' && pathParts[1] === 'topics' ? (
  <ResearchTopic topic={page.slug ?? ''} locale="zh" />
) : page.kind === 'research-weekly' ? (
  <ResearchWeekly week={page.slug ?? ''} locale="zh" />
) : page.kind === 'research-collection' && page.slug === 'preprints' ? (
  <ResearchPreprintsPage locale="zh" />
) : page.kind === 'research-article' ? (
  <ResearchArticle articleSlug={page.slug ?? ''} locale="zh" />
) : page.kind === 'research-index' ? (
  <ResearchIndexPage locale="zh" />
) : page.kind === 'research-collection' && page.slug === 'ask' ? (
  <ResearchAskPage locale="zh" />
) : page.kind === 'research-collection' && page.slug === 'graph' ? (
  <ResearchGraphPage locale="zh" />
) : page.kind === 'research-collection' && page.slug === 'integrity' ? (
  <ResearchIntegrityPage locale="zh" />
) : page.kind === 'situation' && pathParts.length === 1 ? (
  <SituationIndexPage locale="zh" />
) : page.kind === 'situation' && page.slug === 'weekly' ? (
  <SituationWeeklyArchivePage locale="zh" />
) : page.kind === 'situation' && page.slug === 'monthly' ? (
  <SituationMonthlyArchivePage locale="zh" />
) : page.kind === 'situation' && pathParts[1] === 'weekly' && pathParts.length === 3 ? (
  <SituationWeeklyPeriod reportPeriod={page.slug ?? ''} locale="zh" />
) : page.kind === 'situation' && pathParts[1] === 'monthly' && pathParts.length === 3 ? (
  <SituationMonthlyPeriod reportPeriod={page.slug ?? ''} locale="zh" />
) : page.kind === 'situation-methodology' ? (
  <SituationMethodologyPage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'countries' ? (
  <CountriesIndexPage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'diseases' ? (
  <DiseasesIndexPage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'subscribe' ? (
  <SubscribePage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'changelog' ? (
  <ChangelogPage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'terms' ? (
  <TermsPage locale="zh" />
) : page.kind === 'static' && !Astro.params.path ? (
  <HomePage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'about' ? (
  <AboutPage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'copyright' ? (
  <CopyrightPage locale="zh" />
) : page.kind === 'static' && Astro.params.path === 'downloads' ? (
  <DownloadsPage locale="zh" />
) : (
  null
)}
