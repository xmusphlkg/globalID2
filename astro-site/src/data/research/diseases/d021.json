            "publication_gate": "human-review-required"
          }
        },
        "zh": {
          "research_question": "该研究旨在系统对比不同国家针对旅行者使用Qdenga（TAK-003）疫苗的官方指导原则，并剖析各国咨询机构在推荐标准上的异同。",
          "study_design": "本研究采用横向比较设计，整合问卷调查结果与公开指南的结构化审查，对多国发布的旅行者疫苗接种建议进行政策比对。",
          "population_setting": "研究覆盖来自17个国家的18个公共卫生咨询机构，重点聚焦具有或无实验室确诊既往登革热感染史的旅行者群体。",
          "main_findings": "各国指导原则整体较监管授权更为保守。针对已确诊既往感染的旅行者，各机构推荐高度一致；但未明确感染史人群的推荐分歧较大。决策过程中对旅行时长、重复暴露及宿主因素的应用方式不一，部分机构仅限既往感染者接种，另一些则依据暴露风险放宽条件或强制要求出行前完成全程免疫。",
          "public_health_relevance": "研究凸显了跨国疫苗政策碎片化现状，强调在标准不一时应优先保障决策透明度并推行医患共同决策。同时指出需积累阴性旅行者及老年群体的有效性与安全性数据，以推动未来指南趋同。",
          "limitations": "现有资料存在数据空白，且临床试验受试者特征与实际旅行者群体存在差异。研究主要基于公开文本与问卷反馈，未能直接验证实际接种后的临床转归，各机构对证据不确定性的管理策略差异可能限制结论的广泛适用性。",
          "gids_interpretation": "该文献为公共卫生监测网络提供了关于登革热疫苗跨境政策协调性的背景参考。其内容有助于梳理各国在共享科学证据基础上形成差异化建议的内在逻辑，可为后续指南动态调整与资源配置提供结构化信息支撑。",
