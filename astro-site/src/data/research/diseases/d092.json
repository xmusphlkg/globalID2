      "summary": {
        "en": {
          "research_question": "What are the primary transmission routes and attributable sources for sporadic campylobacteriosis and salmonellosis across European populations?",
          "study_design": "A Bayesian meta-analytical framework was utilized to combine population attributable fractions extracted from multiple European case-control investigations spanning two decades.",
          "population_setting": "Participants comprised individuals diagnosed with sporadic infections alongside matched controls recruited from Western and Northern European healthcare settings.",
          "main_findings": "Dietary and aquatic exposures accounted for nearly fifty percent of infections, with poultry products representing the dominant reservoir for Campylobacter and both poultry and pork contributing substantially to Salmonella cases. Incorporating direct animal interactions raised the zoonotic contribution to approximately sixty percent, while environmental factors explained roughly ten percent. The remaining portion of cases correlated with international travel, preexisting medical conditions, pharmaceutical interventions, interpersonal contact, and workplace activities.",
          "public_health_relevance": "Identifying dominant reservoirs and exposure routes supports targeted prevention strategies and resource allocation for enteric pathogen control across European health systems.",
          "limitations": "The synthesis relies exclusively on aggregated data from previously published case-control investigations, which may introduce variability in how exposure categories were defined and reported across different regions.",
          "gids_interpretation": "This publication offers a synthesized overview of historical attribution patterns for two major bacterial enteritides, serving as a reference point for transmission ecology rather than reflecting active outbreak detection or real-time epidemiological tracking.",
          "provenance": {
            "generated_by": "literature-evidence-agent",
            "model": "qwen3.7-flash",
