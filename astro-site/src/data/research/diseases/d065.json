      "summary": {
        "en": {
          "research_question": "What epidemiological, behavioral, and immunological factors influenced the reduction of mpox infections in Belgium during 2022?",
          "study_design": "Researchers combined national surveillance records, a prospective clinical registry, a survey of HIV pre-exposure prophylaxis recipients, and serial antibody testing across four 2022 intervals to assess changing trends.",
          "population_setting": "The analysis examined Belgian mpox cases alongside a cohort of individuals receiving HIV pre-exposure prophylaxis to evaluate risk profiles and immune status.",
          "main_findings": "Individuals diagnosed later in the period exhibited lower engagement in high-risk sexual activities compared to those identified initially. Antibody levels remained stable prior to vaccine distribution, and surveyed prophylaxis users reported consistent sexual habits. These observations suggest that shifts in immunity or reported conduct do not fully account for the declining case counts.",
          "public_health_relevance": "Documenting how case demographics and risk behaviors evolve during an outbreak assists public health planning by clarifying which factors may or may not drive epidemic resolution.",
          "limitations": "The investigators state that documented shifts in population immunity and self-reported conduct appear inadequate to account for the epidemic's decline. The reliance on registry records and survey responses may also limit comprehensive assessment of broader community transmission patterns.",
          "gids_interpretation": "This article offers historical context regarding mpox trend fluctuations in a European region, detailing how patient characteristics shifted over time. It functions as archival reference material for understanding previous outbreak phases rather than reflecting active monitoring efforts.",
          "provenance": {
            "generated_by": "literature-evidence-agent",
            "model": "qwen3.7-flash",
