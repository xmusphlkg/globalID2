  "summary": {
    "en": {
      "research_question": "What factors influenced the timing and rationale behind declaring an international health emergency during the 2018–2020 DRC Ebola response?",
      "study_design": "A retrospective examination utilizing archival document review and interviews with previous committee participants.",
      "population_setting": "Former members of the World Health Organization Emergency Committee who participated in evaluating the North Kivu and Ituri Ebola crisis.",
      "main_findings": "Internal deliberations prioritized local political conditions, institutional reputation management, and anticipated travel or community restrictions over standardized regulatory thresholds. Decision-making processes remained heavily influenced by established global security paradigms that frame specific outbreaks as transnational threats.",
      "public_health_relevance": "Understanding these procedural influences helps clarify potential gaps between formal guidelines and actual emergency classification practices, which may impact future policy adjustments and institutional trust.",
      "limitations": "Reliance on retrospective self-reported accounts and historical documents may compromise the accuracy of reconstructed decision timelines and internal reasoning.",
      "gids_interpretation": "This work situates international emergency declarations within broader policy and administrative contexts, providing background reference material for tracking how global health alert systems evolve through scholarly and institutional discourse.",
