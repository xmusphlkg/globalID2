---
import {
  currentMetric,
  detectorSummary,
  diseaseHref,
  elevatedSignalCount,
  formatDate,
  formatNumber,
  label,
  placeLine,
  riskScore,
  riskTone,
  rows,
  signalCount,
  sortSignals,
  trendLine,
} from '../utils/situation';

interface Props { snapshot: any; compact?: boolean; }

const { snapshot, compact = false } = Astro.props;
const take = compact ? 2 : 3;
const increasingRows = sortSignals(rows(snapshot?.increasing));
const respiratoryRows = sortSignals(rows(snapshot?.respiratory));
const emergingRows = rows(snapshot?.emerging);
const unusualRows = sortSignals(rows(snapshot?.unusual));
const prioritySignals = sortSignals([...increasingRows, ...unusualRows]).slice(0, 3);
const analyzedSeries = snapshot?.coverage?.analyzed_series_count ?? 0;
const panels = [
  { id: 'increasing', icon: '↗', title: 'Increasing', titleZh: '上升', rows: increasingRows.slice(0, take), kind: 'signal' },
  { id: 'respiratory', icon: '◉', title: 'Respiratory', titleZh: '呼吸道', rows: respiratoryRows.slice(0, take), kind: 'respiratory' },
  { id: 'emerging', icon: '◎', title: 'Emerging', titleZh: '新发事件', rows: emergingRows.slice(0, take), kind: 'event' },
  { id: 'unusual', icon: '!', title: 'Unusual', titleZh: '异常信号', rows: unusualRows.slice(0, take), kind: 'signal' },
].filter(panel => compact || panel.rows.length > 0);
---

<section class:list={['situation-summary', compact && 'situation-summary-compact']} aria-labelledby="situation-summary-title">
  {!snapshot?.public_enabled && (
    <div class="shadow-preview" role="status">
      <strong>Shadow preview</strong>
      <span data-lang-en="Development only; excluded from public navigation, downloads, sitemap, and indexing" data-lang-zh="仅开发环境可见；不进入公开导航、下载、站点地图和搜索索引">Development only; excluded from public navigation, downloads, sitemap, and indexing</span>
    </div>
  )}

  <header class="situation-heading">
    <div class="situation-title">
      <p class="situation-kicker" data-lang-en="Global Infectious Disease Situation" data-lang-zh="全球传染病态势">Global Infectious Disease Situation</p>
      <h2 id="situation-summary-title" data-lang-en="Signals worth attention" data-lang-zh="值得关注的当前信号">Signals worth attention</h2>
      {!compact && snapshot?.narrative?.en && (
        <p class="situation-brief" data-lang-en={snapshot.narrative.en} data-lang-zh={snapshot.narrative.zh}>{snapshot.narrative.en}</p>
      )}
    </div>

    <dl class="situation-meta">
      <div><dt>Data through</dt><dd>{snapshot?.data_through ?? '-'}</dd></div>
      <div><dt>Checked</dt><dd>{formatDate(snapshot?.checked_at)}</dd></div>
      {!compact && <div><dt>Analyzed series</dt><dd>{formatNumber(analyzedSeries, 0)}</dd></div>}
    </dl>
  </header>

  {!compact && (
    <div class="situation-scoreboard" aria-label="Situation snapshot headline counts">
      <dl>
        <div><dt>Review queue</dt><dd>{signalCount(snapshot)}</dd><span data-lang-en="statistical signals" data-lang-zh="统计信号">statistical signals</span></div>
        <div><dt>Elevated</dt><dd>{elevatedSignalCount(snapshot)}</dd><span data-lang-en="high priority" data-lang-zh="高优先级">high priority</span></div>
        <div><dt>Events</dt><dd>{emergingRows.length}</dd><span data-lang-en="official alerts" data-lang-zh="官方事件">official alerts</span></div>
        <div><dt>Coverage</dt><dd>{snapshot?.coverage?.jurisdiction_count ?? 0}</dd><span data-lang-en="jurisdictions" data-lang-zh="辖区">jurisdictions</span></div>
      </dl>
    </div>
  )}

  {!compact && prioritySignals.length > 0 && (
    <section class="priority-board" aria-labelledby="priority-board-title">
      <div class="priority-heading">
        <p data-lang-en="Priority queue" data-lang-zh="优先复核队列">Priority queue</p>
        <h3 id="priority-board-title" data-lang-en="Start with these signals" data-lang-zh="优先查看这些信号">Start with these signals</h3>
      </div>
      <ol>
        {prioritySignals.map((signal: any, index: number) => (
          <li style={`--score:${Math.max(5, Math.min(100, riskScore(signal))).toFixed(1)}%`}>
            <span class="priority-rank">{String(index + 1).padStart(2, '0')}</span>
            <div class="priority-copy">
              <a href={diseaseHref(signal)}>{signal.disease_name}</a>
              <span>{placeLine(signal)} · {trendLine(signal)}</span>
            </div>
            <div class="priority-meter" aria-hidden="true"><span></span></div>
            <span class:list={['risk-chip', riskTone(signal.risk?.level)]}>{label(signal.risk?.level)} · {formatNumber(signal.risk?.score, 1)}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <div class:list={['situation-grid', !compact && 'situation-grid-full']}>
    {panels.map(panel => (
      <article class={`situation-panel situation-panel-${panel.id}`}>
        <h3><span aria-hidden="true">{panel.icon}</span><span data-lang-en={panel.title} data-lang-zh={panel.titleZh}>{panel.title}</span></h3>
        {panel.rows.length ? (
          <ul>
            {panel.rows.map((row: any) => (
              <li>
                {panel.kind === 'event'
                  ? row.source_url
                    ? <a href={row.source_url} target="_blank" rel="noreferrer">{row.disease_name ?? row.title}</a>
                    : <span class="item-title">{row.disease_name ?? row.title}</span>
                  : <a href={diseaseHref(row)}>{row.disease_name}</a>}
                {panel.kind === 'signal' && (
                  <>
                    <span class="situation-place">{placeLine(row)}</span>
                    <div class="signal-values"><strong>{trendLine(row)}</strong><span>{detectorSummary(row).votes ? 'review' : 'watch'}</span></div>
                    <span class:list={['risk', riskTone(row.risk?.level)]}><b>{label(row.risk?.level)}</b>{!compact && ` · ${formatNumber(row.risk?.score, 1)}`}</span>
                  </>
                )}
                {panel.kind === 'respiratory' && (
                  <>
                    <span class="situation-place">{placeLine(row)}</span>
                    <span class="respiratory-value">{currentMetric(row)}</span>
                  </>
                )}
                {panel.kind === 'event' && <span class="situation-place">{row.source} · {row.published_at ?? 'Date unavailable'}{row.geographies?.length ? ` · ${row.geographies.map((place: any) => place.name).join(', ')}` : ''}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="situation-empty" data-lang-en="No item met this section's publication rule." data-lang-zh="本栏暂无达到发布规则的项目。">No item met this section's publication rule.</p>
        )}
      </article>
    ))}
  </div>

  {compact && <a class="situation-link" href="/situation/" data-lang-en="Open Situation Room and methodology →" data-lang-zh="进入态势室并查看方法 →">Open Situation Room and methodology →</a>}
</section>

<style>
  .situation-summary { display: grid; gap: 1.05rem; }
  .situation-summary-compact { border: 1px solid rgb(var(--border)); background: linear-gradient(180deg, rgb(var(--surface) / .96), rgb(var(--surface-raised) / .62)); padding: 1rem; box-shadow: var(--paper-shadow); }
  .shadow-preview { align-items: center; background: rgb(255 247 220); border: 1px solid rgb(218 174 76); color: rgb(113 73 12); display: flex; flex-wrap: wrap; font-size: .69rem; gap: .55rem 1rem; padding: .55rem .7rem; }
  .shadow-preview strong { letter-spacing: .08em; text-transform: uppercase; }
  .situation-heading { align-items: start; border-bottom: 1px solid rgb(var(--border)); display: grid; gap: 1.2rem; grid-template-columns: minmax(0, 1fr) minmax(13rem, auto); padding-bottom: 1rem; }
  .situation-title { max-width: 58rem; }
  .situation-kicker { color: rgb(var(--color-teal)); font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 .35rem; }
  h2 { color: rgb(var(--text-strong)); font-family: 'Source Serif 4', serif; font-size: 1.95rem; letter-spacing: 0; line-height: 1.08; margin: 0; }
  .situation-summary-compact h2 { font-size: 1.45rem; }
  .situation-brief { color: rgb(var(--text-muted)); font-size: .96rem; line-height: 1.65; margin: .75rem 0 0; max-width: 54rem; }
  .situation-meta { display: grid; gap: .45rem; margin: .1rem 0 0; }
  .situation-meta div { border-left: 2px solid rgb(var(--border)); display: grid; gap: .1rem; padding-left: .7rem; }
  .situation-meta dt, .situation-meta dd { margin: 0; }
  .situation-meta dt { color: rgb(var(--text-faint)); font-size: .62rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .situation-meta dd { color: rgb(var(--text-strong)); font-family: 'JetBrains Mono', monospace; font-size: .82rem; }
  .situation-scoreboard { border-bottom: 1px solid rgb(var(--border)); padding-bottom: 1rem; }
  .situation-scoreboard dl { display: grid; gap: .7rem; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; }
  .situation-scoreboard div { background: rgb(var(--surface) / .52); border: 1px solid rgb(var(--border) / .72); min-width: 0; padding: .8rem; }
  .situation-scoreboard dt { color: rgb(var(--text-faint)); font-size: .61rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .situation-scoreboard dd { color: rgb(var(--text-strong)); font-family: 'JetBrains Mono', monospace; font-size: 1.45rem; line-height: 1; margin: .35rem 0 .1rem; }
  .situation-scoreboard span { color: rgb(var(--text-muted)); font-size: .7rem; }
  .priority-board { background: linear-gradient(135deg, rgb(var(--surface) / .86), rgb(var(--color-teal) / .08)); border: 1px solid rgb(var(--border) / .78); display: grid; gap: 1rem; grid-template-columns: minmax(11rem, .34fr) minmax(0, 1fr); padding: 1rem; }
  .priority-heading p { color: rgb(var(--color-accent)); font-size: .64rem; font-weight: 800; letter-spacing: .14em; margin: 0 0 .35rem; text-transform: uppercase; }
  .priority-heading h3 { color: rgb(var(--text-strong)); font-family: 'Source Serif 4', serif; font-size: 1.35rem; letter-spacing: 0; line-height: 1.1; margin: 0; text-transform: none; }
  .priority-board ol { display: grid; gap: .55rem; list-style: none; margin: 0; padding: 0; }
  .priority-board li { align-items: center; background: rgb(var(--surface-raised) / .78); border: 1px solid rgb(var(--border) / .72); display: grid; gap: .8rem; grid-template-columns: 2.2rem minmax(0, 1fr) minmax(5.5rem, .2fr) auto; min-height: 4.5rem; padding: .75rem; }
  .priority-rank { color: rgb(var(--text-faint)); font-family: 'JetBrains Mono', monospace; font-size: .76rem; }
  .priority-copy { display: grid; gap: .18rem; min-width: 0; }
  .priority-copy a { color: rgb(var(--text-strong)); font-size: .95rem; font-weight: 750; line-height: 1.22; overflow-wrap: anywhere; text-decoration: none; }
  .priority-copy a:hover { color: rgb(var(--color-teal)); text-decoration: underline; }
  .priority-copy span { color: rgb(var(--text-muted)); font-size: .72rem; line-height: 1.4; }
  .priority-meter { background: rgb(var(--border) / .42); height: .42rem; overflow: hidden; }
  .priority-meter span { background: linear-gradient(90deg, rgb(var(--color-teal)), rgb(var(--color-accent))); display: block; height: 100%; width: var(--score); }
  .risk-chip { border: 1px solid currentColor; font-family: 'JetBrains Mono', monospace; font-size: .66rem; font-weight: 700; padding: .25rem .45rem; text-transform: capitalize; white-space: nowrap; }
  .situation-grid { display: grid; gap: .85rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .situation-grid-full { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .situation-panel { border: 1px solid rgb(var(--border)); border-top: 3px solid rgb(var(--color-teal)); background: linear-gradient(180deg, rgb(var(--surface-raised) / .86), rgb(var(--surface) / .68)); min-width: 0; padding: .9rem; }
  .situation-panel-increasing { border-top-color: rgb(197 91 52); }
  .situation-panel-unusual { border-top-color: rgb(154 70 76); }
  h3 { align-items: center; color: rgb(var(--text)); display: flex; font-size: .74rem; font-weight: 700; gap: .45rem; letter-spacing: .09em; margin: 0 0 .75rem; text-transform: uppercase; }
  h3 > span:first-child { align-items: center; border: 1px solid currentColor; display: inline-flex; font-family: 'JetBrains Mono', monospace; height: 1.25rem; justify-content: center; width: 1.25rem; }
  ul { display: grid; gap: .8rem; list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid rgb(var(--border)); display: grid; gap: .2rem; min-width: 0; padding-top: .65rem; }
  li:first-child { border-top: 0; padding-top: 0; }
  li > a, .item-title { color: rgb(var(--text-strong)); font-size: .86rem; font-weight: 650; line-height: 1.25; overflow-wrap: anywhere; text-decoration: none; }
  li > a:hover, .situation-link:hover { color: rgb(var(--color-teal)); text-decoration: underline; }
  .situation-place, .respiratory-value { color: rgb(var(--text-faint)); font-size: .69rem; line-height: 1.35; }
  .signal-values { align-items: baseline; display: flex; gap: .55rem; }
  .signal-values strong { color: rgb(10 130 101); font-family: 'JetBrains Mono', monospace; font-size: .72rem; }
  .signal-values span { color: rgb(var(--text-muted)); font-family: 'JetBrains Mono', monospace; font-size: .65rem; }
  .risk { color: rgb(var(--text-faint)); font-size: .64rem; text-transform: capitalize; }
  .risk b { color: currentColor; }
  .risk-elevated { color: rgb(218 96 75); }
  .risk-watch { color: rgb(205 138 38); }
  .risk-low { color: rgb(63 157 126); }
  .risk-unknown { color: rgb(var(--text-faint)); }
  .situation-empty { color: rgb(var(--text-faint)); font-size: .8rem; line-height: 1.5; margin: 0; }
  .situation-link { color: rgb(var(--color-teal)); display: inline-block; font-size: .82rem; font-weight: 700; margin-top: .1rem; text-decoration: none; }
  @media (max-width: 1040px) {
    .priority-board, .situation-heading { grid-template-columns: 1fr; }
    .situation-scoreboard dl, .situation-grid, .situation-grid-full { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    h2 { font-size: 1.65rem; }
    .priority-board li { align-items: start; grid-template-columns: 2rem minmax(0, 1fr); }
    .priority-meter, .risk-chip { grid-column: 2; }
    .situation-scoreboard dl, .situation-grid, .situation-grid-full { grid-template-columns: 1fr; }
  }
</style>
