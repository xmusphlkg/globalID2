---
// src/components/Footer.astro
import BrandLogo from './BrandLogo.astro';
import metaData from '../data/meta.json';
import sitePackage from '../../package.json';

interface Props {
  initialLanguage?: 'en' | 'zh';
}

const { initialLanguage = 'en' } = Astro.props;
const year = new Date().getFullYear();
const siteVersion = sitePackage.version;
const siteUpdatedAt = import.meta.env.PUBLIC_GIDS_BUILT_AT?.trim() || new Date().toISOString();
const databaseLatestAt = metaData?.generated_at;
const formatDate = (value: string | undefined, locale: 'en-US' | 'zh-CN', fallback: string) => {
  const date = value ? new Date(value) : null;
  return date && !Number.isNaN(date.getTime())
    ? date.toLocaleDateString(locale, {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : fallback;
};
const siteUpdatedEn = formatDate(siteUpdatedAt, 'en-US', 'Unknown');
const siteUpdatedZh = formatDate(siteUpdatedAt, 'zh-CN', '未知');
const databaseLatestEn = formatDate(databaseLatestAt, 'en-US', 'Unknown');
const databaseLatestZh = formatDate(databaseLatestAt, 'zh-CN', '未知');

const links = [
  { href: '/situation/', label: 'Situation', labelZh: '全球态势' },
  { href: '/countries/', label: 'Countries', labelZh: '国家/地区' },
  { href: '/diseases/', label: 'Disease Directory', labelZh: '疾病目录' },
  { href: '/downloads/', label: 'Downloads', labelZh: '数据下载' },
  { href: '/research/', label: 'Research Radar', labelZh: '研究雷达' },
  { href: '/about/', label: 'About', labelZh: '关于' },
  { href: '/subscribe/', label: 'Subscribe', labelZh: '订阅' },
  { href: '/copyright/', label: 'Copyright Notice', labelZh: '版权声明' },
  { href: '/terms/', label: 'Terms & Privacy', labelZh: '条款与隐私' },
];
const localizedHref = (href: string) => initialLanguage === 'zh' ? (href === '/' ? '/zh/' : `/zh${href}`) : href;
const maintainer = initialLanguage === 'zh' ? {
  title: '维护者',
  name: '李康国',
  description: '厦门大学公共卫生学院博士研究生，正在寻找实习机会，也希望提前认识合适的博士后团队。',
  availability: '关注流行病学、卫生统计、公共卫生数据系统与健康 AI；可全球远程，或在中国大陆及香港线下工作。',
  learnMore: '了解更多',
  contact: '邮件联系',
} : {
  title: 'Maintainer',
  name: 'Kangguo Li',
  description: 'Doctoral researcher at Xiamen University, looking for internships and hoping to connect early with potential postdoctoral teams.',
  availability: 'Interested in epidemiology, health statistics, public-health data systems, and health AI. Available remotely worldwide or on site in mainland China and Hong Kong.',
  learnMore: 'Learn more',
  contact: 'Email me',
};
---

<footer class="site-footer border-t mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="site-footer-main">
      <!-- Brand -->
      <div class="space-y-4">
        <BrandLogo
          variant="wordmark"
          theme="dark"
          alt="GIDS"
          class="site-footer-logo"
          loading="lazy"
          wordmarkClass="h-11 w-auto max-w-[280px]"
        />
        <p class="site-footer-copy text-sm leading-relaxed">
          {initialLanguage === 'zh'
            ? '全球传染病监测数据，附官方来源链接与数据使用提示。'
            : 'Global infectious disease data with official source links and guidance for interpretation.'}
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h2 class="site-footer-section-title font-semibold text-sm mb-3">
          {initialLanguage === 'zh' ? '导航' : 'Navigate'}
        </h2>
        <ul class="space-y-2">
          {links.map(({ href, label, labelZh }) => (
            <li>
              <a href={localizedHref(href)} class="site-footer-link text-sm transition-colors">
                {initialLanguage === 'zh' ? labelZh : label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Data info -->
      <div>
        <h2 class="site-footer-section-title font-semibold text-sm mb-3">
          {initialLanguage === 'zh' ? '数据' : 'Data'}
        </h2>
        <ul class="site-footer-meta space-y-1.5 text-sm">
          <li>
            <span>
              {initialLanguage === 'zh' ? '网站更新' : 'Website updated'}
            </span>:
            {' '}
            <span class="site-footer-meta-value">
              {initialLanguage === 'zh' ? siteUpdatedZh : siteUpdatedEn}
            </span>
          </li>
          <li>
            <span>
              {initialLanguage === 'zh' ? '数据库最新日期' : 'Latest database date'}
            </span>:
            {' '}
            <span class="site-footer-meta-value">
              {initialLanguage === 'zh' ? databaseLatestZh : databaseLatestEn}
            </span>
          </li>
          <li><a class="site-footer-link" href={localizedHref('/about/')}>{initialLanguage === 'zh' ? '数据来源与方法' : 'Sources and methods'}</a></li>
          <li><a class="site-footer-link" href={localizedHref('/copyright/')}>{initialLanguage === 'zh' ? '版权与许可声明' : 'Copyright and licensing notice'}</a></li>
        </ul>
      </div>

      <!-- Maintainer -->
      <div class="site-footer-maintainer">
        <h2 class="site-footer-section-title font-semibold text-sm mb-3">{maintainer.title}</h2>
        <p class="site-footer-maintainer-name"><span aria-hidden="true"></span>{maintainer.name}</p>
        <p>{maintainer.description}</p>
        <p>{maintainer.availability}</p>
        <div class="site-footer-maintainer-links">
          <a class="site-footer-link" href={`${localizedHref('/about/')}#maintainer`}>{maintainer.learnMore}</a>
          <a class="site-footer-link" href="mailto:lkg1116@outlook.com">{maintainer.contact}<span aria-hidden="true"> ↗</span></a>
        </div>
      </div>
    </div>

    <div class="site-footer-divider border-t mt-10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="site-footer-legal text-xs">
        <span>© {year} GIDS</span>
        <span aria-hidden="true"> · </span>
        <a class="site-footer-link" href={localizedHref('/copyright/')}>{initialLanguage === 'zh' ? '版权声明' : 'Copyright notice'}</a>
        <span aria-hidden="true"> · </span>
        <a
          class="site-footer-link"
          href={localizedHref('/changelog/')}
        >v{siteVersion} · {initialLanguage === 'zh' ? '更新记录' : 'Changelog'}</a>
      </p>
      <p class="site-footer-legal-note text-xs">
        {initialLanguage === 'zh'
          ? '数据仅供信息参考，请以官方卫生机构发布为准。'
          : 'Data provided for informational purposes only. Always refer to official health authorities.'}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer-main {
    display: grid;
    grid-template-columns: 1.25fr .75fr 1fr 1.15fr;
    gap: clamp(2rem, 4vw, 4.5rem);
  }
  .site-footer-maintainer {
    padding-left: 1.25rem;
    border-left: 1px solid rgb(255 255 255 / .1);
  }
  .site-footer-maintainer-name {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin: 0;
    color: rgb(235 241 247);
    font-size: .84rem;
    font-weight: 700;
  }
  .site-footer-maintainer-name span {
    width: .42rem;
    height: .42rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgb(83 198 187);
    box-shadow: 0 0 0 4px rgb(83 198 187 / .08);
  }
  .site-footer-maintainer > p:not(.site-footer-maintainer-name) {
    margin: .55rem 0 0;
    color: rgb(160 177 195);
    font-size: .72rem;
    line-height: 1.6;
  }
  .site-footer-maintainer-links {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem .9rem;
    margin-top: .9rem;
  }
  .site-footer-maintainer-links a {
    color: rgb(145 224 214);
    font-size: .72rem;
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .site-footer-maintainer-links a:hover {
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .site-footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer-maintainer { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 600px) {
    .site-footer-main { grid-template-columns: 1fr; }
    .site-footer-maintainer { padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / .1); }
  }
</style>
