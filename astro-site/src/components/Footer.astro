---
// src/components/Footer.astro
import BrandLogo from './BrandLogo.astro';
import metaData from '../data/meta.json';

interface Props {
  initialLanguage?: 'en' | 'zh';
}

const { initialLanguage = 'en' } = Astro.props;
const year = new Date().getFullYear();
const dataVersion = metaData?.generated_at
  ? new Date(metaData.generated_at).toLocaleDateString(initialLanguage === 'zh' ? 'zh-CN' : 'en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'Unknown';

const links = [
  { href: '/', label: 'Home', labelZh: '首页' },
  { href: '/countries/', label: 'Countries', labelZh: '国家/地区' },
  { href: '/diseases/', label: 'Disease Directory', labelZh: '疾病目录' },
  { href: '/changelog/', label: 'Changelog', labelZh: '版本更新' },
  { href: '/about/', label: 'About', labelZh: '关于' },
  { href: '/subscribe/', label: 'Subscribe', labelZh: '订阅' },
  { href: '/terms/', label: 'Service Terms', labelZh: '服务条款' },
];
---

<footer class="site-footer border-t mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div class="space-y-4">
        <BrandLogo
          variant="wordmark"
          theme="dark"
          alt="GIDS"
          wordmarkClass="h-11 w-auto max-w-[280px]"
        />
        <p class="site-footer-copy text-sm leading-relaxed">
          {initialLanguage === 'zh'
            ? '全球传染病监测数据，附官方来源链接与数据使用提示。'
            : 'Global infectious disease data with official source links and guidance for interpretation.'}
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="site-footer-section-title font-semibold text-sm mb-3">
          {initialLanguage === 'zh' ? '导航' : 'Navigate'}
        </h3>
        <ul class="space-y-2">
          {links.map(({ href, label, labelZh }) => (
            <li>
              <a href={href} class="site-footer-link text-sm transition-colors" data-lang-en={label} data-lang-zh={labelZh}>
                {initialLanguage === 'zh' ? labelZh : label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Data info -->
      <div>
        <h3 class="site-footer-section-title font-semibold text-sm mb-3">
          {initialLanguage === 'zh' ? '数据' : 'Data'}
        </h3>
        <ul class="site-footer-meta space-y-1.5 text-sm">
          <li>{initialLanguage === 'zh' ? '数据更新' : 'Data updated'}: <span class="site-footer-meta-value">{dataVersion}</span></li>
          <li><a class="site-footer-link" href="/about/">{initialLanguage === 'zh' ? '数据来源与方法' : 'Sources and methods'}</a></li>
          <li><a class="site-footer-link" href="/terms/">{initialLanguage === 'zh' ? '数据使用提示' : 'Data-use guidance'}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer-divider border-t mt-10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="site-footer-legal text-xs">
        {initialLanguage === 'zh'
          ? `© ${year} GIDS。数据更新于 ${dataVersion}。`
          : `© ${year} GIDS. Data updated ${dataVersion}.`}
      </p>
      <p class="site-footer-legal-note text-xs">
        {initialLanguage === 'zh'
          ? '数据仅供信息参考，请以官方卫生机构发布为准。'
          : 'Data provided for informational purposes only. Always refer to official health authorities.'}
      </p>
    </div>
  </div>
</footer>
