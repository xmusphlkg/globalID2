---
// src/components/Footer.astro
import BrandLogo from './BrandLogo.astro';
import metaData from '../data/meta.json';
import sitePackage from '../../package.json';

const year = new Date().getFullYear();
const siteVersion = sitePackage?.version ? `v${sitePackage.version}` : 'Unknown';
const dataVersion = metaData?.generated_at
  ? new Date(metaData.generated_at).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'Unknown';
---

<footer class="site-footer border-t mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div class="space-y-4">
        <BrandLogo
          variant="wordmark"
          theme="dark"
          alt="GIDS"
          wordmarkClass="h-11 w-auto max-w-[280px]"
        />
        <p class="site-footer-copy text-sm leading-relaxed">
          Global Infectious Disease Surveillance.
          Data sourced from official public health authorities.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="site-footer-section-title font-semibold text-sm mb-3">Navigate</h3>
        <ul class="space-y-2">
          {[
            { href: '/', label: 'Home' },
            { href: '/countries/', label: 'Countries' },
            { href: '/diseases/', label: 'Disease Directory' },
            { href: '/about/', label: 'About' },
            { href: '/subscribe/', label: 'Subscribe' },
            { href: '/terms/', label: 'Service Terms' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="site-footer-link text-sm transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Data info -->
      <div>
        <h3 class="site-footer-section-title font-semibold text-sm mb-3">Data</h3>
        <ul class="site-footer-meta space-y-1.5 text-sm">
          <li>Site version: <span class="site-footer-meta-value">{siteVersion}</span></li>
          <li>Countries: <span class="site-footer-meta-value">{metaData?.total_countries ?? '—'}</span></li>
          <li>Diseases tracked: <span class="site-footer-meta-value">{metaData?.total_diseases ?? '—'}</span></li>
          <li>Reports generated: <span class="site-footer-meta-value">{metaData?.total_reports ?? '—'}</span></li>
          <li>Data version: <span class="site-footer-meta-value">{dataVersion}</span></li>
        </ul>
      </div>
    </div>

    <div class="site-footer-divider border-t mt-10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="site-footer-legal text-xs">
        © {year} GIDS. Site {siteVersion}. Generated automatically by the GIDS pipeline.
      </p>
      <p class="site-footer-legal-note text-xs">
        Data provided for informational purposes only. Always refer to official health authorities.
      </p>
    </div>
  </div>
</footer>
