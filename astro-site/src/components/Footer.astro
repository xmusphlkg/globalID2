---
// src/components/Footer.astro
import metaData from '../data/meta.json';

const year = new Date().getFullYear();
const updatedAt = metaData?.generated_at
  ? new Date(metaData.generated_at).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'Unknown';
---

<footer class="site-footer border-t mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-brand-500 to-teal-500 flex items-center justify-center text-white font-bold text-xs">
            G
          </div>
          <span class="text-slate-200 font-semibold">GlobalID</span>
        </div>
        <p class="text-slate-500 text-sm leading-relaxed">
          Automated infectious disease surveillance and reporting system.
          Data sourced from official public health authorities.
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h3 class="text-slate-300 font-semibold text-sm mb-3">Navigate</h3>
        <ul class="space-y-2">
          {[
            { href: '/', label: 'Home' },
            { href: '/countries/', label: 'Countries' },
            { href: '/diseases/', label: 'Disease Directory' },
            { href: '/about/', label: 'About' },
            { href: '/subscribe/', label: 'Subscribe' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-500 hover:text-slate-300 text-sm transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Data info -->
      <div>
        <h3 class="text-slate-300 font-semibold text-sm mb-3">Data</h3>
        <ul class="space-y-1.5 text-sm text-slate-500">
          <li>Countries: <span class="text-slate-400">{metaData?.total_countries ?? '—'}</span></li>
          <li>Diseases tracked: <span class="text-slate-400">{metaData?.total_diseases ?? '—'}</span></li>
          <li>Reports generated: <span class="text-slate-400">{metaData?.total_reports ?? '—'}</span></li>
          <li>Last updated: <span class="text-slate-400">{updatedAt}</span></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-600 text-xs">
        © {year} GlobalID. Generated automatically by the GlobalID V2 Pipeline.
      </p>
      <p class="text-slate-700 text-xs">
        Data provided for informational purposes only. Always refer to official health authorities.
      </p>
    </div>
  </div>
</footer>
