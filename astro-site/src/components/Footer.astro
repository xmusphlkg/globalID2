---
// src/components/Footer.astro
import BrandLogo from './BrandLogo.astro';
import { createTranslator, localizedPath, type Lang } from '../utils/i18n';

interface Props {
  initialLanguage?: Lang;
}

const { initialLanguage = 'en' } = Astro.props;
const year = new Date().getFullYear();
// Independent publications share a stable footer. Release versions belong on
// the changelog page, rather than being frozen into every historical page.
const pendingDate = initialLanguage === 'zh' ? '读取中' : initialLanguage === 'fr' ? 'Chargement' : 'Loading';

const copy = createTranslator(initialLanguage);
const links = [
  { href: '/situation/', label: copy('Situation', '全球态势', 'Situation') },
  { href: '/countries/', label: copy('Countries & Regions', '国家与地区', 'Pays et régions') },
  { href: '/diseases/', label: copy('Disease Directory', '疾病目录', 'Répertoire des maladies') },
  { href: '/reports/', label: copy('Reports', '监测报告', 'Rapports') },
  { href: '/compare/', label: copy('Compare', '数据对比', 'Comparer') },
  { href: '/downloads/', label: copy('Data Downloads', '数据下载', 'Téléchargements') },
  { href: '/research/', label: copy('Research Radar', '研究雷达', 'Radar de recherche') },
  { href: '/about/', label: copy('About & Methods', '关于与方法', 'À propos et méthodes') },
  { href: '/subscribe/', label: copy('Subscribe', '订阅', 'S’abonner') },
  { href: '/copyright/', label: copy('Copyright Notice', '版权声明', 'Droits d’auteur') },
  { href: '/terms/', label: copy('Terms & Privacy', '条款与隐私', 'Conditions et confidentialité') },
];
const localizedHref = (href: string) => localizedPath(href, initialLanguage);
const maintainer = copy({
  title: 'Maintainer',
  name: 'Kangguo Li',
  description: 'Doctoral researcher at Xiamen University, sincerely seeking internships with pharmaceutical or biotechnology companies and research institutes, and long-term roles after graduating in 2027.',
  availability: 'Formal roles, internships, and an initial conversation about a possible collaboration are all genuinely welcome. Available remotely worldwide or on site in mainland China and Hong Kong.',
  learnMore: 'Learn more',
  contact: 'Email me directly',
}, {
  title: '维护者',
  name: '李康国',
  description: '厦门大学公共卫生学院博士研究生，真诚寻求药企、生物医药公司或科研单位的实习机会，并期待 2027 年博士毕业后在这些机构长期工作。',
  availability: '无论是正式岗位、实习名额，还是先交流可能的合作，我都十分欢迎。可全球远程，也可在中国大陆或香港线下工作。',
  learnMore: '了解更多',
  contact: '直接邮件联系我',
}, {
  title: 'Responsable du projet',
  name: 'Kangguo Li',
  description: 'Doctorant à l’Université de Xiamen, je recherche sincèrement un stage dans l’industrie pharmaceutique ou biotechnologique ou dans un organisme de recherche, ainsi qu’un emploi à long terme après mon doctorat en 2027.',
  availability: 'Postes, stages ou simple échange sur une collaboration possible sont tous les bienvenus. Disponible à distance dans le monde entier ou sur site en Chine continentale ou à Hong Kong.',
  learnMore: 'En savoir plus',
  contact: 'M’écrire directement',
});
---

<footer class="site-footer border-t mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="site-footer-main">
      <!-- Brand -->
      <div class="space-y-4">
        <BrandLogo
          variant="wordmark"
          theme="dark"
          alt="GIDS"
          class="site-footer-logo"
          loading="lazy"
          wordmarkClass="site-footer-wordmark"
        />
        <p class="site-footer-copy text-sm leading-relaxed">
          {copy('See the signals. Understand the evidence.', '洞察疫情动态，追溯科学证据。', 'Détecter les signaux. Comprendre les données.')}<br />
          {copy('A global platform for infectious disease surveillance, data and research.', '一个整合全球传染病监测、数据与科学研究的公共卫生信息平台。', 'Une plateforme mondiale de surveillance, de données et de recherche sur les maladies infectieuses.')}
        </p>
      </div>

      <!-- Quick links -->
      <div>
        <h2 class="site-footer-section-title font-semibold text-sm mb-3">
          {copy('Navigate', '导航', 'Navigation')}
        </h2>
        <ul class="space-y-2">
          {links.map(({ href, label }) => (
            <li>
              <a href={localizedHref(href)} class="site-footer-link text-sm transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Data info -->
      <div>
        <h2 class="site-footer-section-title font-semibold text-sm mb-3">
          {copy('Data', '数据', 'Données')}
        </h2>
        <ul class="site-footer-meta space-y-1.5 text-sm">
          <li>
            <span>
              {copy('Website updated', '网站更新', 'Site mis à jour')}
            </span>:
            {' '}
            <span class="site-footer-meta-value" data-site-updated>
              {pendingDate}
            </span>
          </li>
          <li>
            <span>
              {copy('Surveillance updated', '监测更新', 'Surveillance mise à jour')}
            </span>:
            {' '}
            <span class="site-footer-meta-value" data-database-updated>
              {pendingDate}
            </span>
          </li>
          <li>
            <span>
              {copy('Situation updated', '态势更新', 'Situation mise à jour')}
            </span>:
            {' '}
            <span class="site-footer-meta-value" data-situation-updated>
              {pendingDate}
            </span>
          </li>
          <li>
            <span>
              {copy('Research updated', '研究更新', 'Recherche mise à jour')}
            </span>:
            {' '}
            <span class="site-footer-meta-value" data-research-updated>
              {pendingDate}
            </span>
          </li>
          <li><a class="site-footer-link" href={localizedHref('/about/')}>{copy('Sources and methods', '数据来源与方法', 'Sources et méthodes')}</a></li>
          <li><a class="site-footer-link" href={localizedHref('/data-updates/')}>{copy('Data & site updates', '网站与数据更新', 'Mises à jour du site et des données')}</a></li>
          <li><a class="site-footer-link" href={localizedHref('/copyright/')}>{copy('Copyright and licensing notice', '版权与许可声明', 'Avis sur les droits d’auteur et les licences')}</a></li>
        </ul>
      </div>

      <!-- Maintainer -->
      <div class="site-footer-maintainer">
        <h2 class="site-footer-section-title font-semibold text-sm mb-3">{maintainer.title}</h2>
        <p class="site-footer-maintainer-name"><span aria-hidden="true"></span>{maintainer.name}</p>
        <p>{maintainer.description}</p>
        <p>{maintainer.availability}</p>
        <div class="site-footer-maintainer-links">
          <a class="site-footer-link" href={`${localizedHref('/about/')}#maintainer`}>{maintainer.learnMore}</a>
          <a class="site-footer-link" href="mailto:lkg1116@outlook.com">{maintainer.contact}<span aria-hidden="true"> ↗</span></a>
        </div>
      </div>
    </div>

    <div class="site-footer-divider border-t mt-10 pt-8 flex flex-col items-start gap-3">
      <p class="site-footer-legal text-xs">
        <span>© {year} GIDS</span>
        <span aria-hidden="true"> · </span>
        <a class="site-footer-link" href={localizedHref('/copyright/')}>{copy('Copyright notice', '版权声明', 'Avis de droits d’auteur')}</a>
        <span aria-hidden="true"> · </span>
        <a
          class="site-footer-link"
          href={localizedHref('/changelog/')}
        >{copy('Changelog', '更新记录', 'Historique des versions')}</a>
      </p>
      <p class="site-footer-legal-note text-xs">
        {copy('GIDS is an independent public-interest project. Data are provided for informational and research purposes and do not replace official public health guidance. Always consult the relevant health authorities for authoritative information.', 'GIDS 是一个独立的公益性项目。平台数据仅用于信息参考与科研用途，不能替代官方公共卫生指导。如需获取权威信息，请以相关卫生主管部门发布的内容为准。', 'GIDS est un projet indépendant d’intérêt général. Les données sont fournies à des fins d’information et de recherche et ne remplacent pas les recommandations officielles de santé publique. Consultez toujours les autorités sanitaires compétentes pour obtenir des informations faisant autorité.')}
      </p>
    </div>
  </div>
</footer>

<script>
  import { mainSiteBase } from '../lib/papers';
  import { researchPublicationData } from '../lib/research-publication-data';
  import { situationData } from '../lib/situation-data';
  import { surveillanceData } from '../lib/surveillance-data';

  const pageLanguage = document.documentElement.lang;
  const language = pageLanguage.startsWith('zh') ? 'zh-CN' : pageLanguage.startsWith('fr') ? 'fr-FR' : 'en-US';
  const fallback = language === 'zh-CN' ? '未知' : language === 'fr-FR' ? 'Inconnu' : 'Unknown';
  const showDate = (selector: string, value: unknown) => {
    const target = document.querySelector<HTMLElement>(selector);
    if (!target) return;
    const date = typeof value === 'string' ? new Date(value) : null;
    target.textContent = date && Number.isFinite(+date)
      ? new Intl.DateTimeFormat(language, { dateStyle: 'long', timeZone: 'UTC' }).format(date)
      : fallback;
  };
  const showManifestDate = (selector: string, load: Promise<{ generated_at?: string } | null>) => {
    void load.then(manifest => showDate(selector, manifest?.generated_at)).catch(() => showDate(selector, null));
  };
  const loadFooterDates = () => {
    if (import.meta.env.DEV) {
      const target = document.querySelector<HTMLElement>('[data-site-updated]');
      if (target) target.textContent = language === 'zh-CN' ? '本地预览' : language === 'fr-FR' ? 'Aperçu local' : 'Local preview';
    } else {
      void fetch(`${mainSiteBase()}/release.json`, { cache: 'no-store' })
        .then(response => response.ok ? response.json() : null)
        .then(data => showDate('[data-site-updated]', data?.built_at))
        .catch(() => showDate('[data-site-updated]', null));
    }
    showManifestDate('[data-database-updated]', surveillanceData.manifest());
    showManifestDate('[data-situation-updated]', situationData.manifest());
    showManifestDate('[data-research-updated]', researchPublicationData.manifest());
  };
  const footer = document.querySelector('footer.site-footer');
  if (footer && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      if (entries[0]?.isIntersecting) { observer.disconnect(); loadFooterDates(); }
    }, { rootMargin: '200px' });
    observer.observe(footer);
  } else if (footer) { loadFooterDates(); }
</script>

<style>
  .site-footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, .7fr) minmax(20rem, 1.45fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 4vw, 4.5rem);
  }
  :global(.site-footer-wordmark) {
    display: block;
    width: min(10rem, 100%);
    height: auto;
    border-radius: 0;
  }
  .site-footer-maintainer {
    padding-left: 1.25rem;
    border-left: 1px solid rgb(255 255 255 / .1);
  }
  .site-footer-maintainer-name {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin: 0;
    color: rgb(235 241 247);
    font-size: .84rem;
    font-weight: 700;
  }
  .site-footer-maintainer-name span {
    width: .42rem;
    height: .42rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgb(83 198 187);
    box-shadow: 0 0 0 4px rgb(83 198 187 / .08);
  }
  .site-footer-maintainer > p:not(.site-footer-maintainer-name) {
    margin: .55rem 0 0;
    color: rgb(160 177 195);
    font-size: .72rem;
    line-height: 1.6;
  }
  .site-footer-maintainer-links {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem .9rem;
    margin-top: .9rem;
  }
  .site-footer-maintainer-links a {
    color: rgb(145 224 214);
    font-size: .72rem;
    font-weight: 700;
    text-underline-offset: 3px;
  }
  .site-footer-maintainer-links a:hover {
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .site-footer-main { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .site-footer-maintainer { padding-left: 0; border-left: 0; }
  }
  @media (max-width: 600px) {
    .site-footer-main { grid-template-columns: 1fr; }
    .site-footer-maintainer { padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / .1); }
  }
</style>
