---
import ReportLayout from '../layouts/ReportLayout.astro';
import SituationSummary from './SituationSummary.astro';
import SituationDetails from './SituationDetails.astro';
import { buildAlternatePaths, type SeoDocument } from '../lib/seo';
import { formatDate, sourceEvidenceUrls, type SituationReportV3 } from '../utils/situation';

interface Props {
  report: SituationReportV3;
  jsonPath: string;
  canonicalPath: string;
  archivePath: string;
  previousPath?: string;
  nextPath?: string;
  locale?: 'en' | 'zh';
}
const { report, jsonPath, canonicalPath, archivePath, previousPath, nextPath, locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const pick = <T,>(en: T, zhValue: T) => zh ? zhValue : en;
const periodKind = report.report.kind === 'weekly' ? 'Weekly' : 'Monthly';
const title = `${periodKind} Infectious Disease Situation — ${report.report.period_key}`;
const titleZh = `${report.report.kind === 'weekly' ? '周度' : '月度'}传染病态势 — ${report.report.period_key}`;
const description = pick(report.narrative.en, report.narrative.zh);
const siteOrigin = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const structuredData = [{
  '@type': 'Report', '@id': `${new URL(canonicalPath, siteOrigin)}#report`, name: pick(title, titleZh),
  datePublished: report.report.as_of, dateModified: report.report.as_of,
  temporalCoverage: `${report.report.period_start}/${report.report.period_end}`,
  isBasedOn: sourceEvidenceUrls(report),
  mainEntity: {
    '@type': 'Dataset',
    distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: new URL(jsonPath, siteOrigin).toString() }],
  },
}];
const seo: SeoDocument = {
  title: `${pick(title, titleZh)} | GIDS`, description, canonicalPath,
  alternatePaths: buildAlternatePaths(canonicalPath, locale), noindex: !report.public_enabled,
  pageType: 'Report', datePublished: report.report.as_of, dateModified: report.report.as_of,
};
---

<ReportLayout title={pick(title, titleZh)} description={description} initialLanguage={locale} structuredData={structuredData} seo={seo} breadcrumbs={[{ label: pick('Situation Room', '全球态势室'), href: zh ? '/zh/situation/' : '/situation/' }, { label: pick(`${periodKind} reports`, report.report.kind === 'weekly' ? '周报' : '月报'), href: archivePath }, { label: report.report.period_key }]}>
  <main class="period-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <header class="period-header">
      <div><p>{pick(`${periodKind} period report`, report.report.kind === 'weekly' ? '周度期间报告' : '月度期间报告')}</p><h1>{pick(title, titleZh)}</h1><span>{formatDate(report.report.period_start)} – {formatDate(report.report.period_end)} · <i>{pick('revision', '修订版')}</i> {report.report.revision}</span></div>
      <a href={jsonPath} download>{pick('Download JSON', '下载 JSON')}</a>
    </header>
    <nav class="adjacent" aria-label={pick('Adjacent reports', '相邻期间报告')}>
      {previousPath ? <a href={previousPath}>← <span>{pick('Previous period', '上一期间')}</span></a> : <span />}
      <a href={archivePath}>{pick('All period reports', '全部期间报告')}</a>
      {nextPath ? <a href={nextPath}><span>{pick('Next period', '下一期间')}</span> →</a> : <span />}
    </nav>
    <SituationSummary snapshot={report} locale={locale} />
    <SituationDetails snapshot={report} locale={locale} />
    <footer><p>{pick(report.limitations.en, report.limitations.zh)}</p></footer>
  </main>
</ReportLayout>

<style>
  .period-page { display: grid; gap: 2rem; padding-bottom: 4rem; padding-top: 2.5rem; }
  .period-header { align-items: end; border-bottom: 2px solid rgb(var(--text-strong)); display: flex; gap: 1rem; justify-content: space-between; padding-bottom: 1.25rem; }
  .period-header p { color: rgb(var(--color-teal)); font-size: .66rem; font-weight: 800; letter-spacing: .13em; margin: 0 0 .35rem; text-transform: uppercase; }
  h1 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.04; margin: 0; }
  .period-header span { color: rgb(var(--text-faint)); display: block; font-size: .72rem; margin-top: .55rem; }
  .period-header i { font-style: normal; }
  .period-header > a, .adjacent a { border: 1px solid rgb(var(--border)); color: rgb(var(--color-teal)); font-size: .72rem; font-weight: 750; padding: .45rem .65rem; text-decoration: none; white-space: nowrap; }
  .adjacent { display: grid; grid-template-columns: 1fr auto 1fr; margin-top: -1rem; }
  .adjacent > :last-child { justify-self: end; }
  footer { border-top: 1px solid rgb(var(--border)); color: rgb(var(--text-faint)); font-size: .7rem; line-height: 1.55; padding-top: 1rem; }
  footer p { margin: 0 0 .4rem; }
  @media (max-width: 640px) { .period-header { align-items: start; display: grid; } .adjacent { gap: .5rem; grid-template-columns: 1fr 1fr; } .adjacent > :nth-child(2) { display: none; } }
</style>
