---
import { hasCountryDataSnapshot } from '../lib/country-coverage';
import metaRaw from '../data/meta.json';
import { formatDate } from '../utils/situation';
import { toSeoSlug } from '../lib/seo';
import {
  groupNoticesByWeek,
  noticeEntityName,
  noticeSummary,
  noticeTitle,
  type InternationalLatest,
  type InternationalNotice,
} from '../utils/international';
import { translateUi } from '../utils/i18n';

interface Props { latest: InternationalLatest; locale?: 'en' | 'zh' | 'fr'; limit?: number; }
const { latest, locale = 'en', limit = 12 } = Astro.props as Props;
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;

const notices: InternationalNotice[] = (latest.recent ?? []).slice(0, limit);
const weeks = groupNoticesByWeek(notices);
const windowStart = latest.window?.since_date ?? null;
const windowEnd = latest.window?.as_of ?? null;
// A notice may name any country, but the site only publishes a country page for
// jurisdictions that already carry a surveillance snapshot.
const linkedCountries = new Set(
  ((metaRaw as any).countries ?? [])
    .filter((country: any) => hasCountryDataSnapshot(country))
    .map((country: any) => String(country.code ?? '').toUpperCase()),
);

function diseaseHref(notice: InternationalNotice, index: number): string | null {
  const row = (notice.diseases ?? [])[index];
  return row?.slug ? `${prefix}/diseases/${toSeoSlug(row.slug)}/` : null;
}
function countryHref(code: string | null | undefined): string | null {
  const normalized = String(code ?? '').toUpperCase();
  return normalized && linkedCountries.has(normalized) ? `${prefix}/countries/${normalized.toLowerCase()}/` : null;
}
---

<section class="intl-notices" aria-labelledby="intl-notices-heading">
  <header class="intl-head">
    <div>
      <p class="eyebrow">{pick('Official cross-border notices', '官方跨境通报', 'Notifications officielles transfrontalières')}</p>
      <h2 id="intl-notices-heading">{pick('Recent international authority notices', '近期国际权威机构通报', 'Notifications récentes des autorités internationales')}</h2>
      <p class="intl-lede">{pick('Every notice below is published by the responsible authority. GIDS normalizes each record onto its own disease, ISO country, and date keys and links back to the original; where redistribution terms are unconfirmed only metadata is carried.', '以下每条通报均由责任机构发布。GIDS 将其规范化到本站的疾病、ISO 国家/地区与日期键，并回链原文；再分发条款尚未确认的来源仅收录元数据。', 'Chaque notification ci-dessous est publiée par l’autorité responsable. GIDS normalise chaque enregistrement selon ses propres clés de maladie, de pays ISO et de date, et renvoie vers l’original ; lorsque les conditions de redistribution ne sont pas confirmées, seules les métadonnées sont reprises.')}</p>
    </div>
    <dl class="intl-window">
      <div><dt>{pick('Window', '时间窗口', 'Fenêtre')}</dt><dd>{windowStart && windowEnd ? `${formatDate(windowStart, locale)} – ${formatDate(windowEnd, locale)}` : '—'}</dd></div>
      <div><dt>{pick('Notices', '通报数', 'Notifications')}</dt><dd>{latest.event_count ?? notices.length}</dd></div>
      <div><dt>{pick('Updated', '更新于', 'Mis à jour')}</dt><dd>{formatDate(latest.generated_at, locale)}</dd></div>
    </dl>
  </header>

  {notices.length === 0 ? (
    <p class="intl-empty">{pick('No authority notices are available for this window.', '该时间窗口内暂无机构通报。', 'Aucune notification d’autorité n’est disponible pour cette fenêtre.')}</p>
  ) : (
    <div class="intl-weeks">
      {weeks.map((week) => (
        <article class="intl-week">
          <p class="week-label">
            <span>{week.iso_week_key === 'undated' ? pick('Undated', '无日期', 'Sans date') : week.iso_week_key}</span>
            <small>{week.notices.length} {pick('notices', '条通报', 'notifications')}</small>
          </p>
          <ul class="notice-list">
            {week.notices.map((notice) => (
              <li class="notice">
                <a class="notice-title" href={notice.url} target="_blank" rel="noopener noreferrer">{noticeTitle(notice, locale)}</a>
                <p class="notice-meta">
                  <time datetime={notice.published_date ?? undefined}>{formatDate(notice.published_date, locale)}</time>
                  <span>{pick('Source', '来源', 'Source')}: {zh ? notice.source_label_zh || notice.source_label_en : notice.source_label_en}</span>
                </p>
                {noticeSummary(notice, locale) && <p class="notice-summary">{noticeSummary(notice, locale)}</p>}
                {((notice.diseases ?? []).length > 0 || (notice.countries ?? []).length > 0) && (
                  <ul class="notice-chips">
                    {(notice.diseases ?? []).map((row, index) => {
                      const href = diseaseHref(notice, index);
                      return <li>{href ? <a href={href}>{noticeEntityName(row, locale)}</a> : <span>{noticeEntityName(row, locale)}</span>}</li>;
                    })}
                    {(notice.countries ?? []).map((row) => {
                      const href = countryHref(row.code);
                      return <li class="chip-country">{href ? <a href={href}>{noticeEntityName(row, locale)}</a> : <span>{noticeEntityName(row, locale)}</span>}</li>;
                    })}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  )}

  <footer class="intl-footer">
    <p class="intl-attribution">{pick('Attribution', '来源署名', 'Attribution')}: {(latest.sources ?? []).map((source, index) => (
      <span>
        {index > 0 && ' · '}
        {source.homepage ? <a href={source.homepage} target="_blank" rel="noopener noreferrer">{zh ? source.label_zh || source.label_en : source.label_en}</a> : <span>{zh ? source.label_zh || source.label_en : source.label_en}</span>}
        {source.status !== 'ok' && <em> ({pick('unavailable this run', '本次未获取', 'indisponible lors de cette exécution')})</em>}
      </span>
    ))}</p>
  </footer>
</section>

<style>
  .intl-notices { background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); display: grid; gap: 1.1rem; padding: clamp(1rem, 2.4vw, 1.6rem); }
  .intl-head { align-items: start; display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.36fr); }
  .eyebrow { color: rgb(var(--color-teal)); font-size: .66rem; font-weight: 800; letter-spacing: .13em; margin: 0 0 .3rem; text-transform: uppercase; }
  h2 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: 1.35rem; line-height: 1.15; margin: 0; }
  .intl-lede { color: rgb(var(--text-muted)); font-size: .82rem; line-height: 1.6; margin: .55rem 0 0; max-width: 46rem; }
  .intl-window { display: grid; gap: .5rem; margin: 0; }
  .intl-window div { border-left: 1px solid rgb(var(--border)); padding-left: .6rem; }
  dt { color: rgb(var(--text-faint)); font-size: .58rem; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
  dd { color: rgb(var(--text-strong)); font-family: ui-monospace, monospace; font-size: .7rem; margin: .15rem 0 0; }
  .intl-empty { color: rgb(var(--text-faint)); font-size: .82rem; margin: 0; }
  .intl-weeks { display: grid; gap: .9rem; }
  .intl-week { border-top: 1px dashed rgb(var(--border)); padding-top: .7rem; }
  .week-label { align-items: baseline; color: rgb(var(--text-strong)); display: flex; font-family: ui-monospace, monospace; font-size: .72rem; gap: .5rem; margin: 0 0 .45rem; }
  .week-label small { color: rgb(var(--text-faint)); font-size: .64rem; }
  .notice-list { display: grid; gap: .55rem; list-style: none; margin: 0; padding: 0; }
  .notice { border-left: 2px solid rgb(var(--color-teal)); padding-left: .7rem; }
  .notice-title { color: rgb(var(--text-strong)); display: block; font-size: .9rem; font-weight: 650; line-height: 1.35; text-decoration: none; }
  .notice-title:hover { color: rgb(var(--color-teal)); text-decoration: underline; }
  .notice-meta { color: rgb(var(--text-faint)); display: flex; flex-wrap: wrap; font-size: .68rem; gap: .45rem; margin: .2rem 0 0; }
  .notice-summary { color: rgb(var(--text-muted)); font-size: .78rem; line-height: 1.55; margin: .35rem 0 0; max-width: 52rem; }
  .notice-chips { display: flex; flex-wrap: wrap; gap: .3rem; list-style: none; margin: .4rem 0 0; padding: 0; }
  .notice-chips li { font-size: .66rem; }
  .notice-chips a, .notice-chips span { border: 1px solid rgb(var(--border)); color: rgb(var(--text-muted)); display: inline-block; padding: .12rem .4rem; text-decoration: none; }
  .notice-chips a:hover { border-color: rgb(var(--color-teal)); color: rgb(var(--color-teal)); }
  .chip-country a, .chip-country span { border-style: dashed; }
  .intl-footer { border-top: 1px solid rgb(var(--border)); padding-top: .7rem; }
  .intl-attribution { color: rgb(var(--text-faint)); font-size: .68rem; margin: 0; }
  .intl-attribution a { color: rgb(var(--color-teal)); }
  @media (max-width: 820px) {
    .intl-head { grid-template-columns: 1fr; }
    .intl-window { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .intl-window { grid-template-columns: 1fr; }
  }
</style>
