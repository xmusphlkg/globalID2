---
// src/components/CountryCard.astro
import CountryFlag from './CountryFlag.astro';

interface Props {
  code: string;
  name: string;
  totalCases?: number;
  totalDeaths?: number;
  diseaseCount?: number;
  dateRange?: { start: string | null; end: string | null };
}

const { code, name, totalCases = 0, totalDeaths = 0, diseaseCount = 0, dateRange } = Astro.props;

function fmtNum(n: number) {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

const href = `/countries/${code.toLowerCase()}/`;
const deathsDisplay = totalDeaths > 0 ? fmtNum(totalDeaths) : '-';
---

<a
  href={href}
  class="card site-card-link p-4 pt-3 block group relative overflow-hidden"
>
  <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-brand-500 via-brand-400 to-transparent opacity-80"></div>
  <div class="flex items-center gap-3 mb-3">
    <CountryFlag code={code} name={name} sizeClass="w-8 h-6" />
    <div class="flex-1 min-w-0">
      <h3 class="text-[rgb(var(--text-strong))] font-semibold text-base truncate group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors">
        {name}
      </h3>
      <span class="text-[rgb(var(--text-faint))] text-[10px] font-mono tracking-[0.12em] uppercase">{code}</span>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-3 border-t border-[rgb(var(--border))/0.68] pt-3">
    <div class="text-center">
      <div class="font-serif text-lg font-semibold tabular-nums text-[rgb(var(--text-strong))]">{fmtNum(totalCases)}</div>
      <div class="mt-0.5 text-[10px] uppercase tracking-wider text-[rgb(var(--text-faint))]" data-lang-en="Cases" data-lang-zh="病例">Cases</div>
    </div>
    <div class="text-center">
      <div class="font-serif text-lg font-semibold tabular-nums text-red-500 dark:text-red-400">{deathsDisplay}</div>
      <div class="mt-0.5 text-[10px] uppercase tracking-wider text-[rgb(var(--text-faint))]" data-lang-en="Deaths" data-lang-zh="死亡">Deaths</div>
    </div>
    <div class="text-center">
      <div class="font-serif text-lg font-semibold tabular-nums text-teal-600 dark:text-teal-400">{diseaseCount}</div>
      <div class="mt-0.5 text-[10px] uppercase tracking-wider text-[rgb(var(--text-faint))]" data-lang-en="Diseases" data-lang-zh="疾病">Diseases</div>
    </div>
  </div>

  {dateRange?.start && (
    <div class="mt-2 pt-2 border-t border-[rgb(var(--border))/0.68] text-xs text-[rgb(var(--text-faint))] tabular-nums">
      {dateRange.start} – {dateRange.end ?? 'Present'}
    </div>
  )}
</a>
