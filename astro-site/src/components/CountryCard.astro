---
// src/components/CountryCard.astro
import CountryFlag from './CountryFlag.astro';

interface Props {
  code: string;
  name: string;
  nameZh?: string;
  totalCases?: number;
  totalDeaths?: number;
  diseaseCount?: number;
  dateRange?: { start: string | null; end: string | null };
  locale?: 'en' | 'zh';
}

const { code, name, nameZh = name, totalCases = 0, totalDeaths = 0, diseaseCount = 0, dateRange, locale = 'en' } = Astro.props;

function fmtNum(n: number) {
  if (n >= 1_000_000) return (n / 1_000_000).toFixed(1) + 'M';
  if (n >= 1_000) return (n / 1_000).toFixed(0) + 'K';
  return n.toLocaleString();
}

const href = `${locale === 'zh' ? '/zh' : ''}/countries/${code.toLowerCase()}/`;
const deathsDisplay = totalDeaths > 0 ? fmtNum(totalDeaths) : '-';
const displayName = locale === 'zh' ? nameZh : name;
const labels = locale === 'zh'
  ? { cases: '病例', deaths: '死亡', diseases: '疾病', present: '至今' }
  : { cases: 'Cases', deaths: 'Deaths', diseases: 'Diseases', present: 'Present' };
---

<a
  href={href}
  class="country-card"
>
  <div class="country-card-heading">
    <CountryFlag code={code} name={name} sizeClass="w-8 h-6" />
    <div>
      <h3>{displayName}</h3>
      <span>{code}</span>
    </div>
  </div>

  <div class="country-card-stats">
    <div>
      <strong>{fmtNum(totalCases)}</strong>
      <span>{labels.cases}</span>
    </div>
    <div>
      <strong>{deathsDisplay}</strong>
      <span>{labels.deaths}</span>
    </div>
    <div>
      <strong>{diseaseCount}</strong>
      <span>{labels.diseases}</span>
    </div>
  </div>

  {dateRange?.start && (
    <p class="country-card-range">{dateRange.start} – {dateRange.end ?? labels.present}</p>
  )}
</a>

<style>
  .country-card { display: grid; gap: .75rem; padding: 1rem; color: rgb(var(--text)); background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); text-decoration: none; transition: border-color .18s ease, background-color .18s ease; }
  .country-card:hover { background: rgb(var(--bg-soft)); border-color: rgb(var(--border-soft)); }
  .country-card-heading { display: flex; align-items: center; gap: .7rem; }
  .country-card-heading > div { min-width: 0; }
  h3 { overflow: hidden; margin: 0; color: rgb(var(--text-strong)); font-size: .9rem; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
  .country-card-heading span { color: rgb(var(--text-faint)); font-family: ui-monospace, monospace; font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; }
  .country-card-stats { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid rgb(var(--border)); }
  .country-card-stats div { display: grid; gap: .12rem; padding: .65rem .5rem 0; border-left: 1px solid rgb(var(--border)); text-align: center; }
  .country-card-stats div:first-child { border-left: 0; }
  .country-card-stats strong { color: rgb(var(--text-strong)); font-size: .92rem; font-variant-numeric: tabular-nums; }
  .country-card-stats span { color: rgb(var(--text-muted)); font-size: .62rem; }
  .country-card-range { margin: 0; padding-top: .55rem; color: rgb(var(--text-faint)); border-top: 1px solid rgb(var(--border)); font-size: .66rem; font-variant-numeric: tabular-nums; }
</style>
