---
// src/components/ReportCard.astro
import CountryFlag from './CountryFlag.astro';

interface Props {
  id: number;
  title: string;
  reportType: string;
  periodStart?: string | null;
  periodEnd?: string | null;
  createdAt?: string | null;
  countryCode?: string;
  countryName?: string;
  qualityScore?: number | null;
}

const {
  id,
  title,
  reportType,
  periodStart,
  periodEnd,
  createdAt,
  countryCode,
  countryName,
  qualityScore,
} = Astro.props;

const href = `/countries/${(countryCode ?? 'cn').toLowerCase()}/reports/${id}/`;

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const typeLabels: Record<string, string> = {
  DAILY: 'Daily', WEEKLY: 'Weekly', MONTHLY: 'Monthly', SPECIAL: 'Special',
};
---

<a
  href={href}
  class="card site-card-link p-4 pt-3 block group relative overflow-hidden"
>
  <div class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-brand-500 via-brand-400 to-transparent opacity-80"></div>
  <div class="flex items-center justify-between gap-3 mb-3">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold tracking-wider uppercase bg-brand-500/10 text-brand-700 dark:text-brand-300 border border-brand-500/20">
        {typeLabels[reportType] ?? reportType}
      </span>
      {countryName && (
        <span class="inline-flex items-center gap-1.5 text-xs text-[rgb(var(--text-muted))]">
          <CountryFlag code={countryCode ?? 'CN'} name={countryName} sizeClass="w-5 h-4" />
          {countryName}
        </span>
      )}
    </div>
  </div>

  <h3 class="text-[rgb(var(--text-strong))] font-semibold text-base mb-2 group-hover:text-brand-700 dark:group-hover:text-brand-400 transition-colors line-clamp-2">
    {title}
  </h3>

  <div class="mt-3 flex items-center justify-between border-t border-[rgb(var(--border))/0.68] pt-3 text-xs text-[rgb(var(--text-faint))]">
    {periodStart && periodEnd && (
      <span class="tabular-nums">
        {formatDate(periodStart)} – {formatDate(periodEnd)}
      </span>
    )}
    {createdAt && (
      <span class="whitespace-nowrap tabular-nums">
        {formatDate(createdAt)}
      </span>
    )}
  </div>
</a>
