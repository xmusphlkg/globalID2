---
// src/components/ReportCard.astro
import CountryFlag from './CountryFlag.astro';

interface Props {
  id: number;
  title: string;
  reportType: string;
  periodStart?: string | null;
  periodEnd?: string | null;
  createdAt?: string | null;
  countryCode?: string;
  countryName?: string;
  qualityScore?: number | null;
}

const {
  id,
  title,
  reportType,
  periodStart,
  periodEnd,
  createdAt,
  countryCode,
  countryName,
  qualityScore,
} = Astro.props;

const href = `/countries/${(countryCode ?? 'cn').toLowerCase()}/reports/${id}/`;

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const scoreColor =
  qualityScore == null ? 'text-slate-600'
    : qualityScore >= 0.85 ? 'text-green-400'
    : qualityScore >= 0.65 ? 'text-amber-400'
    : 'text-red-400';

const typeLabels: Record<string, string> = {
  DAILY: 'Daily', WEEKLY: 'Weekly', MONTHLY: 'Monthly', SPECIAL: 'Special',
};
---

<a
  href={href}
  class="card p-5 hover:border-slate-600 hover:shadow-xl hover:shadow-brand-500/5 transition-all duration-200 block group"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-brand-500/15 text-brand-300 ring-1 ring-brand-500/30">
        {typeLabels[reportType] ?? reportType}
      </span>
      {countryName && (
        <span class="inline-flex items-center gap-1.5 text-xs text-slate-500">
          <CountryFlag code={countryCode ?? 'CN'} name={countryName} sizeClass="w-5 h-4" />
          <span>{countryName}</span>
        </span>
      )}
    </div>
    {qualityScore != null && (
      <span class={`text-xs font-mono font-semibold whitespace-nowrap ${scoreColor}`}>
        QS {(qualityScore * 100).toFixed(0)}%
      </span>
    )}
  </div>

  <h3 class="text-slate-200 font-semibold text-base mb-2 group-hover:text-brand-400 transition-colors line-clamp-2">
    {title}
  </h3>

  <div class="flex items-center gap-4 text-xs text-slate-600 mt-3">
    {periodStart && periodEnd && (
      <span>
        📅 {formatDate(periodStart)} → {formatDate(periodEnd)}
      </span>
    )}
    {createdAt && (
      <span class="ml-auto whitespace-nowrap">
        {formatDate(createdAt)}
      </span>
    )}
  </div>
</a>
