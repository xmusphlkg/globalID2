---
import BaseLayout from '../layouts/BaseLayout.astro';
interface Props { locale?: 'en' | 'zh' | 'fr'; }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const fr = locale === 'fr';
const canonicalPath = zh ? '/zh/search/' : locale === 'fr' ? '/fr/search/' : '/search/';
---
<BaseLayout title={zh ? '全站检索' : locale === 'fr' ? 'Recherche' : 'Search'} description={zh ? '检索 GIDS 的国家、疾病、态势、报告与研究证据。' : locale === 'fr' ? 'Recherchez dans les pays, maladies, rapports et études GIDS.' : 'Search GIDS countries, diseases, situation reports, and research evidence.'} initialLanguage={locale} noindex seo={{ title: zh ? '全站检索 | GIDS' : locale === 'fr' ? 'Recherche | GIDS' : 'Search | GIDS', description: zh ? '检索 GIDS 的公开数据与证据。' : locale === 'fr' ? 'Recherchez dans les données et preuves publiques GIDS.' : 'Search public GIDS data and evidence.', locale, canonicalPath, alternatePaths: { en: '/search/', zh: '/zh/search/', fr: '/fr/search/' }, noindex: true }}>
  <section class="search-page max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <p class="academic-kicker">{zh ? '证据发现' : fr ? 'Découverte des preuves' : 'Evidence discovery'}</p>
    <h1 class="academic-title">{zh ? '检索 GIDS' : fr ? 'Rechercher dans GIDS' : 'Search GIDS'}</h1>
    <p class="academic-lead">{zh ? '跨国家、疾病、态势、监测报告和研究文献查找公开证据。' : fr ? 'Trouvez des preuves publiques parmi les pays, maladies, situations, rapports et publications de recherche.' : 'Find public evidence across countries, diseases, situation intelligence, surveillance reports, and research.'}</p>
    <form class="search-page-form" role="search">
      <label for="search-page-input">{zh ? '搜索词' : fr ? 'Requête' : 'Search query'}</label>
      <div><input id="search-page-input" name="q" type="search" autocomplete="off" minlength="2" placeholder={zh ? '例如：登革热、日本、气候…' : fr ? 'Par exemple : dengue, Japon, vaccination…' : 'For example: dengue, Japan, climate…'} /><button type="submit">{zh ? '搜索' : fr ? 'Rechercher' : 'Search'}</button></div>
    </form>
    <p id="search-page-status" class="search-page-status" role="status" aria-live="polite"></p>
    <div id="search-page-results" class="search-page-results"></div>
  </section>
</BaseLayout>

<script>
  import { normalizeSearchText } from '../lib/disease-search';
  import { searchSiteEntries, searchTitle, searchSummary, type SiteSearchEntry, type SearchLocale } from '../lib/site-search';
  const locale: SearchLocale = document.documentElement.lang.startsWith('zh') ? 'zh' : document.documentElement.lang.startsWith('fr') ? 'fr' : 'en';
  const zh = locale === 'zh';
  const fr = locale === 'fr';
  const form = document.querySelector('.search-page-form');
  const input = document.querySelector<HTMLInputElement>('#search-page-input');
  const status = document.querySelector('#search-page-status');
  const root = document.querySelector('#search-page-results');
  const labels: Record<string, string> = { country: zh ? '国家与地区' : fr ? 'Pays et régions' : 'Countries', disease: zh ? '疾病' : fr ? 'Maladies' : 'Diseases', situation: zh ? '态势' : fr ? 'Situation' : 'Situation', report: zh ? '报告' : fr ? 'Rapports' : 'Reports', research: zh ? '文献' : fr ? 'Recherche' : 'Research', page: zh ? '探索' : fr ? 'Pages' : 'Pages' };
  let entries: SiteSearchEntry[] = [];
  let loaded = false;
  let loading = false;
  function render(queryValue: string) {
    if (!root || !status) return;
    const query = normalizeSearchText(queryValue); root.replaceChildren();
    if (query.length < 2) { status.textContent = zh ? '请输入至少 2 个字符。' : fr ? 'Saisissez au moins 2 caractères.' : 'Enter at least 2 characters.'; return; }
    const results = searchSiteEntries(entries, queryValue, locale, 100);
    status.textContent = zh ? (results.total > results.entries.length ? `找到 ${results.total} 条结果，显示前 ${results.entries.length} 条` : `找到 ${results.total} 条结果`) : fr ? `${results.total} résultat(s)${results.total > 100 ? ' · 100 affichés' : ''}` : `${results.total} results found${results.total > 100 ? ' · showing first 100' : ''}`;
    const groups = new Map<string, SiteSearchEntry[]>();
    for (const entry of results.entries) { const list = groups.get(entry.kind) || []; list.push(entry); groups.set(entry.kind, list); }
    for (const [kind, list] of groups) {
      const section=document.createElement('section'); section.className='search-result-group'; const heading=document.createElement('h2'); heading.textContent=`${labels[kind] || kind} · ${list.length}`; section.append(heading);
      const grid=document.createElement('div'); grid.className='search-result-grid';
      for (const entry of list) { const link=document.createElement('a'); link.className='search-result-card'; link.href=entry.href[locale] || entry.href.en; const title=document.createElement('strong'); title.textContent=searchTitle(entry, locale); const summary=document.createElement('span'); summary.textContent=searchSummary(entry, locale); link.append(title,summary); grid.append(link); }
      section.append(grid); root.append(section);
    }
  }
  async function load() {
    if (loading) return;
    loading = true;
    if (status) status.textContent = zh ? '正在准备搜索…' : fr ? 'Chargement de la recherche…' : 'Loading search…';
    root?.replaceChildren();
    try {
      const response = await fetch('/site-data/search-index.json');
      if (!response.ok) throw new Error('Search index unavailable');
      const payload = await response.json();
      if (!Array.isArray(payload.entries)) throw new Error('Invalid search index');
      entries = payload.entries; loaded = true; render(input?.value || '');
    } catch {
      loaded = false;
      if (status) {
        status.textContent = zh ? '暂时无法加载搜索。' : fr ? 'La recherche est indisponible. ' : 'Search could not load. ';
        const retry=document.createElement('button'); retry.type='button'; retry.className='underline'; retry.textContent=zh?'重试':fr?'Réessayer':'Retry'; retry.addEventListener('click',()=>void load()); status.append(retry);
      }
    } finally { loading = false; }
  }
  if (input) input.value = new URLSearchParams(location.search).get('q') || '';
  form?.addEventListener('submit', event => {
    event.preventDefault(); if (!input) return;
    const url=new URL(location.href); if(input.value.trim()) url.searchParams.set('q',input.value.trim()); else url.searchParams.delete('q'); history.replaceState({},'',url);
    window.dispatchEvent(new Event('gids:urlchange'));
    if (loaded) render(input.value); else void load();
  });
  void load();
</script>
