---
interface Props {
  variant?: 'mark' | 'wordmark' | 'lockup';
  theme?: 'auto' | 'light' | 'dark';
  alt?: string;
  titleText?: string;
  subtitleText?: string;
  href?: string;
  class?: string;
  imgClass?: string;
  wordmarkClass?: string;
  textClass?: string;
  titleClass?: string;
  subtitleClass?: string;
  loading?: 'eager' | 'lazy';
}

const {
  variant = 'lockup',
  alt = 'GIDS — Global Infectious Disease Surveillance',
  titleText = 'GIDS',
  subtitleText = 'Global Infectious Disease Surveillance',
  href,
  class: className = '',
  imgClass = '',
  textClass = '',
  titleClass = '',
  subtitleClass = '',
  loading = 'eager',
} = Astro.props;
const Wrapper = href ? 'a' : 'div';
---

<Wrapper href={href} class:list={['brand-logo', className]} aria-label={href ? alt : undefined}>
  {variant !== 'wordmark' && (
    <img src="/brand/gids-mark.svg" alt="" aria-hidden="true" width="64" height="64" class:list={['brand-logo-mark', imgClass]} loading={loading} decoding="async" />
  )}
  {variant !== 'mark' && (
    <span class:list={['brand-logo-text', textClass]}>
      <span class:list={['brand-logo-title', titleClass]}>{titleText}</span>
      <span class:list={['brand-logo-subtitle', subtitleClass]}>{subtitleText}</span>
    </span>
  )}
  {!href && variant === 'mark' && <span class="sr-only">{alt}</span>}
</Wrapper>

<style>
  .brand-logo { display: inline-flex; align-items: center; gap: .7rem; color: inherit; text-decoration: none; }
  .brand-logo-mark { flex: 0 0 auto; width: 2.5rem; height: 2.5rem; }
  .brand-logo-text { display: grid; min-width: 0; line-height: 1; }
  .brand-logo-title { font-family: 'IBM Plex Sans', 'IBM Plex Sans Fallback', sans-serif; font-size: 1.18rem; font-weight: 700; letter-spacing: .04em; }
  .brand-logo-subtitle { margin-top: .24rem; font-size: .58rem; font-weight: 600; letter-spacing: .075em; text-transform: uppercase; white-space: nowrap; }
</style>
