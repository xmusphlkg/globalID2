---
interface Props {
  variant?: 'mark' | 'wordmark' | 'lockup';
  theme?: 'auto' | 'light' | 'dark';
  alt?: string;
  titleText?: string;
  subtitleText?: string;
  showText?: boolean;
  href?: string;
  class?: string;
  imgClass?: string;
  wordmarkClass?: string;
  textClass?: string;
  titleClass?: string;
  subtitleClass?: string;
  loading?: 'eager' | 'lazy';
}

const {
  variant = 'lockup',
  theme = 'auto',
  alt = 'GIDS — Global Infectious Disease Surveillance',
  titleText = 'GIDS',
  subtitleText = 'Global Infectious Disease Surveillance',
  showText = false,
  href,
  class: className = '',
  imgClass = '',
  wordmarkClass = '',
  textClass = '',
  titleClass = '',
  subtitleClass = '',
  loading = 'eager',
} = Astro.props;

const Wrapper = href ? 'a' : 'div';
const markDecorative = variant !== 'mark' || Boolean(href);
const wordmarkDecorative = variant !== 'wordmark' || Boolean(href);
const wordmarkSrc = theme === 'dark' ? '/logo-2-256.webp' : '/logo-1-256.webp';
---

<Wrapper href={href} class:list={['brand-logo', `brand-logo-theme-${theme}`, className]} aria-label={href ? alt : undefined}>
  {(variant === 'mark' || variant === 'lockup') && (
    <img
      src="/logo-mark-128.png"
      alt=""
      aria-hidden={markDecorative ? 'true' : undefined}
      width="128"
      height="128"
      class:list={['brand-logo-mark object-contain', imgClass]}
      loading={loading}
      decoding="async"
    />
  )}

  {(variant === 'wordmark' || variant === 'lockup') && (
    <img
      src={wordmarkSrc}
      alt={wordmarkDecorative ? '' : alt}
      aria-hidden={wordmarkDecorative ? 'true' : undefined}
      width="256"
      height="151"
      class:list={['brand-logo-wordmark', wordmarkClass]}
      loading={loading}
      decoding="async"
    />
  )}

  {variant === 'mark' && !href && <span class="sr-only">{alt}</span>}
  {variant === 'lockup' && !href && !showText && <span class="sr-only">{alt}</span>}

  {variant === 'lockup' && showText && (
    <div class:list={['brand-logo-text min-w-0', textClass]}>
      <span class="sr-only">{alt}</span>
      <span class:list={['brand-logo-title', titleClass]}>{titleText}</span>
      <span class:list={['brand-logo-subtitle', subtitleClass]}>{subtitleText}</span>
    </div>
  )}
</Wrapper>

<style>
  .brand-logo { display: inline-flex; align-items: center; gap: .875rem; color: inherit; text-decoration: none; }
  .brand-logo-mark { flex: 0 0 auto; }
  .brand-logo-wordmark { display: block; max-width: 100%; height: auto; }
  .brand-logo-theme-dark .brand-logo-wordmark,
  :global(html.dark) .brand-logo-theme-auto .brand-logo-wordmark,
  :global(html[data-theme='dark']) .brand-logo-theme-auto .brand-logo-wordmark { content: url('/logo-2-256.webp'); }
  .brand-logo-text { display: flex; flex-direction: column; justify-content: center; line-height: 1.1; }
  .brand-logo-title { display: block; }
</style>
