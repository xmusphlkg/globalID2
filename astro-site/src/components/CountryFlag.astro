---
import { resolveFlagIso2, toFlagEmoji } from '../lib/country-flag';

interface Props {
  code: string;
  name?: string;
  sizeClass?: string;
}

const { code, name = 'Country flag', sizeClass = 'w-9 h-7' } = Astro.props;

const flagIso2 = resolveFlagIso2(code);
const cdnCode = flagIso2.toLowerCase();

const fallbackEmoji = toFlagEmoji(flagIso2);
---

<span class={`inline-flex items-center justify-center overflow-hidden rounded-none ring-1 ring-slate-700/60 bg-slate-800/30 ${sizeClass}`}>
  <img
    src={`https://flagcdn.com/w80/${cdnCode}.png`}
    alt={name}
    width="80"
    height="60"
    loading="lazy"
    decoding="async"
    class="w-full h-full object-cover"
    onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';"
  />
  <span class="hidden text-base leading-none" role="img" aria-label={name}>{fallbackEmoji}</span>
</span>
