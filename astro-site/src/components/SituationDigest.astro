---
/**
 * Peer-reviewed weekly brief. Every point links to the authority notices it
 * cites, so a reader can check each claim against the original.
 */
import {
  digestHeadline,
  digestPointText,
  noticeTitle,
  type InternationalNotice,
  type SituationDigestRecord,
} from '../utils/international';
import { formatDate } from '../utils/situation';
import { translateUi } from '../utils/i18n';

interface Props {
  digest: SituationDigestRecord;
  notices: InternationalNotice[];
  locale?: 'en' | 'zh' | 'fr';
  periodHref?: string;
}
const { digest, notices, locale = 'en', periodHref } = Astro.props;
const zh = locale === 'zh';
const fr = locale === 'fr';
const pick = <T,>(en: T, zhValue: T, frValue?: T) => fr ? (frValue ?? (typeof en === 'string' ? translateUi(en) as T : en)) : zh ? zhValue : en;
const byId = new Map(notices.map(notice => [notice.event_id, notice]));
const singleModel = digest.ai?.review_mode === 'single_model';
---

<section class="digest" aria-labelledby={`digest-${digest.period_key}`}>
  <header>
    <p class="eyebrow">{pick('Weekly brief', '每周综述', 'Synthèse hebdomadaire')} · {periodHref ? <a href={periodHref}>{digest.period_key}</a> : digest.period_key}</p>
    <h2 id={`digest-${digest.period_key}`}>{digestHeadline(digest, locale)}</h2>
  </header>
  <ol class="points">
    {digest.points.map(point => (
      <li>
        <p>{digestPointText(point, locale)}</p>
        <ul class="cites" aria-label={pick('Cited notices', '引用通报', 'Avis cités')}>
          {point.notice_ids.map(id => {
            const notice = byId.get(id);
            return notice
              ? <li><a href={notice.url} target="_blank" rel="noopener noreferrer" title={noticeTitle(notice, locale)}>{notice.source_label_en ?? notice.source_id} · {notice.published_date}</a></li>
              : <li><span>{id}</span></li>;
          })}
        </ul>
      </li>
    ))}
  </ol>
  <footer>
    <p>
      {pick('Written and peer-reviewed by AI models from the notices cited above; claims that cite no notice are removed automatically.', '由 AI 模型依据上方引用的通报撰写并同行评审；未引用通报的论断会被自动删除。', 'Rédigé et relu par des modèles d’IA à partir des avis cités ; toute affirmation sans avis cité est retirée automatiquement.')}
      {singleModel && <> {pick('This brief was reviewed by the same model that wrote it.', '本期由同一模型撰写并自审。', 'Cette synthèse a été relue par le modèle qui l’a rédigée.')}</>}
    </p>
    {digest.generated_at && <p>{pick('Generated', '生成于', 'Généré le')} {formatDate(digest.generated_at, locale)}</p>}
  </footer>
</section>

<style>
  .digest { background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); border-top: 3px solid rgb(var(--color-teal)); display: grid; gap: 1rem; padding: clamp(1rem, 2.4vw, 1.6rem); }
  .eyebrow { color: rgb(var(--color-teal)); font-size: .66rem; font-weight: 800; letter-spacing: .13em; margin: 0 0 .35rem; text-transform: uppercase; }
  .eyebrow a { color: inherit; }
  h2 { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: 1.35rem; line-height: 1.2; margin: 0; }
  .points { display: grid; gap: .85rem; margin: 0; padding-left: 1.2rem; }
  .points > li { color: rgb(var(--text)); line-height: 1.6; }
  .points p { margin: 0; font-size: .9rem; }
  .cites { display: flex; flex-wrap: wrap; gap: .3rem; list-style: none; margin: .35rem 0 0; padding: 0; }
  .cites a, .cites span { border: 1px solid rgb(var(--border)); color: rgb(var(--text-muted)); display: inline-block; font-size: .64rem; padding: .1rem .4rem; text-decoration: none; }
  .cites a:hover { border-color: rgb(var(--color-teal)); color: rgb(var(--color-teal)); }
  footer { border-top: 1px solid rgb(var(--border)); color: rgb(var(--text-faint)); font-size: .68rem; line-height: 1.55; padding-top: .7rem; }
  footer p { margin: 0; }
</style>
