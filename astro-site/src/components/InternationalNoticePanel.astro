---
/**
 * Alerts already mapped onto one GIDS disease or jurisdiction: one disease in
 * one place as one official report states it, with the report's own numbers,
 * a quotation only where the source allows one, and a link to the original.
 */
import type { Locale, SituationAlertRecord } from '../utils/situationTypes';
import { noticeSnapshotBadges } from '../utils/internationalSnapshot';
import { alertSummary, countryName, countsLine, diseaseName, formatDay, sourceLabel, STATUS_LABELS } from './situation/labels';
import RuntimeNoticePanel from './situation/RuntimeNoticePanel';

interface Props {
  alerts?: SituationAlertRecord[];
  dataUrl?: string;
  diseaseId?: string;
  locale: Locale;
  limit?: number;
  /** Jurisdictions the host page is about, cross-referenced when an alert does not name them. */
  contextCodes?: string[];
  /** Link to the situation map filtered to this page's country or disease. */
  mapHref?: string;
}

const { alerts = [], dataUrl, diseaseId, locale, limit = 8, contextCodes = [], mapHref } = Astro.props;

const COPY = {
  en: {
    heading: 'Official outbreak alerts',
    map: 'Open on the situation map',
    place: 'Show this place on the map',
  },
  zh: {
    heading: '官方疫情警报',
    map: '在态势地图中打开',
    place: '在地图上显示此地',
  },
  fr: {
    heading: 'Alertes officielles de flambée',
    map: 'Ouvrir sur la carte de situation',
    place: 'Afficher ce lieu sur la carte',
  },
} as const;

const copy = COPY[locale];
const prefix = locale === 'zh' ? '/zh' : locale === 'fr' ? '/fr' : '';
const rows = alerts.slice(0, limit);
const badgesFor = (alert: SituationAlertRecord) =>
  noticeSnapshotBadges(
    {
      countries: [{ code: alert.country_code, name_en: alert.country_name_en, name_zh: alert.country_name_zh }],
      diseases: alert.disease_id ? [{ disease_id: alert.disease_id }] : [],
    },
    locale,
    { contextCodes },
  );

// Only pages that render a row ship the panel CSS, so the stylesheet is
// inlined next to the markup rather than living in a static style block
// that Astro emits for every importer.
const PANEL_CSS = `  .intl-panel {
    --intl-panel-accent: 94 234 212;
    padding: clamp(1.25rem, 2vw, 1.5rem);
    border: 1px solid rgb(var(--border));
    background: rgb(var(--surface));
  }
  html[data-theme='light'] .intl-panel { --intl-panel-accent: var(--color-teal); }
  .intl-panel-header {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .intl-panel-heading { margin-top: 0; }
  .intl-panel-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .intl-panel-item {
    position: relative;
    min-width: 0;
    padding: 1rem 1rem 1rem 1.2rem;
    border: 1px solid rgb(var(--border) / 0.8);
    background: linear-gradient(110deg, rgb(var(--intl-panel-accent) / 0.04), transparent 55%), rgb(var(--surface));
    overflow-wrap: anywhere;
  }
  .intl-panel-item::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, rgb(var(--intl-panel-accent)), rgb(var(--color-brand) / 0.2) 75%, transparent);
    pointer-events: none;
  }
  .intl-panel-item:hover,
  .intl-panel-item:focus-within { border-color: rgb(var(--intl-panel-accent) / 0.5); }
  .intl-panel-title {
    display: block;
    margin-top: 0.6rem;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: rgb(var(--text-strong));
    text-decoration: none;
  }
  .intl-panel-title:hover {
    text-decoration: underline;
  }
  .intl-panel-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.65rem;
    margin: 0;
    font-size: 0.7rem;
    color: rgb(var(--text-muted));
  }
  .intl-panel-date { color: rgb(var(--intl-panel-accent)); font-family: ui-monospace, monospace; font-variant-numeric: tabular-nums; }
  .intl-panel-source { font-weight: 650; }
  .intl-panel-status {
    padding: 0.12rem 0.4rem;
    border: 1px solid rgb(var(--border) / 0.75);
    background: rgb(var(--surface-raised) / 0.5);
    font-size: 0.65rem;
  }
  .intl-panel-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.8rem; }
  .intl-panel-action {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    max-width: 100%;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgb(var(--intl-panel-accent) / 0.4);
    border-radius: 0;
    background: rgb(var(--intl-panel-accent) / 0.04);
    color: rgb(var(--intl-panel-accent));
    font-size: 0.7rem;
    font-weight: 650;
    line-height: 1.4;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .intl-panel-action:hover { border-color: rgb(var(--intl-panel-accent) / 0.75); background: rgb(var(--intl-panel-accent) / 0.09); }
  .intl-panel-action:focus-visible,
  .intl-panel-title:focus-visible { outline: 2px solid rgb(var(--intl-panel-accent)); outline-offset: 3px; }
  .intl-panel-summary {
    margin: 0.4rem 0 0;
    font-size: 0.83rem;
    line-height: 1.5;
    color: rgb(var(--text));
  }
  .intl-panel-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.5rem 0 0;
  }
  .intl-panel-chip {
    padding: 0.1rem 0.45rem;
    background: rgb(var(--intl-panel-accent) / 0.1);
    font-size: 0.7rem;
    color: rgb(var(--intl-panel-accent));
  }
  .intl-panel-snapshot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.45rem 0 0;
  }
  .intl-snapshot-badge {
    padding: 0.12rem 0.5rem;
    border: 1px solid rgb(var(--border));
    font-size: 0.7rem;
    color: rgb(var(--intl-panel-accent));
    background: rgb(var(--surface-raised));
  }
  .intl-panel-counts { margin: 0.35rem 0 0; font-size: 0.8rem; font-weight: 600; color: rgb(var(--text)); }
  .intl-panel-quote { margin: 0.4rem 0 0; padding-left: 0.6rem; border-left: 2px solid rgb(var(--border-soft)); font-size: 0.8rem; font-style: italic; color: rgb(var(--text-muted)); }
`;
---

{
  dataUrl && <><style set:html={PANEL_CSS} /><RuntimeNoticePanel client:visible dataUrl={dataUrl} diseaseId={diseaseId} locale={locale} limit={limit} contextCodes={contextCodes} mapHref={mapHref} /></>
}
{
  !dataUrl && rows.length > 0 && (
    <>
      <style set:html={PANEL_CSS} />
      <section class="intl-panel" aria-labelledby="intl-panel-heading">
        <div class="intl-panel-header">
          <div>
            <h2 id="intl-panel-heading" class="figure-title intl-panel-heading">{copy.heading}</h2>
          </div>
          {mapHref && <a class="intl-panel-action" href={mapHref}>{copy.map}</a>}
        </div>
        <ul class="intl-panel-list">
          {rows.map((alert) => (
            <li class="intl-panel-item">
              <p class="intl-panel-meta">
                <time class="intl-panel-date" datetime={alert.published_date}>{formatDay(alert.published_date, locale)}</time>
                <span class="intl-panel-source">{sourceLabel(alert, locale)}</span>
                <span class="intl-panel-status">{STATUS_LABELS[alert.status][locale]}</span>
              </p>
              <a class="intl-panel-title" href={alert.url} target="_blank" rel="noopener noreferrer">
                {diseaseName(alert, locale)} · {alert.admin_area ? `${alert.admin_area}, ` : ''}{countryName(alert, locale)}
              </a>
              {countsLine(alert, locale) && <p class="intl-panel-counts">{countsLine(alert, locale)}</p>}
              {alertSummary(alert, locale) && <p class="intl-panel-summary">{alertSummary(alert, locale)}</p>}
              {alert.quote && <blockquote class="intl-panel-quote">{alert.quote}</blockquote>}
              {badgesFor(alert).length > 0 && (
                <p class="intl-panel-snapshot">
                  {badgesFor(alert).map((badge) => (
                    <span class="intl-snapshot-badge">{badge}</span>
                  ))}
                </p>
              )}
              <div class="intl-panel-actions">
                <a class="intl-panel-action" href={`${prefix}/situation/?place=${encodeURIComponent(alert.alert_id)}`}>{copy.place}</a>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </>
  )
}
