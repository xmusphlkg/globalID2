---
interface SourceSummary {
  country_code?: string;
  country_name?: string;
  scope?: string;
  label?: string;
  url?: string;
  type?: string;
  cadence?: string;
  description?: string;
}

interface SourceInfoGroup {
  country_code?: string;
  country_name?: string;
  sources?: SourceSummary[];
}

interface DownloadEntry {
  dataset_index_path?: string;
  generated_at?: string;
  record_count?: number;
  date_range?: { start?: string; end?: string };
  source_info?: SourceInfoGroup | SourceInfoGroup[];
}

interface Props {
  entry?: DownloadEntry | null;
  title?: string;
  descriptionEn?: string;
  descriptionZh?: string;
  initialLanguage?: 'en' | 'zh';
}

const {
  entry = null,
  title = 'Download Data',
  descriptionEn = 'Open the sharded dataset index for this view, including source metadata and immutable fact shard references.',
  descriptionZh = '打开当前视图的分片数据索引，其中包含数据源元信息和不可变事实分片引用。',
  initialLanguage = 'en',
} = Astro.props;

function pick(en: string, zh: string) {
  return initialLanguage === 'zh' ? zh : en;
}

function formatDate(value?: string | null) {
  if (!value) return '—';
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return date.toISOString().slice(0, 10);
}

function formatCount(value?: number | null) {
  if (value == null) return '—';
  return value.toLocaleString();
}

const CADENCE_ZH: Record<string, string> = {
  daily: '每日',
  weekly: '每周',
  monthly: '每月',
  quarterly: '每季度',
  yearly: '每年',
};

const TYPE_ZH: Record<string, string> = {
  api: '接口',
  csv: '表格',
  open_data_csv: '开放数据',
  web: '网页',
};

const SOURCE_LABEL_ZH: Record<string, string> = {
  jp_weekly: '日本 NIID/JIHS 周报',
};

const SOURCE_DESCRIPTION_ZH: Record<string, string> = {
  jp_weekly: '日本 NIID/JIHS 周度传染病监测数据。',
};

function sourceZhLabel(source: SourceSummary) {
  return SOURCE_LABEL_ZH[source.scope ?? ''] ?? source.label ?? source.scope ?? '未知来源';
}

function sourceZhDescription(source: SourceSummary) {
  return SOURCE_DESCRIPTION_ZH[source.scope ?? ''] ?? source.description ?? '';
}

const rawSourceInfo = entry?.source_info;
const sourceGroups = Array.isArray(rawSourceInfo)
  ? rawSourceInfo
  : rawSourceInfo
    ? [rawSourceInfo]
    : [];

const sourceEntries = sourceGroups.flatMap((group) => {
  const nested = Array.isArray(group?.sources) ? group.sources : [];
  if (nested.length > 0) {
    return nested.map((source) => ({
      ...source,
      country_code: source.country_code ?? group.country_code,
      country_name: source.country_name ?? group.country_name,
    }));
  }
  return [group as SourceSummary];
});

const coverageLabel = (entry?.date_range?.start || entry?.date_range?.end)
  ? `${entry?.date_range?.start ?? '—'} → ${entry?.date_range?.end ?? '—'}`
  : '—';
---

{entry && (
  <section class="figure-panel space-y-6">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="space-y-3">
        <p class="figure-kicker" data-lang-en="Dataset Archive" data-lang-zh="数据归档">
          {pick('Dataset Archive', '数据归档')}
        </p>
        <h2 class="figure-title" data-lang-en={title} data-lang-zh="下载数据">
          {pick(title, '下载数据')}
        </h2>
        <p class="figure-caption" data-lang-en={descriptionEn} data-lang-zh={descriptionZh}>
          {pick(descriptionEn, descriptionZh)}
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        {entry.dataset_index_path && (
          <a
            href={entry.dataset_index_path}
            download
            class="site-action-secondary inline-flex items-center gap-2 rounded-none border px-4 py-2 text-sm font-semibold transition-all"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16V4m0 12-4-4m4 4 4-4M4 20h16" />
            </svg>
            <span data-lang-en="Dataset index" data-lang-zh="数据集索引">{pick('Dataset index', '数据集索引')}</span>
          </a>
        )}
      </div>
    </div>

    <div class="academic-meta-grid">
      <div class="academic-meta-item">
        <div class="academic-meta-label" data-lang-en="Rows" data-lang-zh="记录数">{pick('Rows', '记录数')}</div>
        <div class="academic-meta-value font-serif">{formatCount(entry.record_count)}</div>
      </div>
      <div class="academic-meta-item">
        <div class="academic-meta-label" data-lang-en="Data Version" data-lang-zh="数据版本">
          {pick('Data Version', '数据版本')}
        </div>
        <div class="academic-meta-value font-serif">{formatDate(entry.generated_at)}</div>
      </div>
      <div class="academic-meta-item">
        <div class="academic-meta-label" data-lang-en="Coverage" data-lang-zh="覆盖区间">
          {pick('Coverage', '覆盖区间')}
        </div>
        <div class="academic-meta-value text-sm font-medium">
          {coverageLabel}
        </div>
      </div>
      <div class="academic-meta-item">
        <div class="academic-meta-label" data-lang-en="Included metadata" data-lang-zh="附带元数据">
          {pick('Included metadata', '附带元数据')}
        </div>
        <div class="academic-meta-value text-sm font-medium" data-lang-en="Source links, scope, cadence" data-lang-zh="来源链接、范围、频率">
          {pick('Source links, scope, cadence', '来源链接、范围、频率')}
        </div>
      </div>
    </div>

    {sourceEntries.length > 0 && (
      <div class="space-y-4 border-t border-slate-800 pt-5">
        <div>
          <h3 class="academic-kicker" data-lang-en="Source Register" data-lang-zh="数据源信息">
            {pick('Source Register', '数据源信息')}
          </h3>
          <p class="source-register-intro mt-2 text-sm leading-6" data-lang-en="Official sources and update cadences used to construct the downloadable dataset." data-lang-zh="构建当前可下载数据集所使用的官方来源及更新频率。">
            {pick(
              'Official sources and update cadences used to construct the downloadable dataset.',
              '构建当前可下载数据集所使用的官方来源及更新频率。'
            )}
          </p>
        </div>

        <div class="grid gap-3">
          {sourceEntries.map((source) => (
            <article class="source-register-card">
              <div class="flex flex-wrap items-start gap-2">
                {source.country_code && (
                  <span class="source-register-code">
                    {source.country_code}
                  </span>
                )}
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span
                      class="source-register-title"
                      data-lang-en={source.label ?? source.scope ?? 'Unknown Source'}
                      data-lang-zh={sourceZhLabel(source)}
                    >
                      {pick(source.label ?? source.scope ?? 'Unknown Source', sourceZhLabel(source))}
                    </span>
                    {source.cadence && (
                      <span
                        class="source-register-cadence"
                        data-lang-en={source.cadence}
                        data-lang-zh={CADENCE_ZH[source.cadence] ?? source.cadence}
                      >
                        {pick(source.cadence, CADENCE_ZH[source.cadence] ?? source.cadence)}
                      </span>
                    )}
                    {source.type && (
                      <span
                        class="source-register-type"
                        data-lang-en={source.type}
                        data-lang-zh={TYPE_ZH[source.type] ?? source.type}
                      >
                        {pick(source.type, TYPE_ZH[source.type] ?? source.type)}
                      </span>
                    )}
                  </div>

                  {source.country_name && (
                    <p class="source-register-country mt-1 text-xs uppercase tracking-[0.14em]">{source.country_name}</p>
                  )}

                  {source.description && (
                    <p
                      class="source-register-description mt-3 text-sm leading-relaxed"
                      data-lang-en={source.description}
                      data-lang-zh={sourceZhDescription(source)}
                    >
                      {pick(source.description, sourceZhDescription(source))}
                    </p>
                  )}

                  {source.url && (
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="source-register-link mt-4 inline-flex items-center gap-1.5 text-sm transition-colors"
                    >
                      <span data-lang-en="Official source" data-lang-zh="官方来源">{pick('Official source', '官方来源')}</span>
                      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5m0 0v5m0-5L10 14m-3 5h11a2 2 0 002-2V9m-5 10H6a2 2 0 01-2-2V6a2 2 0 012-2h5" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}

    <div class="academic-note">
      <span data-lang-en="Suggested presentation pattern:" data-lang-zh="建议呈现方式：">{pick('Suggested presentation pattern:', '建议呈现方式：')}</span>
      <span data-lang-en=" cite the data version and coverage window when exporting charts or tables for publication." data-lang-zh=" 在导出图表或表格用于发布时，建议同时标注数据版本和覆盖区间。">{pick(' cite the data version and coverage window when exporting charts or tables for publication.', ' 在导出图表或表格用于发布时，建议同时标注数据版本和覆盖区间。')}</span>
    </div>
  </section>
)}
