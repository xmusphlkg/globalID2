---
import CountryFlag from './CountryFlag.astro';
import { downloadCenterHref } from '../lib/download-center-link';
import { MAIN_ORIGIN } from '../lib/papers';
import { createTranslator, type Lang } from '../utils/i18n';

interface SourceSummary {
  country_code?: string;
  country_name?: string;
  scope?: string;
  label?: string;
  label_zh?: string;
  url?: string;
  type?: string;
  cadence?: string;
  description?: string;
  description_zh?: string;
  description_fr?: string;
}

interface SourceInfoGroup {
  country_code?: string;
  country_name?: string;
  sources?: SourceSummary[];
}

interface DownloadEntry {
  site_json_path?: string;
  source_info?: SourceInfoGroup | SourceInfoGroup[];
}

interface Props {
  entry?: DownloadEntry | null;
  countryCode?: string;
  diseaseId?: string;
  title?: string;
  titleFr?: string;
  descriptionEn?: string;
  descriptionZh?: string;
  descriptionFr?: string;
  initialLanguage?: Lang;
}

const {
  entry = null,
  countryCode,
  diseaseId,
  title = 'Download data',
  titleFr = 'Télécharger les données',
  descriptionEn = 'Download this dataset by time range in CSV, JSON or XLSX format.',
  descriptionZh = '按时间范围下载当前数据集，支持 CSV、JSON 和 XLSX 格式。',
  descriptionFr = 'Téléchargez ce jeu de données par période au format CSV, JSON ou XLSX.',
  initialLanguage = 'en',
} = Astro.props;

const pick = createTranslator(initialLanguage);

const CADENCE_ZH: Record<string, string> = {
  annual: '每年', daily: '每日', weekly: '每周', monthly: '每月', quarterly: '每季度', yearly: '每年',
  'annual and monthly': '年度与月度',
  'monthly facts · quarterly publication': '月度事实（按季度发布）',
};
const TYPE_ZH: Record<string, string> = {
  api: '接口', csv: '表格', microsoft_bi: 'Power BI 看板', official_excel: '官方 Excel', open_data_csv: '开放数据', web: '网页',
};
const SOURCE_LABEL_ZH: Record<string, string> = {
  jp_weekly: '日本 NIID/JIHS 周报',
  is_doh_annual: '冰岛卫生署年度传染病看板',
  is_doh_sti: '冰岛卫生署性病监测看板',
  is_doh_respiratory: '冰岛卫生署呼吸道感染周度看板',
  is_doh_history: '冰岛卫生署历史传染病登记',
  is_doh_legacy_icd: '冰岛卫生署历史 ICD 临床月报',
};
const SOURCE_DESCRIPTION_ZH: Record<string, string> = {
  jp_weekly: '日本 NIID/JIHS 周度传染病监测数据。',
  is_doh_annual: '冰岛全国分病种年度病例通报；历史值可能追溯修订，并保持年度总量口径。',
  is_doh_sti: '实验室与登记监测的月度性病诊断事实；官方看板按季度发布。',
  is_doh_respiratory: '按 ISO 周记录的呼吸道疾病诊断数；住院、样本和疫苗指标不计入诊断数。',
  is_doh_history: '1997—2021 年官方历史登记表，年度与月度事实按原始粒度保留。',
  is_doh_legacy_icd: 'Saga 电子病历 ICD 就诊数；与登记通报不可比并保持独立。',
};
const SOURCE_LABEL_FR: Record<string, string> = {
  jp_weekly: 'Bulletins hebdomadaires NIID/JIHS du Japon',
  is_doh_annual: 'Tableau annuel des maladies infectieuses de l’Islande',
  is_doh_sti: 'Tableau islandais de surveillance des IST',
  is_doh_respiratory: 'Tableau hebdomadaire islandais des infections respiratoires',
  is_doh_history: 'Registre historique islandais des maladies infectieuses',
  is_doh_legacy_icd: 'Rapports cliniques mensuels islandais ICD historiques',
};
const SOURCE_DESCRIPTION_FR: Record<string, string> = {
  jp_weekly: 'Données hebdomadaires de surveillance des maladies infectieuses du NIID/JIHS japonais.',
  is_doh_annual: 'Notifications annuelles islandaises par maladie ; les valeurs historiques peuvent être révisées.',
  is_doh_sti: 'Faits mensuels de diagnostic des IST issus de la surveillance de laboratoire et des registres.',
  is_doh_respiratory: 'Diagnostics d’infections respiratoires par semaine ISO ; les hospitalisations et vaccins sont exclus.',
  is_doh_history: 'Registre historique officiel 1997–2021 conservé à sa granularité annuelle et mensuelle.',
  is_doh_legacy_icd: 'Consultations ICD des dossiers électroniques islandais, conservées séparément des notifications.',
};

function sourceZhLabel(source: SourceSummary) {
  return source.label_zh ?? SOURCE_LABEL_ZH[source.scope ?? ''] ?? source.label ?? source.scope ?? '未知来源';
}

function sourceZhDescription(source: SourceSummary) {
  return source.description_zh ?? SOURCE_DESCRIPTION_ZH[source.scope ?? ''] ?? source.description ?? '';
}
function sourceFrLabel(source: SourceSummary) {
  return SOURCE_LABEL_FR[source.scope ?? ''] ?? source.label ?? source.scope ?? 'Source inconnue';
}
function sourceFrDescription(source: SourceSummary) {
  return source.description_fr ?? SOURCE_DESCRIPTION_FR[source.scope ?? ''] ?? source.description ?? '';
}

const rawSourceInfo = entry?.source_info;
const sourceGroups = Array.isArray(rawSourceInfo) ? rawSourceInfo : rawSourceInfo ? [rawSourceInfo] : [];
const sourceEntries = sourceGroups.flatMap((group) => {
  const nested = Array.isArray(group?.sources) ? group.sources : [];
  return nested.length > 0
    ? nested.map((source) => ({
        ...source,
        country_code: source.country_code ?? group.country_code,
        country_name: source.country_name ?? group.country_name,
      }))
    : [group as SourceSummary];
});
const sourcePreviewEntries = sourceEntries.slice(0, 12);
const fullSourceDataUrl = entry?.site_json_path?.startsWith('/site-data/')
  ? `${import.meta.env.DEV ? '' : MAIN_ORIGIN}${entry.site_json_path}`
  : null;

const centerHref = downloadCenterHref(initialLanguage, { country: countryCode, disease: diseaseId }, !import.meta.env.DEV);
---

{(entry || countryCode || diseaseId) && (
  <section class="figure-panel download-panel">
    <div class="download-panel__header">
      <div class="download-panel__intro">
        <h2 class="figure-title">{pick(title, '数据获取', titleFr)}</h2>
        <p class="download-panel__summary">
          {pick(descriptionEn, descriptionZh, descriptionFr)}
        </p>
      </div>
      <a href={centerHref} data-download-center-link class="intl-panel-action download-panel__action">
        {pick('Open download center', '进入下载中心', 'Ouvrir le centre de téléchargement')}
      </a>
    </div>

    {sourceEntries.length > 0 && (
      <details class="source-register">
        <summary>
          <span><strong>{pick('Official sources', '官方数据来源', 'Sources officielles')}</strong><small>{pick('Authority, cadence, notes', '机构、频率与说明', 'Autorité, fréquence et notes')}</small></span>
          <b>{Math.min(sourceEntries.length, sourcePreviewEntries.length)} / {sourceEntries.length}</b>
        </summary>
        <div class="source-register-grid">
          {sourcePreviewEntries.map((source) => (
            <article class="source-register-card">
              <div class="source-register-card__header">
                <div class="source-register-card__identity">
                  {source.country_code && <CountryFlag code={source.country_code} name={source.country_name ?? source.country_code} sizeClass="h-6 w-8 shrink-0" />}
                  <div class="min-w-0">
                    <h3 class="source-register-title">{pick(source.label ?? source.scope ?? 'Unknown Source', sourceZhLabel(source), sourceFrLabel(source))}</h3>
                    {source.country_name && <p class="source-register-country">{source.country_name}</p>}
                  </div>
                </div>
                {source.url && (
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="source-register-link"
                    aria-label={pick('Open official source', '打开官方来源', 'Ouvrir la source officielle')}
                    title={pick('Official source', '官方来源', 'Source officielle')}
                  >
                    <span>{pick('Source', '来源', 'Source')}</span>
                    <svg aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5h5m0 0v5m0-5L10 14m-3 5h11a2 2 0 002-2V9m-5 10H6a2 2 0 01-2-2h5" /></svg>
                  </a>
                )}
              </div>
              {(source.cadence || source.type) && (
                <div class="source-register-tags">
                  {source.cadence && <span class="source-register-cadence">{pick(source.cadence, CADENCE_ZH[source.cadence] ?? source.cadence, source.cadence)}</span>}
                  {source.type && <span class="source-register-type">{pick(source.type, TYPE_ZH[source.type] ?? source.type, source.type)}</span>}
                </div>
              )}
              {source.description && <p class="source-register-description">{pick(source.description, sourceZhDescription(source), sourceFrDescription(source))}</p>}
            </article>
          ))}
        </div>
        {sourceEntries.length > sourcePreviewEntries.length && fullSourceDataUrl && (
          <p class="source-register-more">
            {pick(
              `Previewing 12 of ${sourceEntries.length} official source records.`,
              `当前预览 ${sourceEntries.length} 条官方来源记录中的 12 条。`,
              `Aperçu de 12 sources officielles sur ${sourceEntries.length}.`,
            )}
            {' '}
            <a href={fullSourceDataUrl}>
              {pick('Open the complete source list (JSON)', '打开完整来源清单（JSON）', 'Ouvrir la liste complète des sources (JSON)')}
            </a>
          </p>
        )}
      </details>
    )}

  </section>
)}

<style>
  .download-panel { --intl-panel-accent: var(--color-teal); display: grid; gap: .85rem; padding-block: 1.05rem; }
  .download-panel__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .download-panel__intro { min-width: 0; display: grid; gap: .28rem; }
  .download-panel .figure-title { font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.15; }
  .download-panel__summary { max-width: 58rem; color: rgb(var(--text-muted)); font-size: .78rem; line-height: 1.45; }
  .download-panel__summary span { margin-left: .45rem; color: rgb(var(--text-faint)); }
  .download-panel__action { flex: 0 0 auto; }
  .source-register { border-top: 1px solid rgb(var(--border)); }
  .source-register > summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem 0 0; color: rgb(var(--text-strong)); cursor: pointer; list-style: none; }
  .source-register > summary::-webkit-details-marker { display: none; }
  .source-register > summary > span { display: grid; gap: .12rem; }
  .source-register > summary strong { font-size: .8rem; }
  .source-register > summary small { color: rgb(var(--text-muted)); font-size: .68rem; font-weight: 400; }
  .source-register > summary b { display: grid; min-width: 1.8rem; height: 1.8rem; place-items: center; color: rgb(var(--color-teal)); border: 1px solid rgb(var(--border)); font-family: ui-monospace, monospace; font-size: .68rem; }
  .source-register-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .55rem; padding-bottom: .5rem; }
  .source-register-card { display: flex; min-width: 0; flex-direction: column; gap: .45rem; padding: .7rem; background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); }
  .source-register-title { display: -webkit-box; overflow: hidden; color: rgb(var(--text-strong)); font-size: .76rem; font-weight: 650; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .source-register-card__header,.source-register-card__identity,.source-register-tags { display: flex; gap: .45rem; }
  .source-register-card__header { min-width: 0; align-items: flex-start; justify-content: space-between; }
  .source-register-card__identity { min-width: 0; flex: 1; align-items: flex-start; }
  .source-register-tags { flex-wrap: wrap; }
  .source-register-cadence,.source-register-type { padding: .12rem .3rem; color: rgb(var(--text-muted)); background: rgb(var(--bg-soft)); font-size: .55rem; font-weight: 650; letter-spacing: .06em; text-transform: uppercase; }
  .source-register-country { margin-top: .08rem; color: rgb(var(--text-faint)); font-size: .58rem; text-transform: uppercase; }
  .source-register-description { display: -webkit-box; overflow: hidden; color: rgb(var(--text-muted)); font-size: .66rem; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .source-register-more { padding: .4rem 0 .25rem; color: rgb(var(--text-muted)); font-size: .72rem; line-height: 1.5; }
  .source-register-more a { color: rgb(var(--color-teal)); font-weight: 700; text-decoration: underline; text-underline-offset: .15em; }
  .source-register-link { display: inline-flex; min-height: 1.65rem; flex: 0 0 auto; align-items: center; gap: .22rem; padding: .2rem .35rem; color: rgb(var(--color-teal)); border: 1px solid rgb(var(--border)); font-size: .58rem; font-weight: 700; text-decoration: none; }
  .source-register-link svg { width: .7rem; height: .7rem; }
  .source-register-link:hover { background: rgb(var(--bg-soft)); border-color: rgb(var(--color-teal)); }
  @media (max-width: 640px) {
    .download-panel { padding-block: .9rem; }
    .download-panel__header { align-items: flex-start; gap: .7rem; }
    .download-panel__summary { display: none; }
    .download-panel__action { justify-content: center; }
    .source-register > summary { padding-top: .45rem; }
    .source-register > summary small { display: none; }

  }
</style>
