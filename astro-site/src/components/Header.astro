---
import BrandLogo from './BrandLogo.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props { initialLanguage?: 'en' | 'zh'; }

const { initialLanguage = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const isChinese = initialLanguage === 'zh' || currentPath === '/zh' || currentPath.startsWith('/zh/');
const englishPath = isChinese ? (currentPath.replace(/^\/zh(?=\/|$)/, '') || '/') : currentPath;
const chinesePath = englishPath === '/' ? '/zh/' : `/zh${englishPath}`;
const localePath = `${isChinese ? englishPath : chinesePath}${Astro.url.search}`;
const localize = (path: string) => isChinese ? (path === '/' ? '/zh/' : `/zh${path}`) : path;
const situationVisible = existsSync(resolve('./src/data/situation/v3/latest.json'))
  || ((import.meta.env.DEV || process.env.SITUATION_SHADOW_PREVIEW === 'true') && existsSync(resolve('./src/data/situation/shadow-latest.json')));

const primaryLinks = [
  ...(situationVisible ? [{ href: '/situation/', en: 'Situation', zh: '全球态势' }] : []),
  { href: '/research/', en: 'Research', zh: '研究' },
  { href: '/about/', en: 'Methods & About', zh: '方法与关于' },
];
const dataLinks = [
  { href: '/countries/', en: 'Countries', zh: '国家与地区' },
  { href: '/diseases/', en: 'Diseases', zh: '疾病目录' },
  { href: '/downloads/', en: 'Downloads', zh: '数据下载' },
];
const active = (path: string) => englishPath === path || (path !== '/' && englishPath.startsWith(path));
---

<header class="site-header sticky top-0 z-50 border-b">
  <div class="site-header-inner">
    <div class="site-header-bar">
      <BrandLogo href={localize('/')} variant="lockup" alt={isChinese ? 'GIDS — 全球传染病监测' : 'GIDS — Global Infectious Disease Surveillance'} subtitleText={isChinese ? '全球传染病监测' : 'Global Infectious Disease Surveillance'} class="site-header-brand-block" imgClass="site-header-mark" titleClass="site-header-brandtitle" subtitleClass="site-header-brandline" />

      <nav class="site-nav-desktop hidden lg:flex items-center gap-1" aria-label={isChinese ? '主导航' : 'Primary navigation'}>
        {primaryLinks.slice(0, 1).map(link => <a href={localize(link.href)} class:list={['nav-link focus-ring', active(link.href) && 'nav-link-active']} aria-current={active(link.href) ? 'page' : undefined}>{isChinese ? link.zh : link.en}</a>)}
        <details class="site-nav-menu">
          <summary class:list={['nav-link focus-ring', dataLinks.some(link => active(link.href)) && 'nav-link-active']}>
            {isChinese ? '数据' : 'Data'} <span aria-hidden="true">⌄</span>
          </summary>
          <div class="site-nav-popover">
            {dataLinks.map(link => <a href={localize(link.href)} class="site-nav-popover-link" aria-current={active(link.href) ? 'page' : undefined}>{isChinese ? link.zh : link.en}</a>)}
          </div>
        </details>
        {primaryLinks.slice(1).map(link => <a href={localize(link.href)} class:list={['nav-link focus-ring', active(link.href) && 'nav-link-active']} aria-current={active(link.href) ? 'page' : undefined}>{isChinese ? link.zh : link.en}</a>)}
      </nav>

      <div class="site-header-actions flex items-center gap-2">
        <button id="site-search-open" class="site-search-trigger focus-ring" type="button" aria-label={isChinese ? '打开全站搜索' : 'Open global search'} aria-haspopup="dialog" aria-controls="site-search-dialog">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.4-4.4m2.4-5.1a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" /></svg>
          <span class="hidden sm:inline">{isChinese ? '搜索' : 'Search'}</span>
        </button>
        <button id="theme-toggle" data-theme-toggle class="site-icon-btn focus-ring" type="button" aria-label={isChinese ? '切换到深色主题' : 'Switch to dark theme'}>
          <svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 15.2A8.5 8.5 0 0 1 8.8 3.6 8.5 8.5 0 1 0 20.4 15.2Z" /></svg>
          <svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <span id="theme-toggle-label" class="sr-only">Dark</span>
        </button>
        <a id="lang-toggle" class="site-toggle-btn focus-ring" href={localePath} hreflang={isChinese ? 'en' : 'zh-CN'} lang={isChinese ? 'en' : 'zh-CN'} aria-label={isChinese ? 'Switch to English' : '切换到中文'}>{isChinese ? 'EN' : '中文'}</a>
        <button id="mobile-menu-toggle" class="site-icon-btn lg:hidden focus-ring" type="button" aria-label={isChinese ? '打开导航菜单' : 'Open navigation menu'} aria-controls="mobile-menu" aria-expanded="false">
          <svg class="menu-open-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="menu-close-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="site-header-mobile-menu hidden lg:hidden" aria-label={isChinese ? '移动导航' : 'Mobile navigation'}>
      <div class="site-header-mobile-inner">
        {primaryLinks.slice(0, 1).map(link => <a href={localize(link.href)} class:list={['nav-link', active(link.href) && 'nav-link-active']} aria-current={active(link.href) ? 'page' : undefined}>{isChinese ? link.zh : link.en}</a>)}
        <p class="site-mobile-group-label">{isChinese ? '数据' : 'Data'}</p>
        {dataLinks.map(link => <a href={localize(link.href)} class:list={['nav-link site-mobile-sub-link', active(link.href) && 'nav-link-active']} aria-current={active(link.href) ? 'page' : undefined}>{isChinese ? link.zh : link.en}</a>)}
        {primaryLinks.slice(1).map(link => <a href={localize(link.href)} class:list={['nav-link', active(link.href) && 'nav-link-active']} aria-current={active(link.href) ? 'page' : undefined}>{isChinese ? link.zh : link.en}</a>)}
        <div class="site-mobile-tools">
          <a class="site-mobile-tool focus-ring" href={localePath} hreflang={isChinese ? 'en' : 'zh-CN'} lang={isChinese ? 'en' : 'zh-CN'} aria-label={isChinese ? 'Switch to English' : '切换到中文'}>
            <span aria-hidden="true">{isChinese ? 'EN' : '中文'}</span>
            <span>{isChinese ? 'English' : '中文界面'}</span>
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<dialog id="site-search-dialog" class="site-search-dialog" aria-labelledby="site-search-title">
  <form method="dialog" class="site-search-dialog-shell">
    <header class="site-search-dialog-header">
      <div><p class="academic-kicker">{isChinese ? '全站检索' : 'Global search'}</p><h2 id="site-search-title">{isChinese ? '查找数据与证据' : 'Find data and evidence'}</h2></div>
      <button class="site-search-close focus-ring" value="cancel" aria-label={isChinese ? '关闭搜索' : 'Close search'}>Esc</button>
    </header>
    <label for="site-search-input" class="sr-only">{isChinese ? '搜索国家、疾病、报告和研究' : 'Search countries, diseases, reports, and research'}</label>
    <div class="site-search-input-wrap">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21 21-4.4-4.4m2.4-5.1a7.5 7.5 0 1 1-15 0 7.5 7.5 0 0 1 15 0Z" /></svg>
      <input id="site-search-input" name="q" type="search" autocomplete="off" placeholder={isChinese ? '搜索国家、疾病、报告、研究…' : 'Search countries, diseases, reports, research…'} aria-describedby="site-search-help" />
    </div>
    <p id="site-search-help" class="site-search-help">{isChinese ? '输入至少 2 个字符。使用方向键浏览，Enter 打开。' : 'Type at least 2 characters. Use arrow keys to review and Enter to open.'}</p>
    <div id="site-search-results" class="site-search-results" role="listbox" aria-label={isChinese ? '搜索结果' : 'Search results'}></div>
    <footer class="site-search-footer"><a id="site-search-all" href={localize('/search/')}>{isChinese ? '查看全部结果' : 'View all results'} <span aria-hidden="true">→</span></a></footer>
  </form>
</dialog>

<style is:global>
  .site-header {
    position: sticky;
    color: rgb(var(--text-strong));
    background: rgb(var(--surface) / .96);
    border-color: rgb(var(--border));
    box-shadow: 0 1px 0 rgb(var(--border) / .35);
    backdrop-filter: blur(18px);
  }
  .site-header-inner { width: min(73.75rem, calc(100% - 2rem)); margin-inline: auto; }
  .site-header-bar { display: flex; height: 4.5rem; align-items: center; justify-content: space-between; gap: 1.25rem; }
  .site-header-brand-block { gap: .9rem; }
  .site-header-brand-copy { display: flex; gap: .12rem; }
  .site-header-brandtitle { color: rgb(var(--text-strong)); font-family: 'IBM Plex Sans', sans-serif; font-size: 1.08rem; font-weight: 700; line-height: 1.05; white-space: nowrap; }
  .site-header-brandline { color: rgb(var(--text-muted)); font-size: .68rem; font-weight: 700; letter-spacing: .18em; line-height: 1.05; text-transform: uppercase; white-space: nowrap; }
  .site-header-mark { width: 2.35rem; height: 2.35rem; flex-shrink: 0; padding: 0; background: transparent; box-shadow: none; }

  .site-header .nav-link { display: inline-flex; align-items: center; min-height: 2.5rem; padding: .45rem .7rem; color: rgb(var(--text-muted)); border: 0; border-radius: 4px; box-shadow: none; font-size: .82rem; font-weight: 600; text-decoration: none; }
  .site-header .nav-link:hover { color: rgb(var(--text-strong)); background: rgb(var(--bg-soft)); }
  .site-header .nav-link-active { color: rgb(var(--text-strong)); background: rgb(var(--bg-soft)); box-shadow: inset 0 -2px 0 rgb(var(--color-teal)); }

  .site-nav-menu { position: relative; }
  .site-nav-menu > summary { cursor: pointer; list-style: none; }
  .site-nav-menu > summary::-webkit-details-marker { display: none; }
  .site-nav-popover { position: absolute; top: calc(100% + .45rem); left: 0; min-width: 12rem; padding: .35rem; background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); border-radius: 6px; box-shadow: 0 14px 32px rgb(10 26 40 / .14); }
  .site-nav-popover-link { display: block; padding: .65rem .75rem; color: rgb(var(--text-strong)); border-radius: 4px; font-size: .82rem; font-weight: 600; text-decoration: none; }
  .site-nav-popover-link:hover { background: rgb(var(--bg-soft)); }

  .site-toggle-btn, .site-search-trigger, .site-icon-btn { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: .42rem; padding: .55rem .7rem; color: rgb(var(--text-strong)); background: transparent; border: 1px solid rgb(var(--border)); border-radius: 4px; font-size: .75rem; font-weight: 650; text-decoration: none; }
  .site-toggle-btn:hover, .site-search-trigger:hover, .site-icon-btn:hover { background: rgb(var(--bg-soft)); border-color: rgb(var(--border-soft)); }
  .site-icon-btn { width: 2.75rem; padding: .55rem; }
  .site-search-trigger svg, .site-icon-btn svg, .site-mobile-tool svg { width: 1.05rem; height: 1.05rem; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .theme-sun, .menu-close-icon { display: none; }
  html[data-theme='dark'] .theme-moon { display: none; }
  html[data-theme='dark'] .theme-sun { display: block; }
  #mobile-menu-toggle[aria-expanded='true'] .menu-open-icon { display: none; }
  #mobile-menu-toggle[aria-expanded='true'] .menu-close-icon { display: block; }

  .site-header-mobile-menu { position: absolute; top: 100%; left: 0; right: 0; max-height: calc(100dvh - 4.5rem); overflow-y: auto; border-top: 1px solid rgb(var(--border)); border-bottom: 1px solid rgb(var(--border)); background: rgb(var(--surface)); box-shadow: 0 18px 34px rgb(10 26 40 / .14); overscroll-behavior: contain; }
  .site-header-mobile-inner { width: min(73.75rem, calc(100% - 2rem)); margin-inline: auto; padding: .55rem 0 1rem; }
  .site-header-mobile-menu .nav-link { display: flex; min-height: 2.7rem; padding: .62rem .7rem; }
  .site-mobile-group-label { margin: .5rem .7rem .15rem; color: rgb(var(--text-muted)); font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .site-header-mobile-menu .site-mobile-sub-link { padding-left: 1.5rem; }
  .site-mobile-tools { margin-top: .75rem; padding-top: .75rem; border-top: 1px solid rgb(var(--border)); }
  .site-mobile-tool { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: .5rem; padding: .55rem .7rem; color: rgb(var(--text-strong)); background: rgb(var(--bg-soft)); border: 1px solid rgb(var(--border)); border-radius: 4px; font-size: .75rem; font-weight: 650; text-decoration: none; }
  .site-mobile-tool:hover { border-color: rgb(var(--border-soft)); }

  .site-search-dialog { width: min(44rem, calc(100vw - 2rem)); max-height: min(46rem, calc(100vh - 2rem)); margin: auto; padding: 0; color: rgb(var(--text)); background: rgb(var(--surface)); border: 1px solid rgb(var(--border)); box-shadow: 0 24px 70px rgb(0 0 0 / .28); }
  .site-search-dialog::backdrop { background: rgb(5 18 29 / .66); backdrop-filter: blur(3px); }
  .site-search-dialog-shell { display: grid; max-height: inherit; }
  .site-search-dialog-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 1.2rem 1.25rem; border-bottom: 1px solid rgb(var(--border)); }
  .site-search-dialog-header h2 { margin-top: .12rem; color: rgb(var(--text-strong)); font-size: 1.55rem; }
  .site-search-close { padding: .35rem .5rem; color: rgb(var(--text-muted)); border: 1px solid rgb(var(--border)); background: transparent; }
  .site-search-input-wrap { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: .7rem; margin: 1rem 1.25rem .4rem; padding: 0 .8rem; border: 2px solid rgb(var(--color-teal)); background: rgb(var(--bg)); }
  .site-search-input-wrap svg { width: 1.2rem; height: 1.2rem; fill: none; stroke: rgb(var(--color-teal)); stroke-width: 1.8; }
  .site-search-input-wrap input { width: 100%; min-height: 3.2rem; color: rgb(var(--text-strong)); background: transparent; border: 0; outline: 0; font-size: 1rem; }
  .site-search-help { margin: 0 1.25rem .75rem; color: rgb(var(--text-muted)); font-size: .75rem; }
  .site-search-results { overflow: auto; display: grid; padding: 0 1.25rem; }
  .site-search-result { display: grid; grid-template-columns: 5.5rem 1fr; gap: .12rem .7rem; padding: .72rem .25rem; color: rgb(var(--text-strong)); border-top: 1px solid rgb(var(--border)); text-decoration: none; }
  .site-search-result:hover { background: rgb(var(--bg-soft)); }
  .site-search-result-kind { grid-row: 1 / 3; color: rgb(var(--color-teal)); font-size: .68rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .site-search-result small { overflow: hidden; color: rgb(var(--text-muted)); text-overflow: ellipsis; white-space: nowrap; }
  .site-search-empty { padding: 2rem 0; color: rgb(var(--text-muted)); text-align: center; }
  .site-search-footer { display: flex; justify-content: flex-end; padding: .9rem 1.25rem; border-top: 1px solid rgb(var(--border)); color: rgb(var(--text-muted)); font-size: .72rem; }
  .site-search-footer a { color: rgb(var(--color-teal)); font-weight: 700; }

  @media (min-width: 1024px) { #mobile-menu-toggle { display: none; } }
  @media (min-width: 640px) { .site-mobile-tools { display: none; } }
  @media (max-width: 1023px) { .site-header-brandline { display: none; } .site-header-actions { gap: .35rem; } }
  @media (max-width: 639px) {
    .site-header-brand-block { gap: .45rem; }
    .site-header-brandtitle { font-size: 1.05rem; }
    .site-header-mark { width: 2rem; height: 2rem; }
    #lang-toggle { display: none; }
    .site-search-trigger, .site-icon-btn { min-width: 2.75rem; padding: .55rem; }
    .site-search-dialog { width: calc(100vw - 1rem); max-height: calc(100vh - 1rem); }
    .site-search-footer { align-items: flex-start; flex-direction: column; }
  }
</style>

<script is:inline define:vars={{ isChinese }}>
  const themeButtons = [...document.querySelectorAll('[data-theme-toggle]')];
  const themeLabel = document.querySelector('#theme-toggle-label');
  const mobileButton = document.querySelector('#mobile-menu-toggle');
  const mobileMenu = document.querySelector('#mobile-menu');
  const siteHeader = document.querySelector('.site-header');
  const dataMenu = document.querySelector('.site-nav-menu');
  const searchDialog = document.querySelector('#site-search-dialog');
  const searchOpen = document.querySelector('#site-search-open');
  const searchInput = document.querySelector('#site-search-input');
  const searchResults = document.querySelector('#site-search-results');
  const searchAll = document.querySelector('#site-search-all');
  let searchEntries = [];
  let searchLoaded = false;

  function applyTheme(theme) {
    document.documentElement.dataset.theme = theme;
    document.documentElement.classList.toggle('dark', theme === 'dark');
    const next = theme === 'dark' ? 'Light' : 'Dark';
    if (themeLabel) themeLabel.textContent = next;
    themeButtons.forEach(button => button.setAttribute('aria-label', isChinese ? (theme === 'dark' ? '切换到浅色主题' : '切换到深色主题') : `Switch to ${next.toLowerCase()} theme`));
  }
  applyTheme(localStorage.getItem('theme') === 'dark' ? 'dark' : 'light');
  themeButtons.forEach(button => button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      localStorage.setItem('theme', next); applyTheme(next);
    }));

  function closeMobileMenu(restoreFocus = false) {
    mobileMenu?.classList.add('hidden');
    mobileButton?.setAttribute('aria-expanded', 'false');
    mobileButton?.setAttribute('aria-label', isChinese ? '打开导航菜单' : 'Open navigation menu');
    if (restoreFocus) mobileButton?.focus();
  }

  mobileButton?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    mobileButton.setAttribute('aria-expanded', String(open));
    mobileButton.setAttribute('aria-label', open ? (isChinese ? '关闭导航菜单' : 'Close navigation menu') : (isChinese ? '打开导航菜单' : 'Open navigation menu'));
  });

  async function loadSearch() {
    if (searchLoaded) return;
    try { const response = await fetch('/site-data/search-index.json'); const payload = await response.json(); searchEntries = payload.entries || []; }
    catch { searchEntries = []; }
    searchLoaded = true;
  }
  function openSearch() {
    closeMobileMenu();
    if (searchDialog instanceof HTMLDialogElement && !searchDialog.open) searchDialog.showModal();
    requestAnimationFrame(() => searchInput?.focus());
    loadSearch().then(renderSearch);
  }
  searchOpen?.addEventListener('click', openSearch);
  document.addEventListener('keydown', event => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); openSearch(); }
    if (event.key === 'Escape' && searchDialog instanceof HTMLDialogElement && searchDialog.open) {
      event.preventDefault();
      searchDialog.close();
      searchOpen?.focus();
      return;
    }
    if (event.key === 'Escape' && mobileButton?.getAttribute('aria-expanded') === 'true') {
      closeMobileMenu(true);
      return;
    }
    if (event.key === 'Escape' && dataMenu instanceof HTMLDetailsElement && dataMenu.open) {
      dataMenu.open = false;
      dataMenu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', event => {
    const target = event.target;
    if (target instanceof Node && mobileButton?.getAttribute('aria-expanded') === 'true' && !siteHeader?.contains(target)) closeMobileMenu();
    if (target instanceof Node && dataMenu instanceof HTMLDetailsElement && dataMenu.open && !dataMenu.contains(target)) dataMenu.open = false;
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', event => { if (event.matches) closeMobileMenu(); });

  const normalized = value => String(value || '').normalize('NFKD').toLowerCase().trim();
  function score(entry, query) {
    const title = normalized(isChinese ? (entry.title.zh || entry.title.en) : entry.title.en);
    const aliases = (entry.aliases || []).map(normalized);
    const summary = normalized(isChinese ? (entry.summary?.zh || entry.summary?.en) : entry.summary?.en);
    if (title === query) return 100;
    if (title.startsWith(query)) return 80;
    if (aliases.some(alias => alias === query)) return 70;
    if (aliases.some(alias => alias.startsWith(query))) return 60;
    if (title.includes(query)) return 50;
    if (summary.includes(query)) return 20;
    return 0;
  }
  function renderSearch() {
    if (!(searchInput instanceof HTMLInputElement) || !searchResults) return;
    const query = normalized(searchInput.value);
    if (searchAll instanceof HTMLAnchorElement) searchAll.href = `${isChinese ? '/zh' : ''}/search/?q=${encodeURIComponent(searchInput.value.trim())}`;
    searchResults.replaceChildren();
    if (query.length < 2) return;
    const matches = searchEntries.map(entry => ({ entry, rank: score(entry, query) })).filter(item => item.rank > 0).sort((a,b) => b.rank-a.rank).slice(0, 8);
    if (!matches.length) { const empty = document.createElement('p'); empty.className='site-search-empty'; empty.textContent=isChinese?'未找到匹配内容。':'No matching evidence found.'; searchResults.append(empty); return; }
    for (const { entry } of matches) {
      const link = document.createElement('a'); link.className='site-search-result'; link.setAttribute('role','option');
      link.href = isChinese && entry.href.zh ? entry.href.zh : entry.href.en;
      const kind = document.createElement('span'); kind.className='site-search-result-kind'; kind.textContent=entry.kind;
      const title = document.createElement('strong'); title.textContent=isChinese?(entry.title.zh||entry.title.en):entry.title.en;
      const summary = document.createElement('small'); summary.textContent=isChinese?(entry.summary?.zh||entry.summary?.en||''):(entry.summary?.en||'');
      link.append(kind,title,summary); searchResults.append(link);
    }
  }
  searchInput?.addEventListener('input', renderSearch);
  searchInput?.addEventListener('keydown', event => {
    if (event.key !== 'ArrowDown') return;
    const firstResult = searchResults?.querySelector('.site-search-result');
    if (firstResult instanceof HTMLElement) { event.preventDefault(); firstResult.focus(); }
  });
  searchResults?.addEventListener('keydown', event => {
    if (!['ArrowDown', 'ArrowUp'].includes(event.key)) return;
    const links = [...searchResults.querySelectorAll('.site-search-result')];
    const index = links.indexOf(document.activeElement);
    if (index < 0) return;
    event.preventDefault();
    const nextIndex = event.key === 'ArrowDown' ? (index + 1) % links.length : (index - 1 + links.length) % links.length;
    links[nextIndex]?.focus();
  });
  searchDialog?.addEventListener('click', event => { if (event.target === searchDialog && searchDialog instanceof HTMLDialogElement) searchDialog.close(); });
  searchDialog?.addEventListener('close', () => searchOpen?.focus());
</script>
