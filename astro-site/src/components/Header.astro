---
// src/components/Header.astro
import BrandLogo from './BrandLogo.astro';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  initialLanguage?: 'en' | 'zh';
}

const situationPublic = existsSync(resolve('./src/data/situation/latest.json'));
const situationPreviewEnabled = import.meta.env.DEV || process.env.SITUATION_SHADOW_PREVIEW === 'true';
const situationDevPreview = situationPreviewEnabled && existsSync(resolve('./src/data/situation/shadow-latest.json'));
const navLinks = [
  { href: '/', label: 'Home', labelZh: '首页' },
  ...(situationPublic || situationDevPreview ? [{ href: '/situation/', label: 'Situation', labelZh: '全球态势' }] : []),
  { href: '/countries/', label: 'Countries', labelZh: '国家' },
  { href: '/diseases/', label: 'Diseases', labelZh: '疾病' },
  { href: '/research/', label: 'Research', labelZh: '研究' },
];

const { initialLanguage = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header
  class="site-header sticky top-0 z-50 border-b backdrop-blur-md"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="min-w-0">
        <BrandLogo
          href="/"
          variant="lockup"
          theme="dark"
          alt="GIDS"
          class="site-header-brand-block group min-w-0"
          wordmarkClass="site-header-wordmark h-11 w-auto max-w-[min(34vw,300px)] group-hover:opacity-90 transition-opacity"
          textClass="site-header-brand-copy"
          titleClass="site-header-brandtitle"
          subtitleClass="site-header-brandline"
          imgClass="site-header-mark h-10 w-10 rounded-none ring-1 ring-white/10"
        />
      </div>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1">
        {
          navLinks.map(({ href, label, labelZh }) => (
            <a
              href={href}
              class:list={[
                'nav-link focus-ring',
                (currentPath === href || (href !== '/' && currentPath.startsWith(href)))
                  ? 'nav-link-active'
                  : '',
              ]}
            >
              <span data-lang-en={label} data-lang-zh={labelZh}>{initialLanguage === 'zh' ? labelZh : label}</span>
            </a>
          ))
        }
      </nav>

      <!-- Right: theme + language toggle + mobile menu -->
      <div class="flex items-center gap-3">
        <button
          id="theme-toggle"
          class="site-toggle-btn text-xs font-medium px-3 py-1.5 rounded-none border transition-all focus-ring"
          aria-label="Toggle color theme"
          title="切换主题 / Toggle Theme"
        >
          <span id="theme-toggle-label">Light</span>
        </button>

        <button
          id="lang-toggle"
          class="site-toggle-btn text-xs font-medium px-3 py-1.5 rounded-none border transition-all focus-ring"
          aria-label="Toggle language"
          title="切换语言 / Switch Language"
        >
          <span id="lang-toggle-label">中文</span>
        </button>

        <!-- Mobile menu toggle -->
        <button
          id="mobile-menu-toggle"
          class="site-toggle-btn md:hidden p-2 rounded-none border transition-colors focus-ring"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile nav -->
    <div id="mobile-menu" class="site-header-mobile-menu hidden md:hidden border-t py-3 pb-4 space-y-1">
      {
        navLinks.map(({ href, label, labelZh }) => (
          <a
            href={href}
            class:list={[
              'block nav-link focus-ring',
              (currentPath === href || (href !== '/' && currentPath.startsWith(href)))
                ? 'nav-link-active'
                : '',
            ]}
          >
            <span data-lang-en={label} data-lang-zh={labelZh}>{initialLanguage === 'zh' ? labelZh : label}</span>
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  // Theme + language toggle
  const themeBtn = document.getElementById('theme-toggle');
  const themeLabel = document.getElementById('theme-toggle-label');
  const toggleBtn = document.getElementById('lang-toggle');
  const toggleLabel = document.getElementById('lang-toggle-label');
  const mobileMenuBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  function getPreferredTheme(): 'light' | 'dark' {
    const storedTheme = localStorage.getItem('theme');
    if (storedTheme === 'light' || storedTheme === 'dark') return storedTheme;
    return 'light';
  }

  function applyTheme(theme: 'light' | 'dark') {
    document.documentElement.setAttribute('data-theme', theme);
    document.documentElement.classList.toggle('dark', theme === 'dark');
    if (themeLabel) themeLabel.textContent = theme === 'dark' ? 'Light' : 'Dark';
  }

  let currentTheme = getPreferredTheme();
  applyTheme(currentTheme);

  themeBtn?.addEventListener('click', () => {
    currentTheme = currentTheme === 'dark' ? 'light' : 'dark';
    localStorage.setItem('theme', currentTheme);
    applyTheme(currentTheme);
  });

  const storedLang = localStorage.getItem('lang');
  const initialLang = document.documentElement.getAttribute('data-initial-lang');
  let currentLang = storedLang === 'zh' || storedLang === 'en'
    ? storedLang
    : (initialLang === 'zh' ? 'zh' : 'en');
  updateLang(currentLang);

  toggleBtn?.addEventListener('click', () => {
    currentLang = currentLang === 'en' ? 'zh' : 'en';
    localStorage.setItem('lang', currentLang);
    updateLang(currentLang);
  });

  function updateLang(lang: string) {
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.setAttribute('lang', lang === 'zh' ? 'zh-CN' : 'en');
    if (toggleLabel) toggleLabel.textContent = lang === 'en' ? '中文' : 'EN';

    // Update all elements with data-lang-en / data-lang-zh attributes
    document.querySelectorAll('[data-lang-en]').forEach((el) => {
      const target = lang === 'zh'
        ? el.getAttribute('data-lang-zh')
        : el.getAttribute('data-lang-en');
      if (target) el.textContent = target;
    });

    // Update elements with HTML content (e.g. citation superscripts)
    document.querySelectorAll('[data-lang-en-html]').forEach((el) => {
      const target = lang === 'zh'
        ? el.getAttribute('data-lang-zh-html')
        : el.getAttribute('data-lang-en-html');
      if (target) el.innerHTML = target;
    });

    document.querySelectorAll('[data-lang-en-placeholder]').forEach((el) => {
      const placeholder = lang === 'zh'
        ? el.getAttribute('data-lang-zh-placeholder')
        : el.getAttribute('data-lang-en-placeholder');
      if (placeholder && (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement)) {
        el.placeholder = placeholder;
      }
    });

    document.dispatchEvent(new CustomEvent('globalid:language-change', { detail: { lang } }));
  }

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
