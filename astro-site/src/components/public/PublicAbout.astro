---
import aboutRaw from '../../data/about.json';
interface Props { locale?: 'en' | 'zh'; }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const about = aboutRaw as any;
const summary = about.summary ?? {};
const dateLocale = zh ? 'zh-CN' : 'en-US';
const generatedAt = about.generated_at ? new Date(about.generated_at).toLocaleDateString(dateLocale, { year: 'numeric', month: zh ? 'numeric' : 'long', day: 'numeric', timeZone: 'UTC' }) : zh ? '暂无' : 'Not available';
const copy = zh ? {
  eyebrow: '方法与关于', title: '每条证据都可以追溯到来源', lead: 'GIDS 整理由公共卫生机构发布的传染病监测记录，让数据更容易查找、比较、理解和下载，同时保留原始报告背景。', updated: `公开数据快照更新于 ${generatedAt}。各来源的覆盖和发布时间不同。`,
  onPage: '本页目录', nav: ['覆盖范围','工作流程','数据原则','局限性','项目'], scopeKicker: '当前范围', scope: '公开目录覆盖什么', scopeNote: '以下数字描述当前发布快照，而不是全球传染病的完整疾病负担。',
  metrics: [['国家与地区',summary.total_countries ?? 0,'已发布监测数据的报告地区。'],['收录疾病',summary.total_diseases ?? 0,'目录中标准化的疾病概念。'],['公开记录',summary.total_cases ?? 0,'当前公开快照中的报告观测记录。'],['最新报告日期',summary.coverage_end ?? '暂无','至少一个公开来源包含的最新日期。']],
  coverage: '当前时间覆盖', workflowKicker: '从来源到发布', workflow: '数据如何进入网站', workflowNote: '每个阶段都保留来源背景，并阻止不完整或未发布的数据进入公开目录。',
  steps: [['采集','从配置的官方卫生机构来源获取新发布记录。'],['标准化','统一疾病名称、地点、日期和指标，同时保留原始报告粒度。'],['检查','在公开前执行完整性、一致性、来源和发布条件检查。'],['发布','更新页面和下载文件，并保留来源链接、局限和纠错渠道。']],
  principlesKicker: '数据原则', principlesTitle: '如何负责任地阅读 GIDS', principles: [['可追溯至官方来源','每个公开数据集都保留卫生机构链接、报告频率和覆盖说明。'],['保留来源定义','不同报告系统并不一定可直接比较；病例定义、时间粒度和修订信息始终随数据保留。'],['缺失不等于零','未提供的字段和未报告的周期保持缺失，不会被静默转换成零。'],['公开结果可以复核','下载、方法、局限和纠错入口与图表及摘要同时发布。']],
  limitsKicker: '局限性', limitsTitle: '这个网站不能告诉你什么', limits: ['GIDS 是监测与证据导航资源，不是临床工具、疫情声明服务，也不能代替国家和地方卫生机构的指导。','数据可能在修订后变化。报告系统的病例定义、覆盖人群、延迟和时间粒度不同；跨地区比较应先阅读各页面的来源及局限。'],
  downloads: '浏览可下载数据', guidance: '阅读版权与复用说明', projectKicker: '项目', projectTitle: '可审查的方法与公开纠错渠道', project: ['GIDS 是独立、源码可见的公共利益项目。仓库当前未发布适用于全部代码的通用开源许可；代码、公开数据产品和第三方来源应分别按其明确标注的许可与使用规则处理。','反馈某个数字时，请同时提供页面地址、国家或疾病、报告周期和用于比较的官方来源。'], repository: '查看源代码仓库', correction: '提交数据纠错',
} : {
  eyebrow: 'Methods & About', title: 'Evidence you can trace back to its source', lead: 'GIDS organizes infectious disease surveillance records published by public health authorities. The site makes those records easier to find, compare, interpret, and download without hiding their original context.', updated: `Public data snapshot updated ${generatedAt}. Coverage and publication schedules vary by source.`,
  onPage: 'On this page', nav: ['Coverage','Workflow','Data principles','Limitations','Project'], scopeKicker: 'Current scope', scope: 'What the public catalogue covers', scopeNote: 'These figures describe the current published snapshot, not the full global burden of infectious disease.',
  metrics: [['Countries and regions',summary.total_countries ?? 0,'Jurisdictions with a published surveillance dataset.'],['Diseases tracked',summary.total_diseases ?? 0,'Standardized disease concepts represented in the catalogue.'],['Published records',summary.total_cases ?? 0,'Reported observations included in the current public snapshot.'],['Latest reporting date',summary.coverage_end ?? 'Not available','The latest date present in at least one published source.']],
  coverage: 'Current time coverage', workflowKicker: 'From source to publication', workflow: 'How data reaches the site', workflowNote: 'Each stage preserves source context and keeps incomplete or unpublished records out of the public catalogue.',
  steps: [['Collect','Retrieve newly published records from configured official health authority sources.'],['Standardize','Align disease names, places, dates, and measures while preserving the original reporting grain.'],['Check','Run completeness, consistency, provenance, and publication checks before records can appear publicly.'],['Publish','Refresh public pages and downloads while retaining source links, limitations, and correction paths.']],
  principlesKicker: 'Data principles', principlesTitle: 'How to read GIDS responsibly', principles: [['Traceable to official sources','Every public dataset retains links to the responsible health authority and records its reporting cadence and coverage.'],['Source definitions remain visible','Reporting systems are not assumed to be directly comparable. Case definitions, temporal grain, and revisions stay attached to the data.'],['Missing does not mean zero','Unavailable fields and unreported periods remain missing. They are not silently converted into zero counts.'],['Public outputs are reviewable','Downloads, methods, limitations, and correction routes are published alongside charts and summaries.']],
  limitsKicker: 'Limitations', limitsTitle: 'What this site cannot tell you', limits: ['GIDS is a surveillance and evidence navigation resource. It is not a clinical tool, an outbreak declaration service, or a substitute for guidance from health authorities.','Counts can change after revision. Reporting systems differ in case definition, population coverage, delay, and temporal grain. Cross-country comparisons should begin with each page’s source and limitation notes.'],
  downloads: 'Explore downloadable data', guidance: 'Read copyright & reuse guidance', projectKicker: 'The project', projectTitle: 'Reviewable methods, public correction routes', project: ['GIDS is an independent, source-visible public-interest project. The repository currently publishes no general open-source licence covering all code; code, public data products, and third-party sources must each be handled under their expressly stated licence or reuse rules.','Questions about a figure should include the page URL, country or disease, reporting period, and the official source being compared.'], repository: 'View the source repository', correction: 'Report a data correction',
};
const ids = ['coverage','workflow','principles','limitations','project'];
---

<article class="about-page">
  <header class="about-hero"><div class="wrap hero-grid"><div><p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1></div><div><p class="lead">{copy.lead}</p><p class="updated">{copy.updated}</p></div></div></header>
  <nav class="local-nav" aria-label={copy.onPage}><div class="wrap"><span>{copy.onPage}</span>{copy.nav.map((label,index)=><a href={`#${ids[index]}`}>{label}</a>)}</div></nav>
  <section id="coverage" class="section wrap"><header class="section-heading"><p class="eyebrow">{copy.scopeKicker}</p><h2>{copy.scope}</h2><p>{copy.scopeNote}</p></header><dl class="metrics">{copy.metrics.map(metric=><div><dt>{metric[0]}</dt><dd>{typeof metric[1] === 'number' ? Number(metric[1]).toLocaleString(dateLocale) : metric[1]}</dd><p>{metric[2]}</p></div>)}</dl><p class="coverage-note">{copy.coverage}: <strong>{summary.coverage_start ?? '—'}</strong> – <strong>{summary.coverage_end ?? '—'}</strong></p></section>
  <section id="workflow" class="band"><div class="wrap"><header class="section-heading"><p class="eyebrow">{copy.workflowKicker}</p><h2>{copy.workflow}</h2><p>{copy.workflowNote}</p></header><ol class="workflow">{copy.steps.map((step,index)=><li><span>{String(index+1).padStart(2,'0')}</span><div><h3>{step[0]}</h3><p>{step[1]}</p></div></li>)}</ol></div></section>
  <section id="principles" class="section wrap"><header class="section-heading"><p class="eyebrow">{copy.principlesKicker}</p><h2>{copy.principlesTitle}</h2></header><div class="principles">{copy.principles.map((item,index)=><section><span>{String(index+1).padStart(2,'0')}</span><h3>{item[0]}</h3><p>{item[1]}</p></section>)}</div></section>
  <section id="limitations" class="band"><div class="wrap two-column"><div><p class="eyebrow">{copy.limitsKicker}</p><h2>{copy.limitsTitle}</h2></div><div class="prose">{copy.limits.map(item=><p>{item}</p>)}<div class="actions"><a class="primary" href={`${prefix}/downloads/`}>{copy.downloads}</a><a href={`${prefix}/copyright/`}>{copy.guidance}</a></div></div></div></section>
  <section id="project" class="section wrap two-column"><div><p class="eyebrow">{copy.projectKicker}</p><h2>{copy.projectTitle}</h2></div><div class="prose">{copy.project.map(item=><p>{item}</p>)}<div class="actions"><a class="primary" href="https://github.com/xmusphlkg/globalID2" target="_blank" rel="noopener noreferrer">{copy.repository}</a><a href="https://github.com/xmusphlkg/globalID2/issues/new" target="_blank" rel="noopener noreferrer">{copy.correction}</a></div></div></section>
</article>

<style>
  .about-page{color:rgb(var(--text))}.wrap{width:min(1080px,calc(100% - 2rem));margin-inline:auto}.about-hero{padding-block:clamp(3.5rem,8vw,6rem);background:rgb(var(--surface));border-bottom:1px solid rgb(var(--border))}.hero-grid,.two-column{display:grid;grid-template-columns:minmax(16rem,.8fr) minmax(0,1.2fr);gap:clamp(2.5rem,8vw,7rem)}.eyebrow{margin:0 0 .65rem;color:rgb(var(--color-teal));font-size:.7rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}h1{max-width:15ch;margin:0;color:rgb(var(--text-strong));font-size:clamp(2.6rem,5.5vw,4.5rem);font-weight:650;line-height:1.04}.lead{margin:0;color:rgb(var(--text-strong));font-size:clamp(1.05rem,2vw,1.3rem);line-height:1.7}.updated{margin:1.2rem 0 0;color:rgb(var(--text-muted));font-size:.78rem}.local-nav{position:sticky;top:72px;z-index:20;background:rgb(var(--bg)/.96);border-bottom:1px solid rgb(var(--border));backdrop-filter:blur(12px)}.local-nav .wrap{display:flex;overflow-x:auto}.local-nav span,.local-nav a{padding:.8rem .75rem;white-space:nowrap}.local-nav span{color:rgb(var(--text-muted));font-size:.66rem;font-weight:700;text-transform:uppercase}.local-nav a{color:rgb(var(--text-strong));border-left:1px solid rgb(var(--border));font-size:.76rem;font-weight:650;text-decoration:none}.section,.band{padding-block:clamp(3.5rem,7vw,5.5rem);scroll-margin-top:8rem}.band{background:rgb(var(--surface));border-block:1px solid rgb(var(--border))}.section-heading{display:grid;grid-template-columns:minmax(15rem,.6fr) minmax(0,1fr);gap:.3rem 3rem;padding-bottom:1rem;border-bottom:2px solid rgb(var(--text-strong))}.section-heading .eyebrow{grid-column:1}.section-heading h2{grid-column:1;margin:0;color:rgb(var(--text-strong));font-size:clamp(1.65rem,3vw,2.25rem)}.section-heading>p:last-child{grid-column:2;grid-row:1/3;align-self:end;margin:0;color:rgb(var(--text-muted));font-size:.82rem;line-height:1.65}.metrics{display:grid;grid-template-columns:repeat(4,1fr);margin:2rem 0 0;border-top:1px solid rgb(var(--border));border-left:1px solid rgb(var(--border))}.metrics div{padding:1rem;border-right:1px solid rgb(var(--border));border-bottom:1px solid rgb(var(--border))}.metrics dt{color:rgb(var(--text-muted));font-size:.7rem}.metrics dd{margin:.5rem 0;color:rgb(var(--text-strong));font-size:1.5rem;font-weight:650}.metrics p,.coverage-note{color:rgb(var(--text-muted));font-size:.7rem;line-height:1.55}.coverage-note{margin:1rem 0 0}.workflow{list-style:none;margin:2rem 0 0;padding:0;border-top:1px solid rgb(var(--border))}.workflow li{display:grid;grid-template-columns:3rem 10rem 1fr;gap:1rem;padding:1.1rem 0;border-bottom:1px solid rgb(var(--border))}.workflow li>span,.principles>section>span{color:rgb(var(--color-teal));font-family:ui-monospace,monospace;font-size:.68rem}.workflow div{display:contents}.workflow h3,.principles h3{margin:0;color:rgb(var(--text-strong));font-size:.95rem}.workflow p,.principles p,.prose p{margin:0;color:rgb(var(--text-muted));font-size:.82rem;line-height:1.7}.principles{display:grid;grid-template-columns:repeat(2,1fr);margin-top:2rem;border-top:1px solid rgb(var(--border));border-left:1px solid rgb(var(--border))}.principles section{display:grid;grid-template-columns:2rem 1fr;gap:.4rem .8rem;padding:1.2rem;border-right:1px solid rgb(var(--border));border-bottom:1px solid rgb(var(--border))}.principles p{grid-column:2}.two-column h2{margin:0;color:rgb(var(--text-strong));font-size:clamp(1.65rem,3vw,2.25rem)}.prose{display:grid;gap:1rem}.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:.5rem}.actions a{padding:.6rem .85rem;color:rgb(var(--text-strong));border:1px solid rgb(var(--border));font-size:.78rem;font-weight:650;text-decoration:none}.actions .primary{color:#fff;background:rgb(var(--color-teal));border-color:rgb(var(--color-teal))}@media(max-width:760px){.hero-grid,.two-column,.section-heading{grid-template-columns:1fr;gap:1.5rem}.section-heading>p:last-child{grid-column:1;grid-row:auto}.metrics{grid-template-columns:1fr 1fr}.workflow li{grid-template-columns:2rem 1fr}.workflow div{display:block}.workflow p{margin-top:.25rem}.principles{grid-template-columns:1fr}}@media(max-width:480px){.metrics{grid-template-columns:1fr}}
</style>
