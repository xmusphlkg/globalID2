---
import aboutRaw from '../../data/about.json';
import { acknowledgementEntries, acknowledgementIntro } from '../../data/acknowledgements';
import PageAnchorNav from '../PageAnchorNav.astro';
import StatBar from '../StatBar.astro';

interface Props {
  locale?: 'en' | 'zh' | 'fr';
}

const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const about = aboutRaw as any;
const summary = about.summary ?? {};
const dateLocale = zh ? 'zh-CN' : fr ? 'fr-FR' : 'en-US';
const generatedAt = about.generated_at
  ? new Date(about.generated_at).toLocaleDateString(dateLocale, {
      year: 'numeric',
      month: zh ? 'numeric' : 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : zh ? '暂无' : fr ? 'Non disponible' : 'Not available';

const copy = zh ? {
  eyebrow: '方法与关于',
  title: '每条证据都可以追溯到来源',
  lead: 'GIDS 整理公共卫生机构发布的传染病监测记录，在保留原始报告语境的同时，让数据更容易查找、理解和复核。',
  updated: `公开数据快照更新于 ${generatedAt}。各来源的覆盖和发布时间不同。`,
  onPage: '本页目录',
  nav: ['项目与维护者', '数据与方法', '使用边界', '致谢'],
  story: {
    kicker: '项目与维护者',
    title: '从居家学习时的一份记录，到今天的全球监测项目',
    lead: 'GIDS 并非始于一份完整的项目计划。2021 年，我只是想把不断更新、散落各处的传染病监测数据保存下来。这次个人的数据整理，后来慢慢变成了一个持续至今的公开项目。',
    milestones: [
      ['2021', '从一个个人需求开始', '受 COVID-19 疫情影响，我不得不在家远程学习。为了不让持续更新的月度数据淹没在网页和表格中，我开始系统整理中国法定报告传染病。'],
      ['2024', '当数据成为研究的一部分', '几年的持续积累，支撑了我与合作者对 COVID-19 前后中国 24 种法定报告传染病变化的研究。'],
      ['2025', '把同样的方法带向更多国家', '项目开始从中国扩展至全球。这不只是增加国家页面，还意味着理解不同报告制度，并保留每个数据源的原有语境。'],
      ['2026', '让一个人的项目走得更远', '在 Codex 的帮助下，我继续扩充数据源，并重新整理采集、标准化、检查和发布流程。'],
    ],
    paperLabel: '阅读 2024 年论文',
    current: '当前阶段',
  },
  maintainer: {
    label: '维护者',
    name: '李康国',
    role: '厦门大学公共卫生学院博士研究生',
    bio: '我目前攻读流行病与卫生统计学博士学位，预计于 2027 年毕业。GIDS 对我来说不只是一个作品集项目，更像是一段长期训练：学习如何把公共卫生问题、真实世界数据、软件工程和可复核的证据链放在一起。',
    focus: ['流行病学', '卫生统计', '真实世界研究', '健康数据', '数据工程', '健康 AI'],
    opportunityTitle: '真诚寻求实习与未来工作机会',
    opportunityIntro: '我目前正在认真寻找实习机会，也提前期待博士毕业后的长期工作。如果您的团队愿意给我一个参与实际项目、继续学习并承担责任的机会，无论是在药企、生物医药公司还是科研单位，我都十分愿意了解和尝试。',
    opportunityNowLabel: '现在 · 实习',
    opportunityNow: '目前，我真诚希望获得药企、生物医药公司或科研单位的实习机会。流行病学、卫生统计、真实世界研究、健康数据平台与健康 AI 是我较熟悉并希望继续深耕的方向；如果岗位名称或具体任务有所不同，只要我的能力能为团队提供帮助，我也愿意认真了解、尽快学习并踏实投入。',
    opportunityFutureLabel: '未来 · 长期工作',
    opportunityFuture: '预计 2027 年博士毕业后，我愿意进入药企、生物医药公司或科研单位长期工作，也会认真考虑研究方向和团队契合的博士后机会。如果一段实习有机会延续为长期合作，我会格外珍惜。',
    opportunityCommitment: '我知道，学历和项目经历只是起点，真正的信任要靠具体工作一点点建立。我愿意从基础而细致的工作做起，尊重团队已有的方法与节奏，按时、可靠地完成任务；遇到不了解的地方会主动学习，也会诚实说明自己的能力边界。无论您目前有正式岗位、实习名额，还是只是愿意先聊聊可能的合作，我都非常感谢，也欢迎直接给我发邮件。我会认真阅读每一封来信并尽快回复。实习时间与形式可以沟通；可全球远程，也可在中国大陆或香港线下工作。',
    profile: '访问个人主页',
    email: '直接邮件联系我',
  },
  data: {
    kicker: '数据与方法',
    title: '数据如何进入网站',
    lead: '网站只发布已通过基本来源、完整性和一致性检查的公开记录。以下数字描述当前快照，不代表全球传染病的完整负担。',
    metrics: [
      ['国家与地区', summary.total_countries ?? 0],
      ['收录疾病', summary.total_diseases ?? 0],
      ['公开记录', summary.total_cases ?? 0],
      ['最新报告日期', summary.coverage_end ?? '暂无'],
    ],
    coverage: `时间覆盖 ${summary.coverage_start ?? '—'} – ${summary.coverage_end ?? '—'}`,
    steps: [
      ['采集', '从已配置的官方卫生机构来源获取新发布记录。'],
      ['标准化', '统一疾病名称、地点、日期和指标，但保留原始报告粒度。'],
      ['检查', '在公开前检查完整性、一致性、来源与发布条件。'],
      ['发布', '更新页面与下载文件，同时保留来源链接、局限和纠错入口。'],
    ],
    notes: [
      ['官方来源', '每个数据集都保留负责机构、来源链接和覆盖周期。'],
      ['保留语境', '不默认不同报告系统可直接比较，原始定义与时间粒度随数据保留。'],
      ['缺失不是零', '未提供的字段和未报告的周期保持缺失，不会被默认转换为零。'],
    ],
  },
  responsibility: {
    kicker: '使用边界',
    title: '如何负责任地使用 GIDS',
    lead: '这里的数据适合用于监测、研究和证据导航，但不能脱离原始报告制度单独解读。',
    items: [
      ['不是临床或疫情声明工具', 'GIDS 不代替国家和地方卫生机构的指导，也不用于个人诊断或风险判断。'],
      ['数字会修订，系统有差异', '病例定义、覆盖人群、报告延迟和时间粒度因地区而异；跨地区比较前应先阅读来源说明。'],
      ['自动化需要公开纠错', '采集、标准化和部分摘要由软件辅助完成。发现问题时，请提供页面、报告周期和用于比较的官方来源。'],
      ['独立性与复用', 'GIDS 是独立的公共利益项目，不代表所链接的机构。代码、公开数据产品与第三方来源应分别按其明确标注的规则使用。'],
    ],
    downloads: '浏览可下载数据',
    reuse: '阅读复用说明',
    repository: '查看源代码',
    correction: '提交数据纠错',
  },
} : {
  eyebrow: 'Methods & About',
  title: 'Evidence you can trace back to its source',
  lead: 'GIDS organizes infectious disease surveillance records published by public health authorities, making them easier to find, understand, and verify while preserving the context of the original reports.',
  updated: `Public data snapshot updated ${generatedAt}. Coverage and publication schedules vary by source.`,
  onPage: 'On this page',
  nav: ['Project & maintainer', 'Data & methods', 'Responsible use', 'Acknowledgements'],
  story: {
    kicker: 'Project & maintainer',
    title: 'What began as a record at home grew into a global surveillance project',
    lead: 'GIDS did not begin with a complete roadmap. In 2021, I simply wanted to preserve surveillance data that kept changing and disappearing into scattered webpages and spreadsheets. That personal archive gradually became the public project I still maintain today.',
    milestones: [
      ['2021', 'It started with a personal need', 'When COVID-19 forced me to study remotely from home, I began organizing China\'s monthly notifiable infectious disease reports so that each release would not disappear into another webpage or spreadsheet.'],
      ['2024', 'The archive became part of the research', 'Several years of accumulation supported research with my collaborators on changes in 24 notifiable infectious diseases in China before and during COVID-19.'],
      ['2025', 'The same approach moved beyond China', 'The project began expanding globally. This meant more than adding country pages: it required understanding different reporting systems while keeping the original context of every source visible.'],
      ['2026', 'Making a personal project sustainable', 'With help from Codex, I continue to add sources and reshape the collection, standardization, checking, and publication workflows.'],
    ],
    paperLabel: 'Read the 2024 paper',
    current: 'Current',
  },
  maintainer: {
    label: 'Maintainer',
    name: 'Kangguo Li',
    role: 'Doctoral researcher, School of Public Health, Xiamen University',
    bio: 'I am pursuing a doctorate in Epidemiology and Health Statistics and expect to graduate in 2027. GIDS is not only a portfolio project for me; it is a long-running way to practice putting public health questions, real-world data, software engineering, and reviewable evidence together.',
    focus: ['Epidemiology', 'Health statistics', 'Real-world research', 'Health data', 'Data engineering', 'Health AI'],
    opportunityTitle: 'Sincerely seeking internships and future roles',
    opportunityIntro: 'I am actively seeking an internship now and looking ahead to long-term work after my doctorate. If your team can offer me the opportunity to contribute to real projects, keep learning, and take responsibility, I would be genuinely glad to explore it—whether with a pharmaceutical or biotechnology company or a research institute.',
    opportunityNowLabel: 'Now · Internships',
    opportunityNow: 'I sincerely welcome internship opportunities with pharmaceutical or biotechnology companies and research institutes. Epidemiology, health statistics, real-world research, health-data platforms, and health AI are the areas I know best and hope to deepen, but I am also open to roles with different titles or responsibilities when my skills could be useful. I am ready to learn quickly and contribute with care.',
    opportunityFutureLabel: 'After the PhD · Long-term roles',
    opportunityFuture: 'After completing my doctorate in 2027, I would be glad to build a long-term career in a pharmaceutical or biotechnology company or a research institute. I will also seriously consider postdoctoral opportunities where the research and team are a good fit. I would especially value an internship that could grow into a longer collaboration.',
    opportunityCommitment: 'I know that degrees and project experience are only a starting point; trust is earned through the work itself. I am willing to begin with foundational, detailed tasks, respect the team\'s established methods and pace, and deliver reliably and on time. I will actively learn when something is new to me and be honest about the limits of my current experience. Whether you have a formal role, an internship opening, or simply would like to discuss a possible collaboration, I would be grateful to hear from you. I read every message carefully and will reply as soon as I can. Internship timing and format are flexible; I can work remotely worldwide or on site in mainland China or Hong Kong.',
    profile: 'Visit my personal website',
    email: 'Email me directly',
  },
  data: {
    kicker: 'Data & methods',
    title: 'How data reaches the site',
    lead: 'Only public records that pass basic provenance, completeness, and consistency checks are published. These figures describe the current snapshot, not the full global burden of infectious disease.',
    metrics: [
      ['Countries and regions', summary.total_countries ?? 0],
      ['Diseases tracked', summary.total_diseases ?? 0],
      ['Published records', summary.total_cases ?? 0],
      ['Latest reporting date', summary.coverage_end ?? 'Not available'],
    ],
    coverage: `Time coverage ${summary.coverage_start ?? '—'} – ${summary.coverage_end ?? '—'}`,
    steps: [
      ['Collect', 'Retrieve newly published records from configured official health authority sources.'],
      ['Standardize', 'Align disease names, places, dates, and measures while preserving the original reporting grain.'],
      ['Check', 'Review completeness, consistency, provenance, and publication conditions before release.'],
      ['Publish', 'Refresh pages and downloads while retaining source links, limitations, and correction routes.'],
    ],
    notes: [
      ['Official sources', 'Each dataset retains the responsible authority, source link, and coverage period.'],
      ['Context stays visible', 'Reporting systems are not assumed to be directly comparable; original definitions and temporal grain remain visible.'],
      ['Missing is not zero', 'Unavailable fields and unreported periods remain missing rather than being silently converted to zero.'],
    ],
  },
  responsibility: {
    kicker: 'Responsible use',
    title: 'How to use GIDS responsibly',
    lead: 'These data support surveillance, research, and evidence navigation, but should not be interpreted outside the context of the original reporting system.',
    items: [
      ['Not a clinical or outbreak declaration tool', 'GIDS does not replace guidance from national or local health authorities and should not be used for personal diagnosis or risk decisions.'],
      ['Figures change and systems differ', 'Case definitions, covered populations, reporting delays, and temporal grain vary. Read the source notes before making cross-jurisdiction comparisons.'],
      ['Automation needs public correction routes', 'Collection, standardization, and parts of summarization are software-assisted. Reports should include the page, period, and official comparison source.'],
      ['Independence and reuse', 'GIDS is an independent public-interest project and does not represent linked institutions. Code, public data products, and third-party sources follow their separately stated rules.'],
    ],
    downloads: 'Explore downloadable data',
    reuse: 'Read reuse guidance',
    repository: 'View source code',
    correction: 'Report a data correction',
  },
};

if (fr) {
  Object.assign(copy, {
    eyebrow: 'Méthodes et à propos', title: 'Chaque preuve remonte à sa source',
    lead: 'GIDS organise les données de surveillance des maladies infectieuses publiées par les autorités de santé, afin de les rendre plus faciles à trouver, comprendre et vérifier tout en préservant le contexte des rapports originaux.',
    updated: `Instantané public mis à jour le ${generatedAt}. La couverture et les calendriers de publication varient selon les sources.`,
    onPage: 'Sur cette page', nav: ['Projet et responsable', 'Données et méthodes', 'Utilisation responsable', 'Remerciements'],
    story: { ...copy.story, kicker: 'Projet et responsable', title: 'D’un relevé personnel à un projet mondial de surveillance', lead: 'GIDS est né en 2021 pour conserver des données de surveillance qui évoluaient et disparaissaient dans des pages web et feuilles de calcul dispersées. Cette archive personnelle est devenue le projet public que je maintiens aujourd’hui.', paperLabel: 'Lire l’article de 2024', current: 'Période actuelle' },
    maintainer: { ...copy.maintainer, label: 'Responsable', role: 'Doctorant, École de santé publique, Université de Xiamen', bio: 'Je prépare un doctorat en épidémiologie et statistiques de santé, avec une diplomation prévue en 2027. GIDS me permet de réunir questions de santé publique, données réelles, ingénierie logicielle et chaîne de preuves vérifiable.', focus: ['Épidémiologie', 'Statistiques de santé', 'Recherche en vie réelle', 'Données de santé', 'Ingénierie des données', 'IA en santé'], opportunityTitle: 'Je recherche sincèrement un stage et de futures opportunités', opportunityIntro: 'Je recherche activement un stage dès maintenant et j\'envisage aussi un emploi à long terme après mon doctorat. Si votre équipe peut me donner l\'occasion de contribuer à des projets concrets, de continuer à apprendre et de prendre des responsabilités, je serais très heureux d\'en discuter, qu\'il s\'agisse d\'une entreprise pharmaceutique ou biotechnologique ou d\'un organisme de recherche.', opportunityNowLabel: 'Maintenant · Stages', opportunityNow: 'Je souhaite sincèrement effectuer un stage dans une entreprise pharmaceutique ou biotechnologique, ou dans un organisme de recherche. L\'épidémiologie, les statistiques de santé, la recherche en vie réelle, les plateformes de données de santé et l\'IA en santé sont les domaines que je connais le mieux et que je souhaite approfondir. Je reste également ouvert à d\'autres intitulés ou missions lorsque mes compétences peuvent être utiles, et je suis prêt à apprendre rapidement et à m\'investir avec sérieux.', opportunityFutureLabel: 'Après le doctorat · Emploi à long terme', opportunityFuture: 'Après mon doctorat, prévu en 2027, je souhaiterais construire une carrière à long terme dans une entreprise pharmaceutique ou biotechnologique, ou dans un organisme de recherche. J\'étudierai aussi sérieusement les possibilités de postdoctorat lorsque le sujet et l\'équipe correspondent bien. J\'accorderais une valeur particulière à un stage susceptible de devenir une collaboration durable.', opportunityCommitment: 'Je sais que les diplômes et les projets ne sont qu\'un point de départ : la confiance se gagne par le travail concret. Je suis prêt à commencer par des tâches fondamentales et minutieuses, à respecter les méthodes et le rythme de l\'équipe, et à tenir mes engagements avec fiabilité. Face à un sujet nouveau, j\'apprendrai activement et je serai honnête sur les limites de mon expérience actuelle. Que vous ayez un poste, une place de stage ou simplement l\'envie d\'échanger sur une collaboration possible, je vous serais reconnaissant de me contacter. Je lirai chaque message avec attention et répondrai dès que possible. Les dates et modalités du stage sont flexibles ; je peux travailler à distance dans le monde entier ou sur site en Chine continentale ou à Hong Kong.', profile: 'Visiter mon site personnel', email: 'M\'écrire directement' },
    data: { ...copy.data, kicker: 'Données et méthodes', title: 'Comment les données arrivent sur le site', lead: 'Seuls les enregistrements publics qui passent les contrôles de provenance, complétude et cohérence sont publiés. Ces chiffres décrivent l’instantané actuel, pas la charge mondiale complète des maladies infectieuses.', metrics: [['Pays et régions', summary.total_countries ?? 0], ['Maladies suivies', summary.total_diseases ?? 0], ['Enregistrements publiés', summary.total_cases ?? 0], ['Dernière date de déclaration', summary.coverage_end ?? 'Non disponible']], coverage: `Période couverte ${summary.coverage_start ?? '—'} – ${summary.coverage_end ?? '—'}`, steps: [['Collecter', 'Récupérer les nouveaux enregistrements publiés par les autorités sanitaires officielles configurées.'], ['Standardiser', 'Harmoniser noms, lieux, dates et mesures tout en conservant le niveau de détail d’origine.'], ['Vérifier', 'Contrôler complétude, cohérence, provenance et conditions de publication avant diffusion.'], ['Publier', 'Actualiser pages et téléchargements en conservant sources, limites et voies de correction.']], notes: [['Sources officielles', 'Chaque jeu de données conserve l’autorité responsable, le lien source et la période couverte.'], ['Contexte conservé', 'Les systèmes de déclaration ne sont pas supposés directement comparables ; définitions et granularité restent visibles.'], ['Manquant ne signifie pas zéro', 'Les champs indisponibles et périodes non déclarées restent manquants.']] },
    responsibility: { ...copy.responsibility, kicker: 'Utilisation responsable', title: 'Utiliser GIDS de manière responsable', lead: 'Ces données servent à la surveillance, à la recherche et à l’orientation vers les preuves, mais doivent rester interprétées dans leur système de déclaration d’origine.', items: [['Ni outil clinique ni déclaration d’épidémie', 'GIDS ne remplace pas les autorités sanitaires et ne doit pas servir au diagnostic ou aux décisions de risque personnels.'], ['Les chiffres évoluent et les systèmes diffèrent', 'Définitions de cas, populations couvertes, délais et granularité varient ; lisez les notes sources avant toute comparaison.'], ['L’automatisation exige des corrections publiques', 'La collecte, la standardisation et une partie des synthèses sont assistées par logiciel ; signalez les problèmes avec leur source officielle.'], ['Indépendance et réutilisation', 'GIDS est un projet indépendant d’intérêt public et ne représente pas les institutions liées ; chaque code, donnée ou source suit ses propres règles.']], downloads: 'Explorer les données téléchargeables', reuse: 'Lire les règles de réutilisation', repository: 'Voir le code source', correction: 'Signaler une correction' },
  });
}

const ids = ['maintainer', 'data-methods', 'responsible-use', 'acknowledgements'];
const anchorItems = ids.map((id, index) => ({ href: `#${id}`, label: copy.nav[index], labelZh: copy.nav[index], labelFr: copy.nav[index] }));
---

<article class="about-page">
  <header class="about-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <div>
        <p class="lead">{copy.lead}</p>
        <p class="updated">{copy.updated}</p>
      </div>
    </div>
  </header>

  <div class="about-nav">
    <div class="wrap">
      <PageAnchorNav items={anchorItems} locale={locale} label={copy.onPage} labelZh={copy.onPage} numbered showTitle={false} />
    </div>
  </div>

  <section id="maintainer" class="band">
    <div class="wrap">
      <header class="section-heading">
        <p class="eyebrow">{copy.story.kicker}</p>
        <h2>{copy.story.title}</h2>
        <p>{copy.story.lead}</p>
      </header>

      <ol class="timeline">
        {copy.story.milestones.map((milestone, index) => (
          <li class:list={[index === copy.story.milestones.length - 1 && 'timeline-current']}>
            <div class="timeline-marker">
              <span class="timeline-node" aria-hidden="true"></span>
              <time datetime={milestone[0]}>{milestone[0]}</time>
              <i aria-hidden="true"></i>
            </div>
            <div>
              {index === copy.story.milestones.length - 1 && <span class="timeline-current-label">{copy.story.current}</span>}
              <h3>{milestone[1]}</h3>
              <p>{milestone[2]}</p>
              {index === 1 && (
                <a class="text-link" href="https://www.nature.com/articles/s41467-024-48201-8" target="_blank" rel="noopener noreferrer">
                  {copy.story.paperLabel}<span aria-hidden="true"> ↗</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>

      <article class="maintainer-card">
        <div class="maintainer-identity">
          <p class="eyebrow">{copy.maintainer.label}</p>
          <h3>{copy.maintainer.name}</h3>
          <p class="maintainer-role">{copy.maintainer.role}</p>
          <p>{copy.maintainer.bio}</p>
          <ul class="focus-list" aria-label={zh ? '专业方向' : fr ? 'Domaines d’expertise' : 'Areas of focus'}>
            {copy.maintainer.focus.map(area => <li>{area}</li>)}
          </ul>
        </div>
        <div class="opportunity">
          <span class="availability-dot" aria-hidden="true"></span>
          <p class="opportunity-label">{copy.maintainer.opportunityTitle}</p>
          <p class="opportunity-intro">{copy.maintainer.opportunityIntro}</p>
          <div class="opportunity-paths">
            <div>
              <p class="opportunity-path-label">{copy.maintainer.opportunityNowLabel}</p>
              <p>{copy.maintainer.opportunityNow}</p>
            </div>
            <div>
              <p class="opportunity-path-label">{copy.maintainer.opportunityFutureLabel}</p>
              <p>{copy.maintainer.opportunityFuture}</p>
            </div>
          </div>
          <p class="opportunity-commitment">{copy.maintainer.opportunityCommitment}</p>
          <div class="actions">
            <a class="site-action-primary" href="https://kangguo.online/" target="_blank" rel="me noopener noreferrer">
              {copy.maintainer.profile}<span aria-hidden="true"> ↗</span>
            </a>
            <a class="site-action-secondary" href="mailto:lkg1116@outlook.com">{copy.maintainer.email}</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="data-methods" class="section wrap">
    <header class="section-heading">
      <p class="eyebrow">{copy.data.kicker}</p>
      <h2>{copy.data.title}</h2>
      <p>{copy.data.lead}</p>
    </header>

    <div class="metrics">
      <StatBar locale={locale} stats={copy.data.metrics.map(metric => ({
        label: metric[0],
        labelZh: metric[0],
        value: typeof metric[1] === 'number' ? Number(metric[1]).toLocaleString(dateLocale) : metric[1],
        accent: 'teal' as const,
      }))} />
    </div>
    <p class="coverage-note">{copy.data.coverage}</p>

    <ol class="workflow">
      {copy.data.steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{step[0]}</h3>
          <p>{step[1]}</p>
        </li>
      ))}
    </ol>

    <div class="data-notes">
      {copy.data.notes.map(note => (
        <article>
          <h3>{note[0]}</h3>
          <p>{note[1]}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="responsible-use" class="band">
    <div class="wrap">
      <header class="section-heading">
        <p class="eyebrow">{copy.responsibility.kicker}</p>
        <h2>{copy.responsibility.title}</h2>
        <p>{copy.responsibility.lead}</p>
      </header>
      <div class="responsibility-grid">
        {copy.responsibility.items.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item[0]}</h3>
            <p>{item[1]}</p>
          </article>
        ))}
      </div>
      <div class="actions responsibility-actions">
        <a class="site-action-primary" href={`${prefix}/downloads/`}>{copy.responsibility.downloads}</a>
        <a class="site-action-secondary" href={`${prefix}/copyright/`}>{copy.responsibility.reuse}</a>
        <a class="site-action-secondary" href="https://github.com/xmusphlkg/globalID2" target="_blank" rel="noopener noreferrer">{copy.responsibility.repository}</a>
        <a class="site-action-secondary" href="https://github.com/xmusphlkg/globalID2/issues/new" target="_blank" rel="noopener noreferrer">{copy.responsibility.correction}</a>
      </div>
    </div>
  </section>

  <section id="acknowledgements" class="section wrap">
    <header class="section-heading acknowledgements-heading">
      <p class="eyebrow">{zh ? acknowledgementIntro.kickerZh : fr ? 'Remerciements' : acknowledgementIntro.kickerEn}</p>
      <h2>{zh ? acknowledgementIntro.titleZh : fr ? 'Merci aux sources et collaborateurs' : acknowledgementIntro.titleEn}</h2>
      <p>{zh ? acknowledgementIntro.leadZh : fr ? 'GIDS remercie les autorités, chercheurs et contributeurs qui rendent ces données de surveillance accessibles.' : acknowledgementIntro.leadEn}</p>
    </header>
    <div class="acknowledgements">
      {acknowledgementEntries.map(entry => (
        <article>
          <h3>{entry.name}</h3>
          <p class="affiliation">{zh ? entry.affiliationZh : entry.affiliationEn}</p>
          <p>{zh ? entry.contributionZh : fr ? entry.contributionEn : entry.contributionEn}</p>
          <ul aria-label={zh ? '贡献类型' : fr ? 'Types de contribution' : 'Contribution types'}>
            {entry.roles.map(role => <li>{zh ? role.zh : fr ? role.en : role.en}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <p class="acknowledgement-note">{zh ? acknowledgementIntro.noteZh : fr ? 'Les liens et attributions restent visibles afin de faciliter la vérification et la réutilisation responsable.' : acknowledgementIntro.noteEn}</p>
  </section>
</article>

