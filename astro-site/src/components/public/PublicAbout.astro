---
import aboutRaw from '../../data/about.json';
import { acknowledgementEntries, acknowledgementIntro } from '../../data/acknowledgements';
import PageAnchorNav from '../PageAnchorNav.astro';
import StatBar from '../StatBar.astro';

interface Props {
  locale?: 'en' | 'zh';
}

const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const about = aboutRaw as any;
const summary = about.summary ?? {};
const dateLocale = zh ? 'zh-CN' : 'en-US';
const generatedAt = about.generated_at
  ? new Date(about.generated_at).toLocaleDateString(dateLocale, {
      year: 'numeric',
      month: zh ? 'numeric' : 'long',
      day: 'numeric',
      timeZone: 'UTC',
    })
  : zh ? '暂无' : 'Not available';

const copy = zh ? {
  eyebrow: '方法与关于',
  title: '每条证据都可以追溯到来源',
  lead: 'GIDS 整理公共卫生机构发布的传染病监测记录，在保留原始报告语境的同时，让数据更容易查找、理解和复核。',
  updated: `公开数据快照更新于 ${generatedAt}。各来源的覆盖和发布时间不同。`,
  onPage: '本页目录',
  nav: ['项目与维护者', '数据与方法', '使用边界', '致谢'],
  story: {
    kicker: '项目与维护者',
    title: '从居家学习时的一份记录，到今天的全球监测项目',
    lead: 'GIDS 并非始于一份完整的项目计划。2021 年，我只是想把不断更新、散落各处的传染病监测数据保存下来。这次个人的数据整理，后来慢慢变成了一个持续至今的公开项目。',
    milestones: [
      ['2021', '从一个个人需求开始', '受 COVID-19 疫情影响，我不得不在家远程学习。为了不让持续更新的月度数据淹没在网页和表格中，我开始系统整理中国法定报告传染病。'],
      ['2024', '当数据成为研究的一部分', '几年的持续积累，支撑了我与合作者对 COVID-19 前后中国 24 种法定报告传染病变化的研究。'],
      ['2025', '把同样的方法带向更多国家', '项目开始从中国扩展至全球。这不只是增加国家页面，还意味着理解不同报告制度，并保留每个数据源的原有语境。'],
      ['2026', '让一个人的项目走得更远', '在 Codex 的帮助下，我继续扩充数据源，并重新整理采集、标准化、检查和发布流程。'],
    ],
    paperLabel: '阅读 2024 年论文',
    current: '当前阶段',
  },
  maintainer: {
    label: '维护者',
    name: '李康国',
    role: '厦门大学公共卫生学院博士研究生',
    bio: '我目前攻读流行病与卫生统计学博士学位，预计于 2027 年毕业。GIDS 对我来说不只是一个作品集项目，更像是一段长期训练：学习如何把公共卫生问题、真实世界数据、软件工程和可复核的证据链放在一起。',
    focus: ['流行病学', '卫生统计', '健康数据', '数据工程', '健康 AI'],
    opportunityTitle: '实习、博士后与合作',
    opportunity: '我正在寻找公共卫生、流行病学、卫生统计、健康数据平台或健康 AI 方向的实习机会；也希望提前认识可能合适的博士后团队。我期待加入愿意认真对待数据质量、开放方法和实际公共卫生问题的团队，在研究和工程之间做踏实、有用的工作。可全球远程，也可在中国大陆或香港线下工作。',
    profile: '访问个人主页',
    email: '邮件联系',
  },
  data: {
    kicker: '数据与方法',
    title: '数据如何进入网站',
    lead: '网站只发布已通过基本来源、完整性和一致性检查的公开记录。以下数字描述当前快照，不代表全球传染病的完整负担。',
    metrics: [
      ['国家与地区', summary.total_countries ?? 0],
      ['收录疾病', summary.total_diseases ?? 0],
      ['公开记录', summary.total_cases ?? 0],
      ['最新报告日期', summary.coverage_end ?? '暂无'],
    ],
    coverage: `时间覆盖 ${summary.coverage_start ?? '—'} – ${summary.coverage_end ?? '—'}`,
    steps: [
      ['采集', '从已配置的官方卫生机构来源获取新发布记录。'],
      ['标准化', '统一疾病名称、地点、日期和指标，但保留原始报告粒度。'],
      ['检查', '在公开前检查完整性、一致性、来源与发布条件。'],
      ['发布', '更新页面与下载文件，同时保留来源链接、局限和纠错入口。'],
    ],
    notes: [
      ['官方来源', '每个数据集都保留负责机构、来源链接和覆盖周期。'],
      ['保留语境', '不默认不同报告系统可直接比较，原始定义与时间粒度随数据保留。'],
      ['缺失不是零', '未提供的字段和未报告的周期保持缺失，不会被默认转换为零。'],
    ],
  },
  responsibility: {
    kicker: '使用边界',
    title: '如何负责任地使用 GIDS',
    lead: '这里的数据适合用于监测、研究和证据导航，但不能脱离原始报告制度单独解读。',
    items: [
      ['不是临床或疫情声明工具', 'GIDS 不代替国家和地方卫生机构的指导，也不用于个人诊断或风险判断。'],
      ['数字会修订，系统有差异', '病例定义、覆盖人群、报告延迟和时间粒度因地区而异；跨地区比较前应先阅读来源说明。'],
      ['自动化需要公开纠错', '采集、标准化和部分摘要由软件辅助完成。发现问题时，请提供页面、报告周期和用于比较的官方来源。'],
      ['独立性与复用', 'GIDS 是独立的公共利益项目，不代表所链接的机构。代码、公开数据产品与第三方来源应分别按其明确标注的规则使用。'],
    ],
    downloads: '浏览可下载数据',
    reuse: '阅读复用说明',
    repository: '查看源代码',
    correction: '提交数据纠错',
  },
} : {
  eyebrow: 'Methods & About',
  title: 'Evidence you can trace back to its source',
  lead: 'GIDS organizes infectious disease surveillance records published by public health authorities, making them easier to find, understand, and verify while preserving the context of the original reports.',
  updated: `Public data snapshot updated ${generatedAt}. Coverage and publication schedules vary by source.`,
  onPage: 'On this page',
  nav: ['Project & maintainer', 'Data & methods', 'Responsible use', 'Acknowledgements'],
  story: {
    kicker: 'Project & maintainer',
    title: 'What began as a record at home grew into a global surveillance project',
    lead: 'GIDS did not begin with a complete roadmap. In 2021, I simply wanted to preserve surveillance data that kept changing and disappearing into scattered webpages and spreadsheets. That personal archive gradually became the public project I still maintain today.',
    milestones: [
      ['2021', 'It started with a personal need', 'When COVID-19 forced me to study remotely from home, I began organizing China\'s monthly notifiable infectious disease reports so that each release would not disappear into another webpage or spreadsheet.'],
      ['2024', 'The archive became part of the research', 'Several years of accumulation supported research with my collaborators on changes in 24 notifiable infectious diseases in China before and during COVID-19.'],
      ['2025', 'The same approach moved beyond China', 'The project began expanding globally. This meant more than adding country pages: it required understanding different reporting systems while keeping the original context of every source visible.'],
      ['2026', 'Making a personal project sustainable', 'With help from Codex, I continue to add sources and reshape the collection, standardization, checking, and publication workflows.'],
    ],
    paperLabel: 'Read the 2024 paper',
    current: 'Current',
  },
  maintainer: {
    label: 'Maintainer',
    name: 'Kangguo Li',
    role: 'Doctoral researcher, School of Public Health, Xiamen University',
    bio: 'I am pursuing a doctorate in Epidemiology and Health Statistics and expect to graduate in 2027. GIDS is not only a portfolio project for me; it is a long-running way to practice putting public health questions, real-world data, software engineering, and reviewable evidence together.',
    focus: ['Epidemiology', 'Health statistics', 'Health data', 'Data engineering', 'Health AI'],
    opportunityTitle: 'Internships, postdoctoral roles & collaboration',
    opportunity: 'I am looking for internship opportunities in public health, epidemiology, health statistics, health-data platforms, or health AI, and I would also be glad to connect early with potential postdoctoral teams. I hope to join a group that takes data quality, open methods, and practical public health questions seriously, and to do careful, useful work across research and engineering. I can contribute remotely worldwide or work on site in mainland China or Hong Kong.',
    profile: 'Visit my personal website',
    email: 'Contact me by email',
  },
  data: {
    kicker: 'Data & methods',
    title: 'How data reaches the site',
    lead: 'Only public records that pass basic provenance, completeness, and consistency checks are published. These figures describe the current snapshot, not the full global burden of infectious disease.',
    metrics: [
      ['Countries and regions', summary.total_countries ?? 0],
      ['Diseases tracked', summary.total_diseases ?? 0],
      ['Published records', summary.total_cases ?? 0],
      ['Latest reporting date', summary.coverage_end ?? 'Not available'],
    ],
    coverage: `Time coverage ${summary.coverage_start ?? '—'} – ${summary.coverage_end ?? '—'}`,
    steps: [
      ['Collect', 'Retrieve newly published records from configured official health authority sources.'],
      ['Standardize', 'Align disease names, places, dates, and measures while preserving the original reporting grain.'],
      ['Check', 'Review completeness, consistency, provenance, and publication conditions before release.'],
      ['Publish', 'Refresh pages and downloads while retaining source links, limitations, and correction routes.'],
    ],
    notes: [
      ['Official sources', 'Each dataset retains the responsible authority, source link, and coverage period.'],
      ['Context stays visible', 'Reporting systems are not assumed to be directly comparable; original definitions and temporal grain remain visible.'],
      ['Missing is not zero', 'Unavailable fields and unreported periods remain missing rather than being silently converted to zero.'],
    ],
  },
  responsibility: {
    kicker: 'Responsible use',
    title: 'How to use GIDS responsibly',
    lead: 'These data support surveillance, research, and evidence navigation, but should not be interpreted outside the context of the original reporting system.',
    items: [
      ['Not a clinical or outbreak declaration tool', 'GIDS does not replace guidance from national or local health authorities and should not be used for personal diagnosis or risk decisions.'],
      ['Figures change and systems differ', 'Case definitions, covered populations, reporting delays, and temporal grain vary. Read the source notes before making cross-jurisdiction comparisons.'],
      ['Automation needs public correction routes', 'Collection, standardization, and parts of summarization are software-assisted. Reports should include the page, period, and official comparison source.'],
      ['Independence and reuse', 'GIDS is an independent public-interest project and does not represent linked institutions. Code, public data products, and third-party sources follow their separately stated rules.'],
    ],
    downloads: 'Explore downloadable data',
    reuse: 'Read reuse guidance',
    repository: 'View source code',
    correction: 'Report a data correction',
  },
};

const ids = ['maintainer', 'data-methods', 'responsible-use', 'acknowledgements'];
const anchorItems = ids.map((id, index) => ({ href: `#${id}`, label: copy.nav[index], labelZh: copy.nav[index] }));
---

<article class="about-page">
  <header class="about-hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
      </div>
      <div>
        <p class="lead">{copy.lead}</p>
        <p class="updated">{copy.updated}</p>
      </div>
    </div>
  </header>

  <div class="about-nav">
    <div class="wrap">
      <PageAnchorNav items={anchorItems} locale={locale} label={copy.onPage} labelZh={copy.onPage} numbered showTitle={false} />
    </div>
  </div>

  <section id="maintainer" class="band">
    <div class="wrap">
      <header class="section-heading">
        <p class="eyebrow">{copy.story.kicker}</p>
        <h2>{copy.story.title}</h2>
        <p>{copy.story.lead}</p>
      </header>

      <ol class="timeline">
        {copy.story.milestones.map((milestone, index) => (
          <li class:list={[index === copy.story.milestones.length - 1 && 'timeline-current']}>
            <div class="timeline-marker">
              <span class="timeline-node" aria-hidden="true"></span>
              <time datetime={milestone[0]}>{milestone[0]}</time>
              <i aria-hidden="true"></i>
            </div>
            <div>
              {index === copy.story.milestones.length - 1 && <span class="timeline-current-label">{copy.story.current}</span>}
              <h3>{milestone[1]}</h3>
              <p>{milestone[2]}</p>
              {index === 1 && (
                <a class="text-link" href="https://www.nature.com/articles/s41467-024-48201-8" target="_blank" rel="noopener noreferrer">
                  {copy.story.paperLabel}<span aria-hidden="true"> ↗</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>

      <article class="maintainer-card">
        <div class="maintainer-identity">
          <p class="eyebrow">{copy.maintainer.label}</p>
          <h3>{copy.maintainer.name}</h3>
          <p class="maintainer-role">{copy.maintainer.role}</p>
          <p>{copy.maintainer.bio}</p>
          <ul class="focus-list" aria-label={zh ? '专业方向' : 'Areas of focus'}>
            {copy.maintainer.focus.map(area => <li>{area}</li>)}
          </ul>
        </div>
        <div class="opportunity">
          <span class="availability-dot" aria-hidden="true"></span>
          <p class="opportunity-label">{copy.maintainer.opportunityTitle}</p>
          <p>{copy.maintainer.opportunity}</p>
          <div class="actions">
            <a class="site-action-primary" href="https://kangguo.online/" target="_blank" rel="me noopener noreferrer">
              {copy.maintainer.profile}<span aria-hidden="true"> ↗</span>
            </a>
            <a class="site-action-secondary" href="mailto:lkg1116@outlook.com">{copy.maintainer.email}</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="data-methods" class="section wrap">
    <header class="section-heading">
      <p class="eyebrow">{copy.data.kicker}</p>
      <h2>{copy.data.title}</h2>
      <p>{copy.data.lead}</p>
    </header>

    <div class="metrics">
      <StatBar locale={locale} stats={copy.data.metrics.map(metric => ({
        label: metric[0],
        labelZh: metric[0],
        value: typeof metric[1] === 'number' ? Number(metric[1]).toLocaleString(dateLocale) : metric[1],
        accent: 'teal' as const,
      }))} />
    </div>
    <p class="coverage-note">{copy.data.coverage}</p>

    <ol class="workflow">
      {copy.data.steps.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{step[0]}</h3>
          <p>{step[1]}</p>
        </li>
      ))}
    </ol>

    <div class="data-notes">
      {copy.data.notes.map(note => (
        <article>
          <h3>{note[0]}</h3>
          <p>{note[1]}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="responsible-use" class="band">
    <div class="wrap">
      <header class="section-heading">
        <p class="eyebrow">{copy.responsibility.kicker}</p>
        <h2>{copy.responsibility.title}</h2>
        <p>{copy.responsibility.lead}</p>
      </header>
      <div class="responsibility-grid">
        {copy.responsibility.items.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item[0]}</h3>
            <p>{item[1]}</p>
          </article>
        ))}
      </div>
      <div class="actions responsibility-actions">
        <a class="site-action-primary" href={`${prefix}/downloads/`}>{copy.responsibility.downloads}</a>
        <a class="site-action-secondary" href={`${prefix}/copyright/`}>{copy.responsibility.reuse}</a>
        <a class="site-action-secondary" href="https://github.com/xmusphlkg/globalID2" target="_blank" rel="noopener noreferrer">{copy.responsibility.repository}</a>
        <a class="site-action-secondary" href="https://github.com/xmusphlkg/globalID2/issues/new" target="_blank" rel="noopener noreferrer">{copy.responsibility.correction}</a>
      </div>
    </div>
  </section>

  <section id="acknowledgements" class="section wrap">
    <header class="section-heading acknowledgements-heading">
      <p class="eyebrow">{zh ? acknowledgementIntro.kickerZh : acknowledgementIntro.kickerEn}</p>
      <h2>{zh ? acknowledgementIntro.titleZh : acknowledgementIntro.titleEn}</h2>
      <p>{zh ? acknowledgementIntro.leadZh : acknowledgementIntro.leadEn}</p>
    </header>
    <div class="acknowledgements">
      {acknowledgementEntries.map(entry => (
        <article>
          <h3>{entry.name}</h3>
          <p class="affiliation">{zh ? entry.affiliationZh : entry.affiliationEn}</p>
          <p>{zh ? entry.contributionZh : entry.contributionEn}</p>
          <ul aria-label={zh ? '贡献类型' : 'Contribution types'}>
            {entry.roles.map(role => <li>{zh ? role.zh : role.en}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <p class="acknowledgement-note">{zh ? acknowledgementIntro.noteZh : acknowledgementIntro.noteEn}</p>
  </section>
</article>

<style>
  .about-page { color: rgb(var(--text)); }
  .wrap { width: min(1080px, calc(100% - 2rem)); margin-inline: auto; }
  .about-hero { padding-block: clamp(3.5rem, 8vw, 6rem); border-bottom: 1px solid rgb(var(--border)); background: rgb(var(--surface)); }
  .hero-grid { display: grid; grid-template-columns: minmax(16rem, .8fr) minmax(0, 1.2fr); gap: clamp(2.5rem, 8vw, 7rem); }
  .eyebrow { margin: 0 0 .65rem; color: rgb(var(--color-teal)); font-size: .7rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
  h1 { max-width: 15ch; margin: 0; color: rgb(var(--text-strong)); font-size: clamp(2.6rem, 5.5vw, 4.5rem); font-weight: 650; line-height: 1.04; }
  .lead { margin: 0; color: rgb(var(--text-strong)); font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.7; }
  .updated { margin: 1.2rem 0 0; color: rgb(var(--text-muted)); font-size: .78rem; }
  .about-nav { position: sticky; top: calc(4.5rem + 1px); z-index: 35; border-bottom: 1px solid rgb(var(--border) / .72); background: rgb(var(--bg) / .96); backdrop-filter: blur(12px); }
  .about-nav :global(.page-anchor-nav-sticky) { position: relative; top: auto; }
  .section, .band { padding-block: clamp(3.5rem, 7vw, 5.5rem); scroll-margin-top: 8rem; }
  .band { border-block: 1px solid rgb(var(--border)); background: rgb(var(--surface)); }
  .section-heading { display: grid; grid-template-columns: minmax(15rem, .65fr) minmax(0, 1fr); gap: .3rem 3rem; padding-bottom: 1rem; border-bottom: 2px solid rgb(var(--text-strong)); }
  .section-heading .eyebrow, .section-heading h2 { grid-column: 1; }
  .section-heading h2 { margin: 0; color: rgb(var(--text-strong)); font-size: clamp(1.65rem, 3vw, 2.25rem); }
  .section-heading > p:last-child { grid-column: 2; grid-row: 1 / 3; align-self: end; margin: 0; color: rgb(var(--text-muted)); font-size: .82rem; line-height: 1.65; }
  .timeline { display: grid; grid-template-columns: 1fr; gap: .8rem; margin: 2.25rem 0 0; padding: 0; list-style: none; }
  .timeline li { position: relative; display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: 1.1rem; min-width: 0; min-height: 14rem; padding: 1.3rem; border: 1px solid rgb(var(--border) / .85); border-top: 3px solid rgb(var(--border-soft)); background: rgb(var(--bg)); transition: border-color 180ms ease, transform 180ms ease; }
  .timeline li.timeline-current { border-top-color: rgb(var(--color-teal)); }
  .timeline-marker { min-width: 0; }
  .timeline-node { display: block; width: .58rem; height: .58rem; margin-bottom: .7rem; border: 2px solid rgb(var(--border-soft)); background: rgb(var(--bg)); }
  .timeline-current .timeline-node { border-color: rgb(var(--color-teal)); background: rgb(var(--color-teal)); box-shadow: 0 0 0 .35rem rgb(var(--color-teal) / .12); }
  .timeline-marker time { color: rgb(var(--color-teal)); font-family: ui-monospace, monospace; font-size: 1.05rem; font-weight: 700; }
  .timeline-marker i { display: none; }
  .timeline-current-label { display: inline-block; margin-bottom: .55rem; padding: .18rem .42rem; color: rgb(var(--color-teal)); background: rgb(var(--color-teal) / .1); box-shadow: inset 0 0 0 1px rgb(var(--color-teal) / .2); font-size: .6rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .timeline h3, .workflow h3, .data-notes h3, .responsibility-grid h3, .maintainer-card h3, .acknowledgements h3 { margin: 0; color: rgb(var(--text-strong)); font-size: .95rem; }
  .timeline p, .workflow p, .data-notes p, .responsibility-grid p, .maintainer-card p, .acknowledgements p { margin: .45rem 0 0; color: rgb(var(--text-muted)); font-size: .8rem; line-height: 1.68; }
  .text-link { display: inline-block; margin-top: .75rem; color: rgb(var(--color-teal)); font-size: .75rem; font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .maintainer-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); margin-top: 2.5rem; overflow: hidden; border: 1px solid rgb(var(--border)); border-top: 3px solid rgb(var(--color-teal)); background: rgb(var(--bg)); }
  .maintainer-identity, .opportunity { padding: clamp(1.25rem, 3vw, 2rem); }
  .maintainer-identity { border-right: 1px solid rgb(var(--border)); }
  .maintainer-card .maintainer-role { margin-top: .35rem; color: rgb(var(--text-strong)); font-weight: 650; }
  .focus-list { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .focus-list li { padding: .28rem .5rem; border: 1px solid rgb(var(--color-teal) / .18); color: rgb(var(--color-teal)); background: rgb(var(--color-teal) / .08); font-size: .68rem; font-weight: 700; }
  .opportunity { position: relative; background: rgb(var(--surface)); }
  .availability-dot { position: absolute; top: 2rem; right: 2rem; width: .55rem; height: .55rem; border-radius: 50%; background: rgb(var(--color-teal)); box-shadow: 0 0 0 5px rgb(var(--color-teal) / .1); }
  .maintainer-card .opportunity-label { margin: 0; color: rgb(var(--text-strong)); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .metrics { margin-top: 2rem; }
  .coverage-note { margin: .8rem 0 0; color: rgb(var(--text-muted)); font-size: .72rem; }
