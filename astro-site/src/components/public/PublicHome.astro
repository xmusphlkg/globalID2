---
import CountryCard from '../CountryCard.astro';
import CountryFlag from '../CountryFlag.astro';
import { hasCountryDataSnapshot } from '../../lib/country-coverage';
import { isSituationReportV3, type SituationReportV3 } from '../../utils/situation';
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import metaRaw from '../../data/meta.json';
import diseasesRaw from '../../data/diseases/index.json';
import reportsRaw from '../../data/reports/index.json';

interface Props { locale?: 'en' | 'zh'; }
const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const href = (path: string) => `${prefix}${path}`;
const copy = zh ? {
  eyebrow: '官方来源的公共卫生数据', title: '全球传染病监测',
  summary: '浏览各报告地区的疾病记录、官方来源背景、当前态势复核与可复用数据集。',
  searchLabel: '检索数据与证据', searchPlaceholder: '搜索国家、疾病、报告或研究', search: '搜索',
  situation: '查看当前态势', countries: '探索国家与地区', diseases: '浏览疾病',
  coverage: '当前覆盖', glance: '数据概览', updated: '已更新', jurisdictions: '国家与地区', tracked: '收录疾病', records: '监测记录', through: '数据截至',
  coverageNote: '各官方来源的覆盖和更新时间不同；没有记录不代表没有疾病。', methods: '查看来源与方法',
  review: '态势复核', attention: '当前需要关注什么', reviewText: '最新复核同时展示统计监测信号与独立发布的官方事件。统计信号用于筛查，并不等同于疫情声明。',
  events: '官方事件', signals: '公开信号', reviewed: '复核地区', fullReview: '查看完整态势复核',
  explore: '探索监测数据', start: '从地区或疾病开始', downloads: '进入数据下载', countryList: '国家与地区', viewAll: '查看全部', common: '常用疾病入口',
  analysis: '已发布分析', latest: '最新监测报告', research: '浏览研究证据', open: '打开报告', empty: '当前没有公开报告。', unavailable: '暂无',
} : {
  eyebrow: 'Official-source public health data', title: 'Global infectious disease surveillance',
  summary: 'Explore comparable disease records, official source context, current situation reviews, and reusable datasets across reporting jurisdictions.',
  searchLabel: 'Search the evidence base', searchPlaceholder: 'Search a country, disease, report, or study', search: 'Search',
  situation: 'View current situation', countries: 'Explore countries', diseases: 'Browse diseases',
  coverage: 'Current coverage', glance: 'Data at a glance', updated: 'Updated', jurisdictions: 'Countries and regions', tracked: 'Diseases tracked', records: 'Surveillance records', through: 'Data through',
  coverageNote: 'Coverage and update schedules vary by official source. Absence of a record does not mean absence of disease.', methods: 'Read sources and methods',
  review: 'Situation review', attention: 'What needs attention now', reviewText: 'Latest review of statistical surveillance signals and independently published official events. Statistical signals are screening results, not outbreak declarations.',
  events: 'Official events', signals: 'Published signals', reviewed: 'Jurisdictions reviewed', fullReview: 'Open the full situation review',
  explore: 'Explore surveillance data', start: 'Start with a place or disease', downloads: 'Go to data downloads', countryList: 'Countries and regions', viewAll: 'View all', common: 'Commonly explored diseases',
  analysis: 'Published analysis', latest: 'Latest surveillance reports', research: 'Browse research evidence', open: 'Open report', empty: 'No public reports are currently available.', unavailable: 'Not available',
};

const meta = metaRaw as any;
const countries = (meta.countries ?? []).filter(hasCountryDataSnapshot);
const featuredCountries = [...countries].sort((a: any, b: any) => Number(b.total_cases ?? 0) - Number(a.total_cases ?? 0)).slice(0, 6);
const preferredDiseases = ['covid-19', 'cholera', 'dengue', 'measles', 'malaria', 'tuberculosis', 'hepatitis-a', 'pertussis'];
const diseaseIndex = new Map((diseasesRaw as any[]).map(item => [item.slug, item]));
const featuredDiseases = preferredDiseases.map(slug => diseaseIndex.get(slug)).filter(Boolean);
const latestReports = (reportsRaw as any[]).slice(0, 3);
const situationPath = resolve('./src/data/situation/v3/latest.json');
const shadowPath = resolve('./src/data/situation/v3/shadow-latest.json');
const readPath = existsSync(situationPath) ? situationPath : import.meta.env.DEV && existsSync(shadowPath) ? shadowPath : null;
const rawSituation: unknown = readPath ? JSON.parse(readFileSync(readPath, 'utf-8')) : null;
const situation: SituationReportV3 | null = isSituationReportV3(rawSituation) ? rawSituation : null;
const formatDate = (value?: string) => value ? new Date(value).toLocaleDateString(zh ? 'zh-CN' : 'en-US', { year: 'numeric', month: zh ? 'numeric' : 'short', day: 'numeric', timeZone: 'UTC' }) : copy.unavailable;
const formatNumber = (value: number) => new Intl.NumberFormat(zh ? 'zh-CN' : 'en-US', { notation: value >= 1_000_000 ? 'compact' : 'standard', maximumFractionDigits: 1 }).format(value);
const totalCases = countries.reduce((sum: number, item: any) => sum + Number(item.total_cases ?? 0), 0);
const dataThrough = situation?.data_currency.latest_data_through ?? meta.generated_at;
---

<div class="public-home">
  <section class="home-intro">
    <div class="page-wrap home-intro-grid">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p><h1>{copy.title}</h1><p class="lead">{copy.summary}</p>
        <form class="home-search" action={href('/search/')} method="get">
          <label for={`home-search-${locale}`}>{copy.searchLabel}</label>
          <div><input id={`home-search-${locale}`} name="q" type="search" placeholder={copy.searchPlaceholder} /><button type="submit">{copy.search}</button></div>
        </form>
        <div class="actions"><a class="primary" href={href('/situation/')}>{copy.situation}</a><a href={href('/countries/')}>{copy.countries}</a><a href={href('/diseases/')}>{copy.diseases}</a></div>
      </div>
      <aside class="status" aria-labelledby={`home-status-${locale}`}>
        <header><div><p class="eyebrow">{copy.coverage}</p><h2 id={`home-status-${locale}`}>{copy.glance}</h2></div><span><i></i>{copy.updated}</span></header>
        <dl><div><dt>{copy.jurisdictions}</dt><dd>{countries.length}</dd></div><div><dt>{copy.tracked}</dt><dd>{meta.total_diseases ?? '—'}</dd></div><div><dt>{copy.records}</dt><dd>{formatNumber(totalCases)}</dd></div><div><dt>{copy.through}</dt><dd class="date">{formatDate(dataThrough)}</dd></div></dl>
        <p>{copy.coverageNote}</p><a href={href('/about/')}>{copy.methods} →</a>
      </aside>
    </div>
  </section>

  {situation && <section class="situation-strip"><div class="page-wrap situation-grid"><div><p class="eyebrow">{copy.review} · {formatDate(situation.report.as_of)}</p><h2>{copy.attention}</h2><p>{copy.reviewText}</p></div><dl><div><dt>{copy.events}</dt><dd>{situation.summary.official_event_count ?? 0}</dd></div><div><dt>{copy.signals}</dt><dd>{situation.summary.unique_signal_count ?? 0}</dd></div><div><dt>{copy.reviewed}</dt><dd>{situation.coverage.jurisdiction_count}</dd></div></dl><a href={href('/situation/')}>{copy.fullReview} →</a></div></section>}

  <section class="home-section"><div class="page-wrap">
    <header class="section-heading"><div><p class="eyebrow">{copy.explore}</p><h2>{copy.start}</h2></div><a href={href('/downloads/')}>{copy.downloads} →</a></header>
    <div class="explore-grid"><div><div class="subheading"><h3>{copy.countryList}</h3><a href={href('/countries/')}>{copy.viewAll} {countries.length}</a></div><div class="country-grid">{featuredCountries.map((country: any) => <CountryCard code={country.code} name={country.name} nameZh={country.name_zh} totalCases={country.total_cases} totalDeaths={country.total_deaths} diseaseCount={country.disease_count} dateRange={country.date_range} locale={locale} />)}</div></div>
      <div><div class="subheading"><h3>{copy.common}</h3><a href={href('/diseases/')}>{copy.viewAll}</a></div><div class="disease-list">{featuredDiseases.map((disease: any) => <a href={href(`/diseases/${disease.slug}/`)}><span><strong>{zh ? disease.name_zh ?? disease.name_en : disease.name_en}</strong><small>{zh ? disease.name_en : `${disease.name_zh ?? ''} · ${disease.category}`}</small></span><span>→</span></a>)}</div></div>
    </div>
  </div></section>

  <section class="home-section reports"><div class="page-wrap"><header class="section-heading"><div><p class="eyebrow">{copy.analysis}</p><h2>{copy.latest}</h2></div><a href={href('/research/')}>{copy.research} →</a></header>
    {latestReports.length ? <div class="report-list">{latestReports.map((report: any) => { const code = String(report.country_code ?? '').toLowerCase(); const name = zh ? report.country_name_zh ?? report.country_name_en ?? report.country_name ?? report.country_code : report.country_name_en ?? report.country_name ?? report.country_code; return <a href={href(`/countries/${code}/reports/${report.id}/`)}><CountryFlag code={report.country_code} name={name} sizeClass="w-9 h-7" /><span><strong>{name}</strong><small>{report.period_start} – {report.period_end}</small></span><b>{copy.open} →</b></a>; })}</div> : <p>{copy.empty}</p>}
  </div></section>
</div>

<style>
  .public-home { color: rgb(var(--text)); }.page-wrap{width:min(1180px,calc(100% - 2rem));margin-inline:auto}.eyebrow{margin:0 0 .65rem;color:rgb(var(--color-teal));font-size:.7rem;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.home-intro{background:rgb(var(--surface));border-bottom:1px solid rgb(var(--border))}.home-intro-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(19rem,.65fr);gap:clamp(2.5rem,6vw,6rem);align-items:center;padding-block:clamp(3.5rem,8vw,6.5rem)}h1{max-width:15ch;margin:0;color:rgb(var(--text-strong));font-size:clamp(2.7rem,6vw,4.8rem);font-weight:650;line-height:1.02}.lead{max-width:46rem;margin:1.25rem 0 0;color:rgb(var(--text-muted));font-size:clamp(1rem,1.6vw,1.16rem);line-height:1.7}.home-search{max-width:43rem;margin-top:2rem}.home-search label{display:block;margin-bottom:.4rem;color:rgb(var(--text-strong));font-size:.78rem;font-weight:650}.home-search>div{display:grid;grid-template-columns:1fr auto;border:1px solid rgb(var(--border-soft));background:rgb(var(--bg))}.home-search input{min-width:0;min-height:3.1rem;padding:.65rem .8rem;color:rgb(var(--text-strong));background:transparent;border:0}.home-search button{padding-inline:1.15rem;color:#fff;background:rgb(var(--color-brand));border:0;font-weight:650}.actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}.actions a{min-height:2.5rem;padding:.55rem .85rem;color:rgb(var(--text-strong));border:1px solid rgb(var(--border));font-size:.8rem;font-weight:650;text-decoration:none}.actions .primary{color:#fff;background:rgb(var(--color-teal));border-color:rgb(var(--color-teal))}.status{border-top:3px solid rgb(var(--color-teal));padding-top:1.25rem}.status header,.section-heading,.subheading{display:flex;align-items:end;justify-content:space-between;gap:1rem}.status h2,.section-heading h2,.subheading h3{margin:0;color:rgb(var(--text-strong))}.status header>span{color:rgb(var(--text-muted));font-size:.7rem}.status header i{display:inline-block;width:.45rem;height:.45rem;margin-right:.35rem;border-radius:50%;background:#15803d}.status dl{display:grid;grid-template-columns:1fr 1fr;margin-top:1.1rem;border-top:1px solid rgb(var(--border));border-left:1px solid rgb(var(--border))}.status dl div{min-height:6rem;padding:.85rem;border-right:1px solid rgb(var(--border));border-bottom:1px solid rgb(var(--border))}.status dt{color:rgb(var(--text-muted));font-size:.7rem}.status dd{margin:.4rem 0 0;color:rgb(var(--text-strong));font-size:1.55rem;font-weight:650}.status .date{font-size:.9rem}.status>p{color:rgb(var(--text-muted));font-size:.73rem;line-height:1.55}.status>a,.section-heading>a,.subheading>a,.situation-grid>a{color:rgb(var(--color-teal));font-size:.78rem;font-weight:650}.situation-strip{color:#e5edf3;background:rgb(var(--color-brand))}.situation-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(19rem,.8fr) auto;gap:2rem;align-items:center;padding-block:2rem}.situation-grid .eyebrow{color:#8ad2ca}.situation-grid h2{margin:0;color:#fff;font-size:1.5rem}.situation-grid p:not(.eyebrow){margin:.55rem 0 0;color:#cbd8e2;font-size:.83rem;line-height:1.6}.situation-grid dl{display:grid;grid-template-columns:repeat(3,1fr)}.situation-grid dl div{padding-inline:.9rem;border-left:1px solid rgb(255 255 255/.2)}.situation-grid dt{font-size:.64rem}.situation-grid dd{margin:.25rem 0 0;color:#fff;font-size:1.3rem;font-weight:650}.situation-grid>a{color:#fff;white-space:nowrap}.home-section{padding-block:clamp(3.5rem,7vw,5.5rem)}.reports{background:rgb(var(--surface));border-top:1px solid rgb(var(--border))}.section-heading{padding-bottom:1rem;border-bottom:2px solid rgb(var(--text-strong))}.section-heading h2{font-size:clamp(1.65rem,3vw,2.2rem)}.explore-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(18rem,.6fr);gap:2.5rem;margin-top:2rem}.subheading{margin-bottom:.75rem}.subheading h3{font-size:1rem}.country-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.disease-list{border-top:1px solid rgb(var(--border))}.disease-list>a{display:flex;min-height:4rem;align-items:center;justify-content:space-between;gap:1rem;padding:.7rem .2rem;color:rgb(var(--text-strong));border-bottom:1px solid rgb(var(--border));text-decoration:none}.disease-list>a:hover strong{color:rgb(var(--color-teal))}.disease-list span:first-child{display:grid}.disease-list strong{font-size:.84rem}.disease-list small{margin-top:.12rem;color:rgb(var(--text-muted));font-size:.68rem}.report-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:2rem;border-top:1px solid rgb(var(--border));border-left:1px solid rgb(var(--border))}.report-list>a{display:grid;grid-template-columns:auto 1fr;gap:.7rem;padding:1rem;color:rgb(var(--text-strong));border-right:1px solid rgb(var(--border));border-bottom:1px solid rgb(var(--border));text-decoration:none}.report-list span{display:grid}.report-list strong{font-size:.88rem}.report-list small{color:rgb(var(--text-muted));font-size:.7rem}.report-list b{grid-column:1/-1;margin-top:.7rem;color:rgb(var(--color-teal));font-size:.74rem}
  @media(max-width:960px){.home-intro-grid,.explore-grid{grid-template-columns:1fr}.status{width:100%;max-width:38rem}.situation-grid{grid-template-columns:1fr auto}.situation-grid>div{grid-column:1/-1}}@media(max-width:680px){.home-intro-grid{padding-block:3rem}h1{font-size:2.5rem}.situation-grid{grid-template-columns:1fr;align-items:start}.section-heading{align-items:flex-start;flex-direction:column;gap:.7rem}.section-heading>a{align-self:flex-start}.country-grid,.report-list{grid-template-columns:1fr}.actions{display:grid}.actions a{text-align:center}}
</style>
