---
import CountryCard from '../CountryCard.astro';
import CountryFlag from '../CountryFlag.astro';
import { localizedDiseaseName } from '../../utils/diseaseNames';
import { localizedRegionName } from '../../utils/i18n';
import { hasCountryDataSnapshot } from '../../lib/country-coverage';
import { readInternationalLatest, readSituationEvents } from '../../utils/international';
import metaRaw from '../../data/meta.json';
import diseasesRaw from '../../data/diseases/index.json';
import reportsRaw from '../../data/reports/index.json';
import japanDataRaw from '../../data/countries/jp.json';
import chinaDataRaw from '../../data/countries/cn.json';

interface Props { locale?: 'en' | 'zh' | 'fr'; }

const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const href = (path: string) => `${prefix}${path}`;
const t = zh ? {
  eyebrow: 'GIDS · 官方来源监测',
  titleLines: ['发现信号', '追溯来源'],
  sloganPrefix: '继续',
  sloganWords: ['比较趋势', '复用数据', '核对证据', '更快研判'],
  summary: '检索官方监测记录、态势复核、研究背景与可下载数据集，在同一个入口完成查源、比较和复用。',
  searchLabel: '搜索 GIDS',
  searchPlaceholder: '搜索国家、疾病、报告或研究',
  search: '搜索',
  situation: '查看当前态势',
  countries: '浏览国家与地区',
  downloads: '下载数据',
  release: '本次公开发布',
  updated: '快照已生成',
  observations: '监测记录',
  reportedCases: '报告病例',
  jurisdictions: '国家与地区',
  diseases: '收录疾病',
  sources: '官方来源',
  through: '数据截至',
  recentBoard: '最新报告期',
  cadence: '报告频率',
  sourceNote: '覆盖、指标定义和发布时间因来源而异；缺失值不应自动解释为零。',
  methods: '来源与方法',
  review: '态势复核',
  attention: '当前关注',
  reviewText: '汇总世卫组织、欧洲疾控中心、非洲疾控中心与泛美卫生组织的官方通报，由 AI 生成多语言摘要与风险评估并经模型同行评审。',
  events: '窗口内通报',
  signals: '活跃事件',
  reviewed: '响应来源',
  fullReview: '查看完整态势复核',
  explore: '开始探索',
  exploreTitle: '像使用数据目录一样进入公共卫生证据',
  exploreText: '从国家、疾病或研究进入数据，沿着来源、趋势与下载继续查证。',
  countryPath: '按地区看',
  countryPathText: '查看国家和地区的监测范围、来源、疾病列表与时间跨度。',
  diseasePath: '按疾病看',
  diseasePathText: '从疾病目录进入跨地区记录，比较同一疾病在不同来源中的覆盖。',
  downloadPath: '直接复用',
  downloadPathText: '获取可下载数据集，并在引用前查看字段说明和限制。',
  researchPath: '连接研究',
  researchPathText: '浏览研究雷达，把监测信号放到文献与证据背景中理解。',
  countryList: '覆盖较多的地区',
  common: '常用疾病入口',
  viewAll: '查看全部',
  analysis: '已发布分析',
  latest: '最新监测报告',
  research: '浏览研究证据',
  openReport: '打开报告',
  unavailable: '暂无',
  empty: '当前没有公开报告。',
  curveLabel: '日本流感 · 中国流感',
} : {
  eyebrow: 'GIDS · official-source surveillance',
  titleLines: ['Find signals', 'Trace sources'],
  sloganPrefix: 'Then',
  sloganWords: ['compare trends', 'reuse data', 'check evidence', 'act faster'],
  summary: 'Search official surveillance records, situation reviews, research context, and download-ready datasets from one public data workspace.',
  searchLabel: 'Search GIDS',
  searchPlaceholder: 'Search a country, disease, report, or study',
  search: 'Search',
  situation: 'View current situation',
  countries: 'Browse countries',
  downloads: 'Download data',
  release: 'Current public release',
  updated: 'Snapshot generated',
  observations: 'Surveillance records',
  reportedCases: 'Reported cases',
  jurisdictions: 'Countries and regions',
  diseases: 'Diseases tracked',
  sources: 'Official sources',
  through: 'Data through',
  recentBoard: 'Latest available reporting periods',
  cadence: 'Reporting frequency',
  sourceNote: 'Coverage, definitions, and release schedules vary by source; missing values should not be read as zero.',
  methods: 'Sources and methods',
  review: 'Situation review',
  attention: 'Current attention',
  reviewText: 'Official notices from WHO, ECDC, Africa CDC and PAHO, with AI-written multilingual summaries and risk assessments checked by model peer review.',
  events: 'Notices in window',
  signals: 'Active events',
  reviewed: 'Sources responding',
  fullReview: 'Open the full situation review',
  explore: 'Start exploring',
  exploreTitle: 'Enter public health evidence like a data catalog',
  exploreText: 'Start with a country, disease, or study, then follow the source, trend, and download links to check the evidence.',
  countryPath: 'Explore by place',
  countryPathText: 'Review each country or region by surveillance scope, source, disease list, and time span.',
  diseasePath: 'Explore by disease',
  diseasePathText: 'Open the disease directory and compare coverage for the same condition across sources.',
  downloadPath: 'Reuse directly',
  downloadPathText: 'Download public datasets and check field notes and limitations before citing.',
  researchPath: 'Connect research',
  researchPathText: 'Use Research Radar to read surveillance signals in the context of published evidence.',
  countryList: 'High-coverage places',
  common: 'Common disease entry points',
  viewAll: 'View all',
  analysis: 'Published analysis',
  latest: 'Latest surveillance reports',
  research: 'Browse research evidence',
  openReport: 'Open report',
  unavailable: 'Not available',
  empty: 'No public reports are currently available.',
  curveLabel: 'Japan influenza · China influenza',
};

const meta = metaRaw as any;
// French is the shared interface language for France and Canada. Keep source
// names and disease names intact, while translating the surrounding controls.
if (fr) Object.assign(t, {
  eyebrow: 'GIDS · surveillance à source officielle', titleLines: ['Repérer les signaux', 'Retracer les sources'],
  sloganPrefix: 'Puis', sloganWords: ['comparer les tendances', 'réutiliser les données', 'vérifier les preuves', 'agir plus vite'],
  summary: 'Recherchez les données officielles, les synthèses de situation, le contexte scientifique et les jeux de données téléchargeables depuis un même espace public.',
  searchLabel: 'Rechercher dans GIDS', searchPlaceholder: 'Rechercher un pays, une maladie, un rapport ou une étude', search: 'Rechercher',
  situation: 'Voir la situation actuelle', countries: 'Parcourir les pays', downloads: 'Télécharger les données', release: 'Publication publique actuelle',
  observations: 'Séries de surveillance', reportedCases: 'Cas déclarés', jurisdictions: 'Pays et régions', diseases: 'Maladies suivies', sources: 'Sources officielles', through: 'Données jusqu’au',
  updated: 'Instantané généré', recentBoard: 'Périodes de déclaration les plus récentes', cadence: 'Fréquence de déclaration', sourceNote: 'La couverture, les définitions et les calendriers varient selon la source; une valeur manquante ne doit pas être interprétée comme zéro.',
  methods: 'Sources et méthodes', review: 'Synthèse de situation', attention: 'Points d’attention', reviewText: 'Avis officiels de l’OMS, de l’ECDC, de l’Africa CDC et de l’OPS, avec résumés multilingues et évaluations du risque rédigés par IA et vérifiés par relecture entre modèles.', events: 'Avis dans la fenêtre', signals: 'Événements actifs', reviewed: 'Sources disponibles', fullReview: 'Ouvrir la synthèse complète',
  explore: 'Commencer l’exploration', exploreTitle: 'Accéder aux preuves de santé publique comme à un catalogue de données', exploreText: 'Choisissez un pays, une maladie ou une étude, puis suivez les liens vers les sources, les tendances et les téléchargements.',
  countryPath: 'Explorer par lieu', countryPathText: 'Consultez la couverture, les sources, les maladies et la période de chaque pays ou région.', diseasePath: 'Explorer par maladie', diseasePathText: 'Comparez la couverture d’une même maladie entre les différentes sources.', downloadPath: 'Réutiliser directement', downloadPathText: 'Téléchargez les jeux de données publics et vérifiez les champs et limites avant citation.', researchPath: 'Relier la recherche', researchPathText: 'Interprétez les signaux de surveillance à la lumière des données publiées.', countryList: 'Pays les mieux couverts', common: 'Maladies courantes', viewAll: 'Tout voir', analysis: 'Analyses publiées', latest: 'Derniers rapports de surveillance', research: 'Parcourir les preuves', openReport: 'Ouvrir le rapport', unavailable: 'Indisponible', empty: 'Aucun rapport public disponible.', curveLabel: 'Grippe au Japon · grippe en Chine',
});
const jurisdictions = (meta.countries ?? []).filter(hasCountryDataSnapshot);
// Headline totals and rankings use one comparable national layer. Subnational
// datasets remain available from their parent country pages.
const countries = jurisdictions.filter((country: any) => (
  country.location_type !== 'subdivision' && !country.parent_code
));
const latestReports = (reportsRaw as any[]).slice(0, 3);
const preferredDiseases = ['covid-19', 'cholera', 'dengue', 'measles', 'malaria', 'tuberculosis', 'hepatitis-a', 'pertussis'];
const diseaseIndex = new Map((diseasesRaw as any[]).map(disease => [disease.slug, disease]));
const featuredDiseases = preferredDiseases.map(slug => diseaseIndex.get(slug)).filter(Boolean);
const featuredCountries = [...countries]
  .sort((a: any, b: any) => Number(b.record_count ?? b.total_cases ?? 0) - Number(a.record_count ?? a.total_cases ?? 0))
  .slice(0, 6);
const recentlyUpdatedCountries = [...countries]
  .sort((a: any, b: any) => String(b.date_range?.end ?? '').localeCompare(String(a.date_range?.end ?? '')))
  .slice(0, 4);
const sourceNames = new Set<string>();
for (const country of countries) {
  for (const source of country.source_info?.sources ?? []) {
    if (source?.label) sourceNames.add(source.label);
  }
}
// The Situation strip reads the notice-based export: notices in the window,
// active disease x place events, and how many authority feeds responded.
const international = readInternationalLatest();
const situation = international && international.event_count > 0
  ? {
      asOf: international.window?.as_of ?? international.generated_at,
      noticeCount: international.event_count,
      activeEvents: readSituationEvents().filter(event => event.status === 'active').length,
      sourcesOk: (international.sources ?? []).filter(source => source.status === 'ok').length,
    }
  : null;
const dataThrough = meta.generated_at;
const formatCadence = (value?: string) => {
  const key = String(value ?? '').trim().toLowerCase().replaceAll('-', '_').replaceAll(' ', '_');
  const labels: Record<string, [string, string, string]> = {
    daily: ['Daily', '每日', 'Quotidienne'],
    weekly: ['Weekly', '每周', 'Hebdomadaire'],
    monthly: ['Monthly', '每月', 'Mensuelle'],
    quarterly: ['Quarterly', '每季度', 'Trimestrielle'],
    annual: ['Annual', '每年', 'Annuelle'],
    yearly: ['Annual', '每年', 'Annuelle'],
    mixed_weekly_annual: ['Weekly and annual', '周报与年报', 'Hebdomadaire et annuelle'],
    weekly_and_annual: ['Weekly and annual', '周报与年报', 'Hebdomadaire et annuelle'],
  };
  if (!value) return t.unavailable;
  return labels[key]?.[zh ? 1 : fr ? 2 : 0] ?? value;
};
const formatDate = (value?: string) => {
  if (!value) return t.unavailable;
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? t.unavailable
    : date.toLocaleDateString(zh ? 'zh-CN' : fr ? 'fr-FR' : 'en-US', { year: 'numeric', month: zh ? 'numeric' : 'short', day: 'numeric', timeZone: 'UTC' });
};
const assetMetrics = [
  { label: t.jurisdictions, value: String(countries.length) },
  { label: t.diseases, value: String(meta.total_diseases ?? t.unavailable) },
  { label: t.sources, value: String(sourceNames.size) },
  { label: t.analysis, value: String(latestReports.length) },
];
const numericCases = (series: any) => (series?.cases ?? [])
  .map((value: unknown) => Number(value))
  .filter((value: number) => Number.isFinite(value) && value >= 0);
const sampleValues = (values: number[], count: number) => {
  if (!values.length) return Array.from({ length: count }, () => 0);
  const max = Math.max(...values, 1);
  return Array.from({ length: count }, (_, index) => {
    const position = index * (values.length - 1) / Math.max(1, count - 1);
    const left = Math.floor(position);
    const right = Math.min(values.length - 1, Math.ceil(position));
    const ratio = position - left;
    return ((values[left] ?? 0) * (1 - ratio) + (values[right] ?? 0) * ratio) / max;
  });
};
const makeCurvePoints = (values: number[], options: { baseline: number; amplitude: number }) => {
  const max = Math.max(...values, 1);
  const samples = values.map(value => value / max);
  return samples.map((value, index) => {
    const x = 42 + index * (1356 / Math.max(1, samples.length - 1));
    const y = options.baseline - value * options.amplitude;
    return `${x.toFixed(1)},${Math.max(468, Math.min(742, y)).toFixed(1)}`;
  }).join(' ');
};
const makeBars = (primary: number[], secondary: number[], count = 72) => {
  const a = sampleValues(primary, count);
  const b = sampleValues(secondary, count);
  const baseline = 760;
  return a.map((value, index) => {
    const mixed = value * .68 + (b[index] ?? 0) * .32;
    const height = 26 + mixed * 198;
    const x = 78 + index * (1284 / Math.max(1, count - 1));
    return { x: x.toFixed(1), y: (baseline - height).toFixed(1), width: '10', height: height.toFixed(1), index };
  });
};
// The hero background is generated from real public surveillance series, then
// normalized to an abstract visual layer so it does not imply comparable counts.
const japanInfluenza = numericCases((japanDataRaw as any).disease_series?.D038);
const chinaInfluenza = numericCases((chinaDataRaw as any).disease_series?.D038);
const backgroundCurves = [
  { className: 'curve-line-a', points: makeCurvePoints(japanInfluenza, { baseline: 724, amplitude: 246 }) },
  { className: 'curve-line-b', points: makeCurvePoints(chinaInfluenza, { baseline: 738, amplitude: 224 }) },
];
const backgroundBars = makeBars(japanInfluenza, chinaInfluenza);
const explorePaths = [
  { href: href('/countries/'), index: '01', title: t.countryPath, text: t.countryPathText, stat: `${countries.length}`, metric: t.jurisdictions },
  { href: href('/diseases/'), index: '02', title: t.diseasePath, text: t.diseasePathText, stat: `${meta.total_diseases ?? t.unavailable}`, metric: t.diseases },
  { href: href('/downloads/'), index: '03', title: t.downloadPath, text: t.downloadPathText, stat: String(sourceNames.size), metric: t.sources },
  { href: href('/research/'), index: '04', title: t.researchPath, text: t.researchPathText, stat: `${latestReports.length}`, metric: t.analysis },
];
---

<div class:list={['public-home-redesign', zh && 'is-zh']}>
  <section class="home-hero">
    <div class="curve-field" aria-hidden="true">
      <svg viewBox="0 0 1440 760" preserveAspectRatio="none">
        <g class="curve-bars">
          {backgroundBars.map(bar => (
            <rect style={`--i:${bar.index}`} x={bar.x} y={bar.y} width={bar.width} height={bar.height} />
          ))}
        </g>
        <g class="curve-lines">
          {backgroundCurves.map(curve => (
            <polyline class:list={['curve-line', curve.className]} pathLength="1" points={curve.points} />
          ))}
        </g>
      </svg>
      <p class="curve-annotation">
        <b>{t.curveLabel}</b>
      </p>
    </div>
    <div class="page-wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.titleLines.map(line => <span>{line}</span>)}</h1>
        <p class="animated-slogan" aria-label={`${t.sloganPrefix} ${t.sloganWords.join(', ')}`}>
          <span>{t.sloganPrefix}</span>
          <span class="slogan-window" aria-hidden="true">
            {t.sloganWords.map((word, index) => (
              <b style={`--i:${index}`}>{word}</b>
            ))}
          </span>
        </p>
        <p class="lead">{t.summary}</p>
        <form class="home-search" action={href('/search/')} method="get">
          <label for={`home-search-${locale}`}>{t.searchLabel}</label>
          <div class="home-search-row">
            <input id={`home-search-${locale}`} name="q" type="search" placeholder={t.searchPlaceholder} />
            <button type="submit">{t.search}</button>
          </div>
        </form>
        <div class="actions" aria-label={zh ? '主要入口' : 'Primary entry points'}>
          <a class="primary" href={href('/situation/')}>{t.situation}</a>
          <a href={href('/compare/')}>{zh ? '对比国家与疾病' : fr ? 'Comparer les pays' : 'Compare trends'}</a>
          <a href={href('/countries/')}>{t.countries}</a>
          <a href={href('/downloads/')}>{t.downloads}</a>
        </div>
      </div>

      <aside class="data-console" aria-labelledby={`home-console-${locale}`}>
        <header class="console-header">
          <div>
            <p class="eyebrow">{t.sources}</p>
            <h2 id={`home-console-${locale}`}>{t.release}</h2>
          </div>
          <span class="release-pill"><i></i>{t.updated}</span>
        </header>
        <dl class="asset-grid">
          {assetMetrics.map((metric, index) => <div style={`--i:${index}`}><dt>{metric.label}</dt><dd>{metric.value}</dd></div>)}
        </dl>
        <div class="release-meta">
          <span>{t.sources}: <strong>{sourceNames.size}</strong></span>
          <span>{t.through}: <strong>{formatDate(dataThrough)}</strong></span>
        </div>
        <div class="source-board">
          <h3>{t.recentBoard}</h3>
          {recentlyUpdatedCountries.slice(0, 3).map((country: any) => {
            const name = zh ? country.name_zh ?? country.name : country.name_en ?? country.name;
            const source = country.source_info?.sources?.[0];
            return (
              <a href={href(`/countries/${String(country.code).toLowerCase()}/`)}>
                <CountryFlag code={country.code} name={name} sizeClass="w-8 h-6" />
                <span><strong>{name}</strong><small>{source?.cadence ? `${t.cadence}: ${formatCadence(source.cadence)}` : source?.type ?? t.unavailable}</small></span>
                <time datetime={country.date_range?.end ?? ''}>{formatDate(country.date_range?.end)}</time>
              </a>
            );
          })}
        </div>
        <p class="source-note">{t.sourceNote}</p>
        <a class="text-link console-link" href={href('/about/')}>{t.methods} <span aria-hidden="true">-&gt;</span></a>
      </aside>
    </div>
  </section>

  {situation && (
    <section class="situation-strip">
      <div class="page-wrap situation-grid">
        <div>
          <p class="eyebrow">{t.review} · {formatDate(situation.asOf ?? undefined)}</p>
          <h2>{t.attention}</h2>
          <p>{t.reviewText}</p>
        </div>
        <dl>
          <div><dt>{t.events}</dt><dd>{situation.noticeCount}</dd></div>
          <div><dt>{t.signals}</dt><dd>{situation.activeEvents}</dd></div>
          <div><dt>{t.reviewed}</dt><dd>{situation.sourcesOk}</dd></div>
        </dl>
        <a href={href('/situation/')}>{t.fullReview} <span aria-hidden="true">-&gt;</span></a>
      </div>
    </section>
  )}

  <section class="home-section browse-section">
    <div class="page-wrap">
      <header class="section-heading">
        <div>
          <p class="eyebrow">{t.explore}</p>
          <h2>{t.exploreTitle}</h2>
        </div>
        <p>{t.exploreText}</p>
      </header>
      <a class="compare-feature" href={href('/compare/')}>
        <span class="compare-feature-copy"><small>{zh ? '交互工具 / 01' : fr ? 'Outil interactif / 01' : 'Interactive tool / 01'}</small><strong>{zh ? '比较国家与疾病趋势' : fr ? 'Comparer les tendances par pays et maladie' : 'Compare country and disease trends'}</strong><span>{zh ? '选择最多两种疾病与四个国家，查看保留原始报告周期和定义的监测曲线。' : fr ? 'Sélectionnez jusqu’à deux maladies et quatre pays ; chaque courbe conserve sa période et sa définition.' : 'Select up to two diseases and four countries. Each series keeps its original reporting period and definition.'}</span></span>
        <span class="compare-feature-arrow" aria-hidden="true">↗</span>
      </a>
      <div class="path-grid">
        {explorePaths.map(path => (
          <a class="path-card" href={path.href}>
            <span class="path-index">{path.index}</span>
            <span class="path-copy"><strong>{path.title}</strong><small>{path.text}</small></span>
            <span class="path-stat"><b>{path.stat}</b><small>{path.metric}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section data-section">
    <div class="page-wrap explore-grid">
      <div>
        <div class="subheading">
          <h2>{t.countryList}</h2>
          <a href={href('/countries/')}>{t.viewAll} {countries.length}</a>
        </div>
        <div class="country-grid">
          {featuredCountries.map((country: any) => (
            <CountryCard code={country.code} name={country.name} nameZh={country.name_zh} nameFr={country.name_fr ?? localizedRegionName('fr', country.code, { en: country.name })} totalCases={country.total_cases} totalDeaths={country.total_deaths} diseaseCount={country.disease_count} dateRange={country.date_range} locationType={country.location_type} locale={locale} />
          ))}
        </div>
      </div>
      <div>
        <div class="subheading">
          <h2>{t.common}</h2>
          <a href={href('/diseases/')}>{t.viewAll}</a>
        </div>
        <div class="disease-list">
          {featuredDiseases.map((disease: any) => (
            <a href={href(`/diseases/${disease.slug}/`)}>
              <span><strong>{zh ? disease.name_zh ?? disease.name_en : fr ? localizedDiseaseName(disease, 'fr') : disease.name_en}</strong><small>{zh ? disease.name_en : fr ? disease.name_en : `${disease.name_zh ?? ''} · ${disease.category}`}</small></span>
              <span aria-hidden="true">-&gt;</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="home-section reports">
    <div class="page-wrap">
      <header class="section-heading compact">
        <div>
          <p class="eyebrow">{t.analysis}</p>
          <h2>{t.latest}</h2>
        </div>
        <a class="text-link" href={href('/research/')}>{t.research} <span aria-hidden="true">-&gt;</span></a>
      </header>
      {latestReports.length ? (
        <div class="report-list">
          {latestReports.map((report: any) => {
            const code = String(report.country_code ?? '').toLowerCase();
            const name = zh ? report.country_name_zh ?? report.country_name_en ?? report.country_name ?? report.country_code : fr ? (report.country_name_fr ?? localizedRegionName('fr', report.country_code, { en: report.country_name_en ?? report.country_name })) : report.country_name_en ?? report.country_name ?? report.country_code;
            return (
              <a href={href(`/countries/${code}/reports/${report.id}/`)}>
                <CountryFlag code={report.country_code} name={name} sizeClass="w-9 h-7" />
                <span><strong>{name}</strong><small>{report.period_start} - {report.period_end}</small></span>
