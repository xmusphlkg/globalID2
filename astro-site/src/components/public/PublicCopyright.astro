---
interface Props { locale?: 'en' | 'zh'; }

const { locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const updatedIso = '2026-08-18';
const updatedLabel = zh ? '2026 年 8 月 18 日' : '18 August 2026';
const currentYear = new Date().getUTCFullYear();

const heroFacts = zh ? [
  ['当前原则', '支持规范的学术研究、教学、新闻报道及其他公共利益用途。'],
  ['核心规则', '监测数据的许可条件以原始来源为准。'],
  ['最后更新', updatedLabel],
] : [
  ['Current position', 'Responsible academic, educational, journalistic, and public-interest use is supported.'],
  ['Key principle', 'Source-specific licences continue to apply to surveillance data.'],
  ['Last updated', updatedLabel],
];

const uses = zh ? [
  ['引用或链接 GIDS 页面', '可以', '注明页面标题、GIDS、页面链接和访问日期；涉及来源数据时，同时保留原始来源。', 'allow'],
  ['用于学术研究、教学或个人学习', '通常可以', '正确署名 GIDS，并保留原始数据来源及其许可信息。', 'allow'],
  ['下载或分析监测数据', '需查看来源许可', '查看来源机构、数据许可和下载文件中的相关说明。', 'check'],
  ['转载或重新绘制 GIDS 图表', '使用前核对', '同时注明 GIDS 与原始来源，并说明筛选、聚合、翻译或重新制图等改动。', 'check'],
  ['用于新闻报道或公共利益传播', '通常可以', '区分 GIDS 的整理或分析与原始机构的官方发布，不得暗示相关机构背书。', 'allow'],
  ['用于商业产品或服务', '部分情形需授权', '除非相关来源或具体材料已有明确许可，否则使用 GIDS 原创内容或服务前请联系项目方。', 'permission'],
  ['使用 GIDS 名称、Logo 或视觉标识', '品牌使用需授权', '正常学术署名无需品牌授权，但不得暗示合作、认证、赞助或官方认可。', 'permission'],
  ['批量获取、自动化商业提取或模型训练', '适用额外规则', '同时查看服务协议、技术访问规则及相关来源材料的许可。', 'check'],
] : [
  ['Link to or cite a GIDS page', 'Permitted', 'Cite the page title, GIDS, URL, and access date, plus the original source where relevant.', 'allow'],
  ['Use GIDS for research, teaching, or personal study', 'Generally permitted', 'Attribute GIDS, preserve the original source information, and follow any source-specific terms.', 'allow'],
  ['Download or analyse surveillance data', 'Check the source licence', 'Review the source authority, licence information, and documentation supplied with the dataset.', 'check'],
  ['Republish or redraw a GIDS chart', 'Check before reuse', 'Credit GIDS and the underlying source, and identify any filtering, aggregation, translation, or redrawing.', 'check'],
  ['Use material in journalism or public-interest communication', 'Generally permitted', 'Distinguish GIDS processing from the original official publication and do not imply endorsement.', 'allow'],
  ['Use GIDS-created material in a commercial product or service', 'Permission may be required', 'Contact GIDS unless a source or component licence independently permits the intended use.', 'permission'],
  ['Use the GIDS name, logo, or visual identity', 'Brand use requires permission', 'Ordinary factual attribution is welcome. Do not imply partnership, certification, sponsorship, or endorsement.', 'permission'],
  ['Bulk access, automated commercial extraction, or model training', 'Separate conditions apply', 'Review the Service Terms, technical access rules, and licences of the underlying materials.', 'check'],
];

const materials = zh ? [
  {
    number: '01',
    title: 'GIDS 原创内容',
    status: '适用 GIDS 使用规则',
    summary: '原创文字、说明文档、摘要、原创图表表达、页面设计及项目专门制作的其他内容。',
    body: '允许正常链接和学术引用。大量复制、作为其他产品重新分发或用于商业用途时，可能需要事先获得许可。除非具体页面或材料另有说明，相关权利予以保留。',
  },
  {
    number: '02',
    title: '官方来源监测数据',
    status: '以原始来源规则为准',
    summary: '来自公共卫生机构、官方开放数据平台、监测报告、仪表板或 API 的监测记录与元数据。',
    body: 'GIDS 不会仅因收集、标准化、分析或展示相关数据，就主张对基础监测事实本身拥有所有权。原始发布机构的许可、署名和复用条件继续有效。',
  },
  {
    number: '03',
    title: '代码与软件',
    status: '查看具体仓库许可',
    summary: '网站代码、数据处理工具、软件包及第三方依赖。',
    body: '应以相关仓库、软件包、目录或文件明确标注的许可证为准。代码公开可见并不自动授予复制、修改、再发布或商业使用权；第三方依赖适用各自许可证。',
  },
  {
    number: '04',
    title: 'GIDS 名称与品牌',
    status: '适用品牌使用规则',
    summary: 'GIDS 名称、Logo、视觉识别及其他项目标识。',
    body: '正常引用和事实性说明中可以使用 GIDS 名称。未经书面许可，不得暗示合作、认证、赞助、官方身份或认可关系。署名不等于品牌授权。',
  },
] : [
  {
    number: '01',
    title: 'GIDS-created content',
    status: 'GIDS rules apply',
    summary: 'Original writing, documentation, summaries, visual expression, page design, and other project-created material.',
    body: 'Linking and citation are permitted. Reproducing substantial material, redistributing it as part of another product, or using it commercially may require prior permission. Rights are reserved unless a page or component states otherwise.',
  },
  {
    number: '02',
    title: 'Official-source surveillance data',
    status: 'Source rules apply',
    summary: 'Surveillance records and metadata from health authorities, official open-data systems, reports, dashboards, or APIs.',
    body: 'GIDS does not claim ownership of underlying surveillance facts merely because they are collected, standardized, analysed, or displayed here. The original publisher’s licence, attribution, and reuse conditions continue to apply.',
  },
  {
    number: '03',
    title: 'Code & software',
    status: 'Check the repository licence',
    summary: 'Website code, data-processing tools, packages, and third-party dependencies.',
    body: 'Use the licence attached to the relevant repository, package, directory, or file. Public visibility does not automatically permit copying, modification, redistribution, or commercial reuse. Dependencies retain their own licences.',
  },
  {
    number: '04',
    title: 'GIDS name & brand',
    status: 'Brand rules apply',
    summary: 'The GIDS name, logo, visual identity, and other project identifiers.',
    body: 'The GIDS name may be used for ordinary factual attribution. Written permission is required for uses suggesting partnership, certification, sponsorship, official status, or endorsement. Attribution is not brand authorisation.',
  },
];

const attributionItems = zh ? [
  ['明确使用对象', '写明页面、图表、报告或数据集的完整名称。'],
  ['保留原始来源', '如页面标注了公共卫生机构或原始发布方，应同时注明。'],
  ['记录版本信息', '注明页面链接及访问或下载日期，并保留发布日期、版本号或快照日期。'],
  ['说明数据改动', '如进行了筛选、聚合、翻译、转换、重新计算或重新制图，应明确说明。'],
] : [
  ['Identify the material', 'Give the full title of the page, figure, report, or dataset.'],
  ['Preserve the original source', 'Credit the relevant public health authority or original publisher where identified.'],
  ['Record the version', 'Include the page URL and access date, plus any release, version, or snapshot date.'],
  ['Disclose modifications', 'State clearly if you filtered, aggregated, translated, transformed, recalculated, or redrew the material.'],
];

const citations = zh ? [
  {
    id: 'plain',
    label: '引用文本',
    content: 'Global Infectious Disease Surveillance（GIDS），“[页面或数据集标题]”。原始来源：[机构及来源链接]。访问日期：[YYYY-MM-DD]。[GIDS 页面 URL]。',
  },
  {
    id: 'bibtex',
    label: 'BibTeX',
    content: `@misc{gids_[short_title]_[year],\n  author = {{Global Infectious Disease Surveillance}},\n  title = {[Page or dataset title]},\n  howpublished = {GIDS},\n  url = {[GIDS page URL]},\n  note = {Primary source: [authority and source]. Accessed [YYYY-MM-DD]}\n}`,
  },
  {
    id: 'ris',
    label: 'RIS',
    content: `TY  - DATA\nTI  - [页面或数据集标题]\nAU  - Global Infectious Disease Surveillance (GIDS)\nUR  - [GIDS 页面 URL]\nY2  - [YYYY/MM/DD]\nN1  - 原始来源：[机构及来源链接]\nER  -`,
  },
] : [
  {
    id: 'plain',
    label: 'Page citation',
    content: 'Global Infectious Disease Surveillance (GIDS), “[page or dataset title].” Primary source: [authority and source]. Accessed [YYYY-MM-DD]. [GIDS page URL].',
  },
  {
    id: 'bibtex',
    label: 'BibTeX',
    content: `@misc{gids_[short_title]_[year],\n  author = {{Global Infectious Disease Surveillance}},\n  title = {[Page or dataset title]},\n  howpublished = {GIDS},\n  url = {[GIDS page URL]},\n  note = {Primary source: [authority and source]. Accessed [YYYY-MM-DD]}\n}`,
  },
  {
    id: 'ris',
    label: 'RIS',
    content: `TY  - DATA\nTI  - [Page or dataset title]\nAU  - Global Infectious Disease Surveillance (GIDS)\nUR  - [GIDS page URL]\nY2  - [YYYY/MM/DD]\nN1  - Primary source: [authority and source]\nER  -`,
  },
];

const sourceChecks = zh ? [
  '原始公共卫生机构或发布方',
  'GIDS 提供的原始来源页面',
  '来源机构公布的版权、开放数据或复用说明',
  '下载文件中的 README、字段说明、来源字段和许可信息',
  '是否包含第三方图片、Logo、报告版式或其他单独受保护的内容',
  '是否修改了疾病定义、报告周期、地理单位或其他关键特征',
] : [
  'the original public health authority or publisher',
  'the source page linked by GIDS',
  'the licence or reuse statement associated with that source',
  'the README, field guide, provenance fields, and licence metadata in the download',
  'whether third-party images, logos, report layouts, or other protected material are included',
  'whether definitions, reporting periods, geographic units, or other material characteristics changed',
];

const concerns = zh ? [
  ['涉及的 GIDS 内容', '提供相关页面、图表、数据集或下载文件。'],
  ['原始材料位置', '如可以，请提供原始来源机构或发布页面。'],
  ['具体问题', '说明涉及版权、许可、署名或其他复用条件中的哪一项。'],
  ['希望采取的处理方式', '例如更正来源、更新许可信息、替换链接、限制下载或移除材料。'],
] : [
  ['Affected GIDS material', 'Provide the relevant page, figure, dataset, or download.'],
  ['Original material', 'Include the original source or publisher link where possible.'],
  ['Rights issue', 'Explain the relevant ownership, licence, attribution, or reuse concern.'],
  ['Requested correction', 'For example: attribution correction, licence update, link replacement, download restriction, or removal.'],
];
---

<section class="copyright-page">
  <header class="copyright-header">
    <div class="copyright-wrap">
      <nav class="copyright-breadcrumb" aria-label={zh ? '面包屑' : 'Breadcrumb'}>
        <a href={`${prefix}/`}>{zh ? '首页' : 'Home'}</a><span aria-hidden="true">/</span><span>{zh ? '版权与复用' : 'Copyright & reuse'}</span>
      </nav>
      <p class="copyright-label">{zh ? '法律与复用' : 'Legal & reuse'}</p>
      <h1>{zh ? '版权、许可与复用说明' : 'Copyright, licensing & reuse'}</h1>
      <p class="copyright-intro">
        {zh
          ? '清楚了解如何引用、使用和再发布 GIDS 内容与数据。GIDS 汇集公共卫生机构公开发布的传染病监测信息，并通过标准化数据、图表、摘要和研究工具进行整理与呈现。'
          : 'Use GIDS materials with clear provenance and appropriate attribution. GIDS brings together infectious disease surveillance information published by public health authorities and presents it through standardized datasets, charts, summaries, and research tools.'}
      </p>
      <div class="copyright-principles" aria-label={zh ? '主要原则' : 'Key principles'}>
        <span>{zh ? '支持学术与公共利益复用' : 'Academic & public-interest reuse supported'}</span>
        <span>{zh ? '监测数据适用来源许可' : 'Source-specific licences apply to surveillance data'}</span>
      </div>
      <dl class="copyright-summary">
        {heroFacts.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
      <p class="copyright-caveat">
        {zh
          ? '公开可访问并不等于不受任何使用条件限制。使用前应先判断相关材料属于 GIDS 原创内容，还是来自外部数据源。'
          : 'Public access does not by itself determine reuse rights. Always distinguish between GIDS-created material and content originating from external sources.'}
      </p>
    </div>
  </header>

  <div class="copyright-shell">
    <aside class="copyright-toc">
      <p>{zh ? '本页目录' : 'On this page'}</p>
      <nav aria-label={zh ? '本页目录' : 'On this page'}>
        <a href="#reuse-checker"><span>01</span>{zh ? '快速判断' : 'Quick guide'}</a>
        <a href="#material-types"><span>02</span>{zh ? '材料类型' : 'Material types'}</a>
        <a href="#attribution"><span>03</span>{zh ? '署名与引用' : 'Attribution'}</a>
        <a href="#source-licences"><span>04</span>{zh ? '来源许可' : 'Source licences'}</a>
        <a href="#automated-use"><span>05</span>{zh ? '自动化与商业使用' : 'Automated use'}</a>
        <a href="#rights-concerns"><span>06</span>{zh ? '权利问题反馈' : 'Rights concerns'}</a>
      </nav>
      <a class="copyright-terms-link" href={`${prefix}/terms/`}>{zh ? '服务协议与隐私说明' : 'Service Terms & Privacy Notice'}</a>
    </aside>

    <div class="copyright-content">
      <section id="reuse-checker" class="copyright-section copyright-section-first">
        <div class="copyright-section-heading">
          <p>01 · {zh ? '快速判断' : 'Quick guide'}</p>
          <h2>{zh ? 'GIDS 内容可以怎样使用？' : 'Using GIDS at a glance'}</h2>
          <p>{zh ? '先按使用场景确认基本规则，再查看具体材料和原始来源的许可。' : 'Start with your intended use, then check the material and its original source for specific terms.'}</p>
        </div>
        <div class="copyright-table-wrap" role="region" tabindex="0" aria-label={zh ? '使用场景与许可判断表，可横向滚动' : 'Reuse guidance table; scroll horizontally'}>
          <table>
            <thead><tr><th>{zh ? '使用场景' : 'You want to…'}</th><th>{zh ? '当前规则' : 'Position'}</th><th>{zh ? '建议操作' : 'What to do'}</th></tr></thead>
            <tbody>
              {uses.map(([use, label, guidance, tone]) => (
                <tr>
                  <th scope="row">{use}</th>
                  <td><span class:list={['copyright-decision', `copyright-decision-${tone}`]}>{label}</span></td>
                  <td>{guidance}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="copyright-note">{zh ? '具体页面、数据集、下载文件、代码仓库或原始来源给出的许可条件，优先于本页的一般说明。' : 'More specific terms shown on an individual page, dataset, download, repository, or source website take priority over this general guide.'}</p>
      </section>

      <section id="material-types" class="copyright-section">
        <div class="copyright-section-heading">
          <p>02 · {zh ? '材料类型' : 'Material types'}</p>
          <h2>{zh ? '不同材料适用什么规则？' : 'What rules apply?'}</h2>
          <p>{zh ? '判断复用条件时，应先区分项目原创内容、来源数据、软件与品牌元素。' : 'Different parts of GIDS may be governed by different rights or licences. These distinctions are the starting point.'}</p>
        </div>
        <div class="copyright-material-grid">
          {materials.map(material => (
            <article>
              <div class="copyright-material-top"><span>{material.number}</span><strong>{material.status}</strong></div>
              <h3>{material.title}</h3>
              <p class="copyright-material-summary">{material.summary}</p>
              <p>{material.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="attribution" class="copyright-section">
        <div class="copyright-section-heading">
          <p>03 · {zh ? '署名与引用' : 'Attribution'}</p>
          <h2>{zh ? '如何引用 GIDS？' : 'How to cite GIDS'}</h2>
          <p>{zh ? '良好的引用应保留完整来源链：使用对象、GIDS 的处理或呈现方式，以及信息最初由哪个机构发布。' : 'Good attribution preserves the provenance chain: what you used, how GIDS presented or processed it, and where it originated.'}</p>
        </div>
        <ol class="copyright-attribution-list">
          {attributionItems.map(([title, body], index) => (
            <li><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{title}</strong><p>{body}</p></div></li>
          ))}
        </ol>

        <div class="copyright-citation-tool">
          <div class="copyright-citation-header">
            <div>
              <span>{zh ? '引用工具' : 'Citation tool'}</span>
              <strong>{zh ? '选择格式并复制' : 'Choose a format and copy'}</strong>
            </div>
            <button class="copyright-copy-button" type="button" data-copy-citation data-label={zh ? '复制引用' : 'Copy citation'} data-copied={zh ? '已复制' : 'Copied'}>{zh ? '复制引用' : 'Copy citation'}</button>
          </div>
          <div class="copyright-citation-tabs" role="tablist" aria-label={zh ? '引用格式' : 'Citation formats'}>
            {citations.map((citation, index) => (
              <button type="button" role="tab" id={`citation-tab-${citation.id}`} aria-controls={`citation-panel-${citation.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-citation-tab={citation.id}>{citation.label}</button>
            ))}
          </div>
          {citations.map((citation, index) => (
            <div class="copyright-citation-panel" id={`citation-panel-${citation.id}`} role="tabpanel" aria-labelledby={`citation-tab-${citation.id}`} hidden={index !== 0} data-citation-panel={citation.id}>
              <pre>{citation.content}</pre>
            </div>
          ))}
          <p class="copyright-modified-note"><strong>{zh ? '如修改了材料：' : 'If you modified the material:'}</strong> {zh ? '请注明“本材料由使用者进一步筛选、转换或重新制图；相关呈现不代表 GIDS 或原始来源机构认可或背书。”' : 'Add “Data filtered, transformed, or redrawn by the user. The resulting presentation does not imply endorsement by GIDS or the original source authority.”'}</p>
        </div>
      </section>

      <section id="source-licences" class="copyright-section">
        <div class="copyright-section-heading">
          <p>04 · {zh ? '数据来源与许可' : 'Source licences'}</p>
          <h2>{zh ? '数据许可由原始来源决定' : 'Data licences follow the source'}</h2>
        </div>
        <div class="copyright-prose">
          <p>{zh ? 'GIDS 整合了多个公共卫生机构发布的资料，因此不存在一项自动覆盖网站全部监测数据的统一许可证。部分来源采用明确的开放许可；另一些来源可能允许公众访问，但没有提供一般再利用许可，或对署名、再发布及商业使用另有规定。' : 'GIDS integrates materials published by multiple public health authorities. There is no single licence that automatically applies to every surveillance record. Some sources carry an explicit open licence; others permit access without a general reuse licence or impose their own conditions.'}</p>
          <p>{zh ? '某一来源采用开放许可，并不意味着该许可自动适用于其他来源、GIDS 品牌或未明确标注许可的材料。' : 'An open licence attached to one source does not extend to another source, to the GIDS brand, or to material that has not been expressly licensed.'}</p>
          <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">{zh ? '查看 CC BY 4.0 官方许可摘要' : 'Read the official licence deed'} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="copyright-checklist">
          <h3>{zh ? '再发布数据前建议核对' : 'Before redistributing a dataset, check'}</h3>
          <ul>{sourceChecks.map(item => <li>{item}</li>)}</ul>
        </div>
        <p class="copyright-note">{zh ? '如果无法找到明确许可，不应仅根据“数据可以公开访问”推定其可以不受限制地重新分发。' : 'When no explicit licence can be identified, do not interpret public availability alone as an unrestricted licence to redistribute the material.'}</p>
      </section>

      <section id="automated-use" class="copyright-section">
        <div class="copyright-section-heading">
          <p>05 · {zh ? '自动化与商业使用' : 'Automated & commercial use'}</p>
          <h2>{zh ? '自动化访问、模型训练与商业复用' : 'Automated access, model training & commercial reuse'}</h2>
        </div>
        <div class="copyright-prose copyright-prose-columns">
          <p>{zh ? '版权、数据许可和网站技术访问规则属于不同层面。自动化访问可能受到请求频率限制、robots 规则、API 规范、安全措施及《服务协议》的约束；遵守这些技术规则并不意味着自动获得底层材料的复用许可。' : 'Copyright, data licensing, and technical access are separate issues. Automated access may be subject to rate limits, robots directives, API rules, security controls, and the Service Terms. Following those technical rules does not grant reuse rights.'}</p>
          <p>{zh ? '对于来源数据，应继续以原始发布机构的许可为准。将 GIDS 原创内容、品牌化输出或相关服务用于商业用途时，部分情形可能需要书面许可。大规模研究访问或本页未明确覆盖的使用场景，请先联系项目方。' : 'For source data, the original publisher’s licence remains controlling. Commercial reuse of GIDS-created content, branded outputs, or services may require written permission. Contact the project about large-scale research access or uses not clearly covered here.'}</p>
        </div>
        <a class="copyright-inline-link" href={`${prefix}/terms/`}>{zh ? '查看服务协议与技术访问规则' : 'Review the Service Terms and technical access rules'} <span aria-hidden="true">→</span></a>
      </section>

      <section id="rights-concerns" class="copyright-section">
        <div class="copyright-section-heading">
          <p>06 · {zh ? '权利问题反馈' : 'Rights concerns'}</p>
          <h2>{zh ? '报告版权、许可或署名问题' : 'Report a copyright or licensing issue'}</h2>
