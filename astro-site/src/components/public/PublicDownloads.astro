---
import downloadsRaw from '../../data/downloads.json';
import metaRaw from '../../data/meta.json';
import DownloadCatalogue from './downloads/DownloadCatalogue.astro';
import { downloadCatalogue } from './downloads/catalogue';
import { downloadMessages } from './downloads/messages';
interface Props { locale?: 'en' | 'zh' | 'fr' }
const { locale = 'en' } = Astro.props;
const model = downloadCatalogue(downloadsRaw, metaRaw, locale);
const copy = downloadMessages(locale, model.subdivisionCount);
---
<DownloadCatalogue locale={locale} model={model} copy={copy} />
