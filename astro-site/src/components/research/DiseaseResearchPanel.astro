---
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import ResearchArticleCard from './ResearchArticleCard.astro';

interface Props { diseaseId: string; locale?: 'en' | 'zh' | 'fr' }
const { diseaseId, locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const fr = locale === 'fr';
const prefix = zh ? '/zh' : locale === 'fr' ? '/fr' : '';
const file = resolve(`./src/data/research/diseases/${diseaseId.toLowerCase()}.json`);
const payload = existsSync(file) ? JSON.parse(readFileSync(file, 'utf-8')) : null;
const articles = payload?.articles ?? [];
const previewArticles = articles.slice(0, 5);
---

{articles.length > 0 && (
  <section class="figure-panel disease-research-panel">
    <div class="research-panel-heading">
      <div>
        <p class="academic-kicker">{zh ? '研究雷达' : fr ? 'Radar de recherche' : 'Research Radar'}</p>
        <h2 class="figure-title mt-1">{zh ? '近期相关研究' : fr ? 'Recherches récentes associées' : 'Recent related research'}</h2>
      </div>
      <a href={`${prefix}/research/?disease=${diseaseId}`}>{zh ? '查看全部研究 →' : fr ? 'Voir toutes les recherches →' : 'View all research →'}</a>
    </div>
    <div class="research-panel-list mt-5">{previewArticles.map((article: any) => <ResearchArticleCard article={article} compact locale={locale} />)}</div>
    {articles.length > previewArticles.length && (
      <p class="research-panel-count">
        {zh ? `显示 ${articles.length} 篇相关论文中的 ${previewArticles.length} 篇。` : fr ? `${previewArticles.length} publications associées sur ${articles.length} affichées.` : `Showing ${previewArticles.length} of ${articles.length} related publications.`}
      </p>
    )}
    <p class="research-panel-note">{zh ? '文献链接仅用于发现研究，不会改变或验证上方的监测序列。' : fr ? 'Les liens bibliographiques servent à découvrir des travaux et ne modifient ni ne valident la série de surveillance ci-dessus.' : 'Literature links are provided for discovery and do not alter or validate the surveillance series above.'}</p>
  </section>
)}

<style>
  .research-panel-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .research-panel-heading > a { flex: none; color: rgb(var(--color-brand)); font-size: .78rem; font-weight: 650; }
  .research-panel-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: .6rem; }
  .research-panel-count { margin-top: .75rem; color: rgb(var(--text-faint)); font: 500 .68rem/1.4 ui-monospace, monospace; }
  .research-panel-note { margin-top: 1rem; color: rgb(var(--text-faint)); font-size: .72rem; line-height: 1.5; }
  @media (max-width: 640px) { .research-panel-heading { align-items: start; flex-direction: column; } }
</style>
