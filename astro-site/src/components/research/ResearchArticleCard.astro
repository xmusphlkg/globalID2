---
interface Props {
  article: any;
  compact?: boolean;
  featured?: boolean;
  stream?: boolean;
  index?: number;
  initialVisible?: number;
  locale?: 'en' | 'zh';
}

const { article, compact = false, featured = false, stream = false, index, initialVisible, locale = 'en' } = Astro.props;
const zh = locale === 'zh';
const prefix = zh ? '/zh' : '';
const localeHref = (href: string | null) => href && zh && href.startsWith('/') ? `${prefix}${href}` : href;
const initiallyHidden = typeof index === 'number' && typeof initialVisible === 'number' && index >= initialVisible;
const publicationDate = article.publication_date_label_en ?? (article.published_at
  ? new Date(article.published_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
  : 'Date unavailable');
const publicationDateZh = article.publication_date_label_zh ?? (article.published_at
  ? new Date(article.published_at).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })
  : '日期暂缺');
const isHistoricalBaseline = article.source_kind === 'historical_seed' || article.historical_baseline;
const diseaseText = (article.diseases ?? []).map((item: any) => `${item.disease_id} ${item.name_en} ${item.name_zh ?? ''}`).join(' ').toLowerCase();
const countryText = (article.countries ?? []).map((item: any) => `${item.code} ${item.name_en}`).join(' ').toLowerCase();
const topicText = (article.topics ?? []).map((item: any) => item.name).join(' ').toLowerCase();
const filterText = `${article.title} ${article.journal ?? ''} ${diseaseText} ${countryText} ${topicText}`.toLowerCase();
const diseaseIds = (article.diseases ?? []).map((item: any) => String(item.disease_id ?? '').toLowerCase()).filter(Boolean);
const countryCodes = (article.countries ?? []).map((item: any) => String(item.code ?? '').toLowerCase()).filter(Boolean);
const topicSlugs = (article.topics ?? []).map((item: any) => String(item.name ?? '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')).filter(Boolean);
const visibleTopics = (article.topics ?? []).slice(0, compact ? 1 : 3);
const authorNames = (article.authors ?? []).filter(Boolean);
const authorPreview = authorNames.slice(0, 3);
const authorLineEn = authorNames.length > 3
  ? `${authorPreview.join(', ')} +${authorNames.length - authorPreview.length} more`
  : authorPreview.join(', ');
const authorLineZh = authorNames.length > 3
  ? `${authorPreview.join('、')} 等 ${authorNames.length} 位作者`
  : authorPreview.join('、');
const openAccessUrl = article.open_access_status === 'open'
  ? article.open_access_url ?? article.source_urls?.publisher ?? null
  : null;
const surveillanceLink = (article.related_surveillance ?? [])[0] ?? null;
const fallbackDisease = (article.diseases ?? [])[0] ?? null;
const surveillanceUrl = surveillanceLink?.url ?? (fallbackDisease?.slug ? `/diseases/${fallbackDisease.slug}/` : null);
const surveillanceLabelEn = surveillanceLink
  ? `${surveillanceLink.disease_name_en} surveillance`
  : fallbackDisease ? `${fallbackDisease.name_en} surveillance` : 'Related surveillance';
const surveillanceLabelZh = surveillanceLink
  ? `${surveillanceLink.disease_name_zh ?? surveillanceLink.disease_name_en}监测`
  : fallbackDisease ? `${fallbackDisease.name_zh ?? fallbackDisease.name_en}监测` : '相关监测';
---

<article
  class:list={[
    'research-card',
    compact && 'research-card-compact',
    featured && 'research-card-featured',
    stream && 'research-card-stream',
  ]}
  hidden={initiallyHidden}
  data-research-card
  data-card-index={index}
  data-search={filterText}
  data-disease={diseaseText}
  data-disease-ids={diseaseIds.join(' ')}
  data-country={countryText}
  data-country-codes={countryCodes.join(' ')}
  data-topic={topicText}
  data-topic-slugs={topicSlugs.join(' ')}
  data-study={(article.study_type ?? '').toLowerCase()}
  data-journal={(article.journal ?? '').toLowerCase()}
  data-publisher={(article.publisher ?? '').toLowerCase()}
  data-published-at={article.published_at ?? ''}
  data-peer-review-status={article.peer_review_status ?? ''}
  data-open-access={article.open_access_status === 'open' ? 'true' : 'false'}
>
  <div class="research-card-topline">
    <div class="research-card-badges">
      <span class="research-badge research-badge-peer">
        {article.peer_review_status === 'peer_reviewed' ? (zh ? '同行评议' : 'Peer reviewed') : (zh ? '预印本' : 'Preprint')}
      </span>
      {isHistoricalBaseline && <span class="research-badge research-badge-history">{zh ? '历史基线' : 'Historical baseline'}</span>}
      {article.open_access_status === 'open' && <span class="research-badge research-badge-oa">{zh ? '开放获取' : 'Open access'}</span>}
      {(article.diseases ?? []).slice(0, compact ? 1 : 2).map((disease: any) => (
        <span class="research-badge">{zh ? disease.name_zh ?? disease.name_en : disease.name_en}</span>
      ))}
      {visibleTopics.map((topic: any) => (
        <a class="research-badge research-badge-topic" href={`${prefix}/research/topics/${String(topic.name).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}/`}>{topic.name}</a>
      ))}
    </div>
    {article.doi && <a class="research-card-doi" href={`https://doi.org/${article.doi}`} target="_blank" rel="noopener noreferrer">DOI {article.doi} ↗</a>}
  </div>

  <h3 class="research-card-title"><a href={`${prefix}/research/articles/${article.slug}/`}>{article.title}</a></h3>
  {authorLineEn && <p class="research-card-authors">{zh ? authorLineZh : authorLineEn}</p>}
  <p class="research-card-source">
    <span>{article.journal ?? (zh ? '期刊信息暂缺' : 'Journal unavailable')}</span>
    <span aria-hidden="true">·</span>
    <time datetime={article.published_at}>{zh ? publicationDateZh : publicationDate}</time>
  </p>
  {(openAccessUrl || surveillanceUrl) && (
    <div class="research-card-actions">
      {openAccessUrl && <a class="research-card-action research-card-action-oa" href={openAccessUrl} target="_blank" rel="noopener noreferrer">{zh ? '打开全文 ↗' : 'Open article ↗'}</a>}
      {surveillanceUrl && <a class="research-card-action" href={localeHref(surveillanceUrl)}>{zh ? surveillanceLabelZh : surveillanceLabelEn} →</a>}
    </div>
  )}

  {!compact && (
    <>
      <dl class="research-card-facts">
        <div><dt>{zh ? '类型' : 'Type'}</dt><dd>{article.study_type ?? (zh ? '期刊论文' : 'Journal article')}</dd></div>
        <div><dt>{zh ? '范围' : 'Scope'}</dt><dd>{(article.countries ?? []).length > 0 ? article.countries.slice(0, 3).map((item: any) => zh ? item.name_zh ?? item.name_en : item.name_en).join(zh ? '、' : ', ') : (zh ? '未分类' : 'Not classified')}</dd></div>
      </dl>
      <p class="research-context">
        <strong>{zh ? '为何现在值得关注' : 'Why it matters now'}</strong>
        <span>{zh ? article.why_it_matters_zh ?? article.why_it_matters_en : article.why_it_matters_en}</span>
      </p>
    </>
  )}
</article>
