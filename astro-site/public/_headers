# Cloudflare Pages cache headers
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML pages — short TTL so reports are always fresh after redeploy
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Machine-readable production release identity — never serve a stale version
/release.json
  Cache-Control: no-store, max-age=0

/research/catalogue/manifest.json
  Cache-Control: no-store, max-age=0

# Astro build output (hashed filenames) — long TTL
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Data paths use stable names. Cache briefly at the edge and revalidate in the
# background rather than marking mutable JSON immutable.
/site-data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/data/*
  Cache-Control: public, max-age=86400

# Static assets with stable names: cache for a week and refresh in the
# background so a changed file reaches visitors without blocking a request.
/logo-mark-128.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logo-1-256.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/logo-2-256.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/scripts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/og-default.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Security headers applied globally. HSTS starts at one week without
# includeSubDomains or preload because subscriptions.* is a separate service;
# raise max-age once the rollout is confirmed.
/*
  Strict-Transport-Security: max-age=604800
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
