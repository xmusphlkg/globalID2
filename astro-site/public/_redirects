# Cloudflare Pages redirect rules
# https://developers.cloudflare.com/pages/configuration/redirects/

/site-data/research-graph.json  /site-data/research/graph.json  302

# Long-tail research pages, cards, and research site-data live on the papers host.
/research/articles/*  https://papers.globalinfectiousdisease.com/research/articles/:splat  301
/zh/research/articles/*  https://papers.globalinfectiousdisease.com/zh/research/articles/:splat  301
/fr/research/articles/*  https://papers.globalinfectiousdisease.com/fr/research/articles/:splat  301
/research/cards/*  https://papers.globalinfectiousdisease.com/research/cards/:splat  301
/site-data/research/*  https://papers.globalinfectiousdisease.com/site-data/research/:splat  301

# Country-disease long-tail URLs use one static runtime shell. The shell reads
# the country and disease values from the query string and loads current data.
/countries/:country/diseases/:disease/  /country-disease/?country=:country&disease=:disease  200
/zh/countries/:country/diseases/:disease/  /zh/country-disease/?country=:country&disease=:disease  200
/fr/countries/:country/diseases/:disease/  /fr/country-disease/?country=:country&disease=:disease  200

# Legacy disease slugs emitted before URL normalization. Keep these exact
# redirects so existing links and indexed URLs preserve their authority.
/diseases/erythema-infectiosum-(fifth-disease)/  /diseases/erythema-infectiosum-fifth-disease/  301
/diseases/respiratory-syncytial-virus-infection-(rsv)/  /diseases/respiratory-syncytial-virus-infection-rsv/  301
